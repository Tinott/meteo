# ===========================================================================
# NOUVELLE DÉCOMPOSITION : fermeture STLSQ de sin(2*phi) — le tilt de la CWT Morlet
#   Réutilise A_dom, sin2phi, zQ, flux_ref (cell 53), rho0, alt, ubar, sig_w, Mc, band
#   Hypothèse : sin(2phi) porte l'info géométrique (cisaillement -> tilt -> corrélation)
# ===========================================================================

# --- 1. Interpolation sur la grille alt (band() travaille sur alt, pas zQ) ---
sin2phi_z = np.interp(alt, zQ, sin2phi)
A_dom_z   = np.interp(alt, zQ, A_dom)

s = band()
zf = alt[s]

fig, ax = plt.subplots(1, 3, figsize=(16, 6), sharey=True)
ax[0].plot(sin2phi_z[s], zf, 'darkgreen', lw=2); ax[0].axvline(0, color='grey', alpha=.4)
ax[0].set_xlabel(r'$\sin(2\varphi)$'); ax[0].set_ylabel('z (m)')
ax[0].set_title('Tilt Morlet (à fermer)', fontweight='bold'); ax[0].grid(alpha=.3)

# --- 2. Dictionnaire de candidats pour expliquer sin(2phi)(z) ---
shear = np.gradient(ubar, alt)
Theta_r = {
    'shear/sig_w'        : shear / (sig_w + 1e-9),          # nombre de cisaillement local
    'Mc/(rho0*sig_w)'    : Mc / (rho0*sig_w + 1e-9),         # fraction convective normalisée
    'sig_u/sig_w'        : sig_u / (sig_w + 1e-9),           # anisotropie turbulente
    'theta_uw'            : np.radians(theta_uw),             # angle interne (cell 29), déjà en mémoire
}
names_r = list(Theta_r.keys())

# --- 3. STLSQ avec validation train/test (pair/impair) ---
Phi_r = np.column_stack([Theta_r[k][s] for k in names_r])
yv_r  = sin2phi_z[s]
ok = np.isfinite(yv_r) & np.all(np.isfinite(Phi_r), axis=1)   # sécurité NaN
Phi_r, yv_r = Phi_r[ok], yv_r[ok]

mu_r, sd_r = Phi_r.mean(0), Phi_r.std(0) + 1e-30
Phi_rs = (Phi_r - mu_r) / sd_r

idx = np.arange(len(yv_r))
tr, te = idx[idx % 2 == 0], idx[idx % 2 == 1]

ym_r = yv_r[tr].mean()
xi_r = stlsq(Phi_rs[tr], yv_r[tr] - ym_r, thresh=0.15)
yh_tr = Phi_rs[tr] @ xi_r + ym_r
yh_te = Phi_rs[te] @ xi_r + ym_r
R2tr_r, R2te_r = r2(yv_r[tr], yh_tr), r2(yv_r[te], yh_te)

print('=== sin(2phi) [tilt Morlet] : fermeture géométrique ===')
print(f'  R² train {R2tr_r:+.3f}   R² TEST {R2te_r:+.3f}   '
      f'({"OK" if R2te_r>0.3 else "sur-ajustement / non fermable"})')
print('  termes retenus :')
for k, c in sorted(zip(names_r, xi_r), key=lambda t: -abs(t[1])):
    if abs(c) > 1e-9:
        print(f'    {k:18s} {c:+.3f}')

sin2phi_hat = Phi_rs @ xi_r + ym_r
zf_ok = zf[ok]

ax[1].plot(yv_r, zf_ok, 'k', lw=2.5, label='sin(2φ) vrai')
ax[1].plot(sin2phi_hat, zf_ok, 'g--', lw=2, label=f'fermeture (test R²={R2te_r:+.2f})')
ax[1].axvline(0, color='grey', alpha=.4)
ax[1].set_xlabel(r'$\sin(2\varphi)$'); ax[1].set_title('Fermeture du tilt', fontweight='bold')
ax[1].legend(fontsize=9); ax[1].grid(alpha=.3)

# --- 4. Reconstruction finale du flux complet : amplitude (mesurée) x tilt (fermé) ---
flux_recon_full = rho0[s][ok] * A_dom_z[s][ok] * sin2phi_hat / n_x
R2_flux_final = r2(flux_ref[np.interp(zf_ok, zQ, np.arange(len(zQ))).astype(int)] if False else
                    np.interp(zf_ok, zQ, flux_ref), flux_recon_full)

ax[2].plot(np.interp(zf_ok, zQ, flux_ref)*1e3, zf_ok, 'k', lw=2.5, label='flux vrai')
ax[2].plot(flux_recon_full*1e3, zf_ok, 'm--', lw=2,
           label=f'amplitude×tilt fermé (R²={R2_flux_final:+.2f})')
ax[2].axvline(0, color='grey', alpha=.4)
ax[2].set_xlabel('flux (×10⁻³)')
ax[2].set_title('Flux reconstruit : amplitude × tilt fermé', fontweight='bold')
ax[2].legend(fontsize=9); ax[2].grid(alpha=.3)

plt.suptitle("Fermeture géométrique : amplitude (mesurée) × sin(2φ) (STLSQ)",
             fontsize=13, fontweight='bold')
plt.tight_layout(); plt.show()
