# ============================================================
uprime_raw = ubar_zt - ubar_zt.mean(axis=1, keepdims=True)

dudt_tot_raw = np.gradient(uprime_raw, dt_phys, axis=1)
dudz_tot_raw = np.gradient(uprime_raw, alt, axis=0)

dtuc_raw = np.gradient(u_h_zt, dt_phys, axis=1)
dtus_raw = np.gradient(u_s_zt, dt_phys, axis=1)
dzuc_raw = np.gradient(u_h_zt, alt, axis=0)
dzus_raw = np.gradient(u_s_zt, alt, axis=0)

