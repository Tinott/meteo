# ── Figure 2 : profils flux Reynolds + fit ───────────────────
sc = 1e3
for sim in ['large300', 'small300']:
    alt  = A_fits[sim]['alt']
    idx  = np.searchsorted(alt, 15000)
    z_f  = alt[:idx].astype(float)
    axes[1].plot(A_fits[sim]['flux_h'][:idx] * sc,
                 z_f, color=colors[sim], lw=2.5, label=f'{sim} simulation')
    axes[1].plot(profil_cmt(z_f, *A_fits[sim]['popt_h']) * sc,
                 z_f, color=colors[sim], lw=1.5, ls='--',
                 label=f'{sim} fit  A={A_fits[sim]["h"]:.2e}')

axes[1].axvline(0, color='grey', alpha=0.4)
axes[1].set_xlabel("ρ₀⟨u'w'⟩  (×10⁻³ kg/m²/s²)")
axes[1].set_title('Flux Reynolds humide + fit', fontweight='bold')
axes[1].legend(fontsize=8); axes[1].grid(True, alpha=0.3)

# ── Figure 3 : A vs M/ρ (test A ∝ M/ρ à la Romps) ───────────
sims_list  = ['large300', 'small300']
A_vals     = np.array([abs(A_fits[s]['h']) for s in sims_list])
Mrho_vals  = np.array([M_scal[s] for s in sims_list])
CAPE_vals  = np.array([CAPE[s]   for s in sims_list])

# régression linéaire A ~ k * M/rho (sans constante, à la Romps)
k_romps = float(np.dot(A_vals, Mrho_vals) / np.dot(Mrho_vals, Mrho_vals))
x_line  = np.linspace(0, Mrho_vals.max() * 1.3, 100)

ax3 = axes[2]
for i, sim in enumerate(sims_list):
    ax3.scatter(Mrho_vals[i] * 100, A_vals[i] * sc,
                color=colors[sim], s=120, zorder=5, label=sim)
    ax3.annotate(sim, (Mrho_vals[i]*100, A_vals[i]*sc),
                 textcoords='offset points', xytext=(6, 4), fontsize=9)

ax3.plot(x_line * 100, k_romps * x_line * sc,
         'k--', lw=1.5, label=f'A = {k_romps:.3f} · M/ρ')
ax3.set_xlabel('M/ρ₀  moyen 2–12 km  (cm/s)')
ax3.set_ylabel('|A|  (×10⁻³ kg/m²/s²)')
ax3.set_title('Test A ∝ M/ρ  (Romps 2014)', fontweight='bold')
ax3.legend(fontsize=9); ax3.grid(True, alpha=0.3)

plt.suptitle('§20 — A vs variables grandes échelles\nlarge300 vs small300',
             fontsize=13, fontweight='bold')
