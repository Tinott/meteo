# ============================================================
# BASES FIXES DE RELIEF pour decomposer psi' et reconstruire le flux
#   On teste des bases TYPIQUES de surface/relief (pas apprises) :
#     - DCT 2D        (base des reliefs bornes, JPEG)
#     - Fourier 2D    (naturelle car x periodique)
#     - Ondelettes 2D (multi-echelle, base reine des reliefs)
#     - Legendre 2D   (polynomiale, surfaces lisses)
#   Pour chaque base : on projette psi', on tronque, on derive
#   -> u',w' -> flux, et on compare au flux VRAI.
# ============================================================
import pywt
from scipy.fft import dctn, idctn, fftn, ifftn
from numpy.polynomial import legendre as Lg

# --- psi'(x,z,t) : moyenne-y + anomalie spatiale (deja construit plus haut) ---
# psi_ano  (Np, n_z, n_x)  et  flux_true_profile  supposes disponibles.
# Si besoin, cible = flux du relief complet (borne haute de la voie psi) :
def flux_from_psi(pa):
    up = np.gradient(pa, alt, axis=1) / rho0[None, :, None]
    wp = -np.gradient(pa, x,   axis=2) / rho0[None, :, None]
    up = up - up.mean(axis=2, keepdims=True)
    wp = wp - wp.mean(axis=2, keepdims=True)
    return (rho0[None, :] * (up * wp).mean(axis=2)).mean(axis=0)

# borne haute atteignable par la voie psi (relief complet, non tronque)
flux_psi_ceiling = flux_from_psi(psi_ano)
nse_ceiling = nse(flux_true_profile, flux_psi_ceiling)
print(f'[borne haute] flux via psi COMPLET : NSE = {nse_ceiling:+.3f}')
print('  -> aucune base ne peut depasser ce plafond (limite physique de psi moyenne-y)\n')

def keep_frac(coef_flat, frac):
    k = max(1, int(frac * coef_flat.size))
    idx = np.argpartition(np.abs(coef_flat), -k)[-k:]
    out = np.zeros_like(coef_flat); out[idx] = coef_flat[idx]
    return out

# --- 1. DCT 2D ---
def recon_dct(pa, frac):
    out = np.empty_like(pa)
    for t in range(pa.shape[0]):
        C = dctn(pa[t], norm='ortho')
        out[t] = idctn(keep_frac(C.ravel(), frac).reshape(C.shape), norm='ortho')
    return out

# --- 2. Fourier 2D ---
def recon_fft(pa, frac):
    out = np.empty_like(pa)
    for t in range(pa.shape[0]):
        C = fftn(pa[t])
        out[t] = np.real(ifftn(keep_frac(C.ravel(), frac).reshape(C.shape)))
    return out

# --- 3. Ondelettes 2D (Daubechies db4, x periodique) ---
def recon_wave(pa, frac, wl='db4'):
    out = np.empty_like(pa)
    for t in range(pa.shape[0]):
        coeffs = pywt.wavedec2(pa[t], wl, mode='periodization')
        arr, sl = pywt.coeffs_to_array(coeffs)
        arr2 = keep_frac(arr.ravel(), frac).reshape(arr.shape)
        c2 = pywt.array_to_coeffs(arr2, sl, output_format='wavedec2')
        out[t] = pywt.waverec2(c2, wl, mode='periodization')[:pa.shape[1], :pa.shape[2]]
    return out

# --- 4. Legendre 2D (produit tensoriel, surfaces lisses) ---
def legendre_basis(n, deg):
    xs = np.linspace(-1, 1, n); B = np.zeros((n, deg))
    for d in range(deg):
        c = np.zeros(deg); c[d] = 1; B[:, d] = Lg.legval(xs, c)
    return B / (np.linalg.norm(B, axis=0, keepdims=True) + 1e-30)
def recon_legendre(pa, frac):
    nz, nx = pa.shape[1], pa.shape[2]
    deg = max(2, int(np.sqrt(frac * nz * nx)))
    Bz = legendre_basis(nz, min(deg, nz)); Bx = legendre_basis(nx, min(deg, nx))
    out = np.empty_like(pa)
    for t in range(pa.shape[0]):
        out[t] = Bz @ (Bz.T @ pa[t] @ Bx) @ Bx.T
    return out

# --- balayage : NSE(flux) vs fraction de coefficients, pour chaque base ---
fracs = np.array([0.02, 0.05, 0.1, 0.2, 0.3, 0.5])
bases = {'DCT': recon_dct, 'Fourier': recon_fft,
         'Ondelettes': recon_wave, 'Legendre': recon_legendre}
results = {name: [] for name in bases}
for fr in fracs:
    for name, fn in bases.items():
        results[name].append(nse(flux_true_profile, flux_from_psi(fn(psi_ano, fr))))
for name in bases:
    results[name] = np.array(results[name])

print('frac% |  ' + ' | '.join(f'{n:>10s}' for n in bases))
for i, fr in enumerate(fracs):
    print(f' {fr*100:4.0f} |  ' +
          ' | '.join(f'{results[n][i]:+10.3f}' for n in bases))

