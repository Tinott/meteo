# ============================================================
#  -I_tend(z)  et  -I_adv(z)  separement, puis leur somme
#    I_tend = ∫_0^z rho0 ∂_t ubar dz'
#    I_adv  = ∫_0^z rho0 wbar ∂_z ubar dz'
# ============================================================
from scipy.integrate import cumulative_trapezoid

dt_ubar = np.gradient(ubar_zt, dt_phys, axis=1)   # ∂_t ubar (z,t)
dz_ubar = np.gradient(ubar_zt, alt,     axis=0)   # ∂_z ubar (z,t)

I_tend = cumulative_trapezoid((rho0[:,None]*dt_ubar).mean(1), alt, initial=0)
I_adv  = cumulative_trapezoid((rho0[:,None]*wbar_zt*dz_ubar).mean(1), alt, initial=0)
somme  = -I_tend - I_adv

fig, ax = plt.subplots(figsize=(7.5, 6))
ax.plot(-I_tend, alt, 'royalblue', lw=2, label=r'$-I_{tend}=-\int_0^z\rho_0\,\partial_t\bar u\,dz$')
ax.plot(-I_adv,  alt, 'seagreen',  lw=2, label=r'$-I_{adv}=-\int_0^z\rho_0\,\bar w\,\partial_z\bar u\,dz$')
ax.plot(somme,   alt, 'crimson',   lw=2.5, ls='--', label=r'$-(I_{tend}+I_{adv})$')
ax.axvline(0, color='grey', lw=.5); ax.set_ylim(0, 15000)
ax.set_xlabel(r'QdM cumulee'); ax.set_ylabel('z (m)')
ax.set_title(r'Les deux integrales, separement puis jointes', fontweight='bold')
ax.legend(fontsize=9); ax.grid(True, alpha=.3)
plt.tight_layout(); plt.show()

print(f'|I_tend| max = {np.abs(I_tend).max():.2e}')
print(f'|I_adv|  max = {np.abs(I_adv).max():.2e}')
print(f'ratio adv/tend = {np.abs(I_adv).max()/max(np.abs(I_tend).max(),1e-30):.0f}x')
