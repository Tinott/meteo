# ======================================================================
#  UNE ELLIPSE PAR CELLULE — blocs ψ′ rouges vs bleus séparés
#  ----------------------------------------------------------------------
#  Chaque grande cellule = composante connexe de ψ′ d'un même signe.
#  ROUGE = ψ′ > 0 (max), BLEU = ψ′ < 0 (min). Pour chaque bloc on ajuste
#  l'ELLIPSE d'inertie : centre, demi-axes (a,b) en km, inclinaison θ.
#  Réutilise : psi_a, psi2d, x, z_reg, n_x, nz_D, dxl, dzl.
# ======================================================================
import numpy as np
from scipy.ndimage import gaussian_filter, label
import matplotlib.pyplot as plt
from matplotlib.colors import TwoSlopeNorm

# --- réglages ---
SIGMA_X, SIGMA_Z = 2.0, 2.0      # lissage (points)
SEUIL_FRAC = 0.20                # un bloc = |ψ′| ≥ frac·max  (baisse->blocs plus larges)
N_MIN      = 50                  # taille mini d'un bloc (points) pour éviter les miettes

# --- ψ′ lissé ---
psi_s = gaussian_filter(psi_a, sigma=(SIGMA_Z, SIGMA_X), mode=('nearest', 'wrap'))
SEUIL = SEUIL_FRAC * np.abs(psi_s).max()

# --- blocs connexes d'un signe donné (couture x périodique recousue) ---
def blocs_signe(sign):
    mask = (sign * psi_s >= SEUIL)
    lab, _ = label(mask)
    for j in range(nz_D):
        a, b = lab[j, 0], lab[j, -1]
        if a > 0 and b > 0 and a != b:
            lab[lab == b] = a
    return [np.argwhere(lab == L) for L in range(1, lab.max()+1)
            if (lab == L).sum() >= N_MIN]

# --- ellipse d'inertie d'un bloc -> (xc,zc en km, a,b demi-axes km, theta deg) ---
def ellipse_bloc(pts):
    js, iis = pts[:, 0], pts[:, 1]
    w = np.abs(psi_s[js, iis]); w = w / (w.sum() + 1e-30)
    xc = (w*iis*dxl).sum(); zc = (w*js*dzl).sum()
    xx = iis*dxl - xc; zz = js*dzl - zc
    Ixx = (w*xx*xx).sum(); Izz = (w*zz*zz).sum(); Ixz = (w*xx*zz).sum()
    theta = np.degrees(0.5*np.arctan2(2*Ixz, Ixx - Izz))
    tr, det = Ixx + Izz, Ixx*Izz - Ixz**2
    disc = np.sqrt(max(tr*tr/4 - det, 0.0))
    a = 2*np.sqrt(tr/2 + disc)        # demi-grand axe [m]
    b = 2*np.sqrt(tr/2 - disc)        # demi-petit axe [m]
    return xc/1000, zc/1000, a/1000, b/1000, theta

def trace_ellipse(ax, xc, zc, a, b, theta_deg, color):
    t  = np.linspace(0, 2*np.pi, 200); th = np.radians(theta_deg)
    ex, ez = a*np.cos(t), b*np.sin(t)
    X = xc + ex*np.cos(th) - ez*np.sin(th)
    Z = zc + ex*np.sin(th) + ez*np.cos(th)
    ax.plot(X, Z, color=color, lw=3)
    ax.plot([xc-a*np.cos(th), xc+a*np.cos(th)],
            [zc-a*np.sin(th), zc+a*np.sin(th)], color=color, lw=1.4, ls='--')
    ax.plot(xc, zc, 'o', color=color, ms=7, mec='k', mew=1.2)

# --- ajustement + tableau ---
fig, ax = plt.subplots(figsize=(14, 6))
pmax = np.percentile(np.abs(psi_a), 99) + 1e-30
pc = ax.pcolormesh(x/1000, z_reg/1000, psi_a, shading='auto',
                   norm=TwoSlopeNorm(vcenter=0, vmin=-pmax, vmax=pmax), cmap='RdBu_r')
ax.contour(x/1000, z_reg/1000, psi2d, levels=20, colors='k', linewidths=0.3, alpha=0.4)

print(f"{'cellule':>10} | {'x_c':>5} | {'z_c':>5} | {'grand':>6} | {'petit':>6} | {'θ°':>4}")
print('-'*52)
for sign, nom, coul in [(+1, 'ROUGE', 'gold'), (-1, 'BLEU', 'deepskyblue')]:
    blocs = blocs_signe(sign)
    blocs.sort(key=lambda p: -len(p))            # plus gros bloc d'abord
    for k, pts in enumerate(blocs, 1):
        xc, zc, a, b, theta = ellipse_bloc(pts)
        trace_ellipse(ax, xc, zc, a, b, theta, coul)
        ax.text(xc, zc, f"{nom[0]}{k}", ha='center', va='center',
                fontsize=9, fontweight='bold', color='k')
        print(f"{nom+str(k):>10} | {xc:5.0f} | {zc:5.1f} | {2*a:5.0f}km | {2*b:5.0f}km | {theta:+4.0f}")

ax.set_xlabel('x [km]'); ax.set_ylabel('z [km]')
ax.set_title("Une ellipse par cellule ψ′  —  ROUGE = max (or), BLEU = min (cyan)")
fig.colorbar(pc, ax=ax, label=r"$\psi'$ [kg m$^{-1}$ s$^{-1}$]", pad=0.01)
plt.tight_layout(); plt.show()
