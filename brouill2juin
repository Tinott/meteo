# ============================================================
#  ETAPE 2 — SMOOTH APPLIQUE EN DERNIER, sur les champs deja derives
# ============================================================
WIN_T = 8
def smooth_t(fld):
    return uniform_filter1d(fld, size=WIN_T, axis=1, mode='nearest')

dudt_tot = smooth_t(dudt_tot_raw)
dudz_tot = smooth_t(dudz_tot_raw)
dtuc = smooth_t(dtuc_raw); dtus = smooth_t(dtus_raw)
dzuc = smooth_t(dzuc_raw); dzus = smooth_t(dzus_raw)
w_s_smooth = smooth_t(w_s_raw)





