# ============================================================================
# CHERCHER LE TERME PHYSIQUE QUI SUIT <u'w'>_up : candidats INTERNES (point par point)
#   On ne predit plus avec des moyennes. On mesure des quantites DANS le coeur et on
#   regarde laquelle a la meme forme verticale que la covariance interne.
# ============================================================================
reg = mh; C = float(C_star)

cov_up = np.full(n_z, np.nan)   # CIBLE : <u'_int w'_int>_up
# candidats internes :
su_up  = np.full(n_z, np.nan)   # sigma_u interne (amplitude des fluct. de u dans le coeur)
sw_up  = np.full(n_z, np.nan)   # sigma_w interne
skew_w = np.full(n_z, np.nan)   # asymetrie de w' interne (coeur vs bord)
cov_uT = np.full(n_z, np.nan)   # <u'_int * w'_int * sign> deja dans cov ; ici <u'_int^2 w'_int> (transport de variance)
flux_in= np.full(n_z, np.nan)   # <w'_int * |grad lateral|> proxy de cisaillement INTERNE
# cisaillement INTERNE du vent vertical : un updraft a un coeur rapide et des bords lents
# -> on mesure <u'_int w'_int> conditionne, mais on teste aussi le lien avec la taille du coeur

ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for iz in range(n_z):
    acov=asu=asw=askw=auuw=0.0; n=0
    for it in range(t_stat, n_t):
        u = ds_u['ua'].isel({dim_t:it, dim_z:iz}).values[reg]
        w = ds_w['wa'].isel({dim_t:it, dim_z:iz}).values[reg]
        ws, up, dn, env = classify(w, C)
        if up.sum() >= 8:
            uu, ww = u[up], w[up]
            up_ = uu-uu.mean(); wp_ = ww-ww.mean()
            su, sw = up_.std(), wp_.std()
            acov += (up_*wp_).mean()
            asu  += su; asw += sw
            askw += (wp_**3).mean()/(sw**3 + 1e-12)        # skewness de w' interne
            auuw += (up_**2 * wp_).mean()                   # transport interne de variance de u
        n += 1; del u, w
    cov_up[iz]=acov/n; su_up[iz]=asu/n; sw_up[iz]=asw/n
    skew_w[iz]=askw/n; cov_uT[iz]=auuw/n
    gc.collect()
ds_u.close(); ds_w.close(); del ds_u, ds_w; gc.collect()

# candidat composite cle : produit des amplitudes internes (su * sw)
amp = su_up * sw_up

s = band()
def zcorr(a,b,s):
    a,b=a[s],b[s]; ok=np.isfinite(a)&np.isfinite(b)
    return np.corrcoef(a[ok],b[ok])[0,1] if ok.sum()>=5 else np.nan

print("=== correlation verticale de <u'w'>_up avec des candidats INTERNES ===")
cands = {'sigma_u interne':su_up, 'sigma_w interne':sw_up,
         'sigma_u*sigma_w (amplitude)':amp, 'skewness w interne':skew_w,
         'transport variance <u\'^2 w\'>':cov_uT}
for name, arr in cands.items():
    print(f"  {name:>32} : r = {zcorr(cov_up, arr, s):+.2f}")
