# --- inclinaison typique : 3 mesures pour comparer ---
    # (1) moyenne circulaire (recommandée : gère le repli d'axe, pas de biais)
    th_circ = 0.5 * np.degrees(np.arctan2(
        np.mean(np.sin(np.radians(2*thetas))),
        np.mean(np.cos(np.radians(2*thetas)))))
    # (2) médiane des valeurs absolues (inclinaison "moyenne" sans signe)
    th_abs = np.median(np.abs(thetas))
    # (3) moyenne des valeurs absolues (ce que tu demandes)
    th_absmean = np.mean(np.abs(thetas))
    th_disp = 0.5 * np.degrees(np.std(np.radians(2*thetas)))


print(f"  inclinaison θ ..... circulaire {th_circ:+.0f}°  |  "
          f"|θ| médiane {th_abs:.0f}°  |  |θ| moyenne {th_absmean:.0f}°   (± {th_disp:.0f}°)")
