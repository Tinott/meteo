# ======================================================================
# §17 — Paramétrisation down-gradient par région : K(z) = -<u'w'> / (dū/dz)
#
# Entrées :
#   flux_loc_h, flux_loc_s  = rho0 * <u'w'>  anomalies locales (§16)
#   ubar_b_2d   (n_z, n_y, n_x)  champ moyen (§15b — même que §15a)
#   mh, ms      masques humide / sec
#   rho0, alt
# ======================================================================

SEUIL_GRAD = 1e-5   # s⁻¹

# ── 1. ū(z) moyen par région ──────────────────────────────────────────
ubar_z_h = np.array([ubar_b_2d[iz][mh].mean() for iz in range(n_z)])
ubar_z_s = np.array([ubar_b_2d[iz][ms].mean() for iz in range(n_z)])

# ── 2. dū/dz par région ───────────────────────────────────────────────
dubar_dz_h = np.gradient(ubar_z_h, alt)
dubar_dz_s = np.gradient(ubar_z_s, alt)

# ── 3. K(z) diagnostiqué + interpolé par région ───────────────────────
def diagnostiquer_K(flux_reg, dubar_dz_reg):
    uw = flux_reg / rho0
    K  = np.full(n_z, np.nan)
    masque = np.abs(dubar_dz_reg) > SEUIL_GRAD
    K[masque] = -uw[masque] / dubar_dz_reg[masque]
    K_interp  = K.copy()
    idx_val   = np.where(masque)[0]
    if len(idx_val) > 1:
        K_interp = np.interp(np.arange(n_z), idx_val, K[idx_val])
    return K, K_interp, masque

K_h, K_interp_h, masque_h = diagnostiquer_K(flux_loc_h, dubar_dz_h)
K_s, K_interp_s, masque_s = diagnostiquer_K(flux_loc_s, dubar_dz_s)

# ── 4. Flux reconstruit ───────────────────────────────────────────────
flux_pred_h = -rho0 * K_interp_h * dubar_dz_h
flux_pred_s = -rho0 * K_interp_s * dubar_dz_s

print('§17 calcul terminé.')
print(f'  K humide  min={np.nanmin(K_h):.1f}  max={np.nanmax(K_h):.1f}  m²/s')
print(f'  K sec     min={np.nanmin(K_s):.1f}  max={np.nanmax(K_s):.1f}  m²/s')





# ======================================================================
# §17 — Visualisation : flux simulé vs prédit par région
# ======================================================================

sc     = 1.0
sc_div = 1e5
idx_tropo = np.searchsorted(alt, 15000)

t1_sim_h  = tendance(flux_loc_h)
t1_sim_s  = tendance(flux_loc_s)
t1_pred_h = tendance(flux_pred_h)
t1_pred_s = tendance(flux_pred_s)

for region, flux_sim, flux_pred, t1_sim, t1_pred, ubar_z, dubar_dz, K, couleur in [
    ('HUMIDE', flux_loc_h, flux_pred_h, t1_sim_h, t1_pred_h, ubar_z_h, dubar_dz_h, K_h, 'royalblue'),
    ('SECHE',  flux_loc_s, flux_pred_s, t1_sim_s, t1_pred_s, ubar_z_s, dubar_dz_s, K_s, 'saddlebrown'),
]:
    fig, axes = plt.subplots(1, 4, figsize=(20, 9), sharey=True)

    for ax, sl in zip(axes, [slice(None, idx_tropo)]*2 + [slice(None, idx_tropo)]*2):
        ax.grid(True, alpha=0.3)
        ax.axvline(0, color='grey', alpha=0.4)

    # ── ax0 : ū et dū/dz ─────────────────────────────────────────────
    axes[0].plot(ubar_z[:idx_tropo],          alt[:idx_tropo],
                 color=couleur, lw=2, label='ū (m/s)')
    ax0b = axes[0].twiny()
    ax0b.plot(dubar_dz[:idx_tropo]*1e4, alt[:idx_tropo],
              color=couleur, lw=1.5, linestyle='--', label='dū/dz ×10⁻⁴')
    axes[0].set_xlabel('ū  (m/s)',            color=couleur)
    ax0b.set_xlabel('dū/dz  (×10⁻⁴ s⁻¹)',   color=couleur)
    axes[0].set_title('ū et dū/dz', fontweight='bold')

    # ── ax1 : K(z) ───────────────────────────────────────────────────
    axes[1].plot(K[:idx_tropo],         alt[:idx_tropo],
                 color=couleur, lw=0, marker='.', markersize=3, label='K diagnostiqué')
    axes[1].plot(K_interp_h[:idx_tropo] if region == 'HUMIDE' else K_interp_s[:idx_tropo],
                 alt[:idx_tropo],
                 color=couleur, lw=2, label='K interpolé')
    axes[1].set_xlabel('K  (m²/s)')
    axes[1].set_title('K(z)', fontweight='bold')
    axes[1].legend(fontsize=8)

    # ── ax2 : flux simulé vs prédit ──────────────────────────────────
    axes[2].plot(flux_sim[:idx_tropo],  alt[:idx_tropo],
                 color=couleur, lw=2.5, label='simulé')
    axes[2].plot(flux_pred[:idx_tropo], alt[:idx_tropo],
                 color='black', lw=2, linestyle='--', label='prédit')
    axes[2].set_xlabel('ρ₀⟨u\'w\'⟩  (kg m⁻¹ s⁻²)')
    axes[2].set_title('Flux simulé vs prédit', fontweight='bold')
    axes[2].legend(fontsize=8)

    # ── ax3 : divergence simulée vs prédite ──────────────────────────
    axes[3].plot(t1_sim[:idx_tropo]  * sc_div, alt[:idx_tropo],
                 color=couleur, lw=2.5, label='simulée')
    axes[3].plot(t1_pred[:idx_tropo] * sc_div, alt[:idx_tropo],
                 color='black', lw=2, linestyle='--', label='prédite')
    axes[3].set_xlabel('−1/ρ₀ ∂(ρ₀⟨u\'w\'⟩)/∂z  (×10⁻⁵ m/s²)')
    axes[3].set_title('Divergence simulée vs prédite', fontweight='bold')
    axes[3].legend(fontsize=8)

    axes[0].set_ylabel('Altitude (m)')
    plt.suptitle(f'§17 — Région {region} — Fermeture down-gradient (anomalies locales)\n'
                 'Troposphère 0–15 km',
                 fontsize=13, fontweight='bold')
    plt.tight_layout()
    plt.show()
