## 15. Fermeture du bilan de QdM par région (humide / sèche)

On vérifie si l'équation de Navier-Stokes se ferme séparément dans chaque région.

**Méthode directe** : dérivée du flux de Reynolds calculée à partir de ρ₀⟨u′w′⟩ restreint aux colonnes humides (ou sèches), exactement comme au §9.

**Méthode résiduelle** : ∂ū/∂t calculé en ne moyennant que sur les colonnes humides (ou sèches).

Si l'advection et la pression ne s'annulent plus localement (contrairement au cas global), l'écart entre les deux profils sera plus grand. On visualise les deux profils côte à côte pour chaque région.








# ======================================================================
# §15 — Fermeture du bilan par région : humide vs sèche
#
# Méthode A (directe)   : -1/rho0 * d(rho0 <u'w'>_region)/dz
#                          flux_h / flux_s déjà disponibles depuis §9
#
# Méthode B (résiduelle) : <∂u/∂t>_region  moyenné sur les colonnes
#                          de la région à chaque pas de temps
#
# mh / ms : masques 2D (ny, nx) construits au §4
# ======================================================================

dt_sec = 6.0 * 3600.0

dudt_h = np.zeros(n_z)   # ∂ū/∂t moyenné sur colonnes humides
dudt_s = np.zeros(n_z)   # ∂ū/∂t moyenné sur colonnes sèches

ds_u = xr.open_dataset(path3d('ua'))

for iz in range(n_z):

    acc_h = 0.0
    acc_s = 0.0
    n = 0

    for it in range(t_stat, n_t - 1):

        u_now  = ds_u['ua'].isel({dim_t: it,     dim_z: iz}).values  # (ny, nx)
        u_next = ds_u['ua'].isel({dim_t: it + 1, dim_z: iz}).values

        dudt_2d = (u_next - u_now) / dt_sec  # (ny, nx)

        # Moyenne sur les colonnes de chaque région
        acc_h += dudt_2d[mh].mean()
        acc_s += dudt_2d[ms].mean()
        n += 1

        del u_now, u_next, dudt_2d
        gc.collect()

    dudt_h[iz] = acc_h / n if n > 0 else 0.0
    dudt_s[iz] = acc_s / n if n > 0 else 0.0

    if iz % 10 == 0:
        print(f'  iz={iz}/{n_z-1}  ({alt[iz]:.0f} m)')

ds_u.close()
del ds_u
gc.collect()

# Méthode directe : tendance par divergence du flux de Reynolds
# flux_h et flux_s sont déjà calculés au §9
tend_h_direct = tendance(flux_h)   # -1/rho0 * d(rho0 <u'w'>_h)/dz
tend_s_direct = tendance(flux_s)

print('§15 : calcul terminé.')








# ======================================================================
# §15 — Visualisation : comparaison directe vs résiduelle par région
# ======================================================================

idx_tropo = np.searchsorted(alt, 15000)
sc = 1e5

fig, axes = plt.subplots(2, 2, figsize=(14, 14), sharey='row')

# ── Ligne 1 : troposphère (0–15 km) ───────────────────────────────────
sl = slice(None, idx_tropo)

ax = axes[0, 0]
ax.plot(tend_h_direct[sl] * sc, alt[sl], color='royalblue', lw=2,
        label=r"Directe $-\frac{1}{\rho_0}\partial_z(\rho_0\overline{u'w'}_h)$")
ax.plot(dudt_h[sl] * sc,        alt[sl], color='crimson',   lw=2, linestyle='--',
        label=r'Résidu $\langle\partial u/\partial t\rangle_h$')
ax.axvline(0, color='grey', alpha=0.4)
ax.set_title('Région HUMIDE — troposphère', fontweight='bold')
ax.set_xlabel('Tendance (×10⁻⁵ m/s²)')
ax.set_ylabel('Altitude (m)')
ax.legend()
ax.grid(True, alpha=0.3)

ax = axes[0, 1]
ax.plot(tend_s_direct[sl] * sc, alt[sl], color='saddlebrown', lw=2,
        label=r"Directe $-\frac{1}{\rho_0}\partial_z(\rho_0\overline{u'w'}_s)$")
ax.plot(dudt_s[sl] * sc,        alt[sl], color='crimson',     lw=2, linestyle='--',
        label=r'Résidu $\langle\partial u/\partial t\rangle_s$')
ax.axvline(0, color='grey', alpha=0.4)
ax.set_title('Région SÈCHE — troposphère', fontweight='bold')
ax.set_xlabel('Tendance (×10⁻⁵ m/s²)')
ax.legend()
ax.grid(True, alpha=0.3)

# ── Ligne 2 : colonne complète ─────────────────────────────────────────
ax = axes[1, 0]
ax.plot(tend_h_direct * sc, alt, color='royalblue', lw=2,
        label=r"Directe $-\frac{1}{\rho_0}\partial_z(\rho_0\overline{u'w'}_h)$")
ax.plot(dudt_h * sc,        alt, color='crimson',   lw=2, linestyle='--',
        label=r'Résidu $\langle\partial u/\partial t\rangle_h$')
ax.axvline(0, color='grey', alpha=0.4)
ax.set_title('Région HUMIDE — colonne complète', fontweight='bold')
ax.set_xlabel('Tendance (×10⁻⁵ m/s²)')
ax.set_ylabel('Altitude (m)')
ax.legend()
ax.grid(True, alpha=0.3)

ax = axes[1, 1]
ax.plot(tend_s_direct * sc, alt, color='saddlebrown', lw=2,
        label=r"Directe $-\frac{1}{\rho_0}\partial_z(\rho_0\overline{u'w'}_s)$")
ax.plot(dudt_s * sc,        alt, color='crimson',     lw=2, linestyle='--',
        label=r'Résidu $\langle\partial u/\partial t\rangle_s$')
ax.axvline(0, color='grey', alpha=0.4)
ax.set_title('Région SÈCHE — colonne complète', fontweight='bold')
ax.set_xlabel('Tendance (×10⁻⁵ m/s²)')
ax.legend()
ax.grid(True, alpha=0.3)

plt.suptitle('Fermeture du bilan de QdM : régions humide vs sèche\n'
             r"Directe = $-\frac{1}{\rho_0}\partial_z(\rho_0\overline{u'w'})$   "
             r"Résidu = $\langle\partial u/\partial t\rangle$",
             fontsize=13, fontweight='bold')
plt.tight_layout()
plt.show()
