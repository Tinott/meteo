# ======================================================================
#  BLOC C — Catalogue des rouleaux sur TOUT le stationnaire
#  ----------------------------------------------------------------------
#  Pour chaque pas de temps it du stationnaire :
#    1. coupe (z,x) moyennée-y  -> U,W,UPWP  (coupe_instant)
#    2. ψ(z,x)                  -> psi_poisson_periodic
#    3. détection des cellules  -> detect_rolls (signe ψ + inertie)
#    4. enrichissement de chaque rouleau avec :
#         - λ_x, λ_z  (extension physique via la boîte englobante pondérée)
#         - contribution T1 et T2 LOCALE (sur le support de la cellule)
#  Sortie : `catalogue` = liste de dicts (un par rouleau, tous t confondus),
#           + `cat_by_t` = {it: [rouleaux]} pour le tracking (bloc E).
#
#  "Bien si possible" -> on calcule T1/T2 par rouleau, mais proprement :
#    T1 local  = Σ_{(z,x)∈cell} ρ0(z) ū_org(z,x) w̄_org(z,x) · dV / V_tot
#  où ū_org/w̄_org sont les champs organisés par paliers (cf BLOC A).
#  C'est une ATTRIBUTION spatiale de T1 à chaque structure (pas une
#  re-dérivation : la somme sur toutes les cellules + l'environnement
#  redonne le T1 organisé total — on le vérifie).
# ======================================================================
IT_LIST = list(range(t_stat, n_t))          # tout le stationnaire
print(f"[catalogue] {len(IT_LIST)} pas de temps  (it {IT_LIST[0]}..{IT_LIST[-1]})")

dx = float(x[1] - x[0])
CATS = ('up', 'dn', 'env')

def organized_fields(it):
    """Champs 2D organisés u_org(z,x), w_org(z,x) à l'instant it,
       + profils ū(z), w̄(z) et ρ0(z). Mêmes conventions up/dn/env."""
    z_i, rho_i, U_i, W_i, _ = coupe_instant(it)
    nz_i, nx_i = U_i.shape
    u_org = np.zeros((nz_i, nx_i)); w_org = np.zeros((nz_i, nx_i))
    for j in range(nz_i):
        uy = U_i[j]; wy = W_i[j]
        ubar, wbar = uy.mean(), wy.mean()
        ws = max(W0_MIN, C_DECOMP * wy.std())
        masks = {'up': wy > ws, 'dn': wy < -ws, 'env': np.abs(wy) <= ws}
        for k in CATS:
            m = masks[k]
            if m.any():
                u_org[j, m] = uy[m].mean() - ubar
                w_org[j, m] = wy[m].mean() - wbar
    return z_i, rho_i, U_i, W_i, u_org, w_org

def enrich_roll(r, psi_i, u_org, w_org, rho_i, x, z_i, labels_signed):
    """Ajoute λ_x, λ_z et contribution T1 locale à un rouleau déjà géométré."""
    # support de la cellule = pixels du même label que le centre
    # (on retrouve le label via la position du centre)
    jc = int(np.argmin(np.abs(z_i/1000 - r['zc_km'])))
    ic = int(np.argmin(np.abs(x/1000  - r['xc_km'])))
    L  = labels_signed[jc, ic]
    ii, jj = np.where(labels_signed == L)
    if ii.size == 0:
        r['lam_x_km'] = np.nan; r['lam_z_km'] = np.nan
        r['T1_cell']  = 0.0;    r['T2_cell']  = 0.0
        return r
    # extension physique (boîte englobante)
    r['lam_x_km'] = (x[jj].max()  - x[jj].min())  / 1000 + dx/1000
    r['lam_z_km'] = (z_i[ii].max() - z_i[ii].min()) / 1000 + (z_i[1]-z_i[0])/1000
    # T1 local attribué à la cellule (densité ρ0 ū_org w̄_org, moyenne de domaine)
    dV = 1.0 / (psi_i.shape[0] * psi_i.shape[1])      # poids uniforme par pixel
    contrib = rho_i[ii] * u_org[ii, jj] * w_org[ii, jj]
    r['T1_cell'] = float(contrib.sum() * dV)
    return r

catalogue = []          # tous les rouleaux, tous t
cat_by_t  = {}          # it -> liste de rouleaux (pour tracking)
T1org_tot = []          # contrôle : T1 organisé total par t
T1cell_sum= []          # contrôle : somme des T1_cell par t

for it in IT_LIST:
    z_i, rho_i, U_i, W_i, u_org, w_org = organized_fields(it)
    psi_i = psi_poisson_periodic(U_i, W_i, x, z_i, rho_i)

    # détection + récupération des labels signés pour l'attribution
    psi_amp = np.percentile(np.abs(psi_i), 99) + 1e-30
    strong  = np.abs(psi_i) > 0.05 * psi_amp
    labels_signed = np.zeros_like(psi_i, dtype=np.int64)
    offset = 0
    for sgn in (+1, -1):
        mask = strong & (np.sign(psi_i) == sgn)
        lab, n = label_connected(mask)
        lab[lab > 0] += offset
        labels_signed += lab
        offset += n

    rolls = detect_rolls(psi_i, x, z_i, min_area_px=12, rel_amp=0.05)
    for r in rolls:
        r['it'] = it
        enrich_roll(r, psi_i, u_org, w_org, rho_i, x, z_i, labels_signed)
    cat_by_t[it] = rolls
    catalogue.extend(rolls)

    # contrôles d'attribution
    T1org_tot.append(float((rho_i[:,None]*u_org*w_org).mean()))
    T1cell_sum.append(sum(r['T1_cell'] for r in rolls))

print(f"[catalogue] {len(catalogue)} rouleaux extraits au total "
      f"({len(catalogue)/len(IT_LIST):.1f} par pas de temps en moyenne)")

T1org_tot = np.array(T1org_tot); T1cell_sum = np.array(T1cell_sum)
frac = np.nanmean(T1cell_sum / (T1org_tot + 1e-30))
print(f"[attribution] fraction de T1 organisé portée par les cellules détectées : "
      f"{frac*100:.0f}% (le reste = environnement diffus / cellules sous le seuil)")







# ======================================================================
#  BLOC D — Distributions des descripteurs + relations d'échelle
#  ----------------------------------------------------------------------
#  À partir de `catalogue` (tous t), on construit les lois statistiques
#  qui constituent la BRIQUE du modèle réduit :
#    • distributions : AR, θ, λ_x, λ_z, intensité, z du centre
#    • relations d'échelle (régressions) :  λ_x ~ f(z),  AR ~ f(intensité),
#      λ_z ~ f(λ_x)  -> dit si les rouleaux sont auto-similaires
#  Tout est pondéré par l'intensité de circulation (les gros rouleaux
#  comptent plus dans la paramétrisation).
# ======================================================================
import numpy as np

# --- extraction en arrays ---
def col(key): return np.array([r.get(key, np.nan) for r in catalogue], float)
AR   = col('AR');     ang  = col('angle');   circ = col('circ')
lamx = col('lam_x_km'); lamz = col('lam_z_km')
