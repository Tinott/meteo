seuil_dudz = 0.1*np.percentile(np.abs(dudz_zt[m28]), 90)
K_zt_masked = np.where(np.abs(dudz_zt) > seuil_dudz, K_zt, np.nan)

fig, ax = plt.subplots(figsize=(8,5))
