# ======================================================================
# §15 — Visualisation simplifiée : Reynolds vs reste
#
# On réécrit le bilan :
#   T1 = MG - T2 - T3 - T4 - T5
# soit :
#   -1/rho0 * d(rho0 <u'w'>)/dz  =  <dt u>  +  <u dx u>  +  <v dy u>  +  <w dz u>  +  <-1/rho0 dx p>
# ======================================================================

idx_tropo = np.searchsorted(alt, 15000)
sc = 1e5

for region, t1, mg, t2, t3, t4, t5, couleur in [
    ('HUMIDE', t1_h, mg_h, t2_h, t3_h, t4_h, t5_h, 'royalblue'),
    ('SECHE',  t1_s, mg_s, t2_s, t3_s, t4_s, t5_s, 'saddlebrown'),
]:
    # Membre droit = tout sauf Reynolds, passé de l'autre côté
    membre_droit = mg - t2 - t3 - t4 - t5

    fig, axes = plt.subplots(1, 2, figsize=(14, 8), sharey=True)

    for ax, sl, titre in zip(
        axes,
        [slice(None, idx_tropo), slice(None)],
        ['Troposphere (0-15 km)', 'Colonne complete']
    ):
        ax.plot(t1[sl]           * sc, alt[sl],
                color=couleur, lw=2.5,
                label='Reynolds direct T1')
        ax.plot(membre_droit[sl] * sc, alt[sl],
                color='black', lw=2, linestyle='--',
                label='dt_u - T2 - T3 - T4 - T5')
        ax.axvline(0, color='grey', alpha=0.4)
        ax.set_xlabel('Tendance (x1e-5 m/s2)')
        ax.set_title(titre, fontweight='bold')
        ax.legend(fontsize=9)
        ax.grid(True, alpha=0.3)

    axes[0].set_ylabel('Altitude (m)')
    plt.suptitle(
        'Region ' + region + ' — Reynolds direct vs residu\n'
        'Si coincident : bilan ferme',
        fontsize=13, fontweight='bold'
    )
    plt.tight_layout()
    plt.show()
