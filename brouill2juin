# ============================================================
#  Pente calibree sur 1-12km, PONDEREE EGALEMENT PAR NIVEAU
#  (evite que 2-8km, plus energetique, domine la regression globale)
# ============================================================
pentes_locales = []
for iz in range(n_z):
    if not m112[iz]: continue
    x, y = dudt_reel[iz,:], dudt_pred_s[iz,:]
    ok = np.isfinite(x) & np.isfinite(y)
    if ok.sum() < 10 or np.nanstd(x[ok]) < 1e-15: continue
    p = np.sum(x[ok]*y[ok])/np.sum(x[ok]**2)
    if np.isfinite(p): pentes_locales.append(p)

PENTE_112 = np.median(pentes_locales)   # mediane des pentes par niveau, pas une regression poolee
print(f"pente calibree (mediane des pentes par niveau, 1-12km) : {PENTE_112:.3f}")
print(f"nombre de niveaux utilises : {len(pentes_locales)}")

dudt_pred_recalibre_112 = dudt_pred_s / PENTE_112

R2_recal_112 = np.full(n_z, np.nan)
for iz in range(n_z):
    if not m112[iz]: continue
    a, b = dudt_reel[iz,:], dudt_pred_recalibre_112[iz,:]
    if np.nanstd(a) < 1e-15 or np.all(np.isnan(b)): continue
    ss_res = np.nansum((a-b)**2); ss_tot = np.nansum((a-a.mean())**2)
    R2_recal_112[iz] = 1-ss_res/ss_tot if ss_tot>0 else np.nan

fig, ax = plt.subplots(figsize=(5,7))
ax.plot(R2_recal_112[m112], zkm[m112], 'o-', ms=3)
ax.axvline(0,color='k',lw=.5)
ax.set_xlabel('R2'); ax.set_ylabel('z (km)')
ax.set_title(f'R2 recalibre (mediane des pentes, facteur={PENTE_112:.2f})')
plt.tight_layout(); plt.show()
