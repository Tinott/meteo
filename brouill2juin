# ============================================================
#  c_z PAR SPECTRE 2D (t,z) — methode independante de Hilbert
#  Une onde descendante ~ cos(k_z z - omega t) donne un pic dans
#  le plan (omega, k_z). La pente c_z = omega/k_z se lit au pic.
# ============================================================
from numpy.fft import fft2, fftfreq, fftshift

# champ dans la bande 2-8 km, detrende dans les deux directions
fld = ubar_zt[m28]                       # (n_z28, n_t)
fld = detrend(fld, axis=0)               # retire tendance en z
fld = detrend(fld, axis=1)               # retire tendance en t
fld = fld - fld.mean()
win = np.hanning(fld.shape[0])[:,None] * np.hanning(fld.shape[1])[None,:]
F   = fftshift(np.abs(fft2(fld*win))**2) # densite spectrale de puissance

dz  = np.mean(np.diff(alt[m28]))         # m
kz_ax = fftshift(fftfreq(fld.shape[0], d=dz))  * 2*np.pi   # rad/m
om_ax = fftshift(fftfreq(fld.shape[1], d=dt_phys)) * 2*np.pi # rad/s

# on masque le mode continu (k=0 ou omega=0) puis on cherche le pic
KZ, OM = np.meshgrid(kz_ax, om_ax, indexing='ij')
mask0  = (np.abs(KZ) > 1e-9) & (np.abs(OM) > 1e-9)
Fm     = np.where(mask0, F, 0)
i,j    = np.unravel_index(np.argmax(Fm), Fm.shape)
kz_pic, om_pic = KZ[i,j], OM[i,j]

cz_spec   = om_pic/kz_pic                 # m/s (signe = sens de descente)
T_spec    = 2*np.pi/abs(om_pic)/3600      # h
lam_spec  = 2*np.pi/abs(kz_pic)/1000      # km

print('=== c_z par SPECTRE 2D (t,z), bande 2-8 km ===')
print(f'  pic : omega={om_pic:+.2e} rad/s | k_z={kz_pic:+.2e} rad/m')
print(f'  c_z    = {cz_spec*100:+.2f} cm/s')
print(f'  periode= {T_spec:.0f} h ({T_spec/24:.1f} j)')
print(f'  lambda_z = {lam_spec:.1f} km')
print(f'  {"DESCENTE (c_z<0)" if cz_spec<0 else "montee (c_z>0)"}')
















# ============================================================
#  PENTE DES BANDES = c_z, mesuree directement dans (t,z)
#  On correle le champ decale de dt avec lui-meme : le lag vertical
#  qui maximise la correlation donne la migration dz par pas de temps.
# ============================================================
fld = dudz_zt[m28]                        # cisaillement, bande 2-8 km
fld = detrend(detrend(fld, axis=0), axis=1)
fld = (fld - fld.mean()) / (fld.std() + 1e-12)

nz, nt = fld.shape
dz = np.mean(np.diff(alt[m28]))
best = []
for dt_lag in range(1, 6):                # decalages temporels (en pas de 6h)
    a = fld[:, :nt-dt_lag]
    b = fld[:, dt_lag:]
    corr_by_shift = []
    shifts = range(-6, 7)                  # decalages verticaux testes (en niveaux)
    for s in shifts:
        bb = np.roll(b, s, axis=0)
        corr_by_shift.append(np.mean(a*bb))
    s_best = list(shifts)[int(np.argmax(corr_by_shift))]
    cz_lag = (s_best*dz) / (dt_lag*dt_phys)   # m/s
    best.append(cz_lag)
    print(f'  lag {dt_lag*dt_phys/3600:.0f}h : decalage vertical optimal = {s_best*dz:+.0f} m'
          f'  -> c_z = {cz_lag*100:+.2f} cm/s')

cz_slope = np.median(best)
print(f'\n=== c_z par pente des bandes (correlation decalee) ===')
print(f'  c_z median = {cz_slope*100:+.2f} cm/s'
      f'  ({"DESCENTE" if cz_slope<0 else "montee"})')
