    fig, axes = plt.subplots(1, 2, figsize=(14, 8), sharey=True)

    for ax, sl, titre in zip(
        axes,
        [slice(None, idx_tropo), slice(None)],
        ['Troposphere (0-15 km)', 'Colonne complete'],
    ):
        ax.plot(t1a[sl]          * sc, alt[sl],
                color=couleur, lw=2.5, linestyle='-',
                label='T1 w\'w\' intra-région (§16a)')
        ax.plot(t1b[sl]          * sc, alt[sl],
                color=couleur, lw=2,   linestyle='--',
                label='T1 w\'w\' global    (§16b)')
        ax.plot(membre_droit[sl] * sc, alt[sl],
                color='black', lw=1.5, linestyle=':',
                label='résidu = dtw - T2 - T3 - T4 - T5 + g')
        ax.axvline(0, color='grey', alpha=0.4)
        ax.set_xlabel('Tendance (x1e-5 m/s2)')
        ax.set_title(titre, fontweight='bold')
        ax.legend(fontsize=9)
        ax.grid(True, alpha=0.3)

    axes[0].set_ylabel('Altitude (m)')
    plt.suptitle(
        f'Region {region} — §16 : T1(w\'w\') intra vs global\n'
        'Si différents : circulation méso-échelle active sur w',
        fontsize=13, fontweight='bold'
    )
    plt.tight_layout()
    plt.show()
