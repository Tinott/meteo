# ============================================================================
# §26 — Sensibilité de l'identité Reynolds↔masse au seuil de détection updraft
# ----------------------------------------------------------------------------
# On balaye le couple (W0_MIN, C_SIGMA) -> seuil ws(z)=max(W0, C·σ_w(z)).
# Pour chaque seuil on recalcule Mc, (u_c-u_e), Phi_masse = Mc·(u_c-u_e)
# et on confronte au flux de Reynolds VÉRITÉ flux_glob_* (invariant, indép. du seuil).
# Métriques : corrélation, pente (Reynolds/masse) -> idéalement ~1, et amplitude.
# ============================================================================

# grille de seuils : (plancher W0 en m/s, multiplicateur c de σ_w)
seuils = [(0.0, 0.5), (0.0, 1.0), (0.0, 1.5), (0.0, 2.0),
          (0.5, 1.0), (1.0, 1.0), (0.25, 0.75)]

def diag_flux_masse(W0, C, region_mask):
    """Recalcule Mc, duc=u_c-u_e, sigma updraft pour un seuil donné, sur une région.
    Retourne (Mc, duc, Phi, sigma) profils (n_z,)."""
    Mc  = np.zeros(n_z); duc = np.zeros(n_z); sig = np.zeros(n_z)
    ds_u = xr.open_dataset(path3d('ua'))
    ds_w = xr.open_dataset(path3d('wa'))
    for iz in range(n_z):
        a_mc = a_uc = a_ue = a_sg = 0.0; n = 0
        for it in range(t_stat, n_t):
            u_r = ds_u['ua'].isel({dim_t: it, dim_z: iz}).values[region_mask]
            w_r = ds_w['wa'].isel({dim_t: it, dim_z: iz}).values[region_mask]
            ws  = max(W0, C * w_r.std())
            up  = w_r > ws
            a_mc += (w_r * up).mean()
            a_uc += u_r[up].mean()  if up.any()    else u_r.mean()
            a_ue += u_r[~up].mean() if (~up).any() else u_r.mean()
            a_sg += up.mean()
            n += 1
            del u_r, w_r, up
        Mc[iz]  = rho0[iz] * a_mc / n
        duc[iz] = (a_uc - a_ue) / n
        sig[iz] = a_sg / n
        gc.collect()
    ds_u.close(); ds_w.close(); del ds_u, ds_w; gc.collect()
    return Mc, duc, Mc * duc, sig

res_seuil = {}   # (W0,C) -> dict par région
for (W0, C) in seuils:
    print(f'seuil W0={W0}  C={C} ...', end=' ', flush=True)
    d = {}
    for tag, mask, fr in [('h', mh, flux_glob_h), ('s', ms, flux_glob_s)]:
        Mc, duc, Phi, sig = diag_flux_masse(W0, C, mask)
        a = fr[:idx_tropo]; b = Phi[:idx_tropo]
        ok = np.isfinite(a) & np.isfinite(b)
        r     = np.corrcoef(a[ok], b[ok])[0, 1]
        pente = (a[ok] @ b[ok]) / (b[ok] @ b[ok]) if (b[ok] @ b[ok]) != 0 else np.nan
        d[tag] = dict(Mc=Mc, duc=duc, Phi=Phi, sig=sig, r=r, pente=pente)
    res_seuil[(W0, C)] = d
    print(f"corr_h={d['h']['r']:+.3f} pente_h={d['h']['pente']:+.2f} | "
          f"corr_s={d['s']['r']:+.3f} pente_s={d['s']['pente']:+.2f}")

print('\n── Récap sensibilité au seuil (région HUMIDE) ──')
print(f"{'W0':>5} {'C':>5} | {'σ@2km(%)':>9} {'corr':>7} {'pente':>7} {'max|Φ|×sc':>10}")
iz2 = np.argmin(np.abs(alt - 2000))
for (W0, C), d in res_seuil.items():
    h = d['h']
    print(f"{W0:5.2f} {C:5.2f} | {h['sig'][iz2]*100:9.2f} {h['r']:+7.3f} "
          f"{h['pente']:+7.2f} {np.nanmax(np.abs(h['Phi'][:idx_tropo]))*sc:10.3f}")








