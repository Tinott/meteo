# --- recalcul cov_up / su_up / sw_up / amp (anomalies INTERNES aux updrafts) ---
nz = u.shape[0]                      # nb de niveaux (adapte si u est (nz,ny,nx))
cov_up = np.full(nz, np.nan)
su_up  = np.full(nz, np.nan)
sw_up  = np.full(nz, np.nan)

for k in range(nz):
    uk, wk = u[k].ravel(), w[k].ravel()
    sel = up[k].ravel()              # <-- ton masque updraft au niveau k
    if sel.sum() < 2:
        continue
    uu, ww = uk[sel], wk[sel]
    up_ = uu - uu.mean()             # anomalie u DANS les up
    wp_ = ww - ww.mean()             # anomalie w DANS les up
    cov_up[k] = (up_*wp_).mean()
    su_up[k]  = up_.std()
    sw_up[k]  = wp_.std()

amp = su_up * sw_up
ax[1].legend(fontsize=9); ax[1].grid(alpha=.3)
