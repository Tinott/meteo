# --- cisaillement / fermeture en longueur de mélange ---
        'dudz':        dudz,
        'd2udz2':      d2udz2,
        'd3udz3':      d3udz3,
        'dudz2':       dudz ** 2,                       # production de cisaillement S^2
        'absdudz_dudz': np.abs(dudz) * dudz,             # K ~ l^2 |S| S, fermeture signée
        'dudz_d2udz2': dudz * d2udz2,
        'd2udz2_2':    d2udz2 ** 2,

        # --- vent moyen ---
        'u':      ubar,
        'u2':     ubar ** 2,
        'u3':     ubar ** 3,
        'u_dudz': ubar * dudz,
        'u_d2udz2': ubar * d2udz2,
        'u2_dudz': ubar ** 2 * dudz,

        # --- vent vertical ---
        'w':        wbar,
        'w2':       wbar ** 2,
        'w_dudz':   wbar * dudz,
        'w_d2udz2': wbar * d2udz2,
        'dwdz':     dwdz,
        'w_u':      wbar * ubar,

        # --- densité / fermeture down-gradient classique (à confronter à Romps 2014) ---
        'rho0_dudz':   rho0_2d * dudz,       # -K*rho0*dudz : LE terme down-gradient
        'rho0_d2udz2': rho0_2d * d2udz2,
        'drho0dz_u':    drho0dz * ubar,
        'drho0dz_dudz': drho0dz * dudz,

        # --- structure verticale (cohérent avec le fit A*(z/zc)(1-z/zc)^n déjà validé) ---
        'z_dudz':    Z * dudz,
        'z2_dudz':   Z ** 2 * dudz,
        'z_d2udz2':  Z * d2udz2,
        'zHz_dudz':  Z * (H - Z) * dudz,     # forme "profil CMT" appliquée au cisaillement
        'zHz':       (Z / H) * (1 - Z / H),  # juste la forme géométrique, sans dérivée
    
