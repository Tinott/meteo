# Laplacien 2D complet, mêmes schémas que le solveur
d2x = (np.roll(psi, -1, 1) - 2*psi + np.roll(psi, 1, 1)) / dx**2   # périodique en x
d2z = (psi[2:] - 2*psi[1:-1] + psi[:-2]) / dz**2                    # centré en z, intérieur
lap = d2x[1:-1, :] + d2z                                            # aligne sur z intérieur

res = lap - omega[1:-1, :]
print("résidu relatif Poisson =", np.linalg.norm(res) / np.linalg.norm(omega[1:-1, :]))
