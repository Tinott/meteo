## 15. Fermeture du bilan de QdM par région (humide / sèche)

En RCE sur domaine périodique, l'équation de QdM zonale moyennée
sur une région R se réduit à :

$$-\frac{1}{\rho_0}\partial_z\!\left(\rho_0\langle\overline{u'w'}\rangle_R\right)
\approx
\langle\bar{v}\,\partial_y\bar{u}\rangle_R
+ \frac{1}{\rho_0}\langle\partial_x\bar{p}\rangle_R$$

Les termes négligés sont justifiés :
- $\partial_t\bar{u}_R \approx 0$ : état stationnaire
- $\bar{u}_R \approx 0$ : pas de vent moyen zonal en RCE → $\bar{u}\partial_x\bar{u} \approx 0$
- $\bar{w}_R\partial_z\bar{u}_R \approx 0$ : $\bar{w}$ et $\bar{u}$ tous deux faibles en moyenne

**Membre gauche** : flux de Reynolds recalculé avec anomalies intra-région.
**Membre droit** : $\langle\bar{v}\partial_y\bar{u}\rangle_R + \frac{1}{\rho_0}\langle\partial_x\bar{p}\rangle_R$
calculés depuis les champs 2D moyennés sur l'état stationnaire.


# ======================================================================
# §15 — Fermeture du bilan de QdM par région
#
# Membre gauche : -1/rho0 * d(rho0 <u'w'>_R)/dz
#   u'w' calculé avec anomalies intra-région
#
# Membre droit : <v̄ * ∂ū/∂y>_R  +  <-1/rho0 * ∂p̄/∂x>_R
#   v̄ et ū : moyennes temporelles des champs 2D sur l'état stationnaire
#   ∂ū/∂y  : gradient méridional du champ 2D moyen ū(y,x)
#   ∂p̄/∂x  : gradient zonal du champ 2D moyen p̄(y,x)
# ======================================================================

dt_sec = 6.0 * 3600.0

# ── Tableaux résultats ────────────────────────────────────────────────
flux_h2  = np.zeros(n_z)   # membre gauche : ρ₀⟨u′w′⟩_R
flux_s2  = np.zeros(n_z)

vdudy_h  = np.zeros(n_z)   # membre droit terme 1 : ⟨v̄∂ū/∂y⟩_R
vdudy_s  = np.zeros(n_z)
pres_h   = np.zeros(n_z)   # membre droit terme 2 : ⟨-1/ρ₀ ∂p̄/∂x⟩_R
pres_s   = np.zeros(n_z)

# Champs 2D moyens temporels (ny, nx) par niveau
ubar_2d  = np.zeros((n_z, n_y, n_x))   # ū moyen global (pour ∂ū/∂y)
vbar_2d  = np.zeros((n_z, n_y, n_x))   # v̄ moyen global (pour v̄∂ū/∂y)
pbar_2d  = np.zeros((n_z, n_y, n_x))   # p̄ moyen global (pour ∂p̄/∂x)

ds_u = xr.open_dataset(path3d('ua'))
ds_v = xr.open_dataset(path3d('va'))
ds_w = xr.open_dataset(path3d('wa'))
ds_p = xr.open_dataset(path3d('pa'))

for iz in range(n_z):

    acc_uw_h  = 0.0 ; acc_uw_s  = 0.0
    acc_u2d   = np.zeros((n_y, n_x))
    acc_v2d   = np.zeros((n_y, n_x))
    acc_p2d   = np.zeros((n_y, n_x))
    n = 0

    for it in range(t_stat, n_t):

        u_2d = ds_u['ua'].isel({dim_t: it, dim_z: iz}).values  # (ny, nx)
        w_2d = ds_w['wa'].isel({dim_t: it, dim_z: iz}).values
        v_2d = ds_v['va'].isel({dim_t: it, dim_z: iz}).values
        p_2d = ds_p['pa'].isel({dim_t: it, dim_z: iz}).values

        # ── Flux direct : anomalies intra-région ─────────────────────
        u_h   = u_2d[mh] ; u_s   = u_2d[ms]
        w_h   = w_2d[mh] ; w_s   = w_2d[ms]

        u_p_h = u_h - u_h.mean()
        u_p_s = u_s - u_s.mean()
        w_p_h = w_h - w_h.mean()
        w_p_s = w_s - w_s.mean()

        acc_uw_h += (u_p_h * w_p_h).mean()
        acc_uw_s += (u_p_s * w_p_s).mean()

        # ── Accumulation champs 2D pour moyennes temporelles ─────────
        acc_u2d += u_2d
        acc_v2d += v_2d
        acc_p2d += p_2d

        n += 1
        del u_2d, w_2d, v_2d, p_2d
        del u_h, u_s, w_h, w_s
        del u_p_h, u_p_s, w_p_h, w_p_s
        gc.collect()

    flux_h2[iz] = rho0[iz] * acc_uw_h / n
    flux_s2[iz] = rho0[iz] * acc_uw_s / n

    ubar_2d[iz] = acc_u2d / n
    vbar_2d[iz] = acc_v2d / n
    pbar_2d[iz] = acc_p2d / n

    if iz % 10 == 0:
        print(f'  iz={iz}/{n_z-1}  ({alt[iz]:.0f} m)')

ds_u.close() ; ds_v.close() ; ds_w.close() ; ds_p.close()
del ds_u, ds_v, ds_w, ds_p
gc.collect()

# ======================================================================
# Calcul du membre droit après la boucle
# (on a les champs 2D moyens complets)
# ======================================================================

for iz in range(n_z):

    u2d = ubar_2d[iz]   # ū moyen (ny, nx)
    v2d = vbar_2d[iz]   # v̄ moyen (ny, nx)
    p2d = pbar_2d[iz]   # p̄ moyen (ny, nx)

    # ∂ū/∂y sur la grille complète puis restriction à la région
    dudy = np.gradient(u2d, dy, axis=0)   # (ny, nx)

    # ∂p̄/∂x sur la grille complète puis restriction à la région
    dpdx = np.gradient(p2d, dx, axis=1)   # (ny, nx)

    # ⟨v̄ ∂ū/∂y⟩_R : produit puis moyenne sur les colonnes de la région
    vdudy_h[iz] = (v2d * dudy)[mh].mean()
    vdudy_s[iz] = (v2d * dudy)[ms].mean()

    # ⟨-1/ρ₀ ∂p̄/∂x⟩_R
    pres_h[iz]  = (-dpdx[mh] / rho0[iz]).mean()
    pres_s[iz]  = (-dpdx[ms] / rho0[iz]).mean()

# ── Membre gauche : tendance par divergence du flux de Reynolds ───────
tend_h_direct = tendance(flux_h2)
tend_s_direct = tendance(flux_s2)

# ── Membre droit : somme des deux termes ─────────────────────────────
membre_droit_h = vdudy_h + pres_h
membre_droit_s = vdudy_s + pres_s

print('§15 terminé.')


# ======================================================================
# §15 — Visualisation membre gauche vs membre droit
# ======================================================================

idx_tropo = np.searchsorted(alt, 15000)
sc = 1e5

for region, mg, md, vdy, pres, couleur in [
