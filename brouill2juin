# ======================================================================
# §17 — Visualisation 4 : divergence simulée vs prédite  (tendance sur ū)
# ======================================================================

t1_sim  = tendance(flux)       # −1/ρ₀ * d(ρ₀⟨u'w'⟩)/dz  simulé
t1_pred = tendance(flux_pred)  # −1/ρ₀ * d(−ρ₀ K dū/dz)/dz  prédit
sc_div  = 1e5                  # ×10⁻⁵ m/s²

fig, axes = plt.subplots(1, 2, figsize=(12, 8), sharey=True)

for ax, sl, titre in zip(
    axes,
    [slice(None, idx_tropo), slice(None)],
    ['Troposphere (0-15 km)', 'Colonne complète'],
):
    ax.plot(t1_sim[sl]  * sc_div, alt[sl], color='steelblue', lw=2.5,
            label='simulée')
    ax.plot(t1_pred[sl] * sc_div, alt[sl], color='crimson',   lw=2,   linestyle='--',
            label='prédite  (K down-gradient)')
    ax.axvline(0, color='grey', alpha=0.4)
    ax.set_xlabel('−1/ρ₀ ∂(ρ₀⟨u\'w\'⟩)/∂z  (×10⁻⁵ m/s²)')
    ax.set_title(titre, fontweight='bold')
    ax.legend(fontsize=9)
    ax.grid(True, alpha=0.3)

axes[0].set_ylabel('Altitude (m)')
plt.suptitle('§17 — Divergence du flux : tendance simulée vs prédite',
             fontsize=13, fontweight='bold')
plt.tight_layout()
plt.show()
