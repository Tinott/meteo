# 1. TRONCATURE DCT 2D SUR LE CHAMP PSI
# ============================================================================
def reconstruct_psi_dct(psi_field, frac):
    """Garde la fraction 'frac' des plus gros coefficients DCT de psi."""
    out_psi = np.empty_like(psi_field)
    for s in range(psi_field.shape[0]):
        C = dctn(psi_field[s], norm='ortho')
        flat = C.ravel()
        k = max(1, int(frac * flat.size))
        
        idx = np.argpartition(np.abs(flat), -k)[-k:]
        Cm = np.zeros_like(flat)
        Cm[idx] = flat[idx]
        
        out_psi[s] = idctn(Cm.reshape(C.shape), norm='ortho')
    return out_psi

# ============================================================================
# 2. DÉDUCTION DE U' ET W' PAR DÉRIVATION NUMÉRIQUE
# ============================================================================
def velocities_from_psi(psi_field, dx, dz):
    """Calcule u' = d(psi)/dz et w' = -d(psi)/dx par schémas de gradient central."""
    # np.gradient renvoie les dérivées selon les axes (axe 0 = z, axe 1 = x)
    u_rec = np.gradient(psi_field, dz, axis=1)  # d(psi)/dz
    w_rec = -np.gradient(psi_field, dx, axis=2) # -d(psi)/dx
    return u_rec, w_rec

