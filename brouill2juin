import numpy as np
import matplotlib.pyplot as plt
from scipy.signal import hilbert, detrend
from scipy.ndimage import uniform_filter1d
from matplotlib.colors import TwoSlopeNorm

# ============================================================
#   ANALYSE DE LA DESCENTE DE PHASE POUR LE VENT VERTICAL W
# ============================================================

# 1. Extraction des anomalies de w par rapport a sa moyenne temporelle
wprime = wbar_zt - wbar_zt.mean(axis=1, keepdims=True)

# Lissage pour nettoyer le bruit numerique sur l'axe du temps
wps = uniform_filter1d(wprime, size=3, axis=0, mode="nearest")

tt = np.arange(n_stat)
fig, axes = plt.subplots(1, 2, figsize=(13, 5))

# --- GRAPHIQUE 1 : Hovmoller de w' ---
ax = axes[0]
ax.grid(False)

# Definition des echelles de couleurs centrees sur zero
v = np.percentile(np.abs(wps[mask_show]), 98) + 1e-9
im = ax.pcolormesh(tt + t_stat, zkm[mask_show], wps[mask_show], cmap="RdBu_r",
                   norm=TwoSlopeNorm(0, -v, v), shading="auto")

ax.axhspan(2, 8, color="k", alpha=.06)
ax.set_ylim(0, Z_TOP_KM)
ax.set_xlabel("t")
ax.set_ylabel("z (km)")
ax.set_title("Hovmoller w prime (bandes descendantes)")
fig.colorbar(im, ax=ax, pad=.02, label="m/s")

# --- GRAPHIQUE 2 : Vitesse de phase verticale c_z ---
# Analyse de Fourier locale par transformee de Hilbert sur l'axe du temps (axis=1)
analytic = hilbert(detrend(wps, axis=1), axis=1)
phase = np.unwrap(np.angle(analytic), axis=1)

# Calcul des gradients de phase (temporel et vertical)
dphi_dt = np.gradient(phase, dt_phys, axis=1)
dphi_dz = np.gradient(phase, alt, axis=0)

# Calcul de la vitesse de phase c_z = - omega / k_z
with np.errstate(divide="ignore", invalid="ignore"):
    cz = - dphi_dt / dphi_dz

# Filtrage pour la zone cible entre 2 et 8 km d'altitude
cz28 = cz[m28]
cz28 = cz28[np.isfinite(cz28)]
cz_ok = cz28[np.abs(cz28) < 1.0] # Filtre les valeurs aberrantes fortes

# Calcul des statistiques (mediane, quartiles et fraction de points descendants)
q25, q50, q75 = np.percentile(cz_ok, [25, 50, 75]) if cz_ok.size else (np.nan,)*3
frac = np.mean(cz_ok < 0) if cz_ok.size else np.nan

ax = axes[1]
ax.hist(cz_ok * 100, bins=30, color="steelblue", alpha=.85)
ax.axvline(q50 * 100, color="r", lw=2, label=f"mediane={q50*100:+.2f} cm/s")
ax.axvline(0, color="k", lw=.8)
ax.set_xlabel("c_z (cm/s)")
ax.set_ylabel("nb (z,t) 2-8 km")
ax.set_title(f"{frac:.0%} des points DESCENDENT")
ax.legend(fontsize=9)

fig.tight_layout()
plt.show()

# --- DIAGNOSTICS TEXTUELS (Frequence, Periode, Longueur d'onde) ---
om = np.abs(dphi_dt[m28])
om = om[np.isfinite(om) & (om > 0)]

kz = np.abs(dphi_dz[m28])
kz = kz[np.isfinite(kz) & (kz > 0)]

T_h = 2 * np.pi / np.median(om) / 3600 if om.size else np.nan
lam = 2 * np.pi / np.median(kz) / 1000 if kz.size else np.nan

print(f"c_z (2-8 km) mediane={q50*100:+.2f} cm/s [IQR {q25*100:+.2f},{q75*100:+.2f}] | {frac:.0%} descendants")
print(f"periode ~ {T_h:.0f} h ({T_h/24:.1f} j) | lambda_z ~ {lam:.1f} km")
print("=> Analyse de la phase de w terminee.")
