# ============================================================
#  §9. Flux de Reynolds (2-8km) vs activite convective INSTANTANEE
#       (fraction humide au pas de temps t, pas le masque fixe mh/ms)
# ============================================================
ds_prw2 = xr.open_dataset(path2d('prw'))
prw_t = ds_prw2['prw'].isel({dim_t: idx_stat}).values.reshape(n_stat, -1)
ds_prw2.close()
frac_h_t = (prw_t > PRW_SEUIL).mean(axis=1)   # fraction de colonnes humides, par instant

flux_band = flux_prime[m28].mean(axis=0)      # anomalie de flux moyennee 2-8km, par instant

fig, ax1 = plt.subplots(figsize=(10,4))
ax1.plot(tt+t_stat, flux_band, 'b-', label=r"$\rho_0\langle u'w'\rangle'$ (2-8km)")
ax1.axhline(0, color='k', lw=.5); ax1.set_xlabel('t')
ax1.set_ylabel("flux anomalie (kg/m/s2)", color='b')
ax2 = ax1.twinx()
ax2.plot(tt+t_stat, frac_h_t, 'r-', alpha=.6)
ax2.set_ylabel('fraction humide instantanee', color='r')
plt.title("Flux de Reynolds (2-8km) vs activite convective instantanee")
fig.tight_layout(); plt.show()

corr = np.corrcoef(flux_band, frac_h_t - frac_h_t.mean())[0,1]
lags = np.arange(-15,16)
xcorr = [np.corrcoef(np.roll(flux_band,l), frac_h_t)[0,1] for l in lags]
lag_max = lags[int(np.argmax(np.abs(xcorr)))]
print(f"correlation lag 0 (flux anomalie / fraction humide) : r={corr:+.2f}")
print(f"correlation max = {xcorr[int(np.argmax(np.abs(xcorr)))]:+.2f} au decalage {lag_max} pas "
      f"({lag_max*dt_phys/3600:+.0f} h, flux en avance si <0)")
