            y_hat = a_arr[i_t, iz] * x1 + b_arr[i_t, iz] * x2

            y_list.extend(y.tolist())
            yhat_list.extend(y_hat.tolist())

    del u_all, u_lo, u_hi, w_lo, w_hi
    gc.collect()

