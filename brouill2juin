# ============================================================================
# BANC D'ESSAI : fermeture parcimonieuse de <u'w'>_up  (cible = cov_up)
#   Objectif : battre la baseline amplitude r0c*amp en validation croisee LOO.
#   Methodes : OLS dictionnaire, Lasso (chemin complet), best-subset k<=2.
#   Regle d'or : un score n'est credible qu'en LOO-CV (32 niveaux => sur-ajust facile).
# ============================================================================
from itertools import combinations
from sklearn.linear_model import LassoCV, LinearLayer if False else LinearRegression
from sklearn.preprocessing import StandardScaler

s = band()
y_full = cov_up.copy()

# --- dictionnaire de predicteurs PHYSIQUEMENT motives (2nd moment + structure) ---
feat = {
    'su'        : su_up,                 # amplitude u interne
    'sw'        : sw_up,                 # amplitude w interne
    'amp'       : amp,                   # su*sw  (la baseline)
    'skew_w'    : skew_w,                # asymetrie coeur/bord
    'varflx'    : varflx,                # <u'^2 w'> transport interne de variance
    'sig_up'    : sig_up,                # fraction surfacique
    'dudz'      : dudz,                  # cisaillement (signe oscillant -> piege)
    'amp_dudz'  : amp*dudz,              # down-gradient module par amplitude
    'sw2'       : sw_up**2,              # variance w (TKE-like)
}

# masque commun : niveaux de la bande, finis partout
names = list(feat.keys())
X_all = np.column_stack([feat[k] for k in names])
m = np.isfinite(y_full) & np.all(np.isfinite(X_all), axis=1)
m[:s.start] = False; m[s.stop:] = False
X = X_all[m]; y = y_full[m]
zlev = alt[m]
N = len(y)
print(f"N niveaux exploitables = {N}  (sur bande {alt[s.start]:.0f}-{alt[s.stop-1]:.0f} m)\n")

def nse_vec(truth, pred):
    return 1 - np.sum((truth-pred)**2)/np.sum((truth-truth.mean())**2)

# --- LOO-CV generique : renvoie le NSE hors-echantillon d'un estimateur sklearn ---
def loo_nse(make_model, Xm):
    pred = np.empty(N)
    for i in range(N):
        tr = np.arange(N) != i
        sc = StandardScaler().fit(Xm[tr])
        mdl = make_model().fit(sc.transform(Xm[tr]), y[tr])
        pred[i] = mdl.predict(sc.transform(Xm[i:i+1]))[0]
    return nse_vec(y, pred), pred

# =================== 0) BASELINE (r0 constant * amplitude) ===================
# meme construction que ton predA, mais evaluee proprement en LOO
def loo_nse_baseline():
    pred = np.empty(N)
    a_idx = names.index('amp')
    for i in range(N):
        tr = np.arange(N) != i
        r0 = np.median(y[tr]/(X[tr, a_idx] + 1e-12))     # r0 calibre hors point i
        pred[i] = r0 * X[i, a_idx]
    return nse_vec(y, pred), pred
nse_base, _ = loo_nse_baseline()
print(f"[BASELINE]  r0*amp                 LOO-NSE = {nse_base:+.3f}   <-- a battre\n")

# =================== 1) OLS sur le dictionnaire complet =====================
nse_ols, _ = loo_nse(lambda: LinearRegression(), X)
print(f"[OLS dict complet, {len(names)} feats] LOO-NSE = {nse_ols:+.3f}   "
      f"(in-sample sur-ajuste, attendu bas en CV)")

# =================== 2) Lasso (chemin complet, alpha auto-CV) ===============
# StandardScaler integre dans la boucle LOO pour ne pas fuiter la variance test
def make_lasso():
    return LassoCV(cv=5, n_alphas=60, max_iter=20000, random_state=0)
nse_lasso, _ = loo_nse(make_lasso, X)
# coefficients retenus sur tout l'echantillon (lecture des features survivants)
scl = StandardScaler().fit(X)
lasso_full = make_lasso().fit(scl.transform(X), y)
kept = [(n, c) for n, c in zip(names, lasso_full.coef_) if abs(c) > 1e-10]
kept.sort(key=lambda t: -abs(t[1]))
print(f"[LASSO]                            LOO-NSE = {nse_lasso:+.3f}")
print(f"   alpha* = {lasso_full.alpha_:.2e} | features retenus (coef standardise) :")
for n, c in kept: print(f"      {n:>10} : {c:+.3f}")
print()

# =================== 3) Best-subset interpretable (k = 1 et 2) ==============
# on cherche LE couple de predicteurs qui generalise le mieux (loi simple, GCM-ready)
print("[BEST-SUBSET]  meilleurs modeles a 1 et 2 termes (classes par LOO-NSE) :")
results = []
for k in (1, 2):
    for combo in combinations(range(len(names)), k):
        Xc = X[:, combo]
        sc, _ = loo_nse(lambda: LinearRegression(), Xc)
        results.append((sc, [names[j] for j in combo]))
results.sort(key=lambda t: -t[0])
for sc, combo in results[:8]:
    flag = "  <-- bat la baseline" if sc > nse_base else ""
    print(f"   NSE={sc:+.3f}  {{{', '.join(combo)}}}{flag}")
print()

# =================== 4) VERDICT ============================================
best_sc, best_combo = results[0]
gain = best_sc - nse_base
print("="*68)
if gain > 0.05:
    print(f"VERDICT : le modele {{{', '.join(best_combo)}}} bat la baseline")
    print(f"          de +{gain:.3f} NSE en validation croisee.")
    print(f"          -> piste de fermeture du 2nd moment a creuser.")
elif gain > 0:
    print(f"VERDICT : amelioration marginale (+{gain:.3f}) sur {{{', '.join(best_combo)}}}.")
    print(f"          Pas decisif vu N={N} : prudence, possible bruit d'echantillon.")
else:
    print(f"VERDICT : RIEN ne bat r0*amp en CV (meilleur = {best_sc:+.3f}).")
    print(f"          Resultat FORT : <u'w'>_up est bien un pur terme d'amplitude,")
    print(f"          la correlation interne r0 est structurellement ~constante.")
    print(f"          La fermeture amplitude est la bonne -- et c'est demontre, pas")
    print(f"          juste constate. C'est une conclusion publiable en soi.")
print("="*68)
