# ============================================================================
# S30 — Lien entre l'eq. de momentum du panache et le budget
#   Eq.1 (panache stationnaire) : dz(u_c) = eps * (u_e - u_c)
#   Eq.2 (budget)               : dz(Mc*Du) = Mc[(eps-delta)Du + dz Du],  Du=u_c-u_e
#   En injectant Eq.1 : dz(Mc*Du) = Mc[-delta*Du - dz(u_e)]
#   -> on TESTE Eq.1 (regression eps) puis la coherence de la reecriture.
#   (calculs pleine colonne ; affichage 2000-18000 m ; zone humide)
# ============================================================================

# --- profils issus du meilleur seuil (S26) ; uc/ue/ubar viennent de S21 ---
# Du = u_c - u_e (deja = duc_h), et les deux contrastes demandes :
duc_h_loc = uc_h - ue_h          # u_c - u_e
uec_h     = ue_h - uc_h          # u_e - u_c  = -duc_h_loc

dz_uc_h = np.gradient(uc_h, alt)  # membre de gauche de l'eq.1
dz_ue_h = np.gradient(ue_h, alt)

# --- 1) Test de l'eq.1 : regression dz(u_c) = eps * (u_e - u_c) ---
#     eps_local(z) = dz(u_c) / (u_e - u_c)   (masque ou |u_e-u_c| trop petit)
seuil_du = 0.05 * np.nanmax(np.abs(uec_h))
eps_loc_h = np.where(np.abs(uec_h) > seuil_du, dz_uc_h / uec_h, np.nan)

# eps global par moindres carres sur la fenetre 2-18 km : dz_uc = eps * uec
x = uec_h[disp]; y = dz_uc_h[disp]
ok = np.isfinite(x) & np.isfinite(y)
eps_glob_h = (x[ok] @ y[ok]) / (x[ok] @ x[ok]) if (x[ok] @ x[ok]) != 0 else np.nan
r_eq1 = np.corrcoef(x[ok], y[ok])[0, 1]
print('-- Eq.1  dz(u_c) = eps (u_e - u_c)  [humide, 2-18 km] --')
print('   eps_global = ' + format(eps_glob_h*1000, '+.4f') + ' km-1'
      + '   corr = ' + format(r_eq1, '+.3f'))
print('   eps_local median = ' + format(np.nanmedian(eps_loc_h[disp])*1000, '+.4f') + ' km-1')

# --- 2) (eps - delta) du flux de masse (S28) pour isoler delta ---
def eps_delta_si(M, seuil_rel=0.05):
    dMdz = np.gradient(M, alt)
    s = seuil_rel * np.nanmax(np.abs(M))
    return np.where(np.abs(M) > s, dMdz / M, np.nan)

emd_h = eps_delta_si(Mc_up_h)        # = eps - delta
delta_h = eps_glob_h - emd_h         # delta(z) = eps - (eps-delta), eps suppose ~ const

# --- 3) Coherence : reecriture du budget via eq.1 ---
#     div_direct = dz(Mc*Du)                      (verite numerique, S27)
#     div_eq1    = Mc * (-delta*Du - dz(u_e))     (si eq.1 tient)
div_direct_h = np.gradient(Mc_up_h * duc_h_loc, alt)
div_eq1_h    = Mc_up_h * (-delta_h * duc_h_loc - dz_ue_h)

aa = div_direct_h[disp]; bb = div_eq1_h[disp]
ok = np.isfinite(aa) & np.isfinite(bb)
rms_re = np.sqrt(np.nanmean((aa[ok] - bb[ok])**2))
corr_re = np.corrcoef(aa[ok], bb[ok])[0, 1]
print()
print('-- Reecriture budget via eq.1 :  dz(Mc Du) =? Mc[-delta Du - dz(u_e)] --')
print('   corr = ' + format(corr_re, '+.3f')
      + '   RMS ecart = ' + format(rms_re*sc, '.4e') + ' x1e-3')

# ----------------------------------------------------------------------------
# Figures
# ----------------------------------------------------------------------------
fig, axes = plt.subplots(1, 3, figsize=(16, 6), sharey=True)

# (a) test eq.1 : nuage dz(u_c) vs (u_e - u_c) + droite eps
ax = axes[0]
ax.scatter(uec_h[disp], dz_uc_h[disp]*1e3, s=22, color='royalblue', alpha=0.7)
xx = np.linspace(np.nanmin(uec_h[disp]), np.nanmax(uec_h[disp]), 50)
ax.plot(xx, eps_glob_h*xx*1e3, color='red', lw=2,
        label='pente eps=' + format(eps_glob_h*1000, '+.3f') + ' km-1')
ax.axhline(0, color='grey', alpha=0.4); ax.axvline(0, color='grey', alpha=0.4)
ax.set_xlabel('u_e - u_c  (m/s)'); ax.set_ylabel('dz(u_c)  (x1e-3 s-1)')
ax.set_title('Eq.1 : dz(u_c) vs (u_e-u_c)', fontweight='bold')
ax.legend(fontsize=9); ax.grid(alpha=0.3)

# (b) profils des deux contrastes
ax = axes[1]
ax.plot(duc_h_loc[disp], alt[disp], color='royalblue', lw=2.5, label='u_c - u_e')
ax.plot(uec_h[disp],     alt[disp], color='crimson',   lw=2.0, ls='--', label='u_e - u_c')
ax.axvline(0, color='grey', alpha=0.4)
ax.set_xlabel('m/s'); ax.set_title('Contrastes u_c-u_e / u_e-u_c', fontweight='bold')
ax.legend(fontsize=9); ax.grid(alpha=0.3); ax.set_ylim(2000, 18000)
ax.set_ylabel('Altitude (m)')

# (c) coherence des deux divergences
ax = axes[2]
ax.plot(div_direct_h[disp]*sc, alt[disp], color='black', lw=2.5, label='dz(Mc Du) direct')
ax.plot(div_eq1_h[disp]*sc,    alt[disp], color='orange', lw=2, ls='--',
        label='Mc[-delta Du - dz u_e]')
ax.axvline(0, color='grey', alpha=0.4)
ax.set_xlabel('dPhi/dz  (x1e-3)')
ax.set_title('Budget direct vs reecrit via eq.1', fontweight='bold')
ax.legend(fontsize=8); ax.grid(alpha=0.3); ax.set_ylim(2000, 18000)

plt.suptitle('S30 - Lien eq.1 panache (dz u_c = eps(u_e-u_c)) <-> budget  [humide, 2-18 km]',
             fontsize=12, fontweight='bold')
plt.tight_layout(); plt.show()
