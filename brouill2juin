# ===========================================================================
# alpha(z,t), beta(z,t) dans une BOÎTE spatiale (x,z) — système 2x2 (u,v)
#   Zone choisie : structure convective penchée la plus nette du champ
#       1250 < x < 1400 km , 4 < z < 12 km
#   (lignes de courant resserrées + <u'w'>_y de signe cohérent sur la colonne)
#   La "zone" = colonnes x de la fenêtre. Moyenne = <.>_{y, x∈fenêtre}.
#   À chaque (t, z) on résout :
#       y_u = alpha*x1u + beta*x2u ;  y_v = alpha*x1v + beta*x2v   (Cramer)
# ===========================================================================
X_LO, X_HI = 1250.0, 1400.0   # km
Z_LO, Z_HI = 4000.0, 12000.0  # m

# --- indices x de la fenêtre (borné au domaine) ---
ix_box = np.where((x/1000 >= X_LO) & (x/1000 <= X_HI))[0]
if ix_box.size == 0:
    raise ValueError(f"Fenêtre x={X_LO}-{X_HI} km hors domaine (0-{n_x*dx/1000:.0f} km). "
                     f"Vérifie dx={dx:.0f} m / la résolution.")
# --- indices z (besoin de iz-1, iz+1 pour d/dz -> on garde l'intérieur) ---
izs_box = np.where((alt >= Z_LO) & (alt <= Z_HI))[0]
izs_box = izs_box[(izs_box > 0) & (izs_box < n_z-1)]
z_box   = alt[izs_box]; nz_box = izs_box.size
print(f'Zone choisie : x={X_LO}-{X_HI} km ({ix_box.size} colonnes)  '
      f'z={Z_LO:.0f}-{Z_HI:.0f} m ({nz_box} niveaux)')

def alpha_beta_box(ix_box, izs_box):
    """alpha,beta (z,t) via le système 2x2 (u,v), moyennes sur y et x∈fenêtre."""
    A_zt = np.full((izs_box.size, n_stat), np.nan)
    B_zt = np.full((izs_box.size, n_stat), np.nan)

    ds_u = xr.open_dataset(path3d('ua'))
    ds_v = xr.open_dataset(path3d('va'))
    ds_w = xr.open_dataset(path3d('wa'))

    def meanphi(ds, var, it, izz):
        # <phi>_{y, x∈fenêtre} au niveau izz
        return ds[var].isel({dim_t: it, dim_z: izz}).values[:, ix_box].mean()

    def fluxlev(ds, var, it, izz):
        # rho0 * <phi' w'>_fenêtre  (anomalie sur les colonnes de la fenêtre)
        ph = ds[var].isel({dim_t: it, dim_z: izz}).values[:, ix_box]
        ww = ds_w['wa'].isel({dim_t: it, dim_z: izz}).values[:, ix_box]
        php = ph - ph.mean(); wwp = ww - ww.mean()
        return rho0[izz] * (php * wwp).mean()

    for ti, it in enumerate(range(t_stat, n_t)):
        for j, iz in enumerate(izs_box):
            dz = alt[iz+1] - alt[iz-1]
            u0  = meanphi(ds_u,'ua',it,iz  ); ulo = meanphi(ds_u,'ua',it,iz-1); uhi = meanphi(ds_u,'ua',it,iz+1)
            v0  = meanphi(ds_v,'va',it,iz  ); vlo = meanphi(ds_v,'va',it,iz-1); vhi = meanphi(ds_v,'va',it,iz+1)

            x1u = rho0[iz]*u0
            x2u = (rho0[iz+1]*uhi - rho0[iz-1]*ulo)/dz
            x1v = rho0[iz]*v0
            x2v = (rho0[iz+1]*vhi - rho0[iz-1]*vlo)/dz

            yu = -(fluxlev(ds_u,'ua',it,iz+1) - fluxlev(ds_u,'ua',it,iz-1))/dz/rho0[iz]
            yv = -(fluxlev(ds_v,'va',it,iz+1) - fluxlev(ds_v,'va',it,iz-1))/dz/rho0[iz]

            det = x1u*x2v - x1v*x2u
            if abs(det) > 1e-20:
                A_zt[j, ti] = (yu*x2v - yv*x2u)/det     # alpha
                B_zt[j, ti] = (x1u*yv - x1v*yu)/det     # beta
        gc.collect()

    ds_u.close(); ds_v.close(); ds_w.close()
    del ds_u, ds_v, ds_w; gc.collect()
    return A_zt, B_zt

A1, B1 = alpha_beta_box(ix_box, izs_box)
print(f'  alpha méd {np.nanmedian(A1):+.2e}  beta méd {np.nanmedian(B1):+.2e}  '
      f'| NaN {100*np.isnan(A1).mean():.0f}%')

# --- figure : un trait gris par instant + médiane temporelle + bande IQR ---
fig, ax = plt.subplots(1, 2, figsize=(11, 8), sharey=True)
for ti in range(A1.shape[1]):
    ax[0].plot(A1[:,ti], z_box, color='grey', alpha=.25, lw=.8)
    ax[1].plot(B1[:,ti], z_box, color='grey', alpha=.25, lw=.8)
Amed = np.nanmedian(A1,axis=1); Bmed = np.nanmedian(B1,axis=1)
Aq1,Aq3 = np.nanpercentile(A1,[25,75],axis=1); Bq1,Bq3 = np.nanpercentile(B1,[25,75],axis=1)
ax[0].plot(Amed, z_box, 'crimson', lw=2.5, label='médiane t'); ax[0].fill_betweenx(z_box, Aq1, Aq3, color='crimson', alpha=.2)
ax[1].plot(Bmed, z_box, 'navy',    lw=2.5, label='médiane t'); ax[1].fill_betweenx(z_box, Bq1, Bq3, color='navy', alpha=.2)
ax[0].set_title(r'$\alpha(z,t)$', fontweight='bold'); ax[1].set_title(r'$\beta(z,t)$', fontweight='bold')
ax[0].set_ylabel('Altitude (m)')
for a in ax: a.axvline(0, color='k', alpha=.4); a.grid(alpha=.3); a.legend(fontsize=8)
plt.suptitle(f'Structure penchée : x={X_LO:.0f}-{X_HI:.0f} km, z={Z_LO:.0f}-{Z_HI:.0f} m',
             fontsize=13, fontweight='bold')
plt.tight_layout(); plt.show()
