# ======================================================================
#  BLOC F — Modèle génératif ψ à partir des rouleaux-types + validation
#  ----------------------------------------------------------------------
#  Chaque rouleau réel est remplacé par un patch ψ analytique :
#      ψ_patch(x,z) = A · sin(π ξ) · sin(π ζ) · exp(-((ξ-.5)²+(ζ-.5)²)/2σ²)
#  où (ξ,ζ) sont les coords locales dans la boîte du rouleau (largeur λ_x,
#  hauteur λ_z, centre (xc,zc), inclinaison θ). A = signe·intensité calibrée.
#  On reconstruit ψ_model(z,x), on en déduit le flux de masse organisé
#  modèle, et on compare T1_model(z) à T1_vrai(z)  -> NSE.
#
#  -> Valide que les descripteurs géométriques SUFFISENT à expliquer T1.
# ======================================================================
IT_VAL = n_t - 1                            # instant de validation
z_V, rho_V, U_V, W_V, u_orgV, w_orgV = organized_fields(IT_VAL)
psi_V = psi_poisson_periodic(U_V, W_V, x, z_V, rho_V)
rolls_V = cat_by_t[IT_VAL]
nzV, nxV = psi_V.shape
dzV = float(z_V[1]-z_V[0])

def roll_patch(r, Xg, Zg):
    """Patch ψ analytique d'un rouleau (cellule sin×sin gaussienne, inclinée)."""
    xc = r['xc_km']*1000; zc = r['zc_km']*1000
    lx = max(r['lam_x_km'],1e-3)*1000; lz = max(r['lam_z_km'],1e-3)*1000
    th = np.radians(r['angle'])
    # coords centrées + rotation -θ pour aligner sur les axes du rouleau
    Xr =  (Xg-xc)*np.cos(th) + (Zg-zc)*np.sin(th)
    Zr = -(Xg-xc)*np.sin(th) + (Zg-zc)*np.cos(th)
    xi = Xr/lx + 0.5; ze = Zr/lz + 0.5
    inside = (xi>0)&(xi<1)&(ze>0)&(ze<1)
    patch = np.zeros_like(Xg)
    sig = 0.30
    patch[inside] = (np.sin(np.pi*xi[inside])*np.sin(np.pi*ze[inside])
                     * np.exp(-(((xi[inside]-.5)**2+(ze[inside]-.5)**2)/(2*sig**2))))
    # amplitude : signe du rouleau × intensité moyenne de ψ réel sur son support
    patch *= r['sign'] * (r['circ'] / (patch[inside].sum()+1e-30))
    return patch

# --- reconstruction ψ_model ---
Xg, Zg = np.meshgrid(x, z_V)
psi_model = np.zeros_like(psi_V)
for r in rolls_V:
    if np.isfinite(r['lam_x_km']) and np.isfinite(r['lam_z_km']):
        psi_model += roll_patch(r, Xg, Zg)

# --- calibration globale d'amplitude (moindres carrés ψ_model ~ ψ_vrai) ---
alpha = (np.sum(psi_model*psi_V) / (np.sum(psi_model**2)+1e-30))
psi_model *= alpha
print(f"[modèle ψ] calibration d'amplitude α = {alpha:.3f}")

# --- flux de masse organisé du modèle : ρ0 ū = -∂ψ/∂z  -> ū_model ---
rhoU_model = -np.gradient(psi_model, dzV, axis=0)
u_model = rhoU_model / rho_V[:,None]
# w organisé du modèle : ρ0 w = +∂ψ/∂x (x périodique)
dxm = float(x[1]-x[0])
rhoW_model = (np.roll(psi_model,-1,1)-np.roll(psi_model,1,1))/(2*dxm)
w_model = rhoW_model / rho_V[:,None]

# T1 par niveau : vrai (champs organisés) vs modèle
T1_true_p  = (rho_V[:,None]*u_orgV*w_orgV).mean(axis=1)
T1_model_p = (rho_V[:,None]*u_model*w_model).mean(axis=1)

# NSE (Nash-Sutcliffe) du profil T1
def nse(obs, mod):
    return 1 - np.sum((obs-mod)**2)/(np.sum((obs-obs.mean())**2)+1e-30)
score = nse(T1_true_p, T1_model_p)
print(f"[validation] NSE(T1_model vs T1_vrai) = {score:.3f}")

