#  dudt ~ dudz (total/humide/sec) + test dudt = k(z)*w_sec*dzus
#  tout lisse sur 8 pas de temps — SANS afficher k(z), juste R² et significativite
# ============================================================
from scipy import stats

WIN_T = 8
def smooth_t(fld):
    return uniform_filter1d(fld, size=WIN_T, axis=1, mode='nearest')

uh_s = smooth_t(u_h_zt); us_s = smooth_t(u_s_zt)
uprime_s = smooth_t(ubar_zt - ubar_zt.mean(axis=1, keepdims=True))
w_s_smooth = smooth_t(w_s_zt)

dtuc = np.gradient(uh_s, dt_phys, axis=1); dzuc = np.gradient(uh_s, alt, axis=0)
dtus = np.gradient(us_s, dt_phys, axis=1); dzus = np.gradient(us_s, alt, axis=0)
dudt_tot = np.gradient(uprime_s, dt_phys, axis=1); dudz_tot = np.gradient(uprime_s, alt, axis=0)

# ---- 1) dudt vs dudz : total / humide / sec ----
fig, axes = plt.subplots(1,3,figsize=(15,5))
for ax,(x,y,lab) in zip(axes, [(dudz_tot, dudt_tot, "total"),
                                 (dzuc, dtuc, "humide"),
                                 (dzus, dtus, "sec")]):
    xb, yb = x[m28].ravel(), y[m28].ravel()
    ok = np.isfinite(xb)&np.isfinite(yb)
    slope = np.sum(xb[ok]*yb[ok])/np.sum(xb[ok]**2)
    r = np.corrcoef(xb[ok], yb[ok])[0,1]
    ax.scatter(xb[ok], yb[ok], s=3, alpha=.15)
    xx = np.linspace(xb[ok].min(), xb[ok].max(), 10)
    ax.plot(xx, slope*xx, 'r-', lw=1.5)
    ax.set_xlabel(r'$\partial_z u$ (s$^{-1}$)'); ax.set_ylabel(r'$\partial_t u$ (m/s$^2$)')
    ax.set_title(f"{lab} : r={r:+.2f} | pente=-c_z={slope*100:+.2f} cm/s")
plt.suptitle("dudt vs dudz (2-8km, lisse 8 pas)", fontweight='bold')
plt.tight_layout(); plt.show()

# ---- 2) test advectif : dudt =? k(z) * w_sec * dzus, par niveau ----
produit_adv = w_s_smooth * dzus

def n_eff_safe(x, y):
    if np.nanstd(x) < 1e-15 or np.nanstd(y) < 1e-15: return np.nan
    ac_x = np.corrcoef(x[:-1], x[1:])[0,1]; ac_y = np.corrcoef(y[:-1], y[1:])[0,1]
    if not (np.isfinite(ac_x) and np.isfinite(ac_y)): return np.nan
    denom = 1 + ac_x*ac_y
    if denom <= 0: return np.nan
    n = len(x); neff = n*(1-ac_x*ac_y)/denom
    return neff if neff > 2 else np.nan

r2_adv = np.full(n_z, np.nan); p_z = np.full(n_z, np.nan)
dudt_reconstruit = np.full((n_z, n_stat), np.nan)
statut = ['']*n_z
for iz in range(n_z):
    x, y = produit_adv[iz,:], dudt_tot[iz,:]
    if np.nanstd(x) < 1e-15: statut[iz]='x quasi constant'; continue
    k = np.sum(x*y)/np.sum(x*x)                # coefficient interne, utilise seulement pour reconstruire
    y_pred = k*x; dudt_reconstruit[iz,:] = y_pred
    ss_res = np.sum((y-y_pred)**2); ss_tot = np.sum((y-y.mean())**2)
    r2_adv[iz] = 1-ss_res/ss_tot if ss_tot>0 else np.nan
    r_iz = np.corrcoef(x,y)[0,1]
    if not np.isfinite(r_iz): statut[iz]='r indefini'; continue
    neff = n_eff_safe(x,y)
    if not np.isfinite(neff): statut[iz]='n_eff indefini/negatif'; continue
    t_val = r_iz*np.sqrt((neff-2)/(1-r_iz**2))
    p_z[iz] = 2*(1-stats.t.cdf(abs(t_val), neff-2))
    statut[iz]='ok'

for iz in range(n_z):
    if mask_show[iz] and statut[iz]!='ok':
        print(f"z={zkm[iz]:.2f}km : non calculable ({statut[iz]})")

fig, axes = plt.subplots(1,2,figsize=(9,5), sharey=True)
axes[0].plot(r2_adv[mask_show], zkm[mask_show], 'o-', ms=3); axes[0].axvline(0,color='k',lw=.5)
axes[0].set_xlabel('R²(z)')
axes[1].plot(p_z[mask_show], zkm[mask_show], 'o-', ms=3); axes[1].axvline(0.05,color='r',lw=1,ls='--')
axes[1].set_xlabel('p-value'); axes[1].set_xlim(0,1)
axes[0].set_ylabel('z (km)'); axes[0].set_ylim(0,Z_TOP_KM)
plt.suptitle("Test $\\partial_t u \\sim w_{sec}\\,\\partial_z u_{sec}$ : R² et significativite", fontweight='bold')
plt.tight_layout(); plt.show()

