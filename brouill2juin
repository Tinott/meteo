        ax.axvline(0, color='grey', alpha=0.4)
        ax.set_xlabel('Tendance (×10⁻⁵ m/s²)')
        ax.set_title(titre, fontweight='bold')
        ax.legend(fontsize=9)
        ax.grid(True, alpha=0.3)

    axes[0].set_ylabel('Altitude (m)')
    plt.suptitle(
        f'Région {region} — fermeture du bilan de QdM\n'
        r"$-\frac{1}{\rho_0}\partial_z(\rho_0\langle\overline{u'w'}\rangle_R)"
        r"\approx \langle\bar{v}\partial_y\bar{u}\rangle_R"
        r"+ \frac{1}{\rho_0}\langle\partial_x\bar{p}\rangle_R$",
        fontsize=13, fontweight='bold'
    )
