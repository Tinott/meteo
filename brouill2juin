# ── Moyennes temporelles des régresseurs et de y ──────────────────────
# x1 = rho0 * (u_col - ubar_glob),  x2 = dz(rho0 * u'_C) colonne par colonne
# on recharge juste pour calculer les moyennes temporelles de x1, x2, y par région

x1_mean_h = np.zeros(n_z_fit)
x1_mean_s = np.zeros(n_z_fit)
x2_mean_h = np.zeros(n_z_fit)
x2_mean_s = np.zeros(n_z_fit)
y_mean_h  = np.zeros(n_z_fit)
y_mean_s  = np.zeros(n_z_fit)

ds_u = xr.open_dataset(path3d('ua'))
ds_w = xr.open_dataset(path3d('wa'))

for i_iz, iz in enumerate(range(iz_lo_glob, iz_hi_glob)):

    iz_lo = iz - 1
    iz_hi = iz + 1
    dz    = alt[iz_hi] - alt[iz_lo]

    u_all = ds_u['ua'].isel({dim_z: iz,    dim_t: slice(t_stat, n_t)}).values
    u_lo  = ds_u['ua'].isel({dim_z: iz_lo, dim_t: slice(t_stat, n_t)}).values
    u_hi  = ds_u['ua'].isel({dim_z: iz_hi, dim_t: slice(t_stat, n_t)}).values
    w_lo  = ds_w['wa'].isel({dim_z: iz_lo, dim_t: slice(t_stat, n_t)}).values
    w_hi  = ds_w['wa'].isel({dim_z: iz_hi, dim_t: slice(t_stat, n_t)}).values

    acc = {'x1_h':0., 'x1_s':0., 'x2_h':0., 'x2_s':0., 'y_h':0., 'y_s':0.}

    for i_t in range(n_stat_it):

        u_p_lo = u_lo[i_t] - u_lo[i_t].mean()
        w_p_lo = w_lo[i_t] - w_lo[i_t].mean()
        u_p_hi = u_hi[i_t] - u_hi[i_t].mean()
        w_p_hi = w_hi[i_t] - w_hi[i_t].mean()

        flux_lo = rho0[iz_lo] * u_p_lo * w_p_lo
        flux_hi = rho0[iz_hi] * u_p_hi * w_p_hi
        y_2d    = -(flux_hi - flux_lo) / (dz * rho0[iz])

        x1_2d = rho0[iz] * (u_all[i_t] - ubar_glob[i_iz])
        x2_2d = (rho0[iz_hi] * (u_hi[i_t] - ubar_glob[min(i_iz+1, n_z_fit-1)])
               - rho0[iz_lo] * (u_lo[i_t] - ubar_glob[max(i_iz-1, 0)])) / dz

        for mask, tag in [(mh, 'h'), (ms, 's')]:
            acc[f'x1_{tag}'] += x1_2d[mask].mean()
            acc[f'x2_{tag}'] += x2_2d[mask].mean()
            acc[f'y_{tag}']  += y_2d[mask].mean()

    x1_mean_h[i_iz] = acc['x1_h'] / n_stat_it
    x1_mean_s[i_iz] = acc['x1_s'] / n_stat_it
    x2_mean_h[i_iz] = acc['x2_h'] / n_stat_it
    x2_mean_s[i_iz] = acc['x2_s'] / n_stat_it
    y_mean_h[i_iz]  = acc['y_h']  / n_stat_it
    y_mean_s[i_iz]  = acc['y_s']  / n_stat_it

    del u_all, u_lo, u_hi, w_lo, w_hi
    gc.collect()

    if i_iz % 10 == 0:
        print(f'  i_iz={i_iz}/{n_z_fit-1}  ({alt[iz]:.0f} m)')

ds_u.close() ; ds_w.close()
del ds_u, ds_w
gc.collect()

# ── Reconstruction avec les courbes noires ────────────────────────────
alpha_mean_h = alpha_h.mean(axis=0)   # (n_z_fit,)
beta_mean_h  = beta_h.mean(axis=0)
alpha_mean_s = alpha_s.mean(axis=0)
beta_mean_s  = beta_s.mean(axis=0)

recon_h = alpha_mean_h * x1_mean_h + beta_mean_h * x2_mean_h
recon_s = alpha_mean_s * x1_mean_s + beta_mean_s * x2_mean_s

# ── Visualisation ─────────────────────────────────────────────────────
fig, axes = plt.subplots(1, 2, figsize=(14, 8), sharey=True)

for ax, y, recon, label, couleur in [
    (axes[0], y_mean_h, recon_h, 'HUMIDE', 'royalblue'),
    (axes[1], y_mean_s, recon_s, 'SÈCHE',  'saddlebrown'),
]:
    ax.plot(y     * 1e5, z_fit_ab, color=couleur, lw=2.5, label=r'$\bar{y}$ direct')
    ax.plot(recon * 1e5, z_fit_ab, color='black',  lw=2, linestyle='--',
            label=r'$\bar{\alpha}\,\overline{x_1} + \bar{\beta}\,\overline{x_2}$')
    ax.axvline(0, color='grey', alpha=0.4)
    ax.set_xlabel('Tendance (×10⁻⁵ m/s²)')
    ax.set_title(f'Région {label}', fontweight='bold')
    ax.legend(fontsize=9)
    ax.grid(True, alpha=0.3)

axes[0].set_ylabel('Altitude (m)')
plt.suptitle(r'Vérification : $\bar{\alpha}(z)\,\overline{x_1}(z) + \bar{\beta}(z)\,\overline{x_2}(z)$ vs $\bar{y}(z)$',
             fontsize=13, fontweight='bold')
plt.tight_layout()
plt.show()
