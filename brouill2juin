# ============================================================
#  ETAPE 8 — regression par niveau (coefficient interne, jamais affiche seul) + R²(z)
# ============================================================
r2_adv = np.full(n_z, np.nan)
dudt_reconstruit = np.full((n_z, n_stat), np.nan)
for iz in range(n_z):
    x, y = produit_adv[iz,:], dudt_tot[iz,:]
    if np.nanstd(x) < 1e-15: continue
    coef = np.sum(x*y)/np.sum(x*x)
    y_pred = coef*x
    dudt_reconstruit[iz,:] = y_pred
    ss_res = np.sum((y-y_pred)**2); ss_tot = np.sum((y-y.mean())**2)
    r2_adv[iz] = 1-ss_res/ss_tot if ss_tot>0 else np.nan

fig, ax = plt.subplots(figsize=(5,6))
ax.plot(r2_adv[mask_show], zkm[mask_show], 'o-', ms=3); ax.axvline(0,color='k',lw=.5)
ax.set_xlabel('R²(z)'); ax.set_ylabel('z (km)'); ax.set_ylim(0,Z_TOP_KM)
ax.set_title(r"Qualite de l'ajustement $\partial_t u \sim w_{sec}\,\partial_z u_{sec}$")
plt.tight_layout(); plt.show()





