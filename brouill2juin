# ============================================================
#  Prediction recalibree par le facteur d'echelle global, puis nouveau R2
# ============================================================
FACTEUR = 1.69
dudt_pred_recalibre = dudt_pred_s / FACTEUR

R2_recalibre = np.full(n_z, np.nan)
for iz in range(n_z):
    if not m212[iz]: continue
    a, b = dudt_reel[iz,:], dudt_pred_recalibre[iz,:]
    if np.nanstd(a) < 1e-15 or np.all(np.isnan(b)): continue
    ss_res = np.nansum((a-b)**2); ss_tot = np.nansum((a-a.mean())**2)
    R2_recalibre[iz] = 1-ss_res/ss_tot if ss_tot>0 else np.nan

fig, ax = plt.subplots(figsize=(5,7))
ax.plot(R2_final[m212], zkm[m212], 'o-', ms=3, label='sans recalibration')
ax.plot(R2_recalibre[m212], zkm[m212], 'o-', ms=3, label='recalibre (/1.69)')
ax.axvline(0,color='k',lw=.5); ax.legend(fontsize=9)
ax.set_xlabel('R2'); ax.set_ylabel('z (km)')
ax.set_title('Effet de la recalibration d\'echelle')
plt.tight_layout(); plt.show()

print(f"R2 median (2-8km) apres recalibration : {np.nanmedian(R2_recalibre[m28]):.2f}")
