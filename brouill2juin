# Fonction pour obtenir des bornes symétriques basées sur la robustesse des données
def get_sym_norm(data, percentile=98):
    limit = np.percentile(np.abs(data), percentile)
    # Évite une division par zéro si les données sont nulles
    limit = max(limit, 1e-15) 
    return TwoSlopeNorm(vmin=-limit, vcenter=0.0, vmax=limit)

