# ============================================================
#  Regression par niveau : flux_zt(z,t) = alpha(z)*ubar_zt + beta(z)*dudz_zt + gamma(z)*d2udz2_zt
# ============================================================

# ---- 1) les trois termes explicatifs, vus en (z,t) ----
fig, axes = plt.subplots(1, 3, figsize=(16,5), sharey=True)
for ax,(fld,lab) in zip(axes, [(ubar_zt, r"$\bar u$ (m/s)"),
                                 (dudz_zt, r"$\partial_z\bar u$ (s$^{-1}$)"),
                                 (d2udz2_zt, r"$\partial_z^2\bar u$ (m$^{-1}$s$^{-1}$)")]):
    v = np.percentile(np.abs(fld[mask_show]), 98) + 1e-12
    im = ax.pcolormesh(tt+t_stat, zkm[mask_show], fld[mask_show], cmap='RdBu_r',
                        norm=TwoSlopeNorm(0,-v,v), shading='auto')
    ax.axhspan(2,8,color='k',alpha=.06); ax.set_xlabel('t'); ax.set_title(lab,fontsize=10)
    fig.colorbar(im, ax=ax, orientation='horizontal', pad=.12, aspect=25)
axes[0].set_ylabel('z (km)'); axes[0].set_ylim(0,Z_TOP_KM)
plt.suptitle("Termes explicatifs (z,t)", fontweight='bold')
plt.tight_layout(); plt.show()

# ---- 2) les memes termes, profils moyens vs z ----
fig, axes = plt.subplots(1,3,figsize=(12,5), sharey=True)
for ax,(fld,lab) in zip(axes, [(ubar, r"$\langle\bar u\rangle_t$ (m/s)"),
                                 (dudz, r"$\langle\partial_z\bar u\rangle_t$ (s$^{-1}$)"),
                                 (np.gradient(dudz,alt), r"$\langle\partial_z^2\bar u\rangle_t$ (m$^{-1}$s$^{-1}$)")]):
    ax.plot(fld[mask_show], zkm[mask_show]); ax.axvline(0,color='k',lw=.5)
    ax.set_xlabel(lab); ax.axhspan(2,8,color='k',alpha=.06)
axes[0].set_ylabel('z (km)'); axes[0].set_ylim(0,Z_TOP_KM)
plt.suptitle("Termes explicatifs — profils moyennes en temps", fontweight='bold')
plt.tight_layout(); plt.show()

# ---- 3) regression par niveau, sans intercept ----
alpha_z = np.full(n_z, np.nan); beta_z = np.full(n_z, np.nan); gamma_z = np.full(n_z, np.nan)
r2_z = np.full(n_z, np.nan)
flux_reconstruit = np.full((n_z, n_stat), np.nan)

for iz in range(n_z):
    X = np.column_stack([ubar_zt[iz,:], dudz_zt[iz,:], d2udz2_zt[iz,:]])
    y = flux_zt[iz,:]
    if not np.all(np.isfinite(X)) or not np.all(np.isfinite(y)):
        continue
    coefs, *_ = np.linalg.lstsq(X, y, rcond=None)
    alpha_z[iz], beta_z[iz], gamma_z[iz] = coefs
    y_pred = X @ coefs
    flux_reconstruit[iz,:] = y_pred
    ss_res = np.sum((y-y_pred)**2); ss_tot = np.sum((y-y.mean())**2)
    r2_z[iz] = 1 - ss_res/ss_tot if ss_tot > 0 else np.nan

fig, axes = plt.subplots(1,4,figsize=(16,5), sharey=True)
for ax,(fld,lab) in zip(axes, [(alpha_z, r"$\alpha(z)$"), (beta_z, r"$\beta(z)$"),
                                 (gamma_z, r"$\gamma(z)$"), (r2_z, r"$R^2(z)$")]):
    ax.plot(fld[mask_show], zkm[mask_show]); ax.axvline(0,color='k',lw=.5)
    ax.set_xlabel(lab); ax.axhspan(2,8,color='k',alpha=.06)
axes[0].set_ylabel('z (km)'); axes[0].set_ylim(0,Z_TOP_KM)
plt.suptitle("Coefficients de la regression par niveau", fontweight='bold')
plt.tight_layout(); plt.show()

# ---- 4) flux reconstruit vs flux reel ----
diff_zt = flux_zt - flux_reconstruit

fig, axes = plt.subplots(1, 3, figsize=(16,5), sharey=True)
v = np.nanpercentile(np.abs(flux_zt[mask_show]), 98)
for ax,(fld,lab) in zip(axes, [(flux_zt, "flux original"),
                                 (flux_reconstruit, "flux reconstruit (regression)"),
                                 (diff_zt, "difference")]):
    im = ax.pcolormesh(tt+t_stat, zkm[mask_show], fld[mask_show], cmap='RdBu_r',
                        norm=TwoSlopeNorm(0,-v,v), shading='auto')
    ax.axhspan(2,8,color='k',alpha=.06); ax.set_xlabel('t'); ax.set_title(lab,fontsize=10)
axes[0].set_ylabel('z (km)'); axes[0].set_ylim(0,Z_TOP_KM)
fig.colorbar(im, ax=axes, orientation='horizontal', pad=.1, aspect=35, shrink=.6,
             label=r"kg m$^{-1}$ s$^{-2}$")
plt.suptitle("Flux reconstruit par regression a 3 termes vs flux reel", fontweight='bold')
plt.show()

err_rel = np.sqrt(np.nanmean(diff_zt[m28]**2)) / np.sqrt(np.nanmean(flux_zt[m28]**2))
print(f"R2 median (2-8km) : {np.nanmedian(r2_z[m28.any(axis=1) if m28.ndim>1 else m28]):.2f}"
      if False else f"R2 median (2-8km) : {np.nanmedian(r2_z[m28]):.2f}")
print(f"RMSE point par point (2-8km) : {np.sqrt(np.nanmean(diff_zt[m28]**2)):.4f} kg/m/s2 "
      f"| erreur relative = {err_rel:.0%}")
