# ===========================================================================
# BASE DE DÉCOMPOSITION SIMPLE : Φ_rey ≈ a·ρ0σw² + b·Mc + c·ρ0σuσw
#   3 termes seulement, tous physiquement interprétables, dérivés de vos
#   résultats STLSQ précédents (dominants de T1 et T2).
# ===========================================================================

s = band(); zf = alt[s]

# --- 1. Construction de la base (3 fonctions seulement) ---
Base = {
    'rho0*sig_w^2'     : rho0*sig_w**2,
    'Mc'               : Mc,
    'rho0*sig_u*sig_w' : rho0*sig_u*sig_w,
}
names_b = list(Base.keys())
Phi_b = np.column_stack([Base[k][s] for k in names_b])
yv_b  = yflux[s]

# --- 2. Fit par moindres carrés SANS seuillage (3 termes = déjà minimal) ---
#     Validation train/test pair/impair, comme le reste du pipeline
idx = np.arange(len(yv_b))
tr, te = idx[idx % 2 == 0], idx[idx % 2 == 1]

coefs = np.linalg.lstsq(Phi_b[tr], yv_b[tr], rcond=None)[0]
yhat_tr = Phi_b[tr] @ coefs
yhat_te = Phi_b[te] @ coefs
R2tr = r2(yv_b[tr], yhat_tr)
R2te = r2(yv_b[te], yhat_te)

print('=== Base simple à 3 termes : a·ρ0σw² + b·Mc + c·ρ0σuσw ===')
print(f'  R² train {R2tr:+.3f}   R² TEST {R2te:+.3f}')
print('  coefficients (unités physiques directes) :')
for k, c in zip(names_b, coefs):
    print(f'    {k:20s}  {c:+.4e}')

yhat_full = Phi_b @ coefs

# --- 3. Décomposition terme par terme (contribution de chaque brique) ---
contrib_A = coefs[0]*Base['rho0*sig_w^2'][s]
contrib_B = coefs[1]*Base['Mc'][s]
contrib_C = coefs[2]*Base['rho0*sig_u*sig_w'][s]

# --- 4. Figure : flux vrai vs reconstruit, + décomposition des 3 contributions ---
fig, ax = plt.subplots(1, 2, figsize=(13, 7), sharey=True)

ax[0].plot(yv_b*1e3, zf, 'k', lw=2.5, label='flux vrai')
ax[0].plot(yhat_full*1e3, zf, 'r--', lw=2, label=f'base 3 termes (test R²={R2te:+.2f})')
ax[0].axvline(0, color='grey', alpha=.4)
ax[0].set_xlabel('flux (×10⁻³)'); ax[0].set_ylabel('z (m)')
ax[0].set_title('Reconstruction totale', fontweight='bold')
ax[0].legend(fontsize=9); ax[0].grid(alpha=.3)

ax[1].plot(contrib_A*1e3, zf, lw=2, label=r'$a\cdot\rho_0\sigma_w^2$')
ax[1].plot(contrib_B*1e3, zf, lw=2, label=r'$b\cdot M_c$')
ax[1].plot(contrib_C*1e3, zf, lw=2, label=r'$c\cdot\rho_0\sigma_u\sigma_w$')
ax[1].plot(yv_b*1e3, zf, 'k--', lw=1.5, alpha=.6, label='flux vrai')
ax[1].axvline(0, color='grey', alpha=.4)
ax[1].set_xlabel('contribution (×10⁻³)')
ax[1].set_title('Décomposition par terme', fontweight='bold')
ax[1].legend(fontsize=9); ax[1].grid(alpha=.3)

plt.suptitle('Base de décomposition simple du flux de Reynolds (3 termes)',
             fontsize=13, fontweight='bold')
plt.tight_layout(); plt.show()
