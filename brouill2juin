# ============================================================
#  c_z PAR PENTE DES BANDES — SIGNE PHYSIQUE EXPLICITE
#  Convention : c_z<0 = DESCENTE. On decale le champ vers le HAUT
#  de s niveaux (roll +s en z) et vers l'AVANT de dt_lag en temps,
#  puis on cherche (s,dt_lag) qui maximise la correlation.
#  Une crete qui reapparait PLUS BAS PLUS TARD -> s<0 -> c_z<0.
# ============================================================
fld = detrend(detrend(shear_anom[m28], axis=0), axis=1)
fld = (fld - fld.mean()) / (fld.std() + 1e-12)
nz, nt = fld.shape
dz = np.mean(np.diff(alt[m28]))          # m (>0)

results = []
for dt_lag in range(1, 6):               # pas de temps vers l'avant
    a = fld[:, :nt-dt_lag]               # instant t
    b = fld[:, dt_lag:]                  # instant t + dt_lag
    best_s, best_c = 0, -np.inf
    for s in range(-6, 7):               # s = decalage vertical (niveaux)
        # b decale de s niveaux : on teste si "a a l'altitude z"
        # correspond a "b a l'altitude z - s*dz"
        bb = np.roll(b, -s, axis=0)
        c  = np.mean(a * bb)
        if c > best_c:
            best_c, best_s = c, s
    # s>0 : la structure est montee de s niveaux en dt_lag  -> c_z>0
    # s<0 : elle est descendue                              -> c_z<0
    cz = (best_s * dz) / (dt_lag * dt_phys)      # m/s, signe physique correct
    results.append(cz)
    sens = "DESCENTE" if cz < 0 else "montee"
    print(f"  lag {dt_lag*dt_phys/3600:.0f}h : "
          f"deplacement vertical = {best_s*dz:+.0f} m "
          f"-> c_z = {cz*100:+.2f} cm/s ({sens})")

cz_med = np.median(results)
print("\n" + "="*55)
print(f"  c_z median (pente des bandes) = {cz_med*100:+.2f} cm/s "
      f"= {cz_med*1000:+.3f} mm/s")
print(f"  soit {cz_med*86400:+.1f} m/jour  "
      f"({'DESCENTE coherente QBO' if cz_med<0 else 'MONTEE — a verifier'})")
print("="*55)
