# ======================================================================
# §15 — Visualisation avec zoom sur les petits termes
# ======================================================================

idx_tropo = np.searchsorted(alt, 15000)
sc = 1e5

for region, direct, resid, dud, wdz, pres, couleur in [
    ('HUMIDE', tend_h_direct, residuel_h, dudt_h, wdudz_h, pres_h, 'royalblue'),
    ('SÈCHE',  tend_s_direct, residuel_s, dudt_s, wdudz_s, pres_s, 'saddlebrown'),
]:
    fig, axes = plt.subplots(1, 3, figsize=(18, 8), sharey=True)

    sl = slice(None, idx_tropo)

    # ── Panel 1 : tous les termes, troposphère ────────────────────────
    ax = axes[0]
    ax.plot(direct[sl] * sc, alt[sl], color=couleur,      lw=2.5,
            label=r"Directe $-\frac{1}{\rho_0}\partial_z(\rho_0\overline{u'w'})$")
    ax.plot(resid[sl]  * sc, alt[sl], color='black',      lw=2,   linestyle='--',
            label=r'Résidu $\partial_t\bar{u} + \bar{w}\partial_z\bar{u} + \frac{1}{\rho_0}\partial_x\bar{p}$')
    ax.plot(wdz[sl]    * sc, alt[sl], color='darkorange', lw=1.2, linestyle='-.',
            label=r'$\bar{w}\partial_z\bar{u}$')
    ax.plot(pres[sl]   * sc, alt[sl], color='seagreen',   lw=1.2, linestyle='-.',
            label=r'$\frac{1}{\rho_0}\partial_x\bar{p}$')
    ax.axvline(0, color='grey', alpha=0.4)
    ax.set_xlabel('Tendance (×10⁻⁵ m/s²)')
    ax.set_ylabel('Altitude (m)')
    ax.set_title('Tous termes — troposphère', fontweight='bold')
    ax.legend(fontsize=8)
    ax.grid(True, alpha=0.3)

    # ── Panel 2 : zoom sur directe vs résidu (petite échelle) ─────────
    ax = axes[1]
    ax.plot(direct[sl] * sc, alt[sl], color=couleur, lw=2.5,
            label=r"Directe $-\frac{1}{\rho_0}\partial_z(\rho_0\overline{u'w'})$")
    ax.plot(resid[sl]  * sc, alt[sl], color='black', lw=2, linestyle='--',
            label=r'Résidu $\partial_t\bar{u} + \bar{w}\partial_z\bar{u} + \frac{1}{\rho_0}\partial_x\bar{p}$')
    ax.plot(dud[sl]    * sc, alt[sl], color='grey',  lw=1.5, linestyle=':',
            label=r'$\partial_t\bar{u}$')
    # Échelle adaptée automatiquement aux petits termes
    xmax = max(np.abs(direct[sl]).max(), np.abs(resid[sl]).max()) * sc * 1.3
    ax.set_xlim(-xmax, xmax)
    ax.axvline(0, color='grey', alpha=0.4)
    ax.set_xlabel('Tendance (×10⁻⁵ m/s²)')
    ax.set_title('Zoom : directe vs résidu', fontweight='bold')
    ax.legend(fontsize=8)
    ax.grid(True, alpha=0.3)

    # ── Panel 3 : résidu décomposé (petite échelle) ───────────────────
    ax = axes[2]
    ax.plot(direct[sl] * sc, alt[sl], color=couleur,      lw=2.5,
            label=r"Directe")
    ax.plot(resid[sl]  * sc, alt[sl], color='black',      lw=2,   linestyle='--',
            label=r'Résidu total')
    ax.plot(dud[sl]    * sc, alt[sl], color='grey',       lw=1.5, linestyle=':',
            label=r'$\partial_t\bar{u}$')
    ax.plot(wdz[sl]    * sc, alt[sl], color='darkorange', lw=1.2, linestyle='-.',
            label=r'$\bar{w}\partial_z\bar{u}$')
    ax.plot(pres[sl]   * sc, alt[sl], color='seagreen',   lw=1.2, linestyle='-.',
            label=r'$\frac{1}{\rho_0}\partial_x\bar{p}$')
    ax.set_xlim(-xmax, xmax)
    ax.axvline(0, color='grey', alpha=0.4)
    ax.set_xlabel('Tendance (×10⁻⁵ m/s²)')
    ax.set_title('Zoom : décomposition du résidu', fontweight='bold')
    ax.legend(fontsize=8)
    ax.grid(True, alpha=0.3)

    plt.suptitle(
        f'Région {region} — fermeture du bilan de QdM (troposphère)',
        fontsize=13, fontweight='bold'
    )
    plt.tight_layout()
    plt.show()






