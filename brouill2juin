# ============================================================
# vbar_zt si absent (ubar_zt, wbar_zt viennent du setup ; va pas encore lu)
if 'vbar_zt' not in dir():
    vbar_zt = np.zeros((n_z, n_stat))
    ds_v = xr.open_dataset(path3d('va'))
    for iz in range(n_z):
        v = ds_v['va'].isel({dim_t: idx_stat, dim_z: iz}).values
        vbar_zt[iz] = v.mean(axis=(1, 2))
        del v; gc.collect()
    ds_v.close(); del ds_v; gc.collect()
    print('vbar_zt calcule.')

tt = np.arange(n_stat)

def hovmoller(ax, field_zt, label):
    """Anomalie temporelle + lissage vertical, puis pcolormesh centre sur 0."""
    prime = field_zt - field_zt.mean(axis=1, keepdims=True)
    sm = uniform_filter1d(prime, size=3, axis=0, mode='nearest')
    v = np.percentile(np.abs(sm[mask_show]), 98) + 1e-9
    im = ax.pcolormesh(tt + t_stat, zkm[mask_show], sm[mask_show], cmap='RdBu_r',
                       norm=TwoSlopeNorm(0, -v, v), shading='auto')
    ax.grid(False)
    ax.axhspan(2, 8, color='k', alpha=.06); ax.set_ylim(0, Z_TOP_KM)
    ax.set_xlabel('t'); ax.set_ylabel('z (km)')
    ax.set_title(label)
    return im

fig, axes = plt.subplots(1, 3, figsize=(18, 5), sharey=True)
for ax, (fld, lab) in zip(axes, [
        (ubar_zt, r"Hovmoller $\bar u'(z,t)$"),
        (wbar_zt, r"Hovmoller $\bar w'(z,t)$"),
        (vbar_zt, r"Hovmoller $\bar v'(z,t)$")]):
    im = hovmoller(ax, fld, lab)
    fig.colorbar(im, ax=ax, pad=.02, label='m/s')

plt.suptitle("Anomalies moyennes (bandes descendantes = descente de phase)", fontweight='bold')
plt.tight_layout(); plt.show()
