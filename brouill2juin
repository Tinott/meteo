# ======================================================================
#  ÉTAPE 1 — Co-spectre Fourier de la covariance ORGANISÉE T1 par niveau
#  ----------------------------------------------------------------------
#  Idée : T1(z) = covariance en x des profils "par paliers" reconstruits
#         u_org(x) = uc[cat(x)] - ubar,  w_org(x) = wc[cat(x)] - wbar
#  où cat(x) ∈ {up,dn,env} est la catégorie de la colonne x (seuil sur w̄_y).
#  Le co-spectre de (u_org, w_org) vérifie  Σ_λ Co1(λ) = T1(z)  (Parseval),
#  et révèle À QUELLE ÉCHELLE horizontale vit le flux de masse organisé.
#
#  Dépend de : x, alt, iz_lst, z_D, nz_D, dim_t, dim_z, path3d,
#              IT_DECOMP, C_DECOMP, W0_MIN  (mêmes conventions que up/dn/env).
# ======================================================================
CAT_LIST = ('up', 'dn', 'env')

nx  = x.size
dx  = float(x[1] - x[0])
print(f"[T1 spectre] nx={nx}  dx={dx/1000:.2f} km  domaine={nx*dx/1000:.0f} km")

# --- axes spectraux Fourier (rfft : fréquences positives) ---
kx     = np.fft.rfftfreq(nx, d=dx) * 2*np.pi          # nombre d'onde [rad/m]
lam_km = (2*np.pi / np.maximum(kx, 1e-12)) / 1000     # longueur d'onde [km]

# --- conteneurs ---
Co_T1     = np.zeros((nz_D, kx.size))   # co-spectre du flux organisé, par niveau
T1_chk    = np.zeros(nz_D)              # T1 reconstruit (contrôle Parseval)
T1_ref    = np.zeros(nz_D)              # T1 "direct" (somme des catégories) pour cohérence
uorg_all  = np.zeros((nz_D, nx))        # u_org(x) par niveau (utile plus bas)
worg_all  = np.zeros((nz_D, nx))

ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for j, iz in enumerate(iz_lst):
    u_yx = ds_u['ua'].isel({dim_t: IT_DECOMP, dim_z: iz}).values   # (ny, nx)
    w_yx = ds_w['wa'].isel({dim_t: IT_DECOMP, dim_z: iz}).values

    # --- moyenne sur y -> profils en x ---
    uy = u_yx.mean(axis=0); wy = w_yx.mean(axis=0)
    ubar, wbar = uy.mean(), wy.mean()

    # --- classification des colonnes x (même seuil que le bloc up/dn/env) ---
    ws = max(W0_MIN, C_DECOMP * wy.std())
    masks = {'up': wy > ws, 'dn': wy < -ws, 'env': np.abs(wy) <= ws}

    # --- reconstruction par paliers : valeur de catégorie - moyenne globale ---
    u_org = np.zeros(nx); w_org = np.zeros(nx)
    t1_direct = 0.0
    for k in CAT_LIST:
        m = masks[k]; Nk = m.sum()
        if Nk == 0:
            continue
        uc = uy[m].mean(); wc = wy[m].mean()
        u_org[m] = uc - ubar
        w_org[m] = wc - wbar
        t1_direct += (Nk / nx) * (uc - ubar) * (wc - wbar)   # = σ_k (uc-ū)(wc-w̄)

    uorg_all[j] = u_org; worg_all[j] = w_org
    T1_ref[j]   = t1_direct
    T1_chk[j]   = (u_org * w_org).mean()        # doit égaler t1_direct (paliers constants)

    # --- co-spectre Fourier de (u_org, w_org), normalisé Parseval ---
    Fu = np.fft.rfft(u_org); Fw = np.fft.rfft(w_org)
    co = np.real(Fu * np.conj(Fw)) / nx**2
    if nx % 2 == 0:
        co[1:-1] *= 2          # repli des fréquences négatives (sauf 0 et Nyquist)
    else:
        co[1:]   *= 2
    Co_T1[j] = co

    del u_yx, w_yx; gc.collect()
ds_u.close(); ds_w.close(); del ds_u, ds_w; gc.collect()

# ----------------------------------------------------------------------
#  Contrôles
# ----------------------------------------------------------------------
err_parseval = np.abs(Co_T1.sum(axis=1) - T1_chk).max()
err_direct   = np.abs(T1_chk - T1_ref).max()
print(f"[Parseval]  max|Σ_λ Co1 - T1_chk|   = {err_parseval:.2e}   (≈ 1e-18)")
print(f"[cohérence] max|T1_chk - T1_direct| = {err_direct:.2e}     (≈ 1e-18)")

j_max = int(np.argmax(np.abs(T1_chk)))
print(f"niveau |T1| max : z = {z_D[j_max]/1000:.1f} km   (T1 = {T1_chk[j_max]:.2e} m²/s²)")

# --- échelle dominante par niveau (barycentre de |Co1| en log-λ) ---
lam_dom_T1 = np.full(nz_D, np.nan)
for j in range(nz_D):
    wgt = np.abs(Co_T1[j, 1:])
    if wgt.sum() > 0:
        lam_dom_T1[j] = np.exp(np.sum(wgt * np.log(lam_km[1:])) / wgt.sum())

# ======================================================================
#  FIGURE — co-spectre de T1 (area-preserving k·Co) + échelle dominante
# ======================================================================
A1 = kx[None, 1:] * Co_T1[:, 1:]          # k·Co : contribution par décade log
m1 = np.percentile(np.abs(A1), 99) + 1e-30

fig, ax = plt.subplots(1, 2, figsize=(13, 5.5),
                       gridspec_kw={'width_ratios': [2, 1]})

# (a) carte échelle-altitude
pc = ax[0].pcolormesh(lam_km[1:], z_D/1000, A1, shading='auto',
                      norm=TwoSlopeNorm(vcenter=0, vmin=-m1, vmax=m1), cmap='RdBu_r')
ax[0].plot(lam_dom_T1, z_D/1000, 'k-', lw=1.6, alpha=.7, label='échelle dominante')
ax[0].set_xscale('log'); ax[0].invert_xaxis()
ax[0].set_xlabel(r'$\lambda$ [km]'); ax[0].set_ylabel('z [km]')
ax[0].set_title(r'(a) Co-spectre du flux organisé $T_1$  ($k\,\mathrm{Co}$)')
ax[0].legend(fontsize=9, loc='upper left')
fig.colorbar(pc, ax=ax[0], label=r'$k\,\mathrm{Co}_{T_1}$', pad=0.01)

# (b) profil T1(z) + comparaison au T2 si dispo
ax[1].plot(T1_chk*1e3, z_D/1000, 'r-', lw=2, label=r'$T_1$ (organisé)')
if 'T2' in dir() and isinstance(T2, dict) and CAT_DEF_OK := all(T2[k].shape[0]==nz_D for k in T2):
    T2tot_here = sum(T2[k] for k in T2)
    ax[1].plot(T2tot_here*1e3, z_D/1000, 'b-.', lw=2, label=r'$T_2$ (résidu)')
ax[1].axvline(0, color='grey', alpha=.4)
ax[1].set_xlabel(r'flux ($\times10^{-3}$ m²/s²)'); ax[1].set_title('(b) Profils')
ax[1].legend(fontsize=9); ax[1].grid(alpha=.3)

plt.tight_layout(); plt.show()









# ======================================================================
#  ÉTAPE 2 — Forme et orientation des rouleaux de lignes de courant
#  ----------------------------------------------------------------------
#  Un rouleau = une cellule de circulation = une région connexe où ψ garde
#  un signe constant (bornée par les isolignes ψ = 0). Pour chaque cellule :
#    • tenseur d'inertie pondéré par |ψ| (intensité de circulation)
#    • valeurs propres  -> demi-axes a≥b de l'ellipse équivalente
#    • aspect ratio     AR = a/b           (1 = rond, >>1 = lamelle)
#    • angle θ          = orientation de l'axe majeur p/r horizontale [deg]
#    • signe            = sens de rotation (ψ>0 / ψ<0)
#
#  Entrées attendues :  psi_i (nz,nx), x [m], z_i [m]   d'un instant donné.
#  (réutilise la coupe_instant + psi_poisson_periodic des cellules ψ)
#
#  Segmentation des composantes connexes : implémentation NumPy-only par
#  union-find (pas de scipy.ndimage requis -> robuste sur le cluster CNRM,
#  mais on l'utilise si dispo car bien plus rapide).
# ======================================================================

# ---------- (2a) étiquetage des composantes connexes (4-connexité) ----------
def label_connected(mask):
    """Étiquette les régions connexes True de `mask` (2D bool).
    Renvoie (labels int [même shape], n_labels). 4-connexité.
    Utilise scipy.ndimage.label si présent, sinon union-find NumPy-only."""
    try:
        from scipy.ndimage import label as _ndlabel
        lab, n = _ndlabel(mask)              # 4-connexité par défaut
        return lab, int(n)
    except Exception:
        pass
    # --- repli union-find (sans scipy) ---
    nz, nx = mask.shape
    parent = np.full(nz*nx, -1, dtype=np.int64)
    def find(a):
        root = a
        while parent[root] != root:
            root = parent[root]
        while parent[a] != root:           # compression de chemin
            parent[a], a = root, parent[a]
        return root
    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[max(ra, rb)] = min(ra, rb)
    idx = lambda i, j: i*nx + j
    for i in range(nz):
        for j in range(nx):
            if not mask[i, j]:
                continue
            p = idx(i, j); parent[p] = p
            if i > 0 and mask[i-1, j]:
                if parent[idx(i-1, j)] != -1: union(p, idx(i-1, j))
            if j > 0 and mask[i, j-1]:
                if parent[idx(i, j-1)] != -1: union(p, idx(i, j-1))
    labels = np.zeros((nz, nx), dtype=np.int64)
    remap = {}; nxt = 1
    for i in range(nz):
        for j in range(nx):
            if mask[i, j]:
                r = find(idx(i, j))
                if r not in remap:
                    remap[r] = nxt; nxt += 1
                labels[i, j] = remap[r]
    return labels, nxt - 1


# ---------- (2b) diagnostics géométriques d'une cellule ----------
def cell_geometry(ii, jj, wgt, x, z_i):
    """Tenseur d'inertie pondéré -> (aire, AR, angle_deg, xc_km, zc_km, a_km, b_km).
    ii,jj : indices (z,x) des pixels de la cellule ; wgt : poids (|ψ|) par pixel."""
    X = x[jj];  Z = z_i[ii]                       # coordonnées physiques [m]
    W = wgt.astype(float)
    Wsum = W.sum() + 1e-30
    xc = (W * X).sum() / Wsum
    zc = (W * Z).sum() / Wsum
    dX = X - xc; dZ = Z - zc
    # tenseur de covariance spatiale pondéré (2x2)
    Sxx = (W * dX * dX).sum() / Wsum
    Szz = (W * dZ * dZ).sum() / Wsum
    Sxz = (W * dX * dZ).sum() / Wsum
    C = np.array([[Sxx, Sxz], [Sxz, Szz]])
    evals, evecs = np.linalg.eigh(C)              # croissant
    lam_min, lam_max = evals[0], evals[1]
    a = 2.0 * np.sqrt(max(lam_max, 0.0))          # demi-axe majeur (≈2σ)
    b = 2.0 * np.sqrt(max(lam_min, 0.0))          # demi-axe mineur
    AR = a / (b + 1e-30)
    vmaj = evecs[:, 1]                            # vecteur propre de lam_max = (vx, vz)
    angle = np.degrees(np.arctan2(vmaj[1], vmaj[0]))   # p/r horizontale
    if angle < -90: angle += 180
    if angle >  90: angle -= 180
    area_px = ii.size
    return dict(area_px=area_px, AR=AR, angle=angle,
                xc_km=xc/1000, zc_km=zc/1000,
                a_km=a/1000, b_km=b/1000)


# ---------- (2c) extraction de tous les rouleaux d'une coupe ψ ----------
def detect_rolls(psi_i, x, z_i, min_area_px=12, rel_amp=0.05):
    """Détecte les rouleaux (cellules ψ de signe constant) et leurs diagnostics.
    min_area_px : aire minimale (rejette le bruit) ;
    rel_amp     : seuil sur |ψ| relatif au max (rejette les cellules atones)."""
    psi_amp = np.percentile(np.abs(psi_i), 99) + 1e-30
    strong  = np.abs(psi_i) > rel_amp * psi_amp          # masque "circulation notable"

    rolls = []
    for sgn, name in ((+1, 'CCW'), (-1, 'CW')):          # ψ>0 vs ψ<0
        mask = strong & (np.sign(psi_i) == sgn)
        labels, nlab = label_connected(mask)
        for L in range(1, nlab + 1):
            ii, jj = np.where(labels == L)
            if ii.size < min_area_px:
                continue
            wgt = np.abs(psi_i[ii, jj])
            geo = cell_geometry(ii, jj, wgt, x, z_i)
            geo['sense'] = name
            geo['sign']  = sgn
            geo['circ']  = float(wgt.sum())              # ~ intensité de la cellule
            rolls.append(geo)
    # tri par intensité décroissante
    rolls.sort(key=lambda d: d['circ'], reverse=True)
    return rolls


# ======================================================================
#  Application à l'instant final + statistiques + figure
# ======================================================================
IT_ROLL = n_t - 1                       # même instant que la décompo
z_R, rho_R, U_R, W_R, UP_R = coupe_instant(IT_ROLL)
psi_R = psi_poisson_periodic(U_R, W_R, x, z_R, rho_R)

rolls = detect_rolls(psi_R, x, z_R, min_area_px=12, rel_amp=0.05)
print(f"[rouleaux] {len(rolls)} cellules détectées à it={IT_ROLL}")

# --- statistiques agrégées (ce qui se paramétrise) ---
if rolls:
    AR_arr    = np.array([r['AR']    for r in rolls])
    ang_arr   = np.array([r['angle'] for r in rolls])
    a_arr     = np.array([r['a_km']  for r in rolls])
    circ_arr  = np.array([r['circ']  for r in rolls])
    w = circ_arr / circ_arr.sum()                    # pondération par intensité
    print(f"  aspect ratio   : médian {np.median(AR_arr):.2f}   "
          f"moyen-pondéré {np.sum(w*AR_arr):.2f}")
    print(f"  orientation    : médiane {np.median(ang_arr):+.1f}°  "
          f"moyenne-pondérée {np.sum(w*ang_arr):+.1f}°")
    print(f"  demi-axe majeur: médian {np.median(a_arr):.1f} km")

# ======================================================================
#  FIGURE — coupe ψ + ellipses ajustées + histogrammes AR/angle
# ======================================================================
from matplotlib.patches import Ellipse

fig = plt.figure(figsize=(14, 5.5))
