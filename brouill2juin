SEUIL_W_UD = 0.5
regions = {'humide': mh_flat, 'sec': ms_flat}
cats_names = ['up', 'down', 'env']

T1_cat = {r: {c: np.full((n_z, n_stat_agg), np.nan) for c in cats_names} for r in regions}
T2_cat = {r: {c: np.full((n_z, n_stat_agg), np.nan) for c in cats_names} for r in regions}

ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for iz in range(n_z):
    u_full = ds_u['ua'].isel({dim_t: idx_stat_agg, dim_z: iz}).values.reshape(n_stat_agg, -1)
    w_full = ds_w['wa'].isel({dim_t: idx_stat_agg, dim_z: iz}).values.reshape(n_stat_agg, -1)
    for rname, rmask in regions.items():
        u = u_full[:, rmask]; w = w_full[:, rmask]; N = u.shape[1]
        for it in range(n_stat_agg):
            uu, ww = u[it, :], w[it, :]
            ub, wb = uu.mean(), ww.mean()
            mask_up = ww > SEUIL_W_UD; mask_dn = ww < -SEUIL_W_UD; mask_env = ~mask_up & ~mask_dn
            cats = {'up': mask_up, 'down': mask_dn, 'env': mask_env}
            for cname, cmask in cats.items():
                if not cmask.any(): continue
                sig = cmask.sum() / N
                uc, wc = uu[cmask].mean(), ww[cmask].mean()
                T1_cat[rname][cname][iz, it] = rho0[iz] * sig * (uc - ub) * (wc - wb)
                T2_cat[rname][cname][iz, it] = rho0[iz] * sig * ((uu[cmask]-uc)*(ww[cmask]-wc)).mean()
    del u_full, w_full; gc.collect()
ds_u.close(); ds_w.close(); gc.collect()
