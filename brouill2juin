# ============================================================
#  §8. Affichage brut : T1 seul vs T1+T2 vs dudt_reel vs terme_flux
# ============================================================
fig, axes = plt.subplots(2, 2, figsize=(12, 10), sharex=True, sharey=True)
v = max(np.nanpercentile(np.abs(dudt_reel[m212]), 95),
        np.nanpercentile(np.abs(dudt_T1[m212]), 95),
        np.nanpercentile(np.abs(dudt_T1_T2[m212]), 95),
        np.nanpercentile(np.abs(terme_flux[m212]), 95)) * 3600 + 1e-12

champs = [(dudt_reel*3600,    r"$\partial_t\bar u$ reel"),
          (dudt_T1*3600,      r"T1 seul $\to$ tendance"),
          (dudt_T1_T2*3600,   r"T1+T2 $\to$ tendance"),
          (terme_flux*3600,   r"$-\frac{1}{\rho_0}\partial_z(\rho_0\overline{u'w'})$ (domaine entier)")]

for ax, (fld, lab) in zip(axes.ravel(), champs):
    im = ax.pcolormesh(tt+t_stat, zkm[m212], fld[m212], cmap='RdBu_r',
                        norm=TwoSlopeNorm(0, -v, v), shading='auto')
    ax.set_title(lab, fontsize=10); fig.colorbar(im, ax=ax, pad=.02)
for ax in axes[:,0]: ax.set_ylabel('z (km)')
for ax in axes[1,:]: ax.set_xlabel('t')
plt.suptitle("T1 seul / T1+T2 / reel / terme de turbulence convective (domaine entier)", fontweight='bold')
plt.tight_layout(); plt.show()

for lab, pred in [('T1 seul', dudt_T1), ('T1+T2', dudt_T1_T2)]:
    print(f"\n--- {lab} ---")
    for iz in range(0, n_z, 6):
        if not m212[iz]: continue
        a, b = dudt_reel[iz,:], pred[iz,:]
        ok = np.isfinite(a) & np.isfinite(b)
        if ok.sum() < 20: continue
        print(f"z={zkm[iz]:.1f}km | biais={np.mean(b[ok]-a[ok])*3600:+.4f} | "
              f"std_reel={np.std(a[ok])*3600:.4f} | std_pred={np.std(b[ok])*3600:.4f} | "
              f"corr={np.corrcoef(a[ok],b[ok])[0,1]:+.2f}")
