# ============================================================
#  §7. T1(z,t)/T2(z,t) résolus en temps (à la nb3/4), comparés
#      SANS calibration à dudt_reel — pour trancher si la
#      recalibration pente+biais du §6 "réinvente" T2 ou non
# ============================================================
C_CAT = 0.5          # seuil de classification up/dn/env (cohérent avec C* de nb3/4)
W0_MIN = 0.001
reg_flat = mh_flat    # région humide, comme nb3/4 (pas tout le domaine)

T1_zt = np.full((n_z, n_stat), np.nan)   # transport organisé (rho0 * <u'w'>)
T2_zt = np.full((n_z, n_stat), np.nan)   # covariance interne sous-maille
rey_mh_zt = np.full((n_z, n_stat), np.nan)  # flux de Reynolds, région humide seule (référence exacte)

ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for iz in range(n_z):
    u_all = ds_u['ua'].isel({dim_t: idx_stat, dim_z: iz}).values.reshape(n_stat, -1)
    w_all = ds_w['wa'].isel({dim_t: idx_stat, dim_z: iz}).values.reshape(n_stat, -1)
    u_mh = u_all[:, reg_flat]; w_mh = w_all[:, reg_flat]
    del u_all, w_all
    for it in range(n_stat):
        u = u_mh[it]; w = w_mh[it]
        ub = u.mean(); wb = w.mean()
        rey_mh_zt[iz, it] = rho0[iz] * np.mean((u - ub) * (w - wb))

        ws = max(W0_MIN, C_CAT * w.std())
        cats = {'up': w > ws, 'dn': w < -ws, 'env': np.abs(w) <= ws}
        t1 = 0.0; t2 = 0.0
        for k, msk in cats.items():
            if msk.sum() == 0:
                continue
            sig_k = msk.mean()
            u_k = u[msk].mean(); w_k = w[msk].mean()
            t1 += sig_k * (u_k - ub) * (w_k - wb)
            t2 += sig_k * np.mean((u[msk] - u_k) * (w[msk] - w_k))
        T1_zt[iz, it] = rho0[iz] * t1
        T2_zt[iz, it] = rho0[iz] * t2
    del u_mh, w_mh; gc.collect()
ds_u.close(); ds_w.close(); gc.collect()

# controle : identite exacte T1+T2 = Reynolds (region humide)
residu = np.nanmax(np.abs((T1_zt + T2_zt) - rey_mh_zt))
print(f"controle identite T1+T2=Reynolds(mh) : residu max = {residu:.2e} (doit etre ~0)")

# ---- tendances induites, SANS calibration ----
def tend_from_flux(flux_zt):
    return smooth_t(-(1.0 / rho0[:, None]) * np.gradient(flux_zt, alt, axis=0))

dudt_T1      = tend_from_flux(T1_zt)
dudt_T1_T2   = tend_from_flux(T1_zt + T2_zt)

def r2_brut(pred_zt, mask):
    r2 = np.full(n_z, np.nan)
    for iz in np.where(mask)[0]:
        a, b = dudt_reel[iz, :], pred_zt[iz, :]
        ok = np.isfinite(a) & np.isfinite(b)
        if ok.sum() < 20 or np.nanstd(a[ok]) < 1e-15:
            continue
        ss_res = np.nansum((a[ok] - b[ok])**2)
        ss_tot = np.nansum((a[ok] - a[ok].mean())**2)
        r2[iz] = 1 - ss_res / ss_tot if ss_tot > 0 else np.nan
    return r2

R2_T1_seul  = r2_brut(dudt_T1,    m212)
R2_T1_T2    = r2_brut(dudt_T1_T2, m212)

print(f"R2 brut (sans calibration) T1 seul     2-8km : {np.nanmedian(R2_T1_seul[m28]):.2f}")
print(f"R2 brut (sans calibration) T1+T2       2-8km : {np.nanmedian(R2_T1_T2[m28]):.2f}")
print(f"R2 brut (sans calibration) T1 seul   8-12km : {np.nanmedian(R2_T1_seul[(alt>=8000)&(alt<=12000)]):.2f}")
print(f"R2 brut (sans calibration) T1+T2     8-12km : {np.nanmedian(R2_T1_T2[(alt>=8000)&(alt<=12000)]):.2f}")

# pour reference : ou en etait le R2 recalibre (pente+biais) du bulk-plume 1-courant du §6
print(f"[rappel §6] R2 recalibre bulk-plume 1-courant 2-8km : {np.nanmedian(R2_calibre[m28]):.2f}")

