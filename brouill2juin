# ============================================================================
# SECTION RELIEF (3D) — DCT 2D vs POD comme base pour [u';w'] spatiaux
# ============================================================================
half = n_z * nx_r

def flux_from_uw(u2, w2):
    """u2,w2 : (Ns, n_z, nx_r) -> profil rho0<u'w'>_{y,x}(z) sur grille reduite."""
    u = u2.reshape(n_snap_t, ny_r, n_z, nx_r).transpose(0, 2, 1, 3)
    w = w2.reshape(n_snap_t, ny_r, n_z, nx_r).transpose(0, 2, 1, 3)
    
    # --- CORRECTION SPATIALE : Les anomalies u' et w' doivent etre prises par rapport à la moyenne spatiale (x) ---
    u = u - u.mean(axis=3, keepdims=True) # Moyenne sur nx_r uniquement
    w = w - w.mean(axis=3, keepdims=True) # Moyenne sur nx_r uniquement
    
    return (rho0[None, :] * (u * w).mean(axis=(2, 3))).mean(axis=0)

# Sanity check
nse_sanity = nse(flux_true_profile, flux_from_uw(up_snaps, wp_snaps))
print(f'[sanity] flux depuis u,w exacts (anomalie spatiale) : NSE = {nse_sanity:.4f} (doit etre ~1.0)')


# --- 1. DCT 2D : troncature par snapshot, sur u' ET w' spatiaux ---
def dct_trunc_field(F3, frac):
    """F3:(Ns,n_z,nx_r) ; garde les frac plus gros coeffs DCT de chaque snapshot."""
    out = np.empty_like(F3)
    for s in range(F3.shape[0]):
        C = dctn(F3[s], norm='ortho')
        flat = C.ravel()
        k = max(1, int(frac * flat.size))
        idx = np.argpartition(np.abs(flat), -k)[-k:]
        Cm = np.zeros_like(flat); Cm[idx] = flat[idx]
        out[s] = idctn(Cm.reshape(C.shape), norm='ortho')
    return out

fracs = np.array([0.01, 0.02, 0.05, 0.1, 0.3])
nse_dct = []
for fr in fracs:
    ut = dct_trunc_field(up_snaps, fr)
    wt = dct_trunc_field(wp_snaps, fr)
    nse_dct.append(nse(flux_true_profile, flux_from_uw(ut, wt)))
    print(f' DCT {fr*100:4.1f}% coeffs -> NSE flux = {nse_dct[-1]:+.3f}')
nse_dct = np.array(nse_dct)


# --- 2. POD 3D Spatiale : Reconstruction et évaluation de la covariance ---
def flux_pod_N(N):
    rec = Smean[None, :] + a_n[:, :N] @ modes_flat[:N]
    return flux_from_uw(rec[:, :half].reshape(Ns, n_z, nx_r),
                        rec[:, half:].reshape(Ns, n_z, nx_r))

# Nombre de coeffs POD equivalent a une fraction
N_grid = np.unique(np.clip((fracs * Ns).astype(int), 1, Ns - 1))
nse_pod_grid = np.array([nse(flux_true_profile, flux_pod_N(N)) for N in N_grid])
for N, s in zip(N_grid, nse_pod_grid):
    print(f' POD {N:4d} modes ({N/Ns*100:4.1f}%) -> NSE flux = {s:+.3f}')


