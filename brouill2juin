n_stat_it = n_t - t_stat
idx_18km  = np.searchsorted(alt, 18000)

alpha_h = np.zeros((n_stat_it, idx_18km))
beta_h  = np.zeros((n_stat_it, idx_18km))
alpha_s = np.zeros((n_stat_it, idx_18km))
beta_s  = np.zeros((n_stat_it, idx_18km))

tend_mean_h  = np.zeros(idx_18km)
tend_mean_s  = np.zeros(idx_18km)
recon_mean_h = np.zeros(idx_18km)
recon_mean_s = np.zeros(idx_18km)

ds_u = xr.open_dataset(path3d('ua'))
ds_w = xr.open_dataset(path3d('wa'))

ubar_glob = np.zeros(idx_18km)
for iz in range(idx_18km):
    for it in range(t_stat, n_t):
        ubar_glob[iz] += ds_u['ua'].isel({dim_t: it, dim_z: iz}).values.mean()
    ubar_glob[iz] /= n_stat_it
print('ubar_glob calculé.')

for iz in range(idx_18km):

    iz_lo = max(iz - 1, 0)
    iz_hi = min(iz + 1, idx_18km - 1)
    dz    = alt[iz_hi] - alt[iz_lo]
    if dz == 0:
        dz = alt[1] - alt[0]

    u_all  = ds_u['ua'].isel({dim_z: iz,    dim_t: slice(t_stat, n_t)}).values
    w_all  = ds_w['wa'].isel({dim_z: iz,    dim_t: slice(t_stat, n_t)}).values
    u_lo   = ds_u['ua'].isel({dim_z: iz_lo, dim_t: slice(t_stat, n_t)}).values
    u_hi   = ds_u['ua'].isel({dim_z: iz_hi, dim_t: slice(t_stat, n_t)}).values
    w_lo   = ds_w['wa'].isel({dim_z: iz_lo, dim_t: slice(t_stat, n_t)}).values  # CORRIGÉ
    w_hi   = ds_w['wa'].isel({dim_z: iz_hi, dim_t: slice(t_stat, n_t)}).values  # CORRIGÉ

    acc_tend_h  = 0.0 ; acc_tend_s  = 0.0
    acc_recon_h = 0.0 ; acc_recon_s = 0.0

    for i_t in range(n_stat_it):

        u_2d = u_all[i_t]

        # ── tend colonne par colonne (CORRIGÉ : w aux bons niveaux) ──
        # u'w' colonne par colonne à iz_lo et iz_hi
        u_p_lo = u_lo[i_t] - u_lo[i_t].mean()
        w_p_lo = w_lo[i_t] - w_lo[i_t].mean()
        u_p_hi = u_hi[i_t] - u_hi[i_t].mean()
        w_p_hi = w_hi[i_t] - w_hi[i_t].mean()

        # rho0 * u'w' colonne par colonne à chaque niveau voisin : (ny, nx)
        flux_lo_2d = rho0[iz_lo] * (u_p_lo * w_p_lo)
        flux_hi_2d = rho0[iz_hi] * (u_p_hi * w_p_hi)

        # divergence colonne par colonne
        tend_2d = -(flux_hi_2d - flux_lo_2d) / (dz * rho0[iz])   # (ny, nx)

        # ── régresseurs colonne par colonne ──────────────────────────
        uC        = u_2d - ubar_glob[iz]
        rho_uC    = rho0[iz] * uC
        rho_uC_lo = rho0[iz_lo] * (u_lo[i_t] - ubar_glob[iz_lo])
        rho_uC_hi = rho0[iz_hi] * (u_hi[i_t] - ubar_glob[iz_hi])
        dz_rho_uC = (rho_uC_hi - rho_uC_lo) / dz

        # ── OLS par région ────────────────────────────────────────────
        for mask, alpha_arr, beta_arr, tag in [
            (mh, alpha_h, beta_h, 'h'),
            (ms, alpha_s, beta_s, 's'),
        ]:
            y  = tend_2d[mask]
            x1 = rho_uC[mask]
            x2 = dz_rho_uC[mask]

            X   = np.stack([x1, x2], axis=1)
            XtX = X.T @ X
            Xty = X.T @ y
            try:
                coeffs = np.linalg.solve(XtX, Xty)
            except np.linalg.LinAlgError:
                coeffs = np.zeros(2)

            alpha_arr[i_t, iz] = coeffs[0]
            beta_arr[i_t, iz]  = coeffs[1]

            y_pred = coeffs[0] * x1 + coeffs[1] * x2

            if tag == 'h':
                acc_tend_h  += y.mean()
                acc_recon_h += y_pred.mean()
            else:
                acc_tend_s  += y.mean()
                acc_recon_s += y_pred.mean()

    tend_mean_h[iz]  = acc_tend_h  / n_stat_it
    tend_mean_s[iz]  = acc_tend_s  / n_stat_it
    recon_mean_h[iz] = acc_recon_h / n_stat_it
    recon_mean_s[iz] = acc_recon_s / n_stat_it

    del u_all, w_all, u_lo, u_hi, w_lo, w_hi
    gc.collect()

    if iz % 10 == 0:
        print(f'  iz={iz}/{idx_18km-1}  ({alt[iz]:.0f} m)')

ds_u.close() ; ds_w.close()
del ds_u, ds_w
gc.collect()
print('α, β (u) calculés.')





# ── Visualisation y vs ŷ ──────────────────────────────────────────────
z = alt[:idx_18km]

fig, axes = plt.subplots(1, 2, figsize=(14, 8), sharey=True)

for ax, direct, recon, label, couleur in [
    (axes[0], tend_mean_h, recon_mean_h, 'HUMIDE', 'royalblue'),
    (axes[1], tend_mean_s, recon_mean_s, 'SÈCHE',  'saddlebrown'),
]:
    ax.plot(direct * 1e5, z, color=couleur, lw=2.5,
            label=r'$y$ direct $-\frac{1}{\rho_0}\partial_z(\rho_0\overline{u\'w\'})$')
    ax.plot(recon  * 1e5, z, color='black', lw=2, linestyle='--',
            label=r'$\hat{y}$ reconstruit $\alpha\,\rho_0 u_C + \beta\,\partial_z(\rho_0 u_C)$')
    ax.axvline(0, color='grey', alpha=0.4)
    ax.set_xlabel('Tendance (×10⁻⁵ m/s²)')
    ax.set_title(f'Région {label}', fontweight='bold')
    ax.legend(fontsize=9)
    ax.grid(True, alpha=0.3)

axes[0].set_ylabel('Altitude (m)')
plt.suptitle(r'§18u — $y$ vs $\hat{y}$ (moyenne temporelle)',
             fontsize=13, fontweight='bold')
plt.tight_layout()
plt.show()





