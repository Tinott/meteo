def relief_watershed(field, sigma_smooth=2, min_distance=7):
    '''Decompose field (relief) en bassins par watershed.
    field : (nz, nx), typiquement psi' ou une carte de |Gamma|.
    sigma_smooth : lissage gaussien avant detection des marqueurs (evite
    de detecter des dizaines de faux maxima dus au bruit).
    min_distance : taille de la fenetre pour chercher les extrema locaux.
    '''
    field_s = ndimage.gaussian_filter(field, sigma=sigma_smooth)

    is_max = ndimage.maximum_filter(field_s, size=min_distance) == field_s
    is_min = ndimage.minimum_filter(field_s, size=min_distance) == field_s
    lbl_max, n_max = ndimage.label(is_max)
    lbl_min, n_min = ndimage.label(is_min)

    # marqueurs : positifs pour les bosses (updrafts), negatifs pour les
    # creux (downdrafts) -> watershed_ift les traite comme deux familles
    markers = np.zeros(field.shape, dtype=np.int32)
    markers[lbl_max > 0] = lbl_max[lbl_max > 0]
    markers[lbl_min > 0] = -lbl_min[lbl_min > 0]

    field_u = ((field - field.min()) / (field.max() - field.min() + 1e-30) * 255).astype(np.uint8)
    basins = ndimage.watershed_ift(field_u, markers)
    print(f'{n_max} bosses, {n_min} creux -> {len(np.unique(basins))} bassins')
    return basins, markers


