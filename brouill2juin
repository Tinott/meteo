# ============================================================================
# S27 — Decomposition de la divergence du flux de masse (MEILLEUR SEUIL S26)
#   d/dz[Mc·Du] = (dMc/dz)·Du  +  Mc·(dDu/dz)     avec Du = u_c - u_e
#   (CALCULS pleine colonne ; AFFICHAGE 2000-18000 m ; zone humide)
# ============================================================================

st = 1e5  # m/s^2 -> 1e-5

def decompose_div(Mc, duc):
    dMc  = np.gradient(Mc,  alt)
    dduc = np.gradient(duc, alt)
    A = dMc * duc
    B = Mc * dduc
    tot = A + B
    return A, B, tot, -tot / rho0

A_h, B_h, div_h, tend_h = decompose_div(Mc_up_h, duc_h)
A_s, B_s, div_s, tend_s = decompose_div(Mc_up_s, duc_s)   # calcul conserve

tend_rey_h = -np.gradient(flux_glob_h, alt) / rho0
tend_rey_s = -np.gradient(flux_glob_s, alt) / rho0        # calcul conserve

fig, axes = plt.subplots(1, 2, figsize=(14, 8), sharey=True)

ax = axes[0]
ax.plot(A_h[disp]*sc,   alt[disp], color='darkorange', lw=2.2, label='A = (dMc/dz) Du')
ax.plot(B_h[disp]*sc,   alt[disp], color='purple',     lw=2.2, label='B = Mc (dDu/dz)')
ax.plot(div_h[disp]*sc, alt[disp], color='black', lw=2.5, ls='--', label='A + B')
ax.axvline(0, color='grey', alpha=0.4)
ax.set_xlabel('dPhi/dz  (x1e-3)')
ax.set_title('HUMIDE - decomposition divergence', fontweight='bold')
ax.legend(fontsize=9); ax.grid(alpha=0.3)
ax.set_ylabel('Altitude (m)'); ax.set_ylim(2000, 18000)

ax = axes[1]
ax.plot(tend_rey_h[disp]*st, alt[disp], color='royalblue', lw=2.5, label='Reynolds (verite)')
ax.plot(tend_h[disp]*st,     alt[disp], color='red', lw=2, ls='--', label='masse -1/rho0 (A+B)')
ax.plot((-A_h[disp]/rho0[disp])*st, alt[disp], color='darkorange', lw=1.3, ls=':', label='part A')
ax.plot((-B_h[disp]/rho0[disp])*st, alt[disp], color='purple',     lw=1.3, ls=':', label='part B')
ax.axvline(0, color='grey', alpha=0.4)
ax.set_xlabel('d(ubar)/dt  (x1e-5 m/s2)')
ax.set_title('HUMIDE - tendance vent', fontweight='bold')
ax.legend(fontsize=8); ax.grid(alpha=0.3); ax.set_ylim(2000, 18000)

plt.suptitle('S27 - decomposition divergence  [best seuil, humide, 2-18 km]',
             fontsize=13, fontweight='bold')
plt.tight_layout(); plt.show()

print('-- Poids relatif des termes A et B (norme L2, 2-18 km) --')
for tag, A, B in [('HUMIDE', A_h, B_h), ('SECHE', A_s, B_s)]:
    nA = np.sqrt(np.nansum(A[disp]**2)); nB = np.sqrt(np.nansum(B[disp]**2))
    print(tag.ljust(7) + ': ||A||=' + format(nA*sc, '7.3f')
          + '  ||B||=' + format(nB*sc, '7.3f')
          + '  -> A domine a ' + format(100*nA/(nA+nB), '4.1f') + '%')









# ============================================================================
# S29 — Fermetures reduites du contraste Du (MEILLEUR SEUIL S26)
#   (i) Du ~ cste = <Du> ;  (ii) Du ~ a + b z
#   (AFFICHAGE 2000-18000 m ; zone humide)
# ============================================================================

def reduit(Mc, duc, frey):
    Mc_d   = Mc[disp]; duc_d = duc[disp]; frey_d = frey[disp]; z = alt[disp]
    ok = np.isfinite(duc_d)
    duc_cste = np.full_like(z, np.nanmean(duc_d))
    b, a = np.polyfit(z[ok], duc_d[ok], 1)
    duc_lin = a + b*z
    return Mc_d*duc_d, Mc_d*duc_cste, Mc_d*duc_lin, frey_d, z, a, b

Phi_full_h, Phi_cste_h, Phi_lin_h, frey_h, z_h, a_h, b_h = reduit(Mc_up_h, duc_h, flux_glob_h)
Phi_full_s, Phi_cste_s, Phi_lin_s, frey_s, z_s, a_s, b_s = reduit(Mc_up_s, duc_s, flux_glob_s)  # calcul conserve

fig, ax = plt.subplots(figsize=(7, 8))
ax.plot(frey_h*sc,     z_h, color='black',  lw=2.5, label='Reynolds verite')
ax.plot(Phi_full_h*sc, z_h, color='red',    lw=1.8, ls='--', label='Mc Du (reel)')
ax.plot(Phi_cste_h*sc, z_h, color='teal',   lw=1.6, ls=':',  label='Mc <Du>')
ax.plot(Phi_lin_h*sc,  z_h, color='orange', lw=1.6, ls='-.', label='Mc (a+bz)')
ax.axvline(0, color='grey', alpha=0.4)
ax.set_xlabel('flux  (x1e-3)'); ax.set_ylabel('Altitude (m)')
ax.set_title('HUMIDE - fermetures reduites du contraste Du', fontweight='bold')
ax.legend(fontsize=9); ax.grid(alpha=0.3); ax.set_ylim(2000, 18000)
plt.suptitle('S29 - Fermetures reduites  [best seuil, humide, 2-18 km]',
             fontsize=13, fontweight='bold')
plt.tight_layout(); plt.show()

def rms_set(frey_d, Pf, Pc, Pl):
    def rms(e):
        m = np.isfinite(e)
        return np.sqrt(np.nanmean(e[m]**2))*sc
    return rms(frey_d-Pf), rms(frey_d-Pc), rms(frey_d-Pl)

for tag, (Pf, Pc, Pl, fr, a, b) in [
        ('HUMIDE', (Phi_full_h, Phi_cste_h, Phi_lin_h, frey_h, a_h, b_h)),
        ('SECHE',  (Phi_full_s, Phi_cste_s, Phi_lin_s, frey_s, a_s, b_s))]:
    rf, rc, rl = rms_set(fr, Pf, Pc, Pl)
    print(tag.ljust(7) + ': RMS  full=' + format(rf, '.3f')
          + '  cste=' + format(rc, '.3f')
          + '  lin=' + format(rl, '.3f')
          + '  (x1e-3)  [Du~' + format(a, '+.2f') + format(b*1e3, '+.3f') + 'e-3 z]')
