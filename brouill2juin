# ============================================================
# §20 — Lien entre A et variables grandes échelles
#        large300 vs small300
# ============================================================

import numpy as np
import matplotlib.pyplot as plt
import xarray as xr
import gc
import os
from scipy.optimize import curve_fit

# ── Paramètres communs ────────────────────────────────────────
Rd      = 287.05
Rv      = 461.5
EPSILON = Rd / Rv
g       = 9.81
cp      = 1004.0
BLOC    = 2

sims = {
    'large300': '3D/MESONH_RCE_large300_3D_{var}.nc',
    'small300': '3D/MESONH_RCE_small300_3D_{var}.nc',
}

def path(sim, var):
    return sims[sim].format(var=var)

# ── Résultats §17/§18 déjà calculés (à renseigner) ───────────
# Si tu as déjà les fits, colle-les ici directement.
# Sinon le bloc §17/§18 ci-dessous les recalcule.
A_fits = {}   # sera rempli : {'large300': {'h': A, 's': A}, ...}

# ============================================================
# BLOC 1 — Recalcul rapide de A (région humide) si besoin
# ============================================================

def profil_cmt(z, A, zc, n):
    xi  = z / zc
    val = A * xi * (1.0 - xi)**n
    val = np.where(z > zc, 0.0, val)
    return val

def compute_A(sim):
    """Retourne A_h, A_s (kg/m²/s²) pour une simulation."""

    # ── dimensions ──
    _ds  = xr.open_dataset(path(sim, 'ua'))
    _da  = _ds['ua']
    dim_t, dim_z, dim_y, dim_x = _da.dims
    n_t  = _da.sizes[dim_t]
    n_z  = _da.sizes[dim_z]
    _ds.close(); del _ds, _da; gc.collect()

    # ── altitude ──
    p1d = f"1D/MESONH_RCE_{sim}_1D_ua_avg.nc"
    ds1 = xr.open_dataset(p1d)
    alt = ds1.altitude.values.copy()
    ds1.close()

    t_stat   = int(2 * n_t / 3)
    idx_stat = slice(t_stat, None)

    # ── rho0 ──
    rho0 = np.zeros(n_z)
    n_r  = 0
    ds_ta  = xr.open_dataset(path(sim, 'ta'))
    ds_pa  = xr.open_dataset(path(sim, 'pa'))
    ds_hus = xr.open_dataset(path(sim, 'hus'))
    for t0 in range(t_stat, n_t, BLOC):
        t1 = min(t0 + BLOC, n_t)
        sl = {dim_t: slice(t0, t1)}
        T  = ds_ta['ta'].isel(sl).values
        p  = ds_pa['pa'].isel(sl).values
        qv = ds_hus['hus'].isel(sl).values
        Tv = T * (1.0 + qv / EPSILON) / (1.0 + qv)
        rho0 += (p / (Rd * Tv)).mean(axis=(0, 2, 3)) * (t1 - t0)
        n_r  += (t1 - t0)
        del T, p, qv, Tv; gc.collect()
    ds_ta.close(); ds_pa.close(); ds_hus.close()
    rho0 /= n_r

    # ── masque humide/sec ──
    p2d = f"2D/MESONH_RCE_{sim}_2D_prw.nc"
    ds_prw = xr.open_dataset(p2d)
    prw    = ds_prw['prw'].load()
    ds_prw.close()
    prw_stat = prw.isel({dim_t: idx_stat}).mean(dim=dim_t).values
    seuil    = float(np.median(prw.values.ravel()))
    mh = prw_stat > seuil
    ms = ~mh
    del prw; gc.collect()

    # ── flux Reynolds ──
    idx_tropo = np.searchsorted(alt, 15000)
    flux_h    = np.zeros(n_z)
    flux_s    = np.zeros(n_z)
    ds_u = xr.open_dataset(path(sim, 'ua'))
    ds_w = xr.open_dataset(path(sim, 'wa'))
    for iz in range(n_z):
        acc_h = 0.0; acc_s = 0.0; n = 0
        for it in range(t_stat, n_t):
            u2 = ds_u['ua'].isel({dim_t: it, dim_z: iz}).values
            w2 = ds_w['wa'].isel({dim_t: it, dim_z: iz}).values
            up = u2 - u2.mean(); wp = w2 - w2.mean()
            acc_h += (up * wp)[mh].mean()
            acc_s += (up * wp)[ms].mean()
            n += 1
            del u2, w2, up, wp; gc.collect()
        flux_h[iz] = rho0[iz] * acc_h / n
        flux_s[iz] = rho0[iz] * acc_s / n
        if iz % 10 == 0:
            print(f'  [{sim}] flux iz={iz}/{n_z-1}')
    ds_u.close(); ds_w.close()

    # ── fit ──
    z_fit = alt[:idx_tropo].astype(float)
    p0    = [flux_h[:idx_tropo].min(), 12000.0, 1.5]
    popt_h, _ = curve_fit(profil_cmt, z_fit, flux_h[:idx_tropo], p0=p0, maxfev=20000)
    p0s   = [flux_s[:idx_tropo].min(), 12000.0, 1.5]
    popt_s, _ = curve_fit(profil_cmt, z_fit, flux_s[:idx_tropo], p0=p0s, maxfev=20000)

    print(f'[{sim}] A_h={popt_h[0]:.4e}  A_s={popt_s[0]:.4e}')
    return {
        'h': popt_h[0], 's': popt_s[0],
        'popt_h': popt_h, 'popt_s': popt_s,
        'alt': alt, 'rho0': rho0,
        'flux_h': flux_h, 'flux_s': flux_s,
        'mh': mh, 'ms': ms,
        'n_t': n_t, 't_stat': t_stat,
        'dim_t': dim_t, 'dim_z': dim_z,
    }

# Lance les deux (long — commenter si A déjà connu)
for sim in ['large300', 'small300']:
    print(f'\n=== {sim} ===')
    A_fits[sim] = compute_A(sim)



# ============================================================
# BLOC 2 — Flux de masse convectif M(z) — lien direct Romps
# ============================================================
# Définition : updraft nuageux = w > 1 m/s ET (clw+cli) > 1e-5 kg/kg
# M(z) = rho0(z) * <w>_updraft * sigma_updraft   [kg/m²/s]

def compute_M(sim, meta):
    """Profil M(z) = rho0 * w_updraft * fraction_updraft."""
    alt   = meta['alt']
    rho0  = meta['rho0']
    n_z   = len(alt)
    n_t   = meta['n_t']
    t_stat = meta['t_stat']
    dim_t = meta['dim_t']
    dim_z = meta['dim_z']

    M_sum    = np.zeros(n_z)
    n_frames = 0

    ds_w   = xr.open_dataset(path(sim, 'wa'))
    ds_clw = xr.open_dataset(path(sim, 'clw'))
    ds_cli = xr.open_dataset(path(sim, 'cli'))

    for it in range(t_stat, n_t):
        w   = ds_w['wa'].isel({dim_t: it}).values    # (z, y, x)
        clw = ds_clw['clw'].isel({dim_t: it}).values
        cli = ds_cli['cli'].isel({dim_t: it}).values
        mask_up = (w > 1.0) & ((clw + cli) > 1e-5)   # updraft nuageux
        n_pts   = w.shape[1] * w.shape[2]
        for iz in range(n_z):
            m2 = mask_up[iz]
            if m2.any():
                M_sum[iz] += rho0[iz] * w[iz][m2].mean() * m2.mean()
            # m2.mean() = fraction de surface = sigma
        n_frames += 1
        del w, clw, cli, mask_up; gc.collect()
        if it % 20 == 0:
            print(f'  [{sim}] M it={it}/{n_t-1}')

    ds_w.close(); ds_clw.close(); ds_cli.close()
    M = M_sum / n_frames
    print(f'[{sim}] M/rho0 surface ~ {(M/rho0)[0]*100:.2f} cm/s')
    return M

M = {}
for sim in ['large300', 'small300']:
    M[sim] = compute_M(sim, A_fits[sim])



# ============================================================
# BLOC 3 — CAPE
# ============================================================
# CAPE = intégrale sur la colonne de g*(Tv_parcel - Tv_env)/Tv_env dz
# On soulève une particule sèche depuis la surface (approx. simple).
# Pour une CAPE plus précise on peut utiliser les colonnes moyennes.

def compute_CAPE(sim, meta):
    """CAPE moyen sur le domaine, moyenné sur l'état stationnaire."""
    alt   = meta['alt']
    rho0  = meta['rho0']
    n_z   = len(alt)
    n_t   = meta['n_t']
    t_stat = meta['t_stat']
    dim_t = meta['dim_t']
    dim_z = meta['dim_z']

    CAPE_sum = 0.0
    n_frames = 0

    ds_ta  = xr.open_dataset(path(sim, 'ta'))
    ds_pa  = xr.open_dataset(path(sim, 'pa'))
    ds_hus = xr.open_dataset(path(sim, 'hus'))

    for it in range(t_stat, n_t, BLOC):
        t1 = min(it + BLOC, n_t)
        sl = {dim_t: slice(it, t1)}

        T  = ds_ta['ta'].isel(sl).values   # (t, z, y, x)
        p  = ds_pa['pa'].isel(sl).values
        qv = ds_hus['hus'].isel(sl).values

        # profils moyens domaine pour chaque t dans le bloc
        T_bar  = T.mean(axis=(2, 3))   # (t, z)
        p_bar  = p.mean(axis=(2, 3))
        qv_bar = qv.mean(axis=(2, 3))
        Tv_bar = T_bar * (1.0 + qv_bar / EPSILON) / (1.0 + qv_bar)

        for i_t in range(T_bar.shape[0]):
            Tv_env = Tv_bar[i_t]   # (z,)
            p_col  = p_bar[i_t]

            # Température virtuelle de la particule soulevée adiabatiquement
            # depuis la surface — ascension sèche jusqu'au LCL (approx.)
            # On utilise le gradient adiabatique sec Γd = g/cp
            Tv_parcel = np.zeros(n_z)
            Tv_parcel[0] = Tv_env[0]   # ancrage surface
            for iz in range(1, n_z):
                dz = alt[iz] - alt[iz - 1]
                Tv_parcel[iz] = Tv_parcel[iz - 1] - (g / cp) * dz

            # CAPE = somme des couches où la particule est plus chaude
            buoy = g * (Tv_parcel - Tv_env) / Tv_env
            cape_col = 0.0
            for iz in range(n_z - 1):
                if buoy[iz] > 0:
                    cape_col += buoy[iz] * (alt[iz + 1] - alt[iz])
            CAPE_sum += cape_col
            n_frames += 1

        del T, p, qv, T_bar, p_bar, qv_bar, Tv_bar; gc.collect()

    ds_ta.close(); ds_pa.close(); ds_hus.close()
    CAPE_mean = CAPE_sum / n_frames
    print(f'[{sim}] CAPE moyen = {CAPE_mean:.1f} J/kg')
    return CAPE_mean

CAPE = {}
for sim in ['large300', 'small300']:
    CAPE[sim] = compute_CAPE(sim, A_fits[sim])



# ============================================================
# BLOC 4 — Cisaillement de vent vertical
# ============================================================
# Delta_U = max(ubar) - min(ubar) sur 0–15 km (troposphère)
# En RCE le vent moyen est quasi nul, donc Delta_U mesure
# la variabilité verticale résiduelle.

def compute_shear(sim, meta):
    alt    = meta['alt']
    n_z    = len(alt)
    n_t    = meta['n_t']
    t_stat = meta['t_stat']
    dim_t  = meta['dim_t']
    dim_z  = meta['dim_z']

    idx_tropo = np.searchsorted(alt, 15000)
    ubar = np.zeros(n_z)
    n_frames = 0

    ds_u = xr.open_dataset(path(sim, 'ua'))
    for it in range(t_stat, n_t):
        u2 = ds_u['ua'].isel({dim_t: it}).values   # (z, y, x)
        ubar += u2.mean(axis=(1, 2))
        n_frames += 1
        del u2; gc.collect()
    ds_u.close()
    ubar /= n_frames

    ubar_tropo = ubar[:idx_tropo]
    shear = float(ubar_tropo.max() - ubar_tropo.min())
    print(f'[{sim}] cisaillement Delta_U = {shear:.3f} m/s')
    return shear, ubar

shear = {}
ubar_profiles = {}
for sim in ['large300', 'small300']:
    shear[sim], ubar_profiles[sim] = compute_shear(sim, A_fits[sim])



# ============================================================
# BLOC 5 — Synthèse : tableau et figures
# ============================================================

# ── Valeur scalaire de M : moyenne sur 2–12 km (zone convective active)
def M_scalar(sim, meta):
    alt  = meta['alt']
    rho0 = meta['rho0']
    iz_lo = np.searchsorted(alt, 2000)
    iz_hi = np.searchsorted(alt, 12000)
    M_prof = M[sim][iz_lo:iz_hi]
    r_prof = rho0[iz_lo:iz_hi]
    # M/rho moyenné = vitesse convective représentative
    return float(np.mean(M_prof / r_prof))   # m/s

M_scal = {sim: M_scalar(sim, A_fits[sim]) for sim in ['large300', 'small300']}

