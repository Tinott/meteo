from scipy.stats import gaussian_kde

fig, axes = plt.subplots(1, 2, figsize=(16, 7))

# ── couleurs et styles ──────────────────────────────────────────────────
style = {
    'HUMIDE α': dict(arr=alpha_zt_h, color='royalblue',   ls='-',  lw=2.0),
    'HUMIDE β': dict(arr=beta_zt_h,  color='royalblue',   ls='--', lw=2.0),
    'SÈCHE α':  dict(arr=alpha_zt_s, color='saddlebrown', ls='-',  lw=2.0),
    'SÈCHE β':  dict(arr=beta_zt_s,  color='saddlebrown', ls='--', lw=2.0),
}

# ════════════════════════════════════════════════════════════════════════
# GAUCHE — KDE de toutes les valeurs (tous z, tous t confondus)
# ════════════════════════════════════════════════════════════════════════
ax = axes[0]
for label, s in style.items():
    vals = s['arr'].ravel()
    vals = vals[np.isfinite(vals)]
    p1, p99 = np.percentile(vals, [1, 99])
    xs  = np.linspace(p1, p99, 600)
    kde = gaussian_kde(vals, bw_method=0.12)
    ax.plot(xs, kde(xs), color=s['color'], ls=s['ls'], lw=s['lw'], label=label)

ax.axvline(0, color='grey', lw=1, alpha=0.5)
ax.set_xlabel('valeur du paramètre')
ax.set_ylabel('densité')
ax.set_title('Distribution globale — tous z, tous t', fontweight='bold')
ax.legend(fontsize=9)
ax.grid(True, alpha=0.3)

# ════════════════════════════════════════════════════════════════════════
# DROITE — histogrammes à 3 niveaux clés, bien séparés par région/param
# ════════════════════════════════════════════════════════════════════════
# 3 niveaux : base convective, max du flux Reynolds (~zc/(1+n)), sommet
z_key    = [2000, int(zc_h / (1 + n_h)), 10000]   # adapté à ton fit §17
labels_z = [f'{z//1000} km' for z in z_key]
colors_z = ['#e41a1c', '#ff7f00', '#4dac26']       # rouge / orange / vert

ax = axes[1]
BW = 0.15

for label, s in style.items():
    iz_keys = [np.argmin(np.abs(z_fit_ab - zt)) for zt in z_key]
    for iz_t, lbl_z, cz in zip(iz_keys, labels_z, colors_z):
        data = s['arr'][iz_t, :]
        data = data[np.isfinite(data)]
        if data.size < 5:
            continue
        p1, p99 = np.percentile(data, [1, 99])
        xs  = np.linspace(p1, p99, 400)
        kde = gaussian_kde(data, bw_method=BW)
        # label uniquement sur la première combinaison pour éviter la légende en double
        lbl = f'{lbl_z}' if label == 'HUMIDE α' else None
        ax.plot(xs, kde(xs),
                color=cz, ls=s['ls'], lw=s['lw'],
                alpha=0.85, label=lbl)

# légendes manuelles : couleur = altitude, style = param/région
from matplotlib.lines import Line2D
leg_z = [Line2D([0],[0], color=c, lw=2, label=l)
         for c, l in zip(colors_z, labels_z)]
leg_s = [Line2D([0],[0], color='grey', ls='-',  lw=2, label='α  (humide épais / sèche fin)'),
         Line2D([0],[0], color='grey', ls='--', lw=2, label='β  (humide épais / sèche fin)')]
ax.legend(handles=leg_z + leg_s, fontsize=8, ncol=1)

ax.axvline(0, color='grey', lw=1, alpha=0.5)
ax.set_xlabel('valeur du paramètre')
ax.set_ylabel('densité')
ax.set_title('3 niveaux clés — KDE par (région, param, altitude)', fontweight='bold')
ax.grid(True, alpha=0.3)

plt.suptitle(r'§18v — Distributions de $\alpha(z,t)$ et $\beta(z,t)$',
             fontsize=13, fontweight='bold')
