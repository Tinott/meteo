# ============================================================
#  Test direct du WTG : M/rho0  vs  w_sec,rad = Qrad/dtheta_dz
#  (a executer separement dans chaque notebook/simu — Meso-NH, UCLA, SCALE)
#  Compare la "vitesse verticale effective" du flux de masse convectif
#  a la subsidence radiative diagnostique, niveau par niveau, sans passer par dudt.
# ============================================================

# --- vitesse effective issue du flux de masse convectif ---
w_M_zt = M_zt_lisse / rho0[:, None]              # (n_z, n_stat), m/s

# --- vitesse de subsidence radiative diagnostique (deja utilisee pour dudt_pred_rad) ---
w_sec_rad_zt = (theta_zt / T_zt) * tntr_zt / dthetadz_zt   # (n_z, n_stat), m/s

# --- profils composites (median temporel), avec IQR pour voir la dispersion ---
def profil_composite(champ_zt, mask):
    med = np.nanmedian(champ_zt[mask], axis=1)
    q25 = np.nanpercentile(champ_zt[mask], 25, axis=1)
    q75 = np.nanpercentile(champ_zt[mask], 75, axis=1)
    return med, q25, q75

med_M, q25_M, q75_M = profil_composite(w_M_zt, m212)
med_R, q25_R, q75_R = profil_composite(w_sec_rad_zt, m212)

fig, axes = plt.subplots(1, 2, figsize=(11, 7), sharey=True)

# --- panneau gauche : profils superposes ---
ax = axes[0]
ax.plot(med_M*100, zkm[m212], 'o-', ms=3, color='tab:blue', label=r'$M/\rho_0$ (bulk-plume)')
ax.fill_betweenx(zkm[m212], q25_M*100, q75_M*100, color='tab:blue', alpha=.15)
ax.plot(med_R*100, zkm[m212], 'o-', ms=3, color='tab:red', label=r'$w_{sec,rad}=\dot Q_{rad}/\partial_z\bar\theta$')
ax.fill_betweenx(zkm[m212], q25_R*100, q75_R*100, color='tab:red', alpha=.15)
ax.axvline(0, color='k', lw=.5)
ax.axhspan(8, 12, color='grey', alpha=.08)  # bande 8-12km surlignee
ax.set_xlabel('vitesse verticale effective (cm/s)')
ax.set_ylabel('z (km)')
ax.legend(fontsize=9)
ax.set_title('Profils composites (mediane + IQR)')

# --- panneau droit : ecart relatif, pour reperer ou le WTG casse ---
ax = axes[1]
ecart = med_M - med_R
ax.plot(ecart*100, zkm[m212], 'o-', ms=3, color='k')
ax.axvline(0, color='k', lw=.5)
ax.axhspan(8, 12, color='grey', alpha=.08)
ax.set_xlabel(r'$M/\rho_0 - w_{sec,rad}$ (cm/s)')
ax.set_title('Ecart bulk-plume vs radiatif\n(= trace attendue du detrainement)')

plt.suptitle('Test du quasi-equilibre WTG : M/rho0 vs w_sec,rad, niveau par niveau', fontweight='bold')
plt.tight_layout()
plt.show()

# ============================================================
#  Complement : correlation instantanee (z,t) entre les deux vitesses,
#  niveau par niveau — si le WTG tient, la correlation doit rester
#  proche de 1 partout, et chuter specifiquement en 8-12km si le
#  detrainement y introduit un vrai decouplage local (cas Meso-NH attendu)
# ============================================================
corr_wtg = np.full(n_z, np.nan)
for iz in range(n_z):
    if not m212[iz]: continue
    a, b = w_M_zt[iz, :], w_sec_rad_zt[iz, :]
    ok = np.isfinite(a) & np.isfinite(b)
    if ok.sum() < 20 or np.std(a[ok]) < 1e-15 or np.std(b[ok]) < 1e-15: continue
    corr_wtg[iz] = np.corrcoef(a[ok], b[ok])[0, 1]

fig, ax = plt.subplots(figsize=(5, 7))
ax.plot(corr_wtg[m212], zkm[m212], 'o-', ms=3)
ax.axvline(0, color='k', lw=.5)
ax.axhspan(8, 12, color='grey', alpha=.08)
ax.set_xlabel(r'corr($M/\rho_0$, $w_{sec,rad}$)')
ax.set_ylabel('z (km)')
ax.set_title('Coherence temporelle WTG, niveau par niveau')
plt.tight_layout()
plt.show()
