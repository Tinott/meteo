data_cli = xr.open_dataset("3D/MESONH_RCE_small300_3D_cli.nc")  # Glace nuageuse

# Extraction des variables (on prend le premier pas de temps t=0 pour l'exemple)
u = data_ua['UA'].isel(time=0)
w = data_wa['WA'].isel(time=0)
clw = data_clw['CLW'].isel(time=0)
cli = data_cli['CLI'].isel(time=0)

# Récupération du nom des axes (ex: 'level', 'y', 'x')
nom_axe_z = u.dims[0]  # Souvent le premier axe après 'time'
nom_axe_y = u.dims[1]
