
# ======================================================================
#  4b — ÉCHELLES DOMINANTES DES TOURBILLONS (version corrigée)
#  ----------------------------------------------------------------------
#  λx : CWT Morlet 1D en x (ψ' OSCILLE en x -> vraie longueur d'onde).
#       Spectre variance-preserving sommé sur tous les niveaux.
#  λz : ψ' ne fait qu'UNE demi-arche verticale (pas d'oscillation) -> pas
#       de "longueur d'onde" spectrale. On mesure la HAUTEUR de la cellule
#       (épaisseur FWHM de l'amplitude), × 2 = longueur d'onde du demi-mode.
#  Réutilise : psi_a, psi2d, x, z_reg, n_x, nz_D, dxl, dzl.
# ======================================================================
import numpy as np
import matplotlib.pyplot as plt

W0_MORLET = 6.0
fourier_factor = (4*np.pi) / (W0_MORLET + np.sqrt(2 + W0_MORLET**2))

# ----------------------------------------------------------------------
#  λx — CWT Morlet 1D en x, par niveau, spectre variance-preserving
#  PLAFOND = Lx (et non Lx/2) : une cellule peut être aussi large que la
#  demi-boîte, sa longueur d'onde peut donc approcher Lx. Sinon pic au bord.
# ----------------------------------------------------------------------
NSX = 40
Lx_dom   = n_x * dxl
scales_x = np.geomspace(2*dxl, Lx_dom/fourier_factor, NSX)   # -> λx max = Lx
lamx_km  = scales_x * fourier_factor / 1000.0

kx = np.fft.fftfreq(n_x, d=dxl) * 2*np.pi
k0 = W0_MORLET

def cwt_x(sig):
    """|W|²(s,x) de la CWT Morlet 1D d'un profil x périodique."""
    S = np.fft.fft(sig)
    out = np.empty((NSX, n_x))
    for i, s in enumerate(scales_x):
        sk = s * kx
        psih = (np.pi**-0.25) * np.sqrt(2*np.pi*s/dxl) * (sk > 0) * np.exp(-0.5*(sk - k0)**2)
        out[i] = np.abs(np.fft.ifft(S * psih))**2
    return out

# spectre x : somme sur x (variance-preserving /s) ET sur tous les niveaux
Ex = np.zeros(NSX)
for j in range(nz_D):
    Ex += cwt_x(psi_a[j]).sum(axis=1) / scales_x
bx = int(np.argmax(Ex))
lam_x_dom = lamx_km[bx]
if bx in (0, NSX-1):
    print("  ⚠ pic λx sur un bord -> élargis scales_x (cellule ~ taille domaine)")

# ----------------------------------------------------------------------
#  λz — HAUTEUR de la cellule (la structure ne fait qu'une demi-arche)
#  amplitude par niveau = écart-type en x de ψ' ; épaisseur à mi-hauteur ;
#  ×2 car une demi-longueur d'onde occupe cette épaisseur.
# ----------------------------------------------------------------------
amp_z = psi_a.std(axis=1)
half  = amp_z.max() / 2.0
above = np.where(amp_z >= half)[0]
thick = z_reg[above[-1]] - z_reg[above[0]]      # FWHM en z [m]
lam_z_dom = 2 * thick / 1000.0                  # km
z_center  = 0.5*(z_reg[above[-1]] + z_reg[above[0]]) / 1000.0

if above[0] == 0 or above[-1] == nz_D-1:
    print("  ⚠ cellule atteint un bord vertical -> λz borné par le domaine "
          f"({z_reg[-1]/1000:.0f} km), valeur sous-estimée")

print(f"λx dominant ≈ {lam_x_dom:.0f} km")
print(f"λz dominant ≈ {lam_z_dom:.1f} km  (hauteur cellule, centrée z≈{z_center:.1f} km)")

# ======================================================================
#  FIGURE — (a) spectre λx   (b) amplitude verticale   (c) ψ' + repères
# ======================================================================
fig = plt.figure(figsize=(15, 5))
gs = fig.add_gridspec(1, 3, width_ratios=[1.2, 0.7, 1.6], wspace=0.3)

# (a) spectre en x
axa = fig.add_subplot(gs[0])
axa.semilogx(lamx_km, Ex, 'k', lw=1.6)
axa.axvline(lam_x_dom, color='crimson', ls='--', lw=1.3)
axa.text(lam_x_dom, Ex.max()*0.92, f'  λx ≈ {lam_x_dom:.0f} km',
         color='crimson', fontsize=10, va='top')
axa.set_xlabel(r'$\lambda_x$ [km]'); axa.set_ylabel('énergie / échelle (var-pres.)')
axa.set_title('(a) Spectre horizontal de ψ′')

# (b) amplitude verticale + FWHM
axb = fig.add_subplot(gs[1])
axb.plot(amp_z, z_reg/1000, 'k', lw=1.6)
axb.axvline(half, color='grey', ls=':', lw=1)
axb.fill_betweenx(z_reg[above]/1000, 0, amp_z[above], color='crimson', alpha=0.2)
axb.axhline(z_reg[above[0]]/1000,  color='crimson', ls='--', lw=0.8)
axb.axhline(z_reg[above[-1]]/1000, color='crimson', ls='--', lw=0.8)
axb.set_xlabel(r'$\langle|\psi^{\prime}|\rangle_x$'); axb.set_ylabel('z [km]')
axb.set_title(f'(b) Hauteur cellule\nλz ≈ {lam_z_dom:.1f} km')

# (c) champ ψ' + lignes de courant
axc = fig.add_subplot(gs[2])
mC = np.percentile(np.abs(psi_a), 99)
pc = axc.pcolormesh(x/1000, z_reg/1000, psi_a, shading='auto',
                    cmap='RdBu_r', vmin=-mC, vmax=mC)
axc.contour(x/1000, z_reg/1000, psi2d, levels=20, colors='grey',
            linewidths=0.4, alpha=0.6)
axc.set_xlabel('x [km]'); axc.set_ylabel('z [km]')
axc.set_title("(c) ψ′ + lignes de courant")
fig.colorbar(pc, ax=axc, label="ψ′", pad=0.01)

plt.tight_layout()
plt.show()
