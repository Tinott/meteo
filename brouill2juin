# ---- normalise idx_stat en tableau d'indices, qu'il soit slice/liste/array ----
if isinstance(idx_stat, slice):
    _start = idx_stat.start if idx_stat.start is not None else 0
    _step  = idx_stat.step if idx_stat.step is not None else 1
    if idx_stat.stop is None:
        raise ValueError(
            "idx_stat est un slice sans 'stop' defini (ex: slice(10, None)) -- "
            "impossible de le convertir automatiquement en tableau. "
            "Remplace-le par slice(10, 110) ou par un tableau explicite avant de continuer."
        )
    idx_stat = np.arange(_start, idx_stat.stop, _step)
else:
    idx_stat = np.asarray(idx_stat)

print(f"idx_stat normalise en tableau : {idx_stat.size} indices, de {idx_stat.min()} a {idx_stat.max()}")
