# ============================================================================
# S35 — Dependance en longueur d'onde (Romps 2014, eqs. 9-10)
#   tau(lambda) = (rho/M) (eps^2+m^2)/(eps m^2)   [temps d'amortissement]
#   w(lambda)   = -(M/rho) m^2/(eps^2+m^2)        [vitesse de descente]
#   avec m = 2pi/lambda.  Puis decomposition de Fourier verticale du vent moyen
#   pour verifier "petites lambda -> amorties plus vite".
# ============================================================================

sl   = slice(iz_lo, iz_top+1)
zf   = alt[sl].astype(float)
SDAY = 86400.0   # s -> jour

# ---- 1) parametres effectifs moyens sur la couche convective (humide) ----
M_over_rho = np.nanmean((Mc_up_h / rho0)[sl])        # m/s  (≈ 1 cm/s attendu)
# eps : on reprend celui de S30 s'il existe, sinon valeur de reference vent 1.5/km
try:
    eps_eff = abs(eps_glob_h)                         # s'il a ete calcule (m^-1)
    if not np.isfinite(eps_eff) or eps_eff == 0:
        raise ValueError
except (NameError, ValueError):
    eps_eff = 1.5e-3                                  # m^-1 (ref Romps vent)
print(f'M/rho effectif (humide, couche conv.) = {M_over_rho*100:.2f} cm/s')
print(f'eps effectif utilise                  = {eps_eff*1000:.2f} km-1')

# ---- 2) tau(lambda) et w(lambda) analytiques (eqs 9-10) ------------------
lam  = np.linspace(2000., 12000., 200)               # 2 - 12 km
m    = 2*np.pi/lam
tau  = (1.0/(M_over_rho)) * (eps_eff**2 + m**2)/(eps_eff*m**2)   # s
wdes = (M_over_rho)       *  m**2/(eps_eff**2 + m**2)            # m/s (|w|)
tau_day = tau/SDAY

# repere : limites petites/grandes longueurs d'onde
tau_small = 1.0/(M_over_rho*eps_eff)/SDAY             # lambda << 2pi/eps : tau ~ rho/(M eps)
print(f'tau (petite lambda, ~rho/M eps) = {tau_small:.2f} jour  (ref Romps 1 jour)')
print(f'tau a lambda=2 km  = {tau_day[0]:.2f} j   |  lambda=10 km = '
      f'{np.interp(10000,lam,tau_day):.2f} j   (fourchette attendue 1-10 j)')

# ---- 3) decomposition de Fourier verticale du vent moyen (humide) --------
#   On projette ubar(z) sur sin(m z) pour mesurer l'energie par longueur d'onde.
u_prof = ubar_h_prof[sl] - np.nanmean(ubar_h_prof[sl])   # on enleve la moyenne
z0     = zf - zf[0]
Lz     = z0[-1] - z0[0]
lam_k  = np.array([2*Lz/k for k in range(1, 9)])         # modes sin: lambda=2Lz/k
amp_k  = np.array([
    2.0/len(z0) * np.nansum(u_prof*np.sin(np.pi*k*z0/Lz)) for k in range(1, 9)
])
power_k = amp_k**2
# temps d'amortissement theorique de chaque mode present dans le vent
m_k   = 2*np.pi/lam_k
tau_k = (1.0/M_over_rho)*(eps_eff**2 + m_k**2)/(eps_eff*m_k**2)/SDAY

# ---- 4) figures ----------------------------------------------------------
fig, axes = plt.subplots(1, 3, figsize=(16, 6))

ax = axes[0]
ax.plot(lam/1000, tau_day, color='royalblue', lw=2.5)
ax.axhspan(1, 10, color='green', alpha=0.12, label='1-10 j (Matsuno-Gill)')
ax.set_xlabel('longueur d\'onde lambda (km)')
ax.set_ylabel('tau (jours)')
ax.set_title('Temps d\'amortissement tau(lambda)', fontweight='bold')
ax.legend(fontsize=9); ax.grid(alpha=0.3)

ax = axes[1]
ax.plot(lam/1000, wdes*100, color='crimson', lw=2.5)
ax.axhline(M_over_rho*100, color='grey', ls='--', alpha=0.7,
           label=f'M/rho = {M_over_rho*100:.1f} cm/s (limite)')
ax.set_xlabel('longueur d\'onde lambda (km)')
ax.set_ylabel('|w| (cm/s)')
ax.set_title('Vitesse de descente |w|(lambda)', fontweight='bold')
ax.legend(fontsize=9); ax.grid(alpha=0.3)

ax = axes[2]
ax.bar(lam_k/1000, power_k/np.nansum(power_k), width=0.4,
       color='steelblue', alpha=0.8, label='énergie du vent')
ax2 = ax.twinx()
ax2.plot(lam_k/1000, tau_k, 'o-', color='darkorange', lw=2, label='tau du mode')
ax2.set_ylabel('tau (jours)', color='darkorange')
ax.set_xlabel('longueur d\'onde lambda (km)')
ax.set_ylabel('énergie spectrale (norm.)')
ax.set_title('Spectre du vent vs tau\n(modes courts = amortis plus vite)', fontweight='bold')
ax.legend(fontsize=8, loc='upper left'); ax.grid(alpha=0.3)

plt.suptitle('S35 — Dépendance en longueur d\'onde (Romps 2014) : tau, w, spectre vertical du vent',
             fontsize=12, fontweight='bold')
plt.tight_layout(); plt.show()

# ---- 5) bilan chiffre ----------------------------------------------------
print()
print('-- Modes verticaux presents dans ubar (humide) --')
for k in range(len(lam_k)):
    print(f'  lambda={lam_k[k]/1000:5.2f} km : energie={power_k[k]/np.nansum(power_k)*100:5.1f}%'
          f'  tau_theo={tau_k[k]:5.2f} j')
print()
print('Lecture : les modes courts (lambda faible) ont tau plus petit')
print('-> amortis plus vite par la convection, conforme a Romps (eqs 9-10).')
