# ======================================================================
#  Spectre du T2 calculé ci-dessus : à quelle échelle en x vit la covariance within
#  On reprend EXACTEMENT le T2[k] du code précédent et on le décompose en λ.
#    T2_k/sigma_k = <u'' w''>_x = somme_λ Co(λ)        (Parseval)
# ======================================================================
CAT = 'up'                        # catégorie dont on spectralise le T2

nx  = x.size
dx  = float(x[1] - x[0])
kx  = np.fft.rfftfreq(nx, d=dx) * 2*np.pi
lam_km = (2*np.pi / np.maximum(kx, 1e-12)) / 1000

Co_T2   = np.zeros((nz_D, kx.size))   # co-spectre par niveau
T2_chk  = np.zeros(nz_D)              # T2 reconstruit (contrôle = doit == T2[CAT])
upp_all = np.zeros((nz_D, nx))        # u''(x) pour les ondelettes
wpp_all = np.zeros((nz_D, nx))

ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for j, iz in enumerate(iz_lst):
    u_yx = ds_u['ua'].isel({dim_t: IT_DECOMP, dim_z: iz}).values
    w_yx = ds_w['wa'].isel({dim_t: IT_DECOMP, dim_z: iz}).values
    uy = u_yx.mean(axis=0); wy = w_yx.mean(axis=0)

    ws = max(W0_MIN, C_DECOMP * wy.std())
    masks = {'up': wy > ws, 'dn': wy < -ws, 'env': np.abs(wy) <= ws}
    m = masks[CAT]

    # u'', w'' définis sur TOUT x (0 hors catégorie) -> <u''w''>_x == T2[CAT]/... 
    upp = np.zeros(nx); wpp = np.zeros(nx)
    if m.any():
        upp[m] = uy[m] - uy[m].mean()
        wpp[m] = wy[m] - wy[m].mean()
    upp_all[j] = upp; wpp_all[j] = wpp

    T2_chk[j] = (upp * wpp).mean()        # == T2[CAT][j] de ton code (à sigma près déjà inclus)

    Fu = np.fft.rfft(upp); Fw = np.fft.rfft(wpp)
    co = np.real(Fu * np.conj(Fw)) / nx**2
    co[1:] *= 2
    Co_T2[j] = co
    del u_yx, w_yx; gc.collect()
ds_u.close(); ds_w.close(); del ds_u, ds_w; gc.collect()

# --- contrôle 1 : Parseval (somme du spectre == T2) ---
err_p = np.abs(Co_T2.sum(axis=1) - T2_chk).max()
print(f"[Parseval]  max|sum_λ Co - T2| = {err_p:.2e}  (doit etre ~1e-18)")
# --- contrôle 2 : cohérence avec le T2 du code précédent ---
err_c = np.abs(T2_chk - T2[CAT]).max()
print(f"[cohérence] max|T2_spectre - T2[{CAT}]| = {err_c:.2e}  (doit etre ~1e-18)")

k_max = int(np.argmax(np.abs(T2_chk)))
print(f"niveau |T2_{CAT}| max : z = {z_D[k_max]/1000:.1f} km")

# --- ondelettes (Morlet maison) au niveau k_max ---
def cwt_morlet(sig, scales, dx, w0=6.0):
    n = sig.size; sig_hat = np.fft.fft(sig)
    omega = 2*np.pi * np.fft.fftfreq(n, d=dx)
    out = np.zeros((scales.size, n), dtype=complex)
    for i, a in enumerate(scales):
        psi_hat = (np.pi**-0.25)*np.sqrt(2.0)*np.exp(-0.5*(a*omega-w0)**2)*(omega>0)
        out[i] = np.fft.ifft(sig_hat * psi_hat * np.sqrt(a))
    lam = (4*np.pi*scales)/(w0+np.sqrt(2+w0**2))
    return out, lam

scales = np.geomspace(2, nx//2, 60) * dx
cwt_u, lam_w = cwt_morlet(upp_all[k_max], scales/dx, dx)
cwt_w, _     = cwt_morlet(wpp_all[k_max], scales/dx, dx)
co_xz = np.real(cwt_u * np.conj(cwt_w)); lam_w_km = lam_w/1000

# ======================================================================
#  FIGURE : (a) co-spectre T2(z,λ)   (b) co-scalogramme au z de |T2| max
# ======================================================================
fig, ax = plt.subplots(1, 2, figsize=(15, 5.5))

A  = kx[None,1:] * Co_T2[:,1:]
mA = np.percentile(np.abs(A), 99) + 1e-30
pc0 = ax[0].pcolormesh(lam_km[1:], z_D/1000, A, shading='auto',
                       norm=TwoSlopeNorm(vcenter=0, vmin=-mA, vmax=mA), cmap='RdBu_r')
ax[0].set_xscale('log'); ax[0].invert_xaxis()
ax[0].set_xlabel(r'$\lambda$ [km]'); ax[0].set_ylabel('z [km]')
ax[0].set_title(fr'(a) Co-spectre de $T_2^{{{CAT}}}$ — où vit la covariance')
fig.colorbar(pc0, ax=ax[0], label=r'$k\,\mathrm{Co}$', pad=0.01)

mB = np.percentile(np.abs(co_xz), 99) + 1e-30
pc1 = ax[1].pcolormesh(x/1000, lam_w_km, co_xz, shading='auto',
                       norm=TwoSlopeNorm(vcenter=0, vmin=-mB, vmax=mB), cmap='RdBu_r')
ax[1].set_yscale('log')
ax[1].set_xlabel('x [km]'); ax[1].set_ylabel(r'échelle $\lambda$ [km]')
ax[1].set_title(f"(b) Co-scalogramme — z = {z_D[k_max]/1000:.1f} km")
fig.colorbar(pc1, ax=ax[1], label="flux local", pad=0.01)

plt.tight_layout(); plt.show()
