# ============================================================
# BASES FIXES DE RELIEF (sans pywt) pour decomposer psi'
#   Bases typiques de surface, aucune apprise sur les donnees :
#     - DCT 2D        (reliefs bornes, JPEG)
#     - Fourier 2D    (x periodique)
#     - Ondelettes 2D (Haar, multi-echelle, codee a la main en numpy)
#     - Legendre 2D   (polynomiale, surfaces lisses)
#   Pour chaque base : projection -> troncature -> derivation
#   -> u',w' -> flux, compare au flux VRAI.
# ============================================================
from scipy.fft import dctn, idctn, fftn, ifftn
from numpy.polynomial import legendre as Lg

# --- passage relief -> flux ---
def flux_from_psi(pa):
    up = np.gradient(pa, alt, axis=1) / rho0[None, :, None]
    wp = -np.gradient(pa, x,   axis=2) / rho0[None, :, None]
    up = up - up.mean(axis=2, keepdims=True)
    wp = wp - wp.mean(axis=2, keepdims=True)
    return (rho0[None, :] * (up * wp).mean(axis=2)).mean(axis=0)

flux_psi_ceiling = flux_from_psi(psi_ano)
nse_ceiling = nse(flux_true_profile, flux_psi_ceiling)
print(f'[borne haute] flux via psi COMPLET : NSE = {nse_ceiling:+.3f}')
print('  -> aucune base ne peut depasser ce plafond (psi moyenne-y ne porte que T1)\n')

def keep_frac(flat, frac):
    k = max(1, int(frac * flat.size))
    idx = np.argpartition(np.abs(flat), -k)[-k:]
    out = np.zeros_like(flat); out[idx] = flat[idx]
    return out

# --- ondelette Haar 2D separable (numpy pur) ---
def _haar_fwd_1d(v):
    n = len(v) // 2
    a = (v[0:2*n:2] + v[1:2*n:2]) / np.sqrt(2)
    d = (v[0:2*n:2] - v[1:2*n:2]) / np.sqrt(2)
    return a, d
def _haar_inv_1d(a, d):
    n = len(a); v = np.zeros(2*n)
    v[0:2*n:2] = (a + d) / np.sqrt(2); v[1:2*n:2] = (a - d) / np.sqrt(2)
    return v
def haar2d_fwd(img, levels):
    out = img.astype(float).copy(); h, w = out.shape; ch, cw = h, w
    for _ in range(levels):
        if ch < 2 or cw < 2: break
        for i in range(ch):
            a, d = _haar_fwd_1d(out[i, :cw]); out[i, :cw//2] = a; out[i, cw//2:cw] = d
        for j in range(cw):
            a, d = _haar_fwd_1d(out[:ch, j]); out[:ch//2, j] = a; out[ch//2:ch, j] = d
        ch //= 2; cw //= 2
    return out
def haar2d_inv(coef, levels, shape):
    out = coef.astype(float).copy(); h, w = shape
    sizes = []; ch, cw = h, w
    for _ in range(levels):
        if ch < 2 or cw < 2: break
        sizes.append((ch, cw)); ch //= 2; cw //= 2
    for (ch, cw) in reversed(sizes):
        for j in range(cw):
            out[:ch, j] = _haar_inv_1d(out[:ch//2, j], out[ch//2:ch, j])
        for i in range(ch):
            out[i, :cw] = _haar_inv_1d(out[i, :cw//2], out[i, cw//2:cw])
    return out

# --- les 4 reconstructions ---
def recon_dct(pa, frac):
    out = np.empty_like(pa)
    for t in range(pa.shape[0]):
        C = dctn(pa[t], norm='ortho')
        out[t] = idctn(keep_frac(C.ravel(), frac).reshape(C.shape), norm='ortho')
    return out

def recon_fft(pa, frac):
    out = np.empty_like(pa)
    for t in range(pa.shape[0]):
        C = fftn(pa[t])
        out[t] = np.real(ifftn(keep_frac(C.ravel(), frac).reshape(C.shape)))
    return out

def recon_haar(pa, frac, levels=3):
    out = np.empty_like(pa)
    for t in range(pa.shape[0]):
        C = haar2d_fwd(pa[t], levels)
        Cm = keep_frac(C.ravel(), frac).reshape(C.shape)
        out[t] = haar2d_inv(Cm, levels, pa[t].shape)
    return out

def legendre_basis(n, deg):
    xs = np.linspace(-1, 1, n); B = np.zeros((n, deg))
    for d in range(deg):
        c = np.zeros(deg); c[d] = 1; B[:, d] = Lg.legval(xs, c)
    return B / (np.linalg.norm(B, axis=0, keepdims=True) + 1e-30)
def recon_legendre(pa, frac):
    nz, nx = pa.shape[1], pa.shape[2]
    deg = max(2, int(np.sqrt(frac * nz * nx)))
    Bz = legendre_basis(nz, min(deg, nz)); Bx = legendre_basis(nx, min(deg, nx))
    out = np.empty_like(pa)
    for t in range(pa.shape[0]):
        out[t] = Bz @ (Bz.T @ pa[t] @ Bx) @ Bx.T
    return out

# --- balayage NSE(flux) vs fraction, pour chaque base ---
fracs = np.array([0.02, 0.05, 0.1, 0.2, 0.3, 0.5])
bases = {'DCT': recon_dct, 'Fourier': recon_fft,
         'Haar': recon_haar, 'Legendre': recon_legendre}
results = {name: [] for name in bases}
for fr in fracs:
    for name, fn in bases.items():
        results[name].append(nse(flux_true_profile, flux_from_psi(fn(psi_ano, fr))))
for name in bases:
    results[name] = np.array(results[name])

