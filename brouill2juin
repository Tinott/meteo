# =============================================================================
# Moyenne horizontale à chaque pas de temps
UA_moy_horiz = UA.mean(dim=[nom_axe_y, nom_axe_x])
WA_moy_horiz = WA.mean(dim=[nom_axe_y, nom_axe_x])

# Anomalies (Reynolds decomposition)
u_prime = UA - UA_moy_horiz
w_prime = WA - WA_moy_horiz

# =============================================================================
# 3. MASQUAGE REEL DES CORES CONVECTIFS (Appliqué en 4D avant moyenne)
# =============================================================================
# Seuil physique réaliste pour Meso-NH : un courant ascendant solide (> 0.5 m/s) dans un nuage
seuil_w = 0.5 
seuil_nuage = 1e-5

# Le masque est un tableau de Booléens (Time, Altitude, Y, X)
masque_core = (WA > seuil_w) & (EAU_NUAGE > seuil_nuage)

# =============================================================================
# 4. EXTRACTION DES PROPRIETES DU COEUR ET DE L'ENVIRONNEMENT
# =============================================================================
# Fraction surfacique occupée par les cores (moyenne sur X et Y, varie selon le temps et z)
alpha = masque_core.mean(dim=[nom_axe_y, nom_axe_x])

# Vitesse du vent zonal (U) dans le nuage et dans l'environnement
u_updraft = UA.where(masque_core).mean(dim=[nom_axe_y, nom_axe_x])
u_environ = UA.where(~masque_core).mean(dim=[nom_axe_y, nom_axe_x])

# Vitesse verticale réelle dans l'updraft
w_updraft = WA.where(masque_core).mean(dim=[nom_axe_y, nom_axe_x])

# Remplacement des valeurs NaN (si aucun nuage à une altitude donnée) par 0
u_updraft = u_updraft.fillna(0)
u_environ = u_environ.fillna(UA_moy_horiz)
w_updraft = w_updraft.fillna(0)

# =============================================================================
# 5. INTEGRATION TEMPORELLE (Moyenne sur l'axe 'time')
# =============================================================================
alpha_moyen = alpha.mean(dim=nom_axe_t)
u_up_moyen  = u_updraft.mean(dim=nom_axe_t)
u_env_moyen = u_environ.mean(dim=nom_axe_t)
w_up_moyen  = w_updraft.mean(dim=nom_axe_t)

# Profil de densité standard (utile pour passer du flux cinématique au flux physique)
z_en_metres = axe_z
rho_surface = 1.15
H_scale = 8000.0
rho = rho_surface * np.exp(-z_en_metres / H_scale)

# =============================================================================
# 6. CALCUL DES FLUX (MASS-FLUX FORMALISM)
# =============================================================================
# M = rho * alpha * w_up
flux_de_masse_M = rho * alpha_moyen * w_up_moyen

# Flux total mesuré (covariant complet) : rho * <u'w'>_t,x,y
flux_total_local = u_prime * w_prime
tau_total = rho * flux_total_local.mean(dim=[nom_axe_t, nom_axe_y, nom_axe_x])

# Approximation théorique Mass-Flux : tau_MF = M * (u_up - u_env)
tau_mass_flux = flux_de_masse_M * (u_up_moyen - u_env_moyen)

# =============================================================================
# 7. CALCUL DES TENDANCES (FREINAGE DÛ AUX CORES)
# =============================================================================
tendance_totale   = - (1.0 / rho) * tau_total.differentiate(nom_axe_z)
tendance_cores_MF = - (1.0 / rho) * tau_mass_flux.differentiate(nom_axe_z)

# =============================================================================
# 8. VISUALISATION DES TROIS PANNEAUX
# =============================================================================
fig, (ax1, ax2, ax3) = plt.subplots(1, 3, figsize=(18, 6), sharey=True)

# Limiter l'affichage à la troposphère (0 à 15km) pour mieux voir, l'altitude max étant 32km
altitude_max_plot = 15000 # mètres

# Graphe 1 : Flux de Masse
ax1.plot(flux_de_masse_M, axe_z, color='purple', linewidth=2.5)
ax1.set_title("A. Flux de Masse Convectif ($M$)\ndes Cores actifs", fontsize=10)
ax1.set_xlabel("$M$ ($kg / m^2 / s$)")
ax1.set_ylabel(f"Altitude ({nom_axe_z})")
ax1.set_ylim(0, altitude_max_plot)
ax1.grid(True, alpha=0.3)

# Graphe 2 : Comparaison des contraintes (Friction)
ax2.plot(tau_total, axe_z, color='black', linewidth=2.5, label='Contrainte totale résolue')
ax2.plot(tau_mass_flux, axe_z, color='crimson', linestyle='--', linewidth=2, label='Approximation Mass-Flux')
ax2.axvline(0, color='grey', alpha=0.5)
ax2.set_title("B. Flux dynamique de quantité de mouv. ($\\tau$)", fontsize=10)
ax2.set_xlabel("Contrainte ($N/m^2$)")
ax2.grid(True, alpha=0.3)
ax2.legend()

# Graphe 3 : Tendances (Freinage)
ax3.plot(tendance_totale, axe_z, color='black', linewidth=2.5, label='Tendance Totale')
ax3.plot(tendance_cores_MF, axe_z, color='crimson', linestyle='--', linewidth=2, label='Freinage induit par Cores')
ax3.axvline(0, color='grey', alpha=0.5)
ax3.set_title("C. Tendance du vent moyen ($\\partial U / \\partial t$)", fontsize=10)
ax3.set_xlabel("Accélération / Décélération ($m/s^2$)")
ax3.grid(True, alpha=0.3)
ax3.legend()

plt.suptitle("Analyse par Flux de Masse des Cores Convectifs (Meso-NH)", fontsize=13, fontweight='bold')
plt.tight_layout()
plt.show()
