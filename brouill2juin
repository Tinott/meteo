    ax.plot(dudt_prof[idx]   * 1e5, alt[idx], color='crimson',   lw=2, linestyle='--',
            label=r'$\partial\bar{u}/\partial t$')
    ax.plot(wdudz_prof[idx]  * 1e5, alt[idx], color='seagreen',  lw=1.5, linestyle=':',
            label=r'$\bar{w}\,\partial_z\bar{u}$')
    ax.plot((dudt_prof[idx] + wdudz_prof[idx]) * 1e5, alt[idx],
