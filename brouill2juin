import numpy as np
import matplotlib.pyplot as plt

# =============================================================================
# 1. PARAMÈTRES DE LA SIMULATION
# =============================================================================
# Grille d'espace et de temps
N_z = 100
z_top = 15000.0                       # Altitude max (15 km)
z = np.linspace(0, z_top, N_z)
dz = z[1] - z[0]

N_t = 3000
dt = 3600.0 * 3                       # Pas de temps (3 heures)
t = np.arange(N_t) * dt

# Paramètres physiques
rho0 = 1.2 * np.exp(-z / 7000.0)      # Profil de densité basique
N2 = 1e-4 * np.ones(N_z)               # Fréquence de Brunt-Väisälä (stratification uniforme)
nu = 0.05                             # Viscosité turbulente explicite pour stabiliser (m^2/s)

# Propriétés des ondes (Est + et Ouest -)
# Les forçages initiaux en surface (z=0)
F0_plus = 0.005                       # Flux de quantité de mouvement vers l'Est (Pa)
F0_moins = -0.005                     # Flux de quantité de mouvement vers l'Ouest (Pa)

c_plus = 20.0                         # Vitesse de phase de l'onde Est (m/s)
c_moins = -20.0                       # Vitesse de phase de l'onde Ouest (m/s)
k = 2 * np.pi / 100000.0              # Longueur d'onde horizontale (100 km)
alpha = 1e-6                          # Coefficient d'amortissement linéaire des ondes (ex: friction radiative)

# =============================================================================
# 2. INITIALISATION ET BOUCLE TEMPORELLE (Schéma d'Euler)
# =============================================================================
u = np.zeros((N_t, N_z))               # Vent moyen u(z, t)
# On peut ajouter un petit cisaillement initial pour briser la symétrie
u[0, :] = 2.0 * np.sin(2 * np.pi * z / z_top)

for n in range(0, N_t - 1):
    u_current = u[n, :].copy()
    
    # Initialisation des flux à la surface
    F_plus = F0_plus * np.ones(N_z)
    F_moins = F0_moins * np.ones(N_z)
    
    # Intégration WKB verticale de l'atténuation des ondes
    # Le taux d'atténuation augmente drastiquement quand (c - u) approche 0 (couches critiques)
    for iz in range(1, N_z):
        # Onde Est
        denom_plus = (c_plus - u_current[iz-1])**2
        if denom_plus > 0.1:
            m_plus = np.sqrt(N2[iz-1] / denom_plus)
            tau_plus = alpha * (m_plus**3) / (k * N2[iz-1])
            F_plus[iz] = F_plus[iz-1] * np.exp(-tau_plus * dz)
        else:
            F_plus[iz] = 0.0
            
        # Onde Ouest
        denom_moins = (c_moins - u_current[iz-1])**2
        if denom_moins > 0.1:
            m_moins = np.sqrt(N2[iz-1] / denom_moins)
            tau_moins = alpha * (m_moins**3) / (k * N2[iz-1])
            F_moins[iz] = F_moins[iz-1] * np.exp(-tau_moins * dz)
        else:
            F_moins[iz] = 0.0

    # Divergence du flux total (Force de trainée des ondes)
    F_tot = F_plus + F_moins
    dFdz = np.gradient(F_tot, dz)
    wave_forcing = -(1.0 / rho0) * dFdz
    
    # Diffusion numérique/physique pour lisser le profil
    d2udz2 = np.gradient(np.gradient(u_current, dz), dz)
    
    # Évolution temporelle
    u[n+1, :] = u_current + dt * (wave_forcing + nu * d2udz2)
    
    # Condition aux limites simples (no-slip aux bords)
    u[n+1, 0] = 0.0
    u[n+1, -1] = 0.0

# =============================================================================
# 3. VISUALISATION (Hovmöller diagram)
# =============================================================================
plt.figure(figsize=(10, 6), dpi=120)
time_days = t / 86400.0
z_km = z / 1000.0

# Tracé des contours du vent moyen u(z,t)
plt.rcParams.update({'grid.alpha': 0.25, 'image.cmap': 'RdBu_r'})
caxis = plt.contourf(time_days, z_km, u.T, levels=50, extend='both')
cbar = plt.colorbar(caxis)
cbar.set_label('Vent moyen $u$ (m/s)')

plt.title('Modélisation 1D de la descente de phase (Type QBO) induite par des ondes')
plt.xlabel('Temps (jours)')
plt.ylabel('Altitude (km)')
plt.grid(True)
plt.tight_layout()
plt.show()
