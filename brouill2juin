        ax.plot(pres[sl]   * sc, alt[sl],
                color='seagreen',   lw=1.2, linestyle='-.',
                label=r'$\frac{1}{\rho_0}\partial_y\bar{p}$')
        ax.axvline(0, color='grey', alpha=0.4)
        ax.set_xlabel('Tendance (×10⁻⁵ m/s²)')
        ax.set_title(titre, fontweight='bold')
        ax.legend(fontsize=9)
        ax.grid(True, alpha=0.3)

    axes[0].set_ylabel('Altitude (m)')
    plt.suptitle(
        f'Région {region} — fermeture du bilan de QdM méridionale\n'
        r"Directe $= -\frac{1}{\rho_0}\partial_z(\rho_0\overline{v'w'}_\mathrm{rég})$"
        r"   Résidu $= \partial_t\bar{v} + \bar{w}\partial_z\bar{v} + \frac{1}{\rho_0}\partial_y\bar{p}$",
        fontsize=13, fontweight='bold'
    )
    plt.tight_layout()
    plt.show()
