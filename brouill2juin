flux_s2   = np.zeros(n_z)
dudt_h    = np.zeros(n_z)
dudt_s    = np.zeros(n_z)
pres_h    = np.zeros(n_z)
pres_s    = np.zeros(n_z)

# Profils moyens 1D par région (pour w̄∂ū/∂z)
ubar_h    = np.zeros(n_z)
ubar_s    = np.zeros(n_z)
wbar_h    = np.zeros(n_z)
wbar_s    = np.zeros(n_z)

# Champs 2D moyens (ny, nx) par niveau (pour ū∂ū/∂x et v̄∂ū/∂y)
ubar_2d_h = np.zeros((n_z, n_y, n_x))
ubar_2d_s = np.zeros((n_z, n_y, n_x))
vbar_2d_h = np.zeros((n_z, n_y, n_x))
vbar_2d_s = np.zeros((n_z, n_y, n_x))

ds_u = xr.open_dataset(path3d('ua'))
ds_v = xr.open_dataset(path3d('va'))
ds_w = xr.open_dataset(path3d('wa'))
ds_p = xr.open_dataset(path3d('pa'))

for iz in range(n_z):

    acc_uw_h   = 0.0 ; acc_uw_s   = 0.0
    acc_dudt_h = 0.0 ; acc_dudt_s = 0.0
    acc_pres_h = 0.0 ; acc_pres_s = 0.0
    acc_wbar_h = 0.0 ; acc_wbar_s = 0.0
    acc_ubar_h = 0.0 ; acc_ubar_s = 0.0
    acc_u2d_h  = np.zeros((n_y, n_x))
    acc_u2d_s  = np.zeros((n_y, n_x))
    acc_v2d_h  = np.zeros((n_y, n_x))
    acc_v2d_s  = np.zeros((n_y, n_x))
    n = 0

    for it in range(t_stat, n_t - 1):

        u_2d = ds_u['ua'].isel({dim_t: it,     dim_z: iz}).values  # (ny, nx)
        u_nx = ds_u['ua'].isel({dim_t: it + 1, dim_z: iz}).values
        v_2d = ds_v['va'].isel({dim_t: it,     dim_z: iz}).values
        w_2d = ds_w['wa'].isel({dim_t: it,     dim_z: iz}).values
        p_2d = ds_p['pa'].isel({dim_t: it,     dim_z: iz}).values

        # Extraction dans chaque région
        u_h = u_2d[mh] ; u_s = u_2d[ms]
        w_h = w_2d[mh] ; w_s = w_2d[ms]

        # ── Flux direct : anomalies intra-région ─────────────────────
        u_p_h = u_h - u_h.mean()
        u_p_s = u_s - u_s.mean()
        w_p_h = w_h - w_h.mean()
        w_p_s = w_s - w_s.mean()
        acc_uw_h += (u_p_h * w_p_h).mean()
        acc_uw_s += (u_p_s * w_p_s).mean()

        # ── ∂ū/∂t conditionné ────────────────────────────────────────
        u_nx_h = u_nx[mh] ; u_nx_s = u_nx[ms]
        acc_dudt_h += (u_nx_h - u_h).mean() / dt_sec
        acc_dudt_s += (u_nx_s - u_s).mean() / dt_sec

        # ── Pression : -(1/rho0) dp/dx moyenné sur la région ─────────
        dpdx = np.gradient(p_2d, dx, axis=1)
        acc_pres_h += (-dpdx[mh] / rho0[iz]).mean()
        acc_pres_s += (-dpdx[ms] / rho0[iz]).mean()

        # ── Accumulation champs moyens ────────────────────────────────
        acc_ubar_h += u_h.mean()
        acc_ubar_s += u_s.mean()
        acc_wbar_h += w_h.mean()
