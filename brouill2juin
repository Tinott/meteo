# ======================================================================
#  Décomposition par zones up/dn/env du flux de Reynolds  (logique cellule 11)
#  À un instant it, sur la grille (z,x) — chaque point (y,x) classé via w_s = C*sigma_w
#
#    Phi(z)   = somme_k [ T1_k(z) + T2_k(z) ]          (identité exacte)
#    T1_k(z)  = sigma_k * (u_c^k - ubar)(w_c^k - wbar)     <- organisé (mass-flux)
#    T2_k(z)  = sigma_k * <(u-u_c^k)(w-w_c^k)>_k           <- sous-maille (amplitude)
#  k ∈ {up, dn, env},  sigma_k = fraction surfacique de la catégorie
# ======================================================================
ZMIN_D, ZMAX_D = 2000., 15000.
IT_DECOMP = n_t - 1                 # instant analysé (cohérent avec tes coupes)
C_DECOMP  = 1.2                     # seuil (ton C* ; mets 0.5 si tu veux l'ancien)
W0_MIN    = 0.001                   # plancher de w_s
USE_REG   = False                   # True -> restreint à la région humide mh

kz_d   = (alt >= ZMIN_D) & (alt <= ZMAX_D)
iz_lst = np.where(kz_d)[0]
z_D    = alt[kz_d]; nz_D = z_D.size
cats   = ('up', 'dn', 'env')

phi   = np.zeros(nz_D)                              # flux Reynolds total
T1    = {k: np.zeros(nz_D) for k in cats}          # organisé par catégorie
T2    = {k: np.zeros(nz_D) for k in cats}          # sous-maille par catégorie
sig   = {k: np.zeros(nz_D) for k in cats}          # fraction surfacique

ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for j, iz in enumerate(iz_lst):
    u = ds_u['ua'].isel({dim_t: IT_DECOMP, dim_z: iz}).values   # (ny, nx)
    w = ds_w['wa'].isel({dim_t: IT_DECOMP, dim_z: iz}).values
    if USE_REG:
        u = u[mh]; w = w[mh]
    u = u.ravel(); w = w.ravel()
    ubar, wbar, N = u.mean(), w.mean(), u.size

    # flux Reynolds total du niveau
    phi[j] = ((u - ubar) * (w - wbar)).mean()

    # classification up / dn / env via seuil w_s = C * sigma_w
    ws = max(W0_MIN, C_DECOMP * w.std())
    masks = {'up': w > ws, 'dn': w < -ws, 'env': np.abs(w) <= ws}

    for k in cats:
        m = masks[k]; Nk = m.sum()
        if Nk == 0:
            continue
        sk = Nk / N                       # fraction surfacique sigma_k
        uc = u[m].mean(); wc = w[m].mean()    # moyennes conditionnelles
        sig[k][j] = sk
        # T1 : organisé (between-group)
        T1[k][j] = sk * (uc - ubar) * (wc - wbar)
        # T2 : sous-maille (within-group), covariance INTERNE à la catégorie
        T2[k][j] = sk * ((u[m] - uc) * (w[m] - wc)).mean()

    del u, w; gc.collect()
ds_u.close(); ds_w.close(); del ds_u, ds_w; gc.collect()

# --- totaux et contrôle d'identité exacte ---
T1tot = sum(T1[k] for k in cats)
T2tot = sum(T2[k] for k in cats)
err = np.abs(phi - (T1tot + T2tot)).max()
print(f"contrôle identité  max|Φ − Σ_k(T1_k+T2_k)| = {err:.2e}  (doit être ~1e-18)")

frac_T1 = np.median(np.abs(T1tot) / (np.abs(phi) + 1e-30))
frac_T2 = np.median(np.abs(T2tot) / (np.abs(phi) + 1e-30))
print(f"poids médian  T1 (organisé) = {frac_T1:.0%}   T2 (sous-maille) = {frac_T2:.0%}")

# ======================================================================
#  FIGURE : (a) total=T1+T2  (b) contribution par catégorie  (c) fractions
# ======================================================================
Zkm = z_D / 1000; sc = 1e3
col = {'up': 'crimson', 'dn': 'royalblue', 'env': 'green'}
fig, ax = plt.subplots(1, 3, figsize=(16, 6), sharey=True)

# (a) total = organisé + sous-maille
ax[0].plot(phi*sc,   Zkm, 'k',   lw=2.5, label=r"$\Phi$ Reynolds total")
ax[0].plot(T1tot*sc, Zkm, 'r--', lw=2,   label=r'$T_1$ organisé')
ax[0].plot(T2tot*sc, Zkm, 'b-.', lw=2,   label=r'$T_2$ sous-maille')
ax[0].axvline(0, color='grey', alpha=.4)
ax[0].set_xlabel(r'flux ($\times10^{-3}$ m²/s²)'); ax[0].set_ylabel('z [km]')
ax[0].set_title('Total = organisé + sous-maille'); ax[0].legend(fontsize=9); ax[0].grid(alpha=.3)

# (b) qui porte la covariance ? (T1+T2 par catégorie)
for k in cats:
    ax[1].plot((T1[k] + T2[k])*sc, Zkm, color=col[k], lw=2, label=k)
ax[1].axvline(0, color='grey', alpha=.4)
ax[1].set_xlabel(r'flux ($\times10^{-3}$)'); ax[1].set_title('Contribution par catégorie')
ax[1].legend(fontsize=9); ax[1].grid(alpha=.3)

# (c) fractions surfaciques
for k in cats:
    ax[2].plot(sig[k], Zkm, color=col[k], lw=2, label=fr'$\sigma_{{{k}}}$')
ax[2].set_xlabel('fraction surfacique'); ax[2].set_title('Aires des catégories')
ax[2].legend(fontsize=9); ax[2].grid(alpha=.3)

plt.tight_layout(); plt.show()
