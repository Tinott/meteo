               norm=TwoSlopeNorm(vcenter=0, vmin=-pmax, vmax=pmax), cmap='RdBu_r')
axA.contour(Xkm, Zkm, psi_R, levels=[0], colors='k', linewidths=0.8, alpha=.5)
for r in rolls[:40]:                                  # 40 plus intenses
    e = Ellipse((r['xc_km'], r['zc_km']),
