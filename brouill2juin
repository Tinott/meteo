import numpy as np
import matplotlib.subplots as plt
from scipy.fft import dct, idct

# ============================================================================
# OJECTIF : Garder seulement quelques fonctions optimales et les analyser
# ============================================================================

# 1. Calcul du flux de Reynolds vrai (Référence 1D de taille n_z)
def get_true_flux_profile(u2, w2):
    u = u2.reshape(n_snap_t, ny_r, n_z, nx_r).transpose(0, 2, 1, 3)
    w = w2.reshape(n_snap_t, ny_r, n_z, nx_r).transpose(0, 2, 1, 3)
    u = u - u.mean(axis=(2, 3), keepdims=True)
    w = w - w.mean(axis=(2, 3), keepdims=True)
    return (rho0[None, :] * (u * w).mean(axis=(2, 3))).mean(axis=0)

flux_true = get_true_flux_profile(up_snaps, wp_snaps)

# 2. Transformation DCT-II pour obtenir TOUS les coefficients
C_all = dct(flux_true, norm='ortho')
n_z = len(flux_true)

# 3. Sélection des N_keep meilleures fonctions (ex: les 3 plus importantes)
N_keep = 3
# On trie par valeur absolue décroissante pour trouver les indices des fonctions dominantes
best_indices = np.argsort(np.abs(C_all))[::-1][:N_keep]

print(f"--- Analyse des {N_keep} fonctions DCT optimales pour le flux ---")
for rank, idx in enumerate(best_indices):
    contrib = (C_all[idx]**2) / np.sum(C_all**2) * 100
    print(f"Rang {rank+1} : Fonction Cosinus n°{idx} (Fréquence verticale k_z={idx}) -> Explique {contrib:.2f}% de la variance du flux")

# ============================================================================
# VISUALISATION ET ANALYSE DES FONCTIONS SÉLECTIONNÉES
# ============================================================================
fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# --- Graphique 1 : Visualisation des fonctions de base isolées ---
# On reconstruit la forme de chaque fonction de base sélectionnée à son échelle réelle
for idx in best_indices:
    C_single = np.zeros(n_z)
    C_single[idx] = C_all[idx]  # On ne garde QUE ce coefficient
    mode_shape = idct(C_single, norm='ortho')
    axes[0].plot(mode_shape[mask_show], zkm[mask_show], '--', 
                 label=f'Mode k_z={idx} (Coeff={C_all[idx]:.2e})')

axes[0].axvline(0, color='k', lw=0.5)
axes[0].set_ylim(0, Z_TOP_KM)
axes[0].set_xlabel("Amplitude de la composante")
axes[0].set_ylabel("z (km)")
axes[0].set_title("Forme brute des fonctions retenues")
axes[0].legend()

# --- Graphique 2 : Reconstruction cumulée vs Flux Vrai ---
C_truncated = np.zeros(n_z)
C_truncated[best_indices] = C_all[best_indices] # On garde uniquement les N_keep coefficients
flux_reconstructed = idct(C_truncated, norm='ortho')
score_nse = nse(flux_true, flux_reconstructed)

axes[1].plot(flux_true[mask_show], zkm[mask_show], 'k', lw=2.5, label='Flux Vrai 3D')
axes[1].plot(flux_reconstructed[mask_show], zkm[mask_show], 'r-', lw=2,
             label=f'Reconstruction ({N_keep} modes, NSE={score_nse:.3f})')

axes[1].axvline(0, color='k', lw=0.5)
axes[1].set_ylim(0, Z_TOP_KM)
axes[1].set_xlabel(r"$\rho_0\langle u'w'\rangle$")
axes[1].set_ylabel("z (km)")
axes[1].set_title(f"Reconstruction finale avec {N_keep} fonctions")
axes[1].legend()

fig.tight_layout()
plt.show()
