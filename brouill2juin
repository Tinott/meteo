# ============================================================
#  §1 (v3) — FERMETURE LINEAIRE TESTEE SUR LES ZONES DE FORT CISAILLEMENT
#
#  Etape 1 : critere par colonne  S(x,t) = max_{0-15km} |dz ubar_y(x,z,t)|
#            -> seuil par quantile -> regions connexes dans le plan (x,t)
#  Etape 2 : statistiques CONDITIONNELLES aux colonnes retenues
#            ubar_R(z,t) et flux_R(z,t) = rho0 <u'w'>_R (anomalies internes)
#  Etape 3 : ajustement de deux familles de fermeture, zone par zone
#            (A) y = c1 dz ubar + c2 z Hz dz ubar + c3 z dz ubar
#            (B) y = a rho0 ubar + b dz(rho0 ubar) + g dzz(rho0 ubar)
#            + baseline 1 terme (dz ubar seul) pour mesurer le gain reel
#
#  Protocole : 3 blocs temporels (train / val / test). alpha choisi sur VAL,
#  score reporte sur TEST -> pas de selection sur le jeu d'evaluation.
# ============================================================
import numpy as np, xarray as xr, matplotlib.pyplot as plt, gc
from scipy.ndimage import label, uniform_filter

# ---------------- configuration -------------------------------------
Z_SHEAR_MAX = 15000.0        # fenetre du critere de cisaillement
Q_SEUIL     = 0.90           # quantile definissant "fort cisaillement"
LISSE_XT    = 0              # lissage du champ S(x,t) avant seuillage (0 = brut)
MIN_PIX     = 6              # taille min d'une region connexe (pixels x-t)
Z_LO, Z_HI  = 2000.0, 18000.0
FRAC        = (0.50, 0.25, 0.25)     # train / val / test
ALPHAS      = np.logspace(-4, 4, 33)

zk   = alt/1000.0
band = (alt >= Z_LO) & (alt <= Z_HI); ib = np.where(band)[0]
Hz   = np.gradient(np.log(rho0), alt)          # d ln(rho0)/dz

# ============================================================
#  ETAPE 1 — champ de cisaillement par colonne et detection (x,t)
# ============================================================
u_y = np.zeros((n_z, n_stat, n_x), dtype=np.float32)
ds_u = xr.open_dataset(path3d('ua'))
for iz in range(n_z):
    u_y[iz] = ds_u['ua'].isel({dim_t: idx_stat, dim_z: iz}).values.mean(axis=1)
ds_u.close(); gc.collect()

dz_uy = np.gradient(u_y, alt, axis=0)
sel_z = alt <= Z_SHEAR_MAX
S     = np.abs(dz_uy[sel_z]).max(axis=0)        # (n_stat, n_x)
del dz_uy; gc.collect()

S_f   = uniform_filter(S, LISSE_XT) if LISSE_XT else S
seuil = float(np.quantile(S_f, Q_SEUIL))
brut  = S_f > seuil

lab, nlab = label(brut)                          # x NON periodique ici (cf. note)
if MIN_PIX > 1:
    tail = np.bincount(lab.ravel()); tail[0] = 0
    brut = np.isin(lab, np.where(tail >= MIN_PIX)[0])
    lab, nlab = label(brut)
fort   = brut
faible = ~fort

print(f"seuil (q={Q_SEUIL:.2f}) = {seuil:.2e} s-1   |  "
      f"S : med {np.median(S):.2e}  max {S.max():.2e}")
print(f"colonnes qualifiees : {fort.mean()*100:.1f} %  "
      f"({fort.sum()} pixels x-t) en {nlab} regions connexes >= {MIN_PIX} px")
nx_fort = fort.sum(1)
print(f"colonnes fortes par pas de temps : min {nx_fort.min()}  "
      f"med {int(np.median(nx_fort))}  max {nx_fort.max()}")

# ============================================================
#  ETAPE 2 — statistiques conditionnelles aux colonnes retenues
#  (anomalies vs moyenne CONDITIONNELLE -> flux interne a la zone)
# ============================================================
ZONES = {'toutes': np.ones_like(fort), 'fort cisaillement': fort,
         'faible cisaillement': faible}
UB   = {k: np.full((n_z, n_stat), np.nan) for k in ZONES}
FLX  = {k: np.full((n_z, n_stat), np.nan) for k in ZONES}

ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for iz in range(n_z):
    u = ds_u['ua'].isel({dim_t: idx_stat, dim_z: iz}).values.astype(np.float32)
    w = ds_w['wa'].isel({dim_t: idx_stat, dim_z: iz}).values.astype(np.float32)
    for k, M in ZONES.items():
        m = M[:, None, :]                        # (n_stat,1,n_x) -> diffuse sur y
        cnt = M.sum(1)*n_y
        ok  = cnt > 0
        su  = (u*m).sum(axis=(1, 2), dtype=np.float64)
        sw  = (w*m).sum(axis=(1, 2), dtype=np.float64)
        ub  = np.where(ok, su/np.maximum(cnt, 1), np.nan)
        wb  = np.where(ok, sw/np.maximum(cnt, 1), np.nan)
        suw = (u*w*m).sum(axis=(1, 2), dtype=np.float64)
        uw  = np.where(ok, suw/np.maximum(cnt, 1), np.nan)
        UB[k][iz]  = ub
        FLX[k][iz] = rho0[iz]*(uw - ub*wb)       # rho0 <u'w'> interne a la zone
    del u, w; gc.collect()
ds_u.close(); ds_w.close(); gc.collect()

# ============================================================
#  ETAPE 3 — bibliotheque, diagnostic de rang, ajustement ridge
# ============================================================
def build_library(ub):
    du   = np.gradient(ub, alt)
    ru   = rho0*ub
    return {'dudz'       : du,
            'zHz_dudz'   : alt*Hz*du,
            'z_dudz'     : alt*du,
            'rho0_u'     : ru,
            'dz_rho0_u'  : np.gradient(ru, alt),
            'dzz_rho0_u' : np.gradient(np.gradient(ru, alt), alt),
            'intercept'  : np.ones_like(alt)}

MODELES = {'A shear-3'  : ['dudz', 'zHz_dudz', 'z_dudz'],
           'B rho0u-3'  : ['rho0_u', 'dz_rho0_u', 'dzz_rho0_u'],
           'A+B mixte'  : ['dudz', 'zHz_dudz', 'z_dudz',
                           'rho0_u', 'dz_rho0_u', 'dzz_rho0_u', 'intercept'],
           'baseline dz': ['dudz']}

def nse(o, p): return 1 - np.sum((o-p)**2)/np.sum((o-o.mean())**2)

def blocs(tv):
    n = len(tv); i1 = int(FRAC[0]*n); i2 = int((FRAC[0]+FRAC[1])*n)
    return tv[:i1], tv[i1:i2], tv[i2:]

def design(ub_zt, names, ts):
    X = [np.column_stack([build_library(ub_zt[:, t])[nm][ib] for nm in names])
         for t in ts]
    return np.concatenate(X, 0)

def ridge(Xtr, ytr, a):
    mu, sd = Xtr.mean(0), Xtr.std(0); sd = np.where(sd < 1e-30, 1.0, sd)
    Z = (Xtr-mu)/sd
    c = np.linalg.solve(Z.T@Z + a*np.eye(Z.shape[1]), Z.T@ytr)
    return c, mu, sd

def ajuste(ub_zt, fl_zt, names):
    tv = np.where(np.isfinite(ub_zt[ib]).all(0) & np.isfinite(fl_zt[ib]).all(0))[0]
    if tv.size < 12: return None
    ttr, tva, tte = blocs(tv)
    Xtr, Xva, Xte = (design(ub_zt, names, t) for t in (ttr, tva, tte))
    ytr, yva, yte = (fl_zt[np.ix_(ib, t)].ravel(order='F') for t in (ttr, tva, tte))
    Zs = (Xtr - Xtr.mean(0))/(Xtr.std(0) + 1e-30)
    sv = np.linalg.svd(Zs, compute_uv=False)
    sc = [nse(yva, ((Xva-mu)/sd)@c) for c, mu, sd in
          (ridge(Xtr, ytr, a) for a in ALPHAS)]
    a_b = ALPHAS[int(np.argmax(sc))]
    c, mu, sd = ridge(Xtr, ytr, a_b)
    return dict(alpha=a_b, coef=c, mu=mu, sd=sd, names=names,
                nse_tr=nse(ytr, ((Xtr-mu)/sd)@c), nse_va=max(sc),
                nse_te=nse(yte, ((Xte-mu)/sd)@c),
                cond=sv[0]/max(sv[-1], 1e-30),
                rang=int(np.sum(sv > sv[0]*1e-8)), sv=sv, nt=tv.size)

RES = {}
print("\n" + "="*74)
print(f"{'zone':22s} {'modele':13s} {'NSE_tr':>8s} {'NSE_va':>8s} {'NSE_te':>8s}"
      f" {'cond':>9s} {'rang':>5s}")
print("="*74)
for zn in ZONES:
    for mn, nm in MODELES.items():
        r = ajuste(UB[zn], FLX[zn], nm)
        if r is None:
            print(f"{zn:22s} {mn:13s}   pas assez de pas de temps valides"); continue
        RES[(zn, mn)] = r
        print(f"{zn:22s} {mn:13s} {r['nse_tr']:+8.3f} {r['nse_va']:+8.3f}"
              f" {r['nse_te']:+8.3f} {r['cond']:9.1e} {r['rang']:5d}")

r = RES.get(('fort cisaillement', 'A shear-3'))
if r is not None:
    print(f"\nSpectre singulier du modele A (fort cisaillement) : "
          f"{np.array2string(r['sv']/r['sv'][0], precision=3)}")
    print("  -> si la 3e valeur est ~0, les 3 termes n'occupent que 2 directions.")
    b0 = RES.get(('fort cisaillement', 'baseline dz'))
    if b0 is not None:
        print(f"gain du modele A sur la baseline 1 terme (NSE test) : "
              f"{r['nse_te']-b0['nse_te']:+.3f}")

# ============================================================
#  FIGURES
# ============================================================
fig, ax = plt.subplots(2, 3, figsize=(17, 10))
xkm  = np.arange(n_x)*dx/1000.0
ext  = [0, n_stat, xkm[0], xkm[-1]]

a = ax[0, 0]; a.grid(False)
im = a.imshow(S_f.T, origin='lower', aspect='auto', extent=ext, cmap='viridis')
a.contour(np.linspace(0, n_stat, n_stat), xkm, S_f.T, [seuil], colors='r', linewidths=.7)
a.set_xlabel('t (indice fenetre)'); a.set_ylabel('x (km)')
a.set_title(r'$\max_{0-15\,\mathrm{km}}|\partial_z\bar u|(x,t)$ + seuil')
fig.colorbar(im, ax=a, label='intensite cisaillement')

a = ax[0, 1]; a.grid(False)
a.imshow(fort.T, origin='lower', aspect='auto', extent=ext, cmap='gray_r')
a.set_xlabel('t (indice fenetre)'); a.set_ylabel('x (km)')
a.set_title(f'Colonnes qualifiees ({fort.mean()*100:.0f} %, {nlab} regions)')

a = ax[0, 2]
for zn, c in zip(ZONES, ['k', 'crimson', 'steelblue']):
    a.plot(np.nanmean(FLX[zn], 1)[band]*1e3, zk[band], color=c, lw=2, label=zn)
a.axvline(0, color='grey', lw=.8); a.set_xlabel(r'$\times10^{-3}$ kg m$^{-1}$s$^{-2}$')
a.set_ylabel('z (km)'); a.set_title("Flux interne par zone"); a.legend(fontsize=8)

a = ax[1, 0]
for zn, c in zip(ZONES, ['k', 'crimson', 'steelblue']):
    a.plot(np.gradient(np.nanmean(UB[zn], 1), alt)[band], zk[band], color=c, lw=2, label=zn)
a.axvline(0, color='grey', lw=.8); a.set_xlabel(r'$\partial_z\bar u$ (s$^{-1}$)')
a.set_ylabel('z (km)'); a.set_title('Cisaillement moyen par zone'); a.legend(fontsize=8)

a = ax[1, 1]
lab_m = [m for m in MODELES]; w = 0.25
for i, (zn, c) in enumerate(zip(ZONES, ['k', 'crimson', 'steelblue'])):
    v = [RES[(zn, m)]['nse_te'] if (zn, m) in RES else np.nan for m in lab_m]
    a.bar(np.arange(len(lab_m)) + (i-1)*w, v, w, color=c, label=zn)
a.axhline(0, color='grey', lw=.8)
a.set_xticks(range(len(lab_m))); a.set_xticklabels(lab_m, rotation=20, fontsize=8)
a.set_ylabel('NSE test'); a.set_title('Generalisation par zone et modele'); a.legend(fontsize=8)

a = ax[1, 2]
zn = 'fort cisaillement'
a.plot(np.nanmean(FLX[zn], 1)[band]*1e3, zk[band], 'k-', lw=2.4, label='flux vrai')
for mn, c in zip(['A shear-3', 'B rho0u-3', 'A+B mixte'],
                 ['tab:orange', 'tab:green', 'tab:purple']):
    if (zn, mn) not in RES: continue
    rr = RES[(zn, mn)]
    Xm = np.column_stack([build_library(np.nanmean(UB[zn], 1))[q][ib] for q in rr['names']])
    a.plot(((Xm-rr['mu'])/rr['sd'] @ rr['coef'])*1e3, zk[band], '--', color=c, lw=1.8,
           label=f"{mn} (NSE_te={rr['nse_te']:+.2f})")
a.axvline(0, color='grey', lw=.8); a.set_xlabel(r'$\times10^{-3}$ kg m$^{-1}$s$^{-2}$')
a.set_ylabel('z (km)'); a.set_title('Reconstruction, zone de fort cisaillement')
a.legend(fontsize=7)

for a in ax.ravel(): a.grid(alpha=.3)
for a in [ax[0, 2], ax[1, 0], ax[1, 2]]: a.set_ylim(Z_LO/1000, Z_HI/1000)
plt.tight_layout(); plt.show()
