# ===========================================================================
#  Partie ② — Vorticité dans le plan vertical : omega_y = d_x w - d_z u
#  ---------------------------------------------------------------------------
#  Sur la coupe (x,z) moyennée sur y ET sur le temps stationnaire.
#  omega_y > 0 : rotation anti-horaire dans le plan (x,z) ; < 0 : horaire.
#  C'est la vorticité qui matérialise les (sous-)tourbillons de la partie 2,
#  cohérente avec psi (omega = -nabla^2 psi / rho0 en incompressible).
#  Réutilise : path3d, dim_t, dim_z, n_t, n_x, x, alt, t_stat.
# ===========================================================================
Z_MAX_W = 18000.0
iz_w = np.where(alt <= Z_MAX_W)[0]
zW = alt[iz_w].copy(); nzW = zW.size

# --- coupe (z,x) moyennée sur y et sur le temps stationnaire ---
Uy = np.zeros((nzW, n_x)); Wy = np.zeros((nzW, n_x))
ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for j, iz in enumerate(iz_w):
    u_acc = np.zeros(n_x); w_acc = np.zeros(n_x); nt = 0
    for it in range(t_stat, n_t):
        u_acc += ds_u['ua'].isel({dim_t:it, dim_z:iz}).values.mean(axis=0)  # moyenne y
        w_acc += ds_w['wa'].isel({dim_t:it, dim_z:iz}).values.mean(axis=0)
        nt += 1
    Uy[j] = u_acc/nt; Wy[j] = w_acc/nt
ds_u.close(); ds_w.close(); del ds_u, ds_w; gc.collect()

# --- vorticité omega_y = d_x w - d_z u ---
dxl = float(x[1]-x[0])
# d_x w : périodique en x -> différence centrée avec roll
dxw = (np.roll(Wy, -1, axis=1) - np.roll(Wy, 1, axis=1)) / (2*dxl)
# d_z u : gradient vertical (alt non uniforme géré par np.gradient)
dzu = np.gradient(Uy, zW, axis=0)
omega = dxw - dzu                                  # (nzW, n_x)  [s^-1]

print(f'vorticité calculée : ({nzW},{n_x})  '
      f'plage {omega.min():.2e} … {omega.max():.2e} s⁻¹')

# --- figure : carte de vorticité ---
fig, ax = plt.subplots(figsize=(13, 5))
pm = np.percentile(np.abs(omega), 99) + 1e-30
im = ax.pcolormesh(x/1000, zW/1000, omega, cmap='RdBu_r',
                   norm=TwoSlopeNorm(0, -pm, pm), shading='auto')
ax.set_xlabel('x [km]'); ax.set_ylabel('z [km]')
ax.set_title(r'② Vorticité dans le plan vertical  $\omega_y = \partial_x w - \partial_z u$  '
             r'(moyenne $y$, temps)', fontweight='bold')
fig.colorbar(im, ax=ax, label=r'$\omega_y$ [s$^{-1}$]', pad=.01)
plt.tight_layout(); plt.show()
