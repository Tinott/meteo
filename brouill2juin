# ============================================================
# SELECTION DES MODES PAR CONTRIBUTION AU FLUX (et non par energie)
# On a demontre :  Phi_n = rho0 * lambda_n * <phi_n^u , phi_n^w>
# => on trie les modes par |contribution au flux| decroissante,
#    puis on regarde combien il en faut pour reconstruire le flux.
# ============================================================

# --- 1. contribution de chaque mode au flux ---
phi_u = modes_flat[:, :half]           # partie u de chaque mode : (Ns, nz*nx_r)
phi_w = modes_flat[:, half:]           # partie w de chaque mode
c_n   = np.sum(phi_u * phi_w, axis=1)  # <phi_u, phi_w> : alignement spatial u-w
Phi_n = evals * c_n                     # contribution (signee) du mode au flux ~ lambda_n * c_n

order_energy = np.arange(len(evals))            # ordre POD standard (energie decroissante)
order_flux   = np.argsort(np.abs(Phi_n))[::-1]  # ordre par |contribution flux| decroissante

# --- 2. tableau : ou se classent les modes energetiques pour le flux ? ---
print(' mode | energie% |   c_n     | contrib flux |  rang(flux)')
for n in order_energy[:min(10, len(evals))]:
    rf = int(np.where(order_flux == n)[0][0])
    print(f'  {n:4d} | {energy[n]*100:6.2f}% | {c_n[n]:+.4f} | {Phi_n[n]:+.3e} |   {rf:4d}')

# --- 3. reconstruction avec un SOUS-ENSEMBLE choisi de modes ---
def reconstruct_flux_subset(idx):
    """Flux reconstruit en gardant UNIQUEMENT les modes d'indices idx."""
    idx = list(idx)
    if len(idx) == 0:
        return np.zeros(n_z)
    rec = Smean[None, :] + a_n[:, idx] @ modes_flat[idx]
    up_r = rec[:, :half].reshape(Ns, n_z, nx_r)
    wp_r = rec[:, half:].reshape(Ns, n_z, nx_r)
    up_r = up_r.reshape(n_snap_t, ny_r, n_z, nx_r).transpose(0, 2, 1, 3)
    wp_r = wp_r.reshape(n_snap_t, ny_r, n_z, nx_r).transpose(0, 2, 1, 3)
    up_r = up_r - up_r.mean(axis=(2, 3), keepdims=True)
    wp_r = wp_r - wp_r.mean(axis=(2, 3), keepdims=True)
    return (rho0[None, :] * (up_r * wp_r).mean(axis=(2, 3))).mean(axis=0)

# --- 4. courbe NSE(N) : ordre energie vs ordre contribution-flux ---
N_list = np.unique(np.clip(
    np.round(np.linspace(1, min(Ns-1, 200), 30)).astype(int), 1, Ns-1))
nse_energy = np.array([nse(flux_true_profile,
                           reconstruct_flux_subset(order_energy[:N])) for N in N_list])
nse_flux   = np.array([nse(flux_true_profile,
                           reconstruct_flux_subset(order_flux[:N]))   for N in N_list])

# N minimal pour NSE >= 0.9 dans chaque ordre
def n_needed(nse_arr, N_arr, target=0.9):
    hit = np.where(nse_arr >= target)[0]
    return int(N_arr[hit[0]]) if hit.size else None
n_e = n_needed(nse_energy, N_list); n_f = n_needed(nse_flux, N_list)
print(f'\nPour NSE_flux >= 0.90 :')
print(f'  tri energie      -> {n_e} modes')
print(f'  tri contribution -> {n_f} modes   (gain = {("%d modes" % (n_e-n_f)) if (n_e and n_f) else "n/a"})')

fig, axes = plt.subplots(1, 2, figsize=(13, 5))
axes[0].plot(N_list, nse_energy, 'o-', label='ordre energie (POD standard)')
axes[0].plot(N_list, nse_flux,   's-', label='ordre contribution au flux')
axes[0].axhline(0.9, color='grey', ls='--', lw=0.8)
axes[0].set_xlabel('nombre de modes gardes N'); axes[0].set_ylabel('NSE flux')
axes[0].set_title('Reconstruction du flux : quel ordre de selection ?')
axes[0].legend(); axes[0].set_xscale('log')

# spectre : contribution au flux |Phi_n| vs energie lambda_n (rangs differents)
axes[1].bar(np.arange(min(30, len(evals))),
            np.abs(Phi_n)[order_flux][:30] / np.abs(Phi_n).sum(),
            color='steelblue', label='|contrib flux| (triee)')
axes[1].set_xlabel('modes tries par contribution au flux (rang)')
axes[1].set_ylabel('part du flux total'); axes[1].set_title('Spectre de flux des modes')
axes[1].legend()
fig.tight_layout(); plt.show()

# --- 5. flux reconstruit avec les n_f modes "flux" vs profil vrai ---
if n_f:
    flux_sel = reconstruct_flux_subset(order_flux[:n_f])
    fig, ax = plt.subplots(figsize=(5, 5))
    ax.plot(flux_true_profile[mask_show], zkm[mask_show], 'k', lw=2, label='flux vrai')
    ax.plot(flux_sel[mask_show], zkm[mask_show], 'r--',
            label=f'{n_f} modes selectionnes (NSE={nse(flux_true_profile,flux_sel):.2f})')
    ax.axvline(0, color='k', lw=0.5); ax.set_ylim(0, Z_TOP_KM)
    ax.set_xlabel(r"$\rho_0\langle u'w'\rangle$"); ax.set_ylabel('z (km)')
    ax.legend(); ax.set_title('Flux : selection par contribution')
    fig.tight_layout(); plt.show()
