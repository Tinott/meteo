def get_sym_norm(data, p=98):
    lim = max(np.percentile(np.abs(data), p), 1e-15)
    return TwoSlopeNorm(vmin=-lim, vcenter=0.0, vmax=lim)

# on retire la tendance temporelle a chaque niveau -> anomalies pures
