## 15. Fermeture du bilan de QdM par région (humide / sèche)

On vérifie terme à terme l'équation de Navier-Stokes conditionnée sur chaque région :

$$-\frac{1}{\rho_0}\partial_z(\rho_0\overline{u'w'}_{\text{rég}}) \stackrel{?}{=} \left\langle\frac{\partial u}{\partial t}\right\rangle_{\text{rég}} + \left\langle u\partial_x u + v\partial_y u + w\partial_z u\right\rangle_{\text{rég}} + \left\langle\frac{1}{\rho_0}\partial_x p\right\rangle_{\text{rég}}$$

**Méthode directe** : divergence de flux de Reynolds restreint aux colonnes de la région (réutilise `flux_h` / `flux_s` du §9).  
**Méthode résiduelle** : somme de tous les termes connus (∂u/∂t + advection + pression), moyennés sur les mêmes colonnes.  
Un écart résiduel persistant indique la diffusion sous-maille non disponible dans les sorties.




# ======================================================================
# §15 — Fermeture conditionnelle : humide vs sèche
#
# Pour chaque niveau iz, on calcule niveau par niveau :
#   - dudt_2d    = (u(t+1) - u(t)) / dt          [§14 mais conditionné]
#   - adv_2d     = -(u*du/dx + v*du/dy + w*du/dz) [§13.2 mais conditionné]
#   - pres_2d    = -(1/rho0)*dp/dx                [§13.3 mais conditionné]
# puis on moyenne sur mh / ms séparément.
#
# La méthode directe réutilise flux_h / flux_s du §9 → tend_h_direct / tend_s_direct.
# ======================================================================

dt_sec = 6.0 * 3600.0

dudt_h  = np.zeros(n_z)
dudt_s  = np.zeros(n_z)
adv_h   = np.zeros(n_z)
adv_s   = np.zeros(n_z)
pres_h  = np.zeros(n_z)
pres_s  = np.zeros(n_z)

ds_u = xr.open_dataset(path3d('ua'))
ds_v = xr.open_dataset(path3d('va'))
ds_w = xr.open_dataset(path3d('wa'))
ds_p = xr.open_dataset(path3d('pa'))

for iz in range(n_z):

    acc_dudt_h = 0.0 ; acc_dudt_s = 0.0
    acc_adv_h  = 0.0 ; acc_adv_s  = 0.0
    acc_pres_h = 0.0 ; acc_pres_s = 0.0
    n = 0

    iz_lo = max(iz - 1, 0)
    iz_hi = min(iz + 1, n_z - 1)
    dz    = alt[iz_hi] - alt[iz_lo]
    if dz == 0:
        dz = alt[1] - alt[0]

    for it in range(t_stat, n_t - 1):

        u_2d   = ds_u['ua'].isel({dim_t: it,     dim_z: iz}).values  # (ny, nx)
        u_next = ds_u['ua'].isel({dim_t: it + 1, dim_z: iz}).values
        v_2d   = ds_v['va'].isel({dim_t: it,     dim_z: iz}).values
        w_2d   = ds_w['wa'].isel({dim_t: it,     dim_z: iz}).values
        p_2d   = ds_p['pa'].isel({dim_t: it,     dim_z: iz}).values

        # ── ∂u/∂t ────────────────────────────────────────────────────
        dudt_2d = (u_next - u_2d) / dt_sec

        # ── Advection ─────────────────────────────────────────────────
        dudx = np.gradient(u_2d, dx, axis=1)
        dudy = np.gradient(u_2d, dy, axis=0)

        u_lo = ds_u['ua'].isel({dim_t: it, dim_z: iz_lo}).values
        u_hi = ds_u['ua'].isel({dim_t: it, dim_z: iz_hi}).values
        dudz = (u_hi - u_lo) / dz

        adv_2d = -(u_2d * dudx + v_2d * dudy + w_2d * dudz)

        # ── Pression ──────────────────────────────────────────────────
        pres_2d = -np.gradient(p_2d, dx, axis=1) / rho0[iz]

        # ── Accumulation conditionnée ─────────────────────────────────
        acc_dudt_h += dudt_2d[mh].mean()
        acc_dudt_s += dudt_2d[ms].mean()
        acc_adv_h  += adv_2d[mh].mean()
        acc_adv_s  += adv_2d[ms].mean()
        acc_pres_h += pres_2d[mh].mean()
        acc_pres_s += pres_2d[ms].mean()
        n += 1

        del u_2d, u_next, v_2d, w_2d, p_2d
        del dudx, dudy, dudz, u_lo, u_hi
        del dudt_2d, adv_2d, pres_2d
        gc.collect()

    dudt_h[iz] = acc_dudt_h / n
    dudt_s[iz] = acc_dudt_s / n
    adv_h[iz]  = acc_adv_h  / n
    adv_s[iz]  = acc_adv_s  / n
    pres_h[iz] = acc_pres_h / n
    pres_s[iz] = acc_pres_s / n

    if iz % 10 == 0:
        print(f'  iz={iz}/{n_z-1}  ({alt[iz]:.0f} m)')

ds_u.close() ; ds_v.close() ; ds_w.close() ; ds_p.close()
del ds_u, ds_v, ds_w, ds_p
gc.collect()

# Somme des termes connus = ce que devrait être la tendance Reynolds
residuel_h = dudt_h + adv_h + pres_h
residuel_s = dudt_s + adv_s + pres_s

# Méthode directe (réutilise flux_h / flux_s du §9)
tend_h_direct = tendance(flux_h)
tend_s_direct = tendance(flux_s)

print('§15 terminé.')






# ======================================================================
# §15 — Visualisation : directe vs résiduelle, terme par terme
# ======================================================================

idx_tropo = np.searchsorted(alt, 15000)
sc = 1e5

for region, direct, resid, dud, adv, pres, couleur in [
    ('HUMIDE', tend_h_direct, residuel_h, dudt_h, adv_h, pres_h, 'royalblue'),
    ('SÈCHE',  tend_s_direct, residuel_s, dudt_s, adv_s, pres_s, 'saddlebrown'),
]:
    fig, axes = plt.subplots(1, 2, figsize=(14, 8), sharey=True)

    for ax, sl, titre in zip(
        axes,
        [slice(None, idx_tropo), slice(None)],
        ['Troposphère (0–15 km)', 'Colonne complète']
    ):
        ax.plot(direct[sl] * sc, alt[sl],
                color=couleur, lw=2.5,
                label=r"Directe $-\frac{1}{\rho_0}\partial_z(\rho_0\overline{u'w'})$")
        ax.plot(resid[sl]  * sc, alt[sl],
                color='black', lw=2, linestyle='--',
                label=r'Résidu $\partial_t u + \mathrm{adv} + \mathrm{pres}$')
        ax.plot(dud[sl]    * sc, alt[sl],
                color='grey',       lw=1.2, linestyle=':',  label=r'$\partial_t u$')
        ax.plot(adv[sl]    * sc, alt[sl],
                color='darkorange', lw=1.2, linestyle='-.', label='Advection')
        ax.plot(pres[sl]   * sc, alt[sl],
                color='seagreen',   lw=1.2, linestyle='-.', label='Pression')
        ax.axvline(0, color='grey', alpha=0.4)
        ax.set_xlabel('Tendance (×10⁻⁵ m/s²)')
        ax.set_title(titre, fontweight='bold')
        ax.legend(fontsize=9)
        ax.grid(True, alpha=0.3)

    axes[0].set_ylabel('Altitude (m)')
    plt.suptitle(
        f'Région {region} — fermeture du bilan de QdM\n'
        r"Si les courbes coïncident : $\partial_z(\rho_0\overline{u'w'})$ "
        r"$= \rho_0(\partial_t u + \mathrm{adv} + \mathrm{pres})$",
        fontsize=13, fontweight='bold'
    )
    plt.tight_layout()
    plt.show()
