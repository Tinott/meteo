# ============================================================
#  D(uc-ubar) vs w_sec*dudz(ubar) vs leur somme, en (z,t) sur 2-8km
# ============================================================
terme_detrainement = D_zt * (u_h_zt - ubar_zt)
terme_advectif = w_s_obs_s * dudz_tot_s
somme_termes = terme_detrainement + terme_advectif

fig, axes = plt.subplots(1,3,figsize=(16,5),sharey=True)
v = max(np.nanpercentile(np.abs(terme_detrainement[m28]),95),
        np.nanpercentile(np.abs(terme_advectif[m28]),95),
        np.nanpercentile(np.abs(somme_termes[m28]),95))*3600+1e-12
for ax,(fld,lab) in zip(axes,[(terme_detrainement*3600, r"$D(u_c-\bar u)$ (m/s/h)"),
                                (terme_advectif*3600, r"$w_{sec}\,\partial_z\bar u$ (m/s/h)"),
                                (somme_termes*3600, "somme des deux (m/s/h)")]):
    im=ax.pcolormesh(tt+t_stat, zkm[m28], fld[m28], cmap='RdBu_r',
                      norm=TwoSlopeNorm(0,-v,v), shading='auto')
    ax.set_xlabel('t'); ax.set_title(lab,fontsize=10)
    fig.colorbar(im,ax=ax,pad=.02)
axes[0].set_ylabel('z (km)')
plt.suptitle("Decomposition du bilan de moment bulk-plume (2-8km)", fontweight='bold')
plt.tight_layout(); plt.show()









# ============================================================
#  R2 : Tu (=terme_flux) vs somme_termes, et Tu vs D(uc-ubar) seul
# ============================================================
R2_somme = np.full(n_z, np.nan)
R2_detrainement_seul = np.full(n_z, np.nan)
for iz in range(n_z):
    if not (2000 <= alt[iz] <= 8000): continue
    a = terme_flux[iz,:]
    if np.nanstd(a) < 1e-15: continue
    b1 = somme_termes[iz,:]
    ss_res = np.nansum((a-b1)**2); ss_tot = np.nansum((a-a.mean())**2)
    R2_somme[iz] = 1-ss_res/ss_tot if ss_tot>0 else np.nan
    b2 = terme_detrainement[iz,:]
    ss_res = np.nansum((a-b2)**2)
    R2_detrainement_seul[iz] = 1-ss_res/ss_tot if ss_tot>0 else np.nan

fig, ax = plt.subplots(figsize=(6,7))
ax.plot(R2_somme[m28], zkm[m28], 'o-', ms=3, label='Tu vs D(uc-ubar) + w_sec*dudz')
ax.plot(R2_detrainement_seul[m28], zkm[m28], 'o-', ms=3, label='Tu vs D(uc-ubar) seul')
ax.axvline(0,color='k',lw=.5); ax.legend(fontsize=9)
ax.set_xlabel('R2'); ax.set_ylabel('z (km)')
ax.set_title('Bilan complet vs terme de detrainement seul')
plt.tight_layout(); plt.show()

print(f"R2 median (2-8km), Tu vs somme complete : {np.nanmedian(R2_somme[m28]):.2f}")
print(f"R2 median (2-8km), Tu vs D(uc-ubar) seul : {np.nanmedian(R2_detrainement_seul[m28]):.2f}")
