print(f'  dudt     : {np.abs(dudt_h[sl]).max():.2e}')
print(f'  wdudz    : {np.abs(wdudz_h[sl]).max():.2e}')
print(f'  pres     : {np.abs(pres_h[sl]).max():.2e}')
