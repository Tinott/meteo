# (dans la boucle de 4a, à côté du calcul de w_org, ajoute u_org)
    # --- u organisé par paliers (même classification up/dn/env) ---
    u_org = np.zeros(n_x)
    for k, m in masks.items():
        if m.any():
            u_org[m] = uy[m].mean() - ubar
    uorg_all[j] = u_org          # <-- nécessite : uorg_all = np.zeros((nz_D, n_x)) avant la boucle






# ======================================================================
#  4b — DÉCOMPOSITION DE T1 EN ONDELETTES 2D
#  ----------------------------------------------------------------------
#  T1(z) = <u_org · w_org>_x  -> on décompose le CO-FLUX organisé local.
#  (1) CO-SCALOGRAMME 2D (rigoureux) : transformer u_org et w_org SÉPARÉMENT
#      puis  Co(x,z;λx,λz) = Re[Wu · conj(Ww)]   (généralise ton co-scalo 1D)
#      -> signé, intègre vers T1(z). C'est le champ principal.
#  (2) CWT 2D du PRODUIT  c_org = u_org·w_org  (comparaison, signé)
#      -> plus simple mais double la fréquence (carré) : à confronter à (1).
#  Variance-preserving : / (sx·sz). Bande déjà tronquée à Z_MAX (cellule 4a).
#  Réutilise : uorg_all, worg_all, x, z_D, nz_D, n_x, dxl, dzl, rho0_D.
# ======================================================================
import numpy as np

W0_MORLET = 6.0
NSX, NSZ  = 18, 14                                # garde modeste : NSX·NSZ FFT 2D

Lx_dom = n_x * dxl
Lz_dom = (z_D[-1] - z_D[0])
scales_x = np.geomspace(2*dxl, Lx_dom/2, NSX)
scales_z = np.geomspace(2*dzl, Lz_dom/2, NSZ)
fourier_factor = (4*np.pi) / (W0_MORLET + np.sqrt(2 + W0_MORLET**2))
lamx_km = scales_x * fourier_factor / 1000.0
lamz_km = scales_z * fourier_factor / 1000.0

# --- grille z régulière + pondération rho0 (mêmes 2 champs régularisés) ---
z_reg = np.linspace(z_D[0], z_D[-1], nz_D)
def _regrid(field):
    out = np.empty((nz_D, n_x))
    for i in range(n_x):
        out[:, i] = np.interp(z_reg, z_D, field[:, i])
    return out
rho0_reg = np.interp(z_reg, z_D, rho0_D)
wgt = (rho0_reg / rho0_reg[0])[:, None]
u_reg = _regrid(uorg_all) * wgt
w_reg = _regrid(worg_all) * wgt
dzr = float(z_reg[1] - z_reg[0])

kx = np.fft.fftfreq(n_x,  d=dxl) * 2*np.pi
kz = np.fft.fftfreq(nz_D, d=dzr) * 2*np.pi
KX, KZ = np.meshgrid(kx, kz)
Uhat = np.fft.fft2(u_reg); What = np.fft.fft2(w_reg)
k0 = W0_MORLET

def _psih(sx, sz):
    skx = sx*KX; skz = sz*KZ
    return (np.pi**-0.5)*np.sqrt(sx*sz/(dxl*dzr))*(skx > 0)*np.exp(-0.5*((skx-k0)**2 + skz**2))

def coscalo2d(sx, sz):
    """Co(x,z) = Re[Wu·conj(Ww)] à l'échelle (sx,sz)  — SIGNÉ."""
    ph = _psih(sx, sz)
    Wu = np.fft.ifft2(Uhat*ph); Ww = np.fft.ifft2(What*ph)
    return np.real(Wu * np.conj(Ww))

# --- (1) spectre 2D du co-flux : E_co(λx,λz) = Σ_{x,z} Co / (sx·sz) ---
E_co = np.zeros((NSZ, NSX))
for a in range(NSZ):
    for b in range(NSX):
        E_co[a, b] = coscalo2d(scales_x[b], scales_z[a]).sum() / (scales_x[b]*scales_z[a])

# pic = max de |E_co| (le co-flux est signé)
az, bx = np.unravel_index(np.argmax(np.abs(E_co)), E_co.shape)
sx_pk, sz_pk = scales_x[bx], scales_z[az]
print(f"[co-scalo 2D] échelle dominante du flux T1 : λx ≈ {lamx_km[bx]:.0f} km, λz ≈ {lamz_km[az]:.1f} km")
if bx in (0, NSX-1) or az in (0, NSZ-1):
    print("   ⚠️ pic sur un BORD -> élargis scales_x/scales_z")

# carte Co(x,z) à l'échelle pic  -> OÙ vit le flux organisé (signé)
Co_pk = coscalo2d(sx_pk, sz_pk)

# --- contrôle : le co-scalo intègre-t-il vers T1(z) ? (admissibilité Morlet) ---
T1_true = (uorg_all * worg_all).mean(axis=1)              # T1(z) direct
C_DELTA = 0.776
dj_x = np.log(scales_x[1]/scales_x[0]); dj_z = np.log(scales_z[1]/scales_z[0])
T1_rec = np.zeros(nz_D)
for b in range(NSX):
    for a in range(NSZ):
        T1_rec += coscalo2d(scales_x[b], scales_z[a]).mean(axis=1) / (scales_x[b]*scales_z[a])
T1_rec *= (dj_x*dj_z) / C_DELTA / (wgt[:,0]**2 + 1e-30)   # dé-pondère rho0² (produit de 2 champs pondérés)
corr = np.corrcoef(T1_true, T1_rec)[0,1]
print(f"[contrôle] corr( T1_direct , T1_reconstruit_ondelettes ) = {corr:+.3f}  (forme, pas amplitude)")

# --- (2) CWT 2D du PRODUIT c_org = u_org·w_org (comparaison) ---
c_reg = _regrid(uorg_all * worg_all)                      # produit (déjà un co-flux local)
Chat = np.fft.fft2(c_reg)
def cwt_prod(sx, sz):
    return np.abs(np.fft.ifft2(Chat*_psih(sx, sz)))**2
E_prod = np.zeros((NSZ, NSX))
for a in range(NSZ):
    for b in range(NSX):
        E_prod[a, b] = cwt_prod(scales_x[b], scales_z[a]).sum() / (scales_x[b]*scales_z[a])
az2, bx2 = np.unravel_index(np.argmax(E_prod), E_prod.shape)
print(f"[CWT produit] pic : λx ≈ {lamx_km[bx2]:.0f} km, λz ≈ {lamz_km[az2]:.1f} km "
      f"(λx plus court = effet du carré, attendu)")

# Wmap_pk pour §5/6 : on prend |Co| au pic comme carte d'intensité de flux
Wmap_pk = np.abs(Co_pk)

# zeta_reg pour le sens de rotation en §5/6
zeta_reg = _regrid(zeta_a)

# ======================================================================
#  FIGURE — (a) spectre co-flux E_co  (b) carte Co(x,z) signée au pic
#           (c) spectre du produit (comparaison)
# ======================================================================
import matplotlib.pyplot as plt
from matplotlib.colors import TwoSlopeNorm
fig, ax = plt.subplots(1, 3, figsize=(18, 5))

# (a) spectre 2D du co-flux (signé)
mE = np.percentile(np.abs(E_co), 99) + 1e-30
pc0 = ax[0].pcolormesh(lamx_km, lamz_km, E_co, shading='auto',
                       norm=TwoSlopeNorm(vcenter=0, vmin=-mE, vmax=mE), cmap='RdBu_r')
ax[0].set_xscale('log'); ax[0].set_yscale('log')
ax[0].plot(lamx_km[bx], lamz_km[az], 'k*', ms=15, mec='w', label='pic')
ax[0].set_xlabel(r'$\lambda_x$ [km]'); ax[0].set_ylabel(r'$\lambda_z$ [km]')
ax[0].set_title(r'(a) Co-spectre 2D de $T_1$  $\;E_{co}(\lambda_x,\lambda_z)/(s_xs_z)$')
ax[0].legend(fontsize=9); fig.colorbar(pc0, ax=ax[0], label='co-flux / échelle', pad=0.01)

# (b) carte Co(x,z) à l'échelle pic — SIGNÉE (rouge = flux +, bleu = flux −)
mC = np.percentile(np.abs(Co_pk), 99) + 1e-30
pc1 = ax[1].pcolormesh(x/1000, z_reg/1000, Co_pk, shading='auto',
                       norm=TwoSlopeNorm(vcenter=0, vmin=-mC, vmax=mC), cmap='RdBu_r')
ax[1].set_xlabel('x [km]'); ax[1].set_ylabel('z [km]')
ax[1].set_title(fr'(b) Co$(x,z)$ à $(\lambda_x,\lambda_z)\approx({lamx_km[bx]:.0f},{lamz_km[az]:.1f})$ km')
fig.colorbar(pc1, ax=ax[1], label=r'co-flux $T_1$ local [m²/s²]', pad=0.01)

# (c) spectre du produit (comparaison)
pc2 = ax[2].pcolormesh(lamx_km, lamz_km, E_prod, shading='auto', cmap='magma')
ax[2].set_xscale('log'); ax[2].set_yscale('log')
ax[2].plot(lamx_km[bx2], lamz_km[az2], 'c*', ms=15, mec='k', label='pic produit')
ax[2].set_xlabel(r'$\lambda_x$ [km]'); ax[2].set_ylabel(r'$\lambda_z$ [km]')
ax[2].set_title(r'(c) CWT 2D du produit $u_{org}w_{org}$ (comparaison)')
ax[2].legend(fontsize=9); fig.colorbar(pc2, ax=ax[2], label='énergie / échelle', pad=0.01)
plt.tight_layout(); plt.show()
