# ======================================================================
# §15 — Fermeture conditionnelle : humide vs sèche
#
# u_bar, w_bar : moyennes sur le DOMAINE ENTIER (ny*nx)
# u_prime = u_2d - u_bar  →  calculé sur toute la grille
# Le masque est appliqué uniquement au moment de moyenner le produit u′w′
#
# mh / ms : masques 2D (ny, nx) du §4
# ======================================================================

dt_sec = 6.0 * 3600.0
print(f'dt = {dt_sec:.0f} s = {dt_sec/3600:.1f} h')

# ── Tableaux résultats ────────────────────────────────────────────────
flux_h2  = np.zeros(n_z)
flux_s2  = np.zeros(n_z)

dudt_h   = np.zeros(n_z)
dudt_s   = np.zeros(n_z)
wdudz_h  = np.zeros(n_z)
wdudz_s  = np.zeros(n_z)
pres_h   = np.zeros(n_z)
pres_s   = np.zeros(n_z)

ubar_h   = np.zeros(n_z)
ubar_s   = np.zeros(n_z)

ds_u = xr.open_dataset(path3d('ua'))
ds_w = xr.open_dataset(path3d('wa'))
ds_p = xr.open_dataset(path3d('pa'))

for iz in range(n_z):

    acc_uw_h   = 0.0 ; acc_uw_s   = 0.0
    acc_dudt_h = 0.0 ; acc_dudt_s = 0.0
    acc_pres_h = 0.0 ; acc_pres_s = 0.0
    acc_wbar_h = 0.0 ; acc_wbar_s = 0.0
    acc_ubar_h = 0.0 ; acc_ubar_s = 0.0
    n = 0

    for it in range(t_stat, n_t - 1):

        u_2d = ds_u['ua'].isel({dim_t: it,     dim_z: iz}).values  # (ny, nx)
        u_nx = ds_u['ua'].isel({dim_t: it + 1, dim_z: iz}).values
        w_2d = ds_w['wa'].isel({dim_t: it,     dim_z: iz}).values
        p_2d = ds_p['pa'].isel({dim_t: it,     dim_z: iz}).values

        # ── Moyennes sur le DOMAINE ENTIER ───────────────────────────
        u_bar = u_2d.mean()
        w_bar = w_2d.mean()

        # ── Anomalies sur le DOMAINE ENTIER ──────────────────────────
        u_p = u_2d - u_bar   # (ny, nx)
        w_p = w_2d - w_bar   # (ny, nx)

        # ── Flux direct : masque appliqué sur le produit u′w′ ────────
        acc_uw_h += (u_p * w_p)[mh].mean()
        acc_uw_s += (u_p * w_p)[ms].mean()

        # ── ∂ū/∂t conditionné ────────────────────────────────────────
        acc_dudt_h += (u_nx[mh] - u_2d[mh]).mean() / dt_sec
        acc_dudt_s += (u_nx[ms] - u_2d[ms]).mean() / dt_sec

        # ── Pression : gradient zonal moyenné sur la région ──────────
        dpdx = np.gradient(p_2d, dx, axis=1)   # (ny, nx)
        acc_pres_h += (-dpdx[mh] / rho0[iz]).mean()
        acc_pres_s += (-dpdx[ms] / rho0[iz]).mean()

        # ── Vent moyen de la région (pour wdudz après la boucle) ─────
        acc_wbar_h += w_2d[mh].mean()
        acc_wbar_s += w_2d[ms].mean()
        acc_ubar_h += u_2d[mh].mean()
        acc_ubar_s += u_2d[ms].mean()

        n += 1
        del u_2d, u_nx, w_2d, p_2d, u_p, w_p, dpdx
        gc.collect()

    flux_h2[iz]  = rho0[iz] * acc_uw_h   / n
    flux_s2[iz]  = rho0[iz] * acc_uw_s   / n
    dudt_h[iz]   = acc_dudt_h / n
    dudt_s[iz]   = acc_dudt_s / n
    pres_h[iz]   = acc_pres_h / n
    pres_s[iz]   = acc_pres_s / n
    ubar_h[iz]   = acc_ubar_h / n
    ubar_s[iz]   = acc_ubar_s / n
    wdudz_h[iz]  = acc_wbar_h / n   # stocke w̄_région temporairement
    wdudz_s[iz]  = acc_wbar_s / n

    if iz % 10 == 0:
        print(f'  iz={iz}/{n_z-1}  ({alt[iz]:.0f} m)')

ds_u.close() ; ds_w.close() ; ds_p.close()
del ds_u, ds_w, ds_p
gc.collect()

# ── w̄_région · dū_région/dz ──────────────────────────────────────────
wbar_h = wdudz_h.copy()
wbar_s = wdudz_s.copy()
dudz_h = np.gradient(ubar_h, alt)
dudz_s = np.gradient(ubar_s, alt)
wdudz_h = wbar_h * dudz_h
wdudz_s = wbar_s * dudz_s

# ── Tendances directes ────────────────────────────────────────────────
tend_h_direct = tendance(flux_h2)
tend_s_direct = tendance(flux_s2)

# ── Résidu = somme des termes connus ─────────────────────────────────
residuel_h = dudt_h + wdudz_h + pres_h
residuel_s = dudt_s + wdudz_s + pres_s

print('§15 terminé.')
