# ===========================================================================
# NOUVELLE DÉCOMPOSITION : rho0<u'w'> = rho0*sig_u*sig_w * r_uw(z)
#   r_uw = coefficient de corrélation turbulente u'-w' (efficacité de transport)
#   Hypothèse physique : r_uw lié à l'inclinaison des structures cohérentes
#   (théorie eddy-tilt : r_uw ~ sin(2*theta), theta = angle vs verticale)
# ===========================================================================

# --- 1. Calcul de r_uw(z) à partir des quantités déjà calculées ---
r_uw = yflux / (rho0 * sig_u * sig_w + 1e-30)          # coefficient de corrélation, borné [-1,1] en théorie
r_uw = np.clip(r_uw, -1, 1)                             # sécurité numérique

fig, ax = plt.subplots(1, 3, figsize=(16, 6))
ax[0].plot(r_uw, alt, 'k', lw=2)
ax[0].axvline(0, color='grey', alpha=.4)
ax[0].set_xlabel(r"$r_{uw} = \langle u'w' \rangle / (\sigma_u \sigma_w)$")
ax[0].set_ylabel('z (m)'); ax[0].set_title("Efficacité de corrélation turbulente", fontweight='bold')
ax[0].grid(alpha=.3)

# --- 2. Comparaison avec le tilt CWT si disponible ---
have_tilt = 'theta_z' in dir()  # remplacez 'theta_z' par le nom exact de votre profil de tilt
if have_tilt:
    pred_sin2theta = np.sin(2*theta_z)
    ax[1].plot(r_uw, alt, 'k', lw=2, label=r'$r_{uw}$ mesuré')
    ax[1].plot(pred_sin2theta, alt, 'r--', lw=2, label=r'$\sin(2\theta)$ (tilt CWT)')
    ax[1].axvline(0, color='grey', alpha=.4)
    ax[1].set_xlabel('valeur'); ax[1].set_title('r_uw vs prédiction géométrique', fontweight='bold')
    ax[1].legend(); ax[1].grid(alpha=.3)
else:
    ax[1].text(0.5, 0.5, "theta_z non trouvé\n(pipeline Morlet)", ha='center', va='center')
    ax[1].set_title('tilt CWT indisponible', fontweight='bold')

# --- 3. Dictionnaire de candidats pour expliquer r_uw(z) ---
shear = np.gradient(ubar, alt)
Theta_r = {
    'shear/sig_w'        : shear / (sig_w + 1e-9),          # nombre de cisaillement local (adimensionné)
    'Mc/(rho0*sig_w)'    : Mc / (rho0*sig_w + 1e-9),         # fraction convective normalisée
    'sig_u/sig_w'        : sig_u / (sig_w + 1e-9),           # anisotropie de la turbulence
}
if have_tilt:
    Theta_r['sin2theta'] = np.sin(2*theta_z)
    Theta_r['theta']     = theta_z

# --- 4. STLSQ avec validation train/test (pair/impair), sur la bande utile ---
s = band()
names_r = list(Theta_r.keys())
Phi_r = np.column_stack([Theta_r[k][s] for k in names_r])
yv_r  = r_uw[s]

mu_r, sd_r = Phi_r.mean(0), Phi_r.std(0) + 1e-30
Phi_rs = (Phi_r - mu_r) / sd_r

idx = np.arange(len(yv_r))
tr, te = idx[idx % 2 == 0], idx[idx % 2 == 1]

ym_r = yv_r[tr].mean()
xi_r = stlsq(Phi_rs[tr], yv_r[tr] - ym_r, thresh=0.15)
yh_tr = Phi_rs[tr] @ xi_r + ym_r
yh_te = Phi_rs[te] @ xi_r + ym_r
R2tr_r, R2te_r = r2(yv_r[tr], yh_tr), r2(yv_r[te], yh_te)

print('=== r_uw = <u\'w\'>/(sig_u*sig_w) : fermeture géométrique ===')
print(f'  R² train {R2tr_r:+.3f}   R² TEST {R2te_r:+.3f}   '
      f'({"OK" if R2te_r>0.3 else "sur-ajustement / non fermable"})')
print('  termes retenus :')
for k, c in sorted(zip(names_r, xi_r), key=lambda t: -abs(t[1])):
    if abs(c) > 1e-9:
        print(f'    {k:18s} {c:+.3f}')

r_uw_hat = Phi_rs @ xi_r + ym_r

ax[2].plot(yv_r*1, alt[s], 'k', lw=2.5, label='r_uw vrai')
ax[2].plot(r_uw_hat*1, alt[s], 'g--', lw=2, label=f'fermeture (test R²={R2te_r:+.2f})')
ax[2].axvline(0, color='grey', alpha=.4)
ax[2].set_xlabel(r'$r_{uw}$'); ax[2].set_title('Fermeture de r_uw', fontweight='bold')
ax[2].legend(fontsize=9); ax[2].grid(alpha=.3)

plt.suptitle("Décomposition amplitude × efficacité : "
             r"$\rho_0\langle u'w'\rangle = \rho_0\sigma_u\sigma_w \cdot r_{uw}$",
             fontsize=13, fontweight='bold')
plt.tight_layout(); plt.show()

# --- 5. Reconstruction finale du flux complet : amplitude (déjà validée) x r_uw fermé ---
flux_recon_full = rho0[s]*sig_u[s]*sig_w[s] * r_uw_hat
R2_flux_final = r2(yflux[s], flux_recon_full)
print(f"\nR² du flux total reconstruit (amplitude x r_uw fermé) = {R2_flux_final:+.3f}")

plt.figure(figsize=(6,7))
plt.plot(yflux[s]*1e3, alt[s], 'k', lw=2.5, label='flux vrai')
plt.plot(flux_recon_full*1e3, alt[s], 'm--', lw=2,
         label=f'amplitude×r_uw fermé (R²={R2_flux_final:+.2f})')
plt.axvline(0, color='grey', alpha=.4)
plt.xlabel('flux (×10⁻³)'); plt.ylabel('z (m)')
plt.title('Flux reconstruit via décomposition amplitude × efficacité', fontweight='bold')
plt.legend(); plt.grid(alpha=.3); plt.tight_layout(); plt.show()
