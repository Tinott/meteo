             fontsize=13, fontweight='bold')
plt.tight_layout(); plt.show()








# ============================================================================
# §27 — Décomposition de la divergence du flux de masse en deux termes
# ----------------------------------------------------------------------------
#   ∂_z[Mc·Δu] = (∂_z Mc)·Δu   +   Mc·(∂_z Δu)        avec Δu = u_c - u_e
#                └── terme A ──┘   └──── terme B ────┘
#   A : la divergence du flux de MASSE module le moment via le contraste de vent
#       (lié à (ε-δ)Mc·Δu, cf. §22 : ∂_z Mc = (ε-δ)Mc)
#   B : flux de masse agissant sur le CISAILLEMENT du contraste cœur/environnement
#
#   La tendance de vent : ∂_t ū = -(1/ρ₀)·∂_z(Mc·Δu) = -(1/ρ₀)(A + B)
# ============================================================================

def decompose_div(Mc, duc):
    """Retourne (divA, divB, divTot) de Phi=Mc·duc, et la tendance -1/ρ₀·divTot."""
    dMc  = np.gradient(Mc,  alt)
    dduc = np.gradient(duc, alt)
    A = dMc * duc          # (∂_z Mc)·Δu
    B = Mc  * dduc         # Mc·(∂_z Δu)
    tot = A + B            # = ∂_z(Mc·duc)
    return A, B, tot, -tot / rho0

A_h, B_h, div_h, tend_h = decompose_div(Mc_up_h, duc_h)
A_s, B_s, div_s, tend_s = decompose_div(Mc_up_s, duc_s)

# vérité Reynolds pour comparaison (déjà en §24)
tend_rey_h = -np.gradient(flux_glob_h, alt) / rho0
tend_rey_s = -np.gradient(flux_glob_s, alt) / rho0

sl = slice(None, idx_tropo)
fig, axes = plt.subplots(2, 2, figsize=(14, 11), sharey=True)
st = 1e5  # m/s² -> 1e-5

for row, (tag, A, B, div, tend, trey) in enumerate(
        [('HUMIDE', A_h, B_h, div_h, tend_h, tend_rey_h),
         ('SÈCHE',  A_s, B_s, div_s, tend_s, tend_rey_s)]):

    # (gauche) les deux termes de la divergence du flux de masse
    ax = axes[row, 0]
    ax.plot(A[sl]*sc,   alt[sl], color='darkorange', lw=2.2, label=r'A = $(\partial_z M_c)\,\Delta u$')
    ax.plot(B[sl]*sc,   alt[sl], color='purple',     lw=2.2, label=r'B = $M_c\,\partial_z\Delta u$')
    ax.plot(div[sl]*sc, alt[sl], color='black', lw=2.5, ls='--', label='A + B')
    ax.axvline(0, color='grey', alpha=0.4)
    ax.set_xlabel(r'$\partial_z\Phi$  (×10⁻³)'); ax.set_title(f'{tag} — décomposition divergence', fontweight='bold')
    ax.legend(fontsize=9); ax.grid(alpha=0.3); ax.set_ylabel('Altitude (m)')

    # (droite) tendance vent : Reynolds vs masse(A+B)
    ax = axes[row, 1]
    ax.plot(trey[sl]*st, alt[sl], color='royalblue' if row==0 else 'saddlebrown',
            lw=2.5, label='Reynolds (vérité)')
    ax.plot(tend[sl]*st, alt[sl], color='red', lw=2, ls='--', label=r'masse $-\frac1{\rho_0}(A{+}B)$')
    ax.plot((-A[sl]/rho0[sl])*st, alt[sl], color='darkorange', lw=1.3, ls=':', label='part A')
    ax.plot((-B[sl]/rho0[sl])*st, alt[sl], color='purple',     lw=1.3, ls=':', label='part B')
    ax.axvline(0, color='grey', alpha=0.4)
    ax.set_xlabel(r'$\partial_t\bar u$  (×10⁻⁵ m/s²)'); ax.set_title(f'{tag} — tendance vent', fontweight='bold')
    ax.legend(fontsize=8); ax.grid(alpha=0.3)

plt.suptitle(r'§27 — $\partial_z(M_c\Delta u)=(\partial_z M_c)\Delta u+M_c\partial_z\Delta u$',
             fontsize=13, fontweight='bold')
plt.tight_layout(); plt.show()

# poids relatif des deux termes (norme L2 sur 0-tropo)
print('── Poids relatif des termes A et B (norme L2, 0–tropo) ──')
for tag, A, B in [('HUMIDE', A_h, B_h), ('SÈCHE', A_s, B_s)]:
    nA = np.sqrt(np.nansum(A[sl]**2)); nB = np.sqrt(np.nansum(B[sl]**2))
    print(f'{tag:7s}: ||A||={nA*sc:7.3f}  ||B||={nB*sc:7.3f}  '
          f'-> A domine à {100*nA/(nA+nB):4.1f}%')









# ============================================================================
# §28 — Tout exprimer en fonction de Δu = u_c - u_e
# ----------------------------------------------------------------------------
# En injectant l'éq. bulk-plume (1) ∂_z Mc = (ε-δ)Mc  (§22) dans le terme A :
#
#   ∂_z(Mc·Δu) = (ε-δ)·Mc·Δu  +  Mc·∂_z Δu
#              = Mc·[ (ε-δ)·Δu + ∂_z Δu ]
#
# d'où la tendance ENTIÈREMENT pilotée par le flux de masse et le contraste Δu :
#
#   ∂_t ū = -(1/ρ₀)·Mc·[ (ε-δ)Δu + ∂_z Δu ]
#
# On vérifie que cette réécriture reproduit bien div_h/div_s du §27 (sanity check),
# puis on caractérise la VARIATION de Δu : valeur, cisaillement ∂_zΔu, et
# corrélation Δu ↔ ū-u_c (l'autre contraste, cf. avertissement §21).
# ============================================================================

# (ε-δ) déjà calculable ; on le recalcule en s^-1 (sans le ×1000 du §22)
def eps_delta_si(M, seuil_rel=0.05):
    dMdz = np.gradient(M, alt)
    seuil = seuil_rel * np.nanmax(np.abs(M))
    return np.where(np.abs(M) > seuil, dMdz / M, np.nan)   # m^-1

edh = eps_delta_si(Mc_up_h); eds = eps_delta_si(Mc_up_s)

# réécriture Mc·[(ε-δ)Δu + ∂_zΔu]  vs  div direct A+B
div_re_h = Mc_up_h * (edh*duc_h + np.gradient(duc_h, alt))
div_re_s = Mc_up_s * (eds*duc_s + np.gradient(duc_s, alt))

print('── Sanity check : réécriture (ε-δ) vs dérivée directe ──')
for tag, d1, d2 in [('HUMIDE', div_h, div_re_h), ('SÈCHE', div_s, div_re_s)]:
    ok = np.isfinite(d1[sl]) & np.isfinite(d2[sl])
    err = np.sqrt(np.nanmean((d1[sl][ok[:idx_tropo]] - d2[sl][ok[:idx_tropo]])**2))
    print(f'{tag:7s}: RMS écart = {err*sc:.4e} ×10⁻³  (≈0 attendu)')

# caractérisation de la variation de Δu
fig, axes = plt.subplots(1, 3, figsize=(16, 6), sharey=True)

ax = axes[0]
ax.plot(duc_h[sl], alt[sl], color='royalblue', lw=2.5, label=r'$\Delta u=u_c-u_e$ humide')
ax.plot(duc_s[sl], alt[sl], color='saddlebrown', lw=2.5, label='sèche')
# autre contraste pour comparaison (ū - u_c), de signe opposé (cf. §21)
ax.plot((ubar_h-uc_h)[sl], alt[sl], color='royalblue', lw=1.3, ls=':', label=r'$\bar u-u_c$ humide')
ax.plot((ubar_s-uc_s)[sl], alt[sl], color='saddlebrown', lw=1.3, ls=':', label=r'$\bar u-u_c$ sèche')
ax.axvline(0, color='grey', alpha=0.4); ax.set_xlabel('m/s')
ax.set_title('Contrastes de vent', fontweight='bold'); ax.legend(fontsize=8)
ax.grid(alpha=0.3); ax.set_ylabel('Altitude (m)')

ax = axes[1]
ax.plot(np.gradient(duc_h, alt)[sl]*1e3, alt[sl], color='royalblue', lw=2.5, label='humide')
ax.plot(np.gradient(duc_s, alt)[sl]*1e3, alt[sl], color='saddlebrown', lw=2.5, label='sèche')
ax.axvline(0, color='grey', alpha=0.4)
ax.set_xlabel(r'$\partial_z\Delta u$  (×10⁻³ s⁻¹)')
ax.set_title('Cisaillement du contraste', fontweight='bold'); ax.legend(fontsize=9); ax.grid(alpha=0.3)

ax = axes[2]
ax.plot(edh[sl]*1000, alt[sl], color='royalblue', lw=2.5, label='humide')
ax.plot(eds[sl]*1000, alt[sl], color='saddlebrown', lw=2.5, label='sèche')
ax.axvline(0, color='grey', alpha=0.4); ax.set_xlim(-3, 3)
ax.set_xlabel(r'$(\varepsilon-\delta)$  (km⁻¹)')
ax.set_title('Entraînement net', fontweight='bold'); ax.legend(fontsize=9); ax.grid(alpha=0.3)

plt.suptitle(r'§28 — $\partial_t\bar u=-\frac{1}{\rho_0}M_c[(\varepsilon-\delta)\Delta u+\partial_z\Delta u]$',
             fontsize=13, fontweight='bold')
plt.tight_layout(); plt.show()

# le contraste Δu est-il ~ constant ? ~ linéaire en z ? -> conditionne la param
print('\n── Caractérisation de Δu (0–tropo) ──')
for tag, duc in [('HUMIDE', duc_h), ('SÈCHE', duc_s)]:
    d = duc[sl]; ok = np.isfinite(d)
    z = alt[sl][ok]
    pente, ordo = np.polyfit(z, d[ok], 1)
    print(f'{tag:7s}: <Δu>={np.nanmean(d):+.3f} m/s  σ(Δu)={np.nanstd(d):.3f}  '
          f'∂_zΔu(lin)={pente*1e3:+.4f}×10⁻³ s⁻¹  '
