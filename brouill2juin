# ============================================================
#  Test anti-circularite : la relation flux~cisaillement survit-elle
#  une fois retiree la composante lente commune (~20j) partagee par tout ?
# ============================================================
from scipy.ndimage import uniform_filter1d

# 1) on retire la tendance lente (moyenne glissante longue, ex 15 pas ~ 4 jours)
WIN_LENT = 15
def hipass(fld):
    lent = uniform_filter1d(fld, size=WIN_LENT, axis=1, mode='nearest')
    return fld - lent

dudz_hp = hipass(dudz_zt)
uw_hp   = hipass(uw_zt)

# 2) comparaison : correlation brute (piegee) vs correlation apres retrait du mode lent
x_brut, y_brut = -dudz_zt[m28].ravel(), uw_zt[m28].ravel()
x_hp,   y_hp   = -dudz_hp[m28].ravel(), uw_hp[m28].ravel()
ok_b = np.isfinite(x_brut)&np.isfinite(y_brut); ok_h = np.isfinite(x_hp)&np.isfinite(y_hp)

r_brut = np.corrcoef(x_brut[ok_b], y_brut[ok_b])[0,1]
r_hp   = np.corrcoef(x_hp[ok_h],   y_hp[ok_h])[0,1]
print(f"correlation flux vs -dudz, BRUTE (avec mode lent)      : r={r_brut:+.2f}")
print(f"correlation flux vs -dudz, APRES retrait du mode lent  : r={r_hp:+.2f}")

fig,axes=plt.subplots(1,2,figsize=(10,4.5))
axes[0].scatter(x_brut[ok_b],y_brut[ok_b],s=3,alpha=.15)
axes[0].set_title(f"brut, r={r_brut:+.2f}"); axes[0].set_xlabel('-dudz'); axes[0].set_ylabel("u'w'")
axes[1].scatter(x_hp[ok_h],y_hp[ok_h],s=3,alpha=.15)
axes[1].set_title(f"haute-frequence, r={r_hp:+.2f}"); axes[1].set_xlabel('-dudz (hp)')
plt.tight_layout(); plt.show()
