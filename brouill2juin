# ============================================================================
# S26 — Sensibilite au seuil + SELECTION du meilleur seuil
#   Pour chaque (W0,C) : seuil ws(z)=max(W0, C*sigma_w(z)).
#   On recalcule Mc, Du=u_c-u_e, Phi=Mc*Du, puis on confronte au Reynolds verite.
#   Meilleur seuil = celui qui minimise |pente_humide - 1| (identite la plus fidele).
# ============================================================================

iz_lo = int(np.searchsorted(alt, 2000))
iz_hi = int(np.searchsorted(alt, 18000))
disp  = slice(iz_lo, iz_hi)

seuils = [(0.0, 0.5), (0.0, 1.0), (0.0, 1.5), (0.0, 2.0),
          (0.5, 1.0), (1.0, 1.0), (0.25, 0.75)]

def diag_flux_masse(W0, C, region_mask):
    """Recalcule (Mc, Du, Phi, sigma) profils pleine colonne pour un seuil donne."""
    Mc  = np.zeros(n_z); duc = np.zeros(n_z); sig = np.zeros(n_z)
    ds_u = xr.open_dataset(path3d('ua'))
    ds_w = xr.open_dataset(path3d('wa'))
    for iz in range(n_z):
        a_mc = a_uc = a_ue = a_sg = 0.0; n = 0
        for it in range(t_stat, n_t):
            u_r = ds_u['ua'].isel({dim_t: it, dim_z: iz}).values[region_mask]
            w_r = ds_w['wa'].isel({dim_t: it, dim_z: iz}).values[region_mask]
            ws  = max(W0, C * w_r.std())
            up  = w_r > ws
            a_mc += (w_r * up).mean()
            a_uc += u_r[up].mean()  if up.any()    else u_r.mean()
            a_ue += u_r[~up].mean() if (~up).any() else u_r.mean()
            a_sg += up.mean()
            n += 1
            del u_r, w_r, up
        Mc[iz]  = rho0[iz] * a_mc / n
        duc[iz] = (a_uc - a_ue) / n
        sig[iz] = a_sg / n
        gc.collect()
    ds_u.close(); ds_w.close(); del ds_u, ds_w; gc.collect()
    return Mc, duc, Mc * duc, sig

res_seuil = {}
for (W0, C) in seuils:
    print('seuil W0=' + str(W0) + ' C=' + str(C) + ' ...', end=' ', flush=True)
    d = {}
    for tag, mask, fr in [('h', mh, flux_glob_h), ('s', ms, flux_glob_s)]:
        Mc, duc, Phi, sig = diag_flux_masse(W0, C, mask)
        a = fr[disp]; b = Phi[disp]
        ok = np.isfinite(a) & np.isfinite(b)
        r     = np.corrcoef(a[ok], b[ok])[0, 1]
        pente = (a[ok] @ b[ok]) / (b[ok] @ b[ok]) if (b[ok] @ b[ok]) != 0 else np.nan
        d[tag] = dict(Mc=Mc, duc=duc, Phi=Phi, sig=sig, r=r, pente=pente)
    res_seuil[(W0, C)] = d
    print('corr_h=' + format(d['h']['r'], '+.3f')
          + ' pente_h=' + format(d['h']['pente'], '+.2f')
          + ' | corr_s=' + format(d['s']['r'], '+.3f')
          + ' pente_s=' + format(d['s']['pente'], '+.2f'))

# --- SELECTION du meilleur seuil : pente humide la plus proche de 1 ---
def score(k):
    p = res_seuil[k]['h']['pente']
    return abs(p - 1.0) if np.isfinite(p) else np.inf

best = min(seuils, key=score)
W0_BEST, C_BEST = best
print()
print('>>> MEILLEUR SEUIL : W0=' + str(W0_BEST) + '  C=' + str(C_BEST)
      + '  (pente_h=' + format(res_seuil[best]['h']['pente'], '+.3f')
      + ', corr_h=' + format(res_seuil[best]['h']['r'], '+.3f') + ')')

# --- on FIGE les profils du meilleur seuil pour tout le reste (S27-S29) ---
Mc_up_h   = res_seuil[best]['h']['Mc'].copy()
Mc_up_s   = res_seuil[best]['s']['Mc'].copy()
duc_h     = res_seuil[best]['h']['duc'].copy()
duc_s     = res_seuil[best]['s']['duc'].copy()
Phi_masse_h = res_seuil[best]['h']['Phi'].copy()
Phi_masse_s = res_seuil[best]['s']['Phi'].copy()
sig_h     = res_seuil[best]['h']['sig'].copy()
sig_s     = res_seuil[best]['s']['sig'].copy()
print('Mc_up_*, duc_*, Phi_masse_* recalcules avec le meilleur seuil.')









