curv_anom  = detrend(d2udz2_zt, axis=1) * 1e6   # 10^-6 m^-1 s^-1

plots = [
    {"data": shear_anom, "title": r"Anomalie cisaillement $\partial_z\bar u'$ ($10^{-3}$ s$^{-1}$)"},
    {"data": curv_anom,  "title": r"Anomalie courbure $\partial_z^2\bar u'$ ($10^{-6}$ m$^{-1}$s$^{-1}$)"},
]
