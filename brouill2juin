# ======================================================================
#  4a — Coupe (z,x) moyennée-y à IT_DECOMP, TRONQUÉE à z ≤ Z_MAX
#       <u>_y, <w>_y, vorticité zeta' (anomalie x) + psi (réutilise psi_poisson_periodic)
#       Troncature : on écarte le jet/haute troposphère qui captait l'ondelette.
#  Dépend de : path3d, dim_t, dim_z, n_x, x, alt, IT_DECOMP, rho0_full,
#              psi_poisson_periodic, t_stat, n_t, BLOC, EPSILON, Rd.
# ======================================================================
import numpy as np, xarray as xr, gc

Z_MAX = 18000.0                                  # m — plafond d'analyse

# --- garde-fou rho0_full (calculé dans le bloc lignes de courant) ---
if 'rho0_full' not in dir():
    _nz_full = alt.size
    rho0_full = np.zeros(_nz_full); _nr = 0
    _da = xr.open_dataset(path3d('ta')); _dp = xr.open_dataset(path3d('pa')); _dh = xr.open_dataset(path3d('hus'))
    for t0 in range(t_stat, n_t, BLOC):
        t1 = min(t0+BLOC, n_t); sl = {dim_t: slice(t0,t1)}
        T = _da['ta'].isel(sl).values; P = _dp['pa'].isel(sl).values; Q = _dh['hus'].isel(sl).values
        Tv = T*(1.0+Q/EPSILON)/(1.0+Q)
        rho0_full += (P/(Rd*Tv)).mean(axis=(0,2,3))*(t1-t0); _nr += (t1-t0)
        del T,P,Q,Tv; gc.collect()
    _da.close(); _dp.close(); _dh.close(); del _da,_dp,_dh; gc.collect()
    rho0_full /= _nr

# --- bande verticale tronquée ---
iz_lst   = np.where(alt <= Z_MAX)[0]             # <-- seuls les niveaux z ≤ Z_MAX
z_D      = alt[iz_lst].copy(); nz_D = z_D.size
rho0_D   = rho0_full[iz_lst].copy()
print(f"bande analysée : {z_D[0]/1000:.1f}–{z_D[-1]/1000:.1f} km  ({nz_D} niveaux, Z_MAX={Z_MAX/1000:.0f} km)")

Uy2d = np.zeros((nz_D, n_x))                      # <u>_y(z,x)
Wy2d = np.zeros((nz_D, n_x))                      # <w>_y(z,x)
worg_all = np.zeros((nz_D, n_x))                 # w organisé (paliers up/dn/env) -> spectralisé en 4b

ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for j, iz in enumerate(iz_lst):
    u_yx = ds_u['ua'].isel({dim_t: IT_DECOMP, dim_z: iz}).values
    w_yx = ds_w['wa'].isel({dim_t: IT_DECOMP, dim_z: iz}).values
    uy = u_yx.mean(axis=0); wy = w_yx.mean(axis=0)
    Uy2d[j] = uy; Wy2d[j] = wy

    # --- w organisé par paliers (mêmes conventions que la section spectrale) ---
    ubar, wbar = uy.mean(), wy.mean()
    ws = max(W0_MIN, C_DECOMP * wy.std())
    masks = {'up': wy > ws, 'dn': wy < -ws, 'env': np.abs(wy) <= ws}
    w_org = np.zeros(n_x)
    for k, m in masks.items():
        if m.any():
            w_org[m] = wy[m].mean() - wbar
    worg_all[j] = w_org
    del u_yx, w_yx; gc.collect()
ds_u.close(); ds_w.close(); del ds_u, ds_w; gc.collect()

dxl = float(x[1]-x[0])
dzl = float(np.mean(np.diff(z_D)))

# --- vorticité de circulation + anomalie en x (servira de marqueur de rotation en §5/6) ---
dWdx = (np.roll(Wy2d, -1, axis=1) - np.roll(Wy2d, 1, axis=1)) / (2*dxl)
dUdz = np.gradient(Uy2d, z_D, axis=0)
zeta   = dWdx - dUdz
zeta_a = zeta - zeta.mean(axis=1, keepdims=True)

# --- psi cohérent avec la section 1bis, sur la bande tronquée ---
psi2d = psi_poisson_periodic(Uy2d, Wy2d, x, z_D, rho0_D)

print(f"coupe (z,x) prête : {Uy2d.shape}  dx={dxl/1000:.2f} km  dz≈{dzl:.0f} m")
print(f"w_org : std médian (en x) = {np.median(worg_all.std(axis=1)):.2e} m/s")








# ======================================================================
#  4b — CWT 2D Morlet anisotrope sur w_org(x,z), variance-preserving
#  ----------------------------------------------------------------------
#  Champ spectralisé : worg_all (panaches organisés), pondéré rho0 pour ne pas
#  surpondérer la haute troposphère. Bande déjà tronquée à Z_MAX (cellule 4a).
#  Normalisation variance-preserving : |W|² / (sx·sz) -> pic = vrai max interne.
# ======================================================================
import numpy as np

W0_MORLET = 6.0
NSX, NSZ  = 14, 10

Lx_dom = n_x * dxl
Lz_dom = (z_D[-1] - z_D[0])
scales_x = np.geomspace(2*dxl, Lx_dom/2, NSX)
scales_z = np.geomspace(2*dzl, Lz_dom/2, NSZ)
fourier_factor = (4*np.pi) / (W0_MORLET + np.sqrt(2 + W0_MORLET**2))
lamx_km = scales_x * fourier_factor / 1000.0
lamz_km = scales_z * fourier_factor / 1000.0

# --- champ : w organisé, pondéré rho0, sur grille z régularisée ---
z_reg = np.linspace(z_D[0], z_D[-1], nz_D)
champ_reg = np.empty((nz_D, n_x))
for i in range(n_x):
    champ_reg[:, i] = np.interp(z_reg, z_D, worg_all[:, i])
rho0_reg = np.interp(z_reg, z_D, rho0_D)
champ_reg *= (rho0_reg / rho0_reg[0])[:, None]    # pondération masse
dzr = float(z_reg[1] - z_reg[0])

kx = np.fft.fftfreq(n_x,  d=dxl) * 2*np.pi
kz = np.fft.fftfreq(nz_D, d=dzr) * 2*np.pi
KX, KZ = np.meshgrid(kx, kz)
Zhat = np.fft.fft2(champ_reg)
k0 = W0_MORLET

def cwt2d_morlet(sx, sz):
    """|W|² de la CWT 2D pour l'échelle (sx,sz)."""
    skx = sx * KX; skz = sz * KZ
    psih = (np.pi**-0.5) * np.sqrt(sx*sz/(dxl*dzr)) \
           * (skx > 0) * np.exp(-0.5*((skx - k0)**2 + skz**2))
    W = np.fft.ifft2(Zhat * psih)
    return np.abs(W)**2

# --- énergie 2D variance-preserving : E(λx,λz) = Σ_{x,z} |W|² / (sx·sz) ---
E2 = np.zeros((NSZ, NSX))
for a in range(NSZ):
    for b in range(NSX):
        E2[a, b] = cwt2d_morlet(scales_x[b], scales_z[a]).sum() / (scales_x[b]*scales_z[a])

az, bx = np.unravel_index(np.argmax(E2), E2.shape)
sx_pk, sz_pk = scales_x[bx], scales_z[az]
print(f"échelle 2D dominante : λx ≈ {lamx_km[bx]:.0f} km,  λz ≈ {lamz_km[az]:.1f} km")
if bx in (0, NSX-1) or az in (0, NSZ-1):
    print("  ⚠️ pic sur un BORD du balayage -> élargis scales_x/scales_z ou augmente NSX/NSZ")

# --- carte de présence (x,z) à l'échelle pic ---
Wmap_pk = cwt2d_morlet(sx_pk, sz_pk)

# --- zeta_reg pour §5/6 (marqueur de rotation au cœur), sur la même grille ---
zeta_reg = np.empty((nz_D, n_x))
for i in range(n_x):
    zeta_reg[:, i] = np.interp(z_reg, z_D, zeta_a[:, i])

# ======================================================================
#  FIGURE — (a) spectre 2D variance-preserving   (b) carte (x,z) au pic
# ======================================================================
import matplotlib.pyplot as plt
fig, ax = plt.subplots(1, 2, figsize=(14, 5.2))

pc0 = ax[0].pcolormesh(lamx_km, lamz_km, E2, shading='auto', cmap='magma')
ax[0].set_xscale('log'); ax[0].set_yscale('log')
ax[0].plot(lamx_km[bx], lamz_km[az], 'c*', ms=16, mec='k', label='pic')
ax[0].set_xlabel(r'$\lambda_x$ [km]'); ax[0].set_ylabel(r'$\lambda_z$ [km]')
ax[0].set_title(r'(a) Énergie 2D variance-preserving $E(\lambda_x,\lambda_z)/(s_x s_z)$')
ax[0].legend(fontsize=9); fig.colorbar(pc0, ax=ax[0], label='énergie / échelle', pad=0.01)

pc1 = ax[1].pcolormesh(x/1000, z_reg/1000, Wmap_pk, shading='auto', cmap='magma')
ax[1].set_xlabel('x [km]'); ax[1].set_ylabel('z [km]')
ax[1].set_title(fr'(b) Présence à $(\lambda_x,\lambda_z)\approx({lamx_km[bx]:.0f},{lamz_km[az]:.1f})$ km')
fig.colorbar(pc1, ax=ax[1], label=r'$|W_{2D}|^2$', pad=0.01)
plt.tight_layout(); plt.show()
