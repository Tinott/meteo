# --- 2. QUANTIFICATION DE LA SIGNATURE ONDULATOIRE (2 - 8 km) ---
print("\n" + "="*60)
print(" QUANTIFICATION DE LA SIGNATURE ONDULATOIRE (Couche 2-8 km)")
print("="*60)

# Filtrage temporel (band-pass ou detrend) pour isoler les anomalies du jet d'est
ubar_anom = detrend(ubar_zt[m28, :], axis=1)

# Application de la transformée de Hilbert par niveau d'altitude pour extraire la phase de l'onde
phase_zt = np.angle(hilbert(ubar_anom, axis=1))

# Estimation de la vitesse de phase verticale (dz/dt) par corrélation croisée temporelle
zkm_m28 = zkm[m28]
time_steps = np.arange(n_stat)
lags = np.arange(-20, 20)
matrix_corr = np.zeros((len(zkm_m28)-1, len(lags)))

for i in range(len(zkm_m28)-1):
    # Corrélation entre le niveau i et le niveau i+1
    ref = ubar_anom[i, :]
    target = ubar_anom[i+1, :]
    corr = np.correlate(ref - np.mean(ref), target - np.mean(target), mode='same')
    center = len(corr) // 2
    matrix_corr[i, :] = corr[center + lags]

# Décalage temporel moyen optimal (lag en indices de temps)
mean_corr_profile = matrix_corr.mean(axis=0)
opt_lag_idx = lags[np.argmax(mean_corr_profile)]
dt_lag_hours = opt_lag_idx * (dt_phys / 3600.0)

# Calcul de la vitesse de descente moyenne (dz/dt)
dz_mean_m = np.mean(np.diff(alt[m28]))
dt_mean_s = opt_lag_idx * dt_phys

if dt_mean_s != 0:
    w_phase_vertical = (dz_mean_m / dt_mean_s) * 1000.0  # mm/s
    # Inversion de signe pour exprimer une descente positive
    w_descent = -w_phase_vertical if w_phase_vertical < 0 else w_phase_vertical
    print(f"-> Décalage temporel optimal entre niveaux adjacents : {dt_lag_hours:+.1f} heures")
    print(f"-> Vitesse moyenne de migration de la phase vers le bas : {w_descent:.3f} mm/s (~{(w_descent*86.4):.1f} m/jour)")
else:
    print("-> Signal hautement stationnaire ou pas temporel dt trop grossier pour résoudre le lag vertical.")

