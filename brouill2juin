### Analyse du Vent Moyen Horizontal à l'État Stationnaire

# On sélectionne les pas de temps correspondant à l'état stationnaire (ex: les 20 derniers moments)
# Vos données ont 100 moments (de 75 à 100 jours d'après le print), la fin est stabilisée.
indices_stationnaires = slice(-20, None) 

# 1. Calcul des profils de vent moyen horizontal (moyenne sur X, Y et sur le Temps stationnaire)
u_moyen_vertical = data_ua['ua'].isel(time=indices_stationnaires).mean(dim=['time', 'x', 'y'])
v_moyen_vertical = data_va['va'].isel(time=indices_stationnaires).mean(dim=['time', 'x', 'y'])

# Calcul du module du vent horizontal moyen
vitesse_horizontale_moyenne = np.sqrt(u_moyen_vertical**2 + v_moyen_vertical**2)

# Altitude (axe Z)
altitude = data_ua['altitude'].values

# 2. Seuil de tolérance numérique pour tester si le vent est "non nul"
seuil_zero = 1e-2 # m/s

vitesse_max = vitesse_horizontale_moyenne.max().values
print(f"Vitesse maximale du vent moyen horizontal détectée : {vitesse_max:.4f} m/s")

if vitesse_max > seuil_zero:
    print(" CONCLUSION : Il existe un vent moyen horizontal NON NUL à l'état stationnaire.")
    print("   Cela implique l'existence d'un vent de rappel (prescrit/nudging) dans les simulations RCE")
    print("   qui équilibre la divergence des flux de friction (tenseur de Reynolds/tau).")
else:
    print(" CONCLUSION : Le vent moyen horizontal est NUL (aux fluctuations numériques près).")
    print("   Il n'y a pas de vent de rappel horizontal imposé à grande échelle.")

# 3. Visualisation du profil vertical du vent moyen
plt.figure(figsize=(6, 8))
plt.plot(u_moyen_vertical, altitude, label=r'Composante $\overline{u}$', color='blue', linewidth=2)
plt.plot(v_moyen_vertical, altitude, label=r'Composante $\overline{v}$', color='green', linewidth=2)
plt.plot(vitesse_horizontale_moyenne, altitude, label='Module du vent horizontal', color='black', linestyle='--', linewidth=1.5)

plt.axvline(0, color='red', alpha=0.5, linestyle=':')
plt.title("Profil vertical du vent horizontal moyen\nà l'état stationnaire", fontsize=12, fontweight='bold')
plt.xlabel("Vitesse du vent (m/s)")
plt.ylabel("Altitude (m)")
plt.grid(True, alpha=0.3)
plt.legend(loc='best')
plt.tight_layout()
plt.show()
