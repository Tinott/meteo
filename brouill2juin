ubar_h_intra = np.array([ubar_2d[iz][mh].mean() for iz in range(n_z)])
ubar_s_intra = np.array([ubar_2d[iz][ms].mean() for iz in range(n_z)])
ubar_dom     = np.array([ubar_2d[iz].mean()      for iz in range(n_z)])

# <u′>_reg dans le cas global : u′ = u - ū_dom, donc <u′>_reg = ū_reg - ū_dom
uprime_mean_h = ubar_h_intra - ubar_dom   # non nul si les régions ont un vent moyen différent
uprime_mean_s = ubar_s_intra - ubar_dom

idx_tropo = np.searchsorted(alt, 15000)
sl = slice(None, idx_tropo)

fig, axes = plt.subplots(1, 2, figsize=(14, 8), sharey=True)

# ── Panneau 1 : ū_reg vs ū_dom ────────────────────────────────────────
ax = axes[0]
ax.plot(ubar_h_intra[sl], alt[sl], color='royalblue',   lw=2, label=r'$\bar{u}_{\mathrm{humide}}$')
ax.plot(ubar_s_intra[sl], alt[sl], color='saddlebrown', lw=2, label=r'$\bar{u}_{\mathrm{sèche}}$')
ax.plot(ubar_dom[sl],     alt[sl], color='black', lw=2, linestyle='--', label=r'$\bar{u}_{\mathrm{domaine}}$')
ax.axvline(0, color='grey', alpha=0.4)
ax.set_xlabel('m/s')
ax.set_ylabel('Altitude (m)')
ax.set_title(r'$\bar{u}$ selon le centrage', fontweight='bold')
ax.legend(fontsize=10) ; ax.grid(True, alpha=0.3)

# ── Panneau 2 : <u′>_reg dans le cas global ───────────────────────────
ax = axes[1]
ax.plot(uprime_mean_h[sl], alt[sl], color='royalblue',   lw=2, label=r"$\langle u' \rangle_{\mathrm{humide}} = \bar{u}_{\mathrm{humide}} - \bar{u}_{\mathrm{dom}}$")
ax.plot(uprime_mean_s[sl], alt[sl], color='saddlebrown', lw=2, label=r"$\langle u' \rangle_{\mathrm{sèche}} = \bar{u}_{\mathrm{sèche}} - \bar{u}_{\mathrm{dom}}$")
ax.axvline(0, color='grey', alpha=0.4)
ax.set_xlabel('m/s')
ax.set_title(r"$\langle u' \rangle_{\mathrm{rég}}$ si $u' = u - \bar{u}_{\mathrm{dom}}$ (non nul)", fontweight='bold')
ax.legend(fontsize=10) ; ax.grid(True, alpha=0.3)

plt.suptitle(r"Centrage intra-région vs domaine entier : $\bar{u}$ et $\langle u'\rangle_{\mathrm{rég}}$",
             fontsize=13, fontweight='bold')
plt.tight_layout()
plt.show()
