# --- 2. QUANTIFICATION ROBUSTE (Exemple étendu au Cisaillement) ---
print("\n" + "="*60)
print(" QUANTIFICATION DE LA SIGNATURE ONDULATOIRE VIA LE CISAILLEMENT")
print("="*60)

# On applique l'analyse sur le cisaillement qui est souvent plus "propre" et exempt de la tendance grande échelle de u_bar
dudz_anom = detrend(dudz_zt[m28, :], axis=1)

zkm_m28 = zkm[m28]
lags = np.arange(-20, 20)
matrix_corr = np.zeros((len(zkm_m28)-1, len(lags)))

for i in range(len(zkm_m28)-1):
    ref = dudz_anom[i, :]
    target = dudz_anom[i+1, :]
    corr = np.correlate(ref - np.mean(ref), target - np.mean(target), mode='same')
    center = len(corr) // 2
    matrix_corr[i, :] = corr[center + lags]

mean_corr_profile = matrix_corr.mean(axis=0)
opt_lag_idx = lags[np.argmax(mean_corr_profile)]
dt_lag_hours = opt_lag_idx * (dt_phys / 3600.0)

dz_mean_m = np.mean(np.diff(alt[m28]))
dt_mean_s = opt_lag_idx * dt_phys

if dt_mean_s != 0:
    w_phase_vertical = (dz_mean_m / dt_mean_s) * 1000.0  # mm/s
    w_descent = -w_phase_vertical if w_phase_vertical < 0 else w_phase_vertical
    print(f"-> Décalage temporel calculé via le cisaillement : {dt_lag_hours:+.1f} heures")
    print(f"-> Vitesse de descente de la structure de cisaillement : {w_descent:.3f} mm/s (~{(w_descent*86.4):.1f} m/jour)")
else:
    print("-> Lag non résolu à cette résolution temporelle.")
