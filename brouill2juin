# ======================================================================
#  Où vit la covariance within T2 ? — Fourier + ondelettes, MÊME pondération
#    WEIGHTING = 'k'    -> area-preserving (k·Co) : contribution par décade log
#    WEIGHTING = 'brut' -> Co brut : amplitude absolue (grandes échelles ressortent)
#  Les DEUX panneaux (a) Fourier et (b) ondelettes utilisent la même convention.
#  CWT Morlet "maison" (NumPy seul) -> pas de dépendance externe (cluster CNRM).
# ======================================================================
CAT       = 'up'
WEIGHTING = 'k'                    # 'k' (area-preserving) ou 'brut'
W0_MORLET = 6.0                    # paramètre adimensionnel de la Morlet (ω0)

nx  = x.size
dx  = float(x[1] - x[0])
print(f"nx={nx}  dx={dx/1000:.2f} km  domaine={nx*dx/1000:.0f} km  | pondération={WEIGHTING}")

assert T2[CAT].shape[0] == nz_D, (
    f"T2[{CAT}] a {T2[CAT].shape[0]} niveaux, bande={nz_D} -> relance le bloc up/dn/env.")

# --- axes spectraux Fourier ---
kx     = np.fft.rfftfreq(nx, d=dx) * 2*np.pi
lam_km = (2*np.pi / np.maximum(kx, 1e-12)) / 1000

Co_T2   = np.zeros((nz_D, kx.size))
T2_chk  = np.zeros(nz_D)
upp_all = np.zeros((nz_D, nx))
wpp_all = np.zeros((nz_D, nx))

# ----------------------------------------------------------------------
#  (0) Reconstruction des anomalies intra-catégorie u'',w'' + co-spectre Fourier
# ----------------------------------------------------------------------
ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for j, iz in enumerate(iz_lst):
    u_yx = ds_u['ua'].isel({dim_t: IT_DECOMP, dim_z: iz}).values
    w_yx = ds_w['wa'].isel({dim_t: IT_DECOMP, dim_z: iz}).values
    uy = u_yx.mean(axis=0); wy = w_yx.mean(axis=0)

    ws = max(W0_MIN, C_DECOMP * wy.std())
    masks = {'up': wy > ws, 'dn': wy < -ws, 'env': np.abs(wy) <= ws}
    m = masks[CAT]

    upp = np.zeros(nx); wpp = np.zeros(nx)
    if m.any():
        upp[m] = uy[m] - uy[m].mean()
        wpp[m] = wy[m] - wy[m].mean()
    upp_all[j] = upp; wpp_all[j] = wpp

    T2_chk[j] = (upp * wpp).mean()

    Fu = np.fft.rfft(upp); Fw = np.fft.rfft(wpp)
    co = np.real(Fu * np.conj(Fw)) / nx**2
    if nx % 2 == 0:               # normalisation Nyquist correcte
        co[1:-1] *= 2
    else:
        co[1:]   *= 2
    Co_T2[j] = co
    del u_yx, w_yx; gc.collect()
ds_u.close(); ds_w.close(); del ds_u, ds_w; gc.collect()

# --- contrôles Fourier ---
err_p = np.abs(Co_T2.sum(axis=1) - T2_chk).max()
err_c = np.abs(T2_chk - T2[CAT]).max()
print(f"[Parseval]  max|sum_λ Co - T2|       = {err_p:.2e}")
print(f"[cohérence] max|T2_spectre - T2[{CAT}]| = {err_c:.2e}")

k_max = int(np.argmax(np.abs(T2_chk)))
print(f"niveau |T2_{CAT}| max : z = {z_D[k_max]/1000:.1f} km")

# --- échelle dominante Fourier (barycentre |Co| en log-λ) ---
lam_dom = np.zeros(nz_D)
for j in range(nz_D):
    w_ = np.abs(Co_T2[j, 1:])
    lam_dom[j] = np.exp(np.sum(w_*np.log(lam_km[1:])) / (w_.sum()+1e-30)) if w_.sum()>0 else np.nan

# ----------------------------------------------------------------------
#  (1) CWT Morlet NumPy-only -> co-scalogramme co(λ, z) moyenné en x
#      Morlet : psi_hat(s·k) = pi^-1/4 · H(k) · exp(-(s·k - w0)^2 / 2)
#      Relation échelle<->longueur d'onde de Fourier :
#         lam = 2*pi*s / (w0 + sqrt(2 + w0^2))         (Torrence & Compo 1998)
# ----------------------------------------------------------------------
NSCALE = 48
# bornes d'échelle : de ~2 dx (Nyquist) à ~ la moitié du domaine
s_min  = 2.0 * dx / (W0_MORLET + np.sqrt(2 + W0_MORLET**2)) * (W0_MORLET + np.sqrt(2 + W0_MORLET**2)) / (2*np.pi) * (2*np.pi)  # = 2 dx en échelle Fourier
scales = np.geomspace(2*dx, nx*dx/2, NSCALE)               # échelles s [m]
# facteur de conversion échelle s -> longueur d'onde de Fourier lam
fourier_factor = (4*np.pi) / (W0_MORLET + np.sqrt(2 + W0_MORLET**2))
lam_w  = scales * fourier_factor / 1000.0                  # [km], 1 par échelle

# fréquences angulaires du domaine périodique (FFT complète)
k_full = np.fft.fftfreq(nx, d=dx) * 2*np.pi                # [rad/m]

def cwt_morlet(sig):
    """CWT Morlet via FFT (domaine périodique). Retourne W[n_scale, nx] complexe."""
    Sig = np.fft.fft(sig)
    out = np.empty((NSCALE, nx), dtype=complex)
    norm = (np.pi**-0.25)
    for i, s in enumerate(scales):
        sk    = s * k_full
        psih  = norm * np.sqrt(2*np.pi*s/dx) * (sk > 0) * np.exp(-0.5*(sk - W0_MORLET)**2)
        out[i] = np.fft.ifft(Sig * psih)
    return out

# co-scalogramme : moyenne en x du produit croisé Re(Wu · conj(Ww))
co_xz = np.zeros((nz_D, NSCALE))
for j in range(nz_D):
    Wu = cwt_morlet(upp_all[j])
    Ww = cwt_morlet(wpp_all[j])
    co_xz[j] = np.real(Wu * np.conj(Ww)).mean(axis=1)      # moyenne sur x -> co(λ) par niveau

# --- échelle dominante ondelettes (barycentre |co_xz| en log-λ) ---
lam_dom_w = np.zeros(nz_D)
for j in range(nz_D):
    w_ = np.abs(co_xz[j])
    lam_dom_w[j] = np.exp(np.sum(w_*np.log(lam_w)) / (w_.sum()+1e-30)) if w_.sum()>0 else np.nan

# ======================================================================
#  Application de la pondération choisie aux DEUX panneaux
# ======================================================================
if WEIGHTING == 'k':
    A_spec  = kx[None, 1:] * Co_T2[:, 1:]          # k·Co  (Fourier)
    k_scale = 2*np.pi / (lam_w[None, :] * 1000.0)  # k de chaque échelle ondelette [rad/m]
    A_scal  = co_xz * k_scale                      # k·Co  (ondelettes)
    lab     = r'$k\,\mathrm{Co}$'
else:  # 'brut'
    A_spec  = Co_T2[:, 1:]
    A_scal  = co_xz
    lab     = r'$\mathrm{Co}$'

# ======================================================================
#  FIGURE — (a) Fourier   (b) ondelettes Morlet
# ======================================================================
fig, ax = plt.subplots(1, 2, figsize=(13, 5.5), sharey=True)

# (a) co-spectre Fourier
mA = np.percentile(np.abs(A_spec), 99) + 1e-30
pc0 = ax[0].pcolormesh(lam_km[1:], z_D/1000, A_spec, shading='auto',
                       norm=TwoSlopeNorm(vcenter=0, vmin=-mA, vmax=mA), cmap='RdBu_r')
ax[0].plot(lam_dom, z_D/1000, 'k-', lw=1.5, alpha=.6, label='échelle dominante')
ax[0].set_xscale('log'); ax[0].invert_xaxis()
ax[0].set_xlabel(r'$\lambda$ [km]'); ax[0].set_ylabel('z [km]')
ax[0].set_title(fr'(a) Co-spectre Fourier de $T_2^{{{CAT}}}$ ({WEIGHTING})')
ax[0].legend(fontsize=8, loc='upper left')
fig.colorbar(pc0, ax=ax[0], label=lab, pad=0.01)

# (b) co-scalogramme ondelettes
mB = np.percentile(np.abs(A_scal), 99) + 1e-30
pc1 = ax[1].pcolormesh(lam_w, z_D/1000, A_scal, shading='auto',
                       norm=TwoSlopeNorm(vcenter=0, vmin=-mB, vmax=mB), cmap='RdBu_r')
ax[1].plot(lam_dom_w, z_D/1000, 'k-', lw=1.5, alpha=.6, label='échelle dominante')
ax[1].set_xscale('log'); ax[1].invert_xaxis()
ax[1].set_xlabel(r'$\lambda$ [km]')
ax[1].set_title(fr'(b) Co-scalogramme Morlet de $T_2^{{{CAT}}}$ ({WEIGHTING})')
ax[1].legend(fontsize=8, loc='upper left')
fig.colorbar(pc1, ax=ax[1], label=lab, pad=0.01)

plt.tight_layout(); plt.show()
