# ======================================================================
#  BLOC A — Co-spectre 2D Fourier (k_x, k_z) du flux organisé T1
#  ----------------------------------------------------------------------
#  On construit les CHAMPS 2D (z,x) du flux organisé, à it = IT_DECOMP :
#      u_org(z,x) = uc[cat(z,x)] - ūbar(z)      (palier par catégorie)
#      w_org(z,x) = wc[cat(z,x)] - w̄bar(z)
#  puis FFT-2D :  Co2(k_x,k_z) = Re[ Û_org · conj(Ŵ_org) ]
#  -> quelles PAIRES (échelle horizontale, échelle verticale) portent T1.
#
#  x est périodique  -> pas de fenêtre en x.
#  z est borné (Dirichlet) -> fenêtre de Hann en z pour éviter le faux
#  signal grande échelle dû aux bords (amplitude qualitative, localisation
#  d'échelle correcte).
#
#  Dépend de : x, alt, iz_lst, z_D, nz_D, dim_t, dim_z, path3d,
#              IT_DECOMP, C_DECOMP, W0_MIN.
# ======================================================================
CATS = ('up', 'dn', 'env')
nx   = x.size
dx   = float(x[1] - x[0])
dz   = float(z_D[1] - z_D[0])
print(f"[T1 2D] grille (z,x) = ({nz_D},{nx})  dx={dx/1000:.2f} km  dz={dz/1000:.2f} km")

# ----------------------------------------------------------------------
#  (A.1) reconstruction des champs 2D organisés u_org(z,x), w_org(z,x)
# ----------------------------------------------------------------------
u_org2d = np.zeros((nz_D, nx))
w_org2d = np.zeros((nz_D, nx))
T1_prof = np.zeros(nz_D)                      # contrôle : T1(z)

ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for j, iz in enumerate(iz_lst):
    uy = ds_u['ua'].isel({dim_t: IT_DECOMP, dim_z: iz}).values.mean(axis=0)
    wy = ds_w['wa'].isel({dim_t: IT_DECOMP, dim_z: iz}).values.mean(axis=0)
    ubar, wbar = uy.mean(), wy.mean()
    ws = max(W0_MIN, C_DECOMP * wy.std())
    masks = {'up': wy > ws, 'dn': wy < -ws, 'env': np.abs(wy) <= ws}
    for k in CATS:
        m = masks[k]
        if m.any():
            u_org2d[j, m] = uy[m].mean() - ubar
            w_org2d[j, m] = wy[m].mean() - wbar
    T1_prof[j] = (u_org2d[j] * w_org2d[j]).mean()
ds_u.close(); ds_w.close(); del ds_u, ds_w; gc.collect()

# ----------------------------------------------------------------------
#  (A.2) FFT-2D : fenêtre de Hann en z (apodisation), brut en x (périodique)
# ----------------------------------------------------------------------
win_z = np.hanning(nz_D)[:, None]            # (nz_D,1)
# correction d'énergie de la fenêtre pour garder une amplitude comparable
win_norm = np.sqrt(np.mean(win_z**2))
Uw = (u_org2d * win_z) / win_norm
Ww = (w_org2d * win_z) / win_norm

# axes spectraux : x via rfft (positifs), z via fft complet (signé)
kx_full = np.fft.rfftfreq(nx,   d=dx) * 2*np.pi      # >= 0
kz_full = np.fft.fftfreq(nz_D, d=dz) * 2*np.pi       # signé
kz_sh   = np.fft.fftshift(kz_full)

Fu = np.fft.rfft2(Uw, axes=(0, 1))           # FFT z (complet) + x (rfft)
Fw = np.fft.rfft2(Ww, axes=(0, 1))
Co2 = np.real(Fu * np.conj(Fw)) / (nz_D * nx)**2
# repli des fréquences x négatives (rfft) sauf 0 et Nyquist
if nx % 2 == 0:
    Co2[:, 1:-1] *= 2
else:
    Co2[:, 1:] *= 2
Co2 = np.fft.fftshift(Co2, axes=0)           # centre k_z = 0

# longueurs d'onde pour les axes (km) ; on évite la division par 0
lamx_km = np.where(kx_full > 0, 2*np.pi/np.maximum(kx_full,1e-30)/1000, np.nan)
lamz_km = np.where(np.abs(kz_sh) > 0, 2*np.pi/np.maximum(np.abs(kz_sh),1e-30)/1000, np.nan)

# ----------------------------------------------------------------------
#  (A.3) diagnostics : pic spectral et orientation k_z/k_x dominante
# ----------------------------------------------------------------------
# on ignore la colonne k_x = 0 (moyenne verticale) pour chercher le pic
absCo = np.abs(Co2.copy()); absCo[:, 0] = 0
iz_pk, ix_pk = np.unravel_index(np.argmax(absCo), absCo.shape)
kx_pk, kz_pk = kx_full[ix_pk], kz_sh[iz_pk]
print(f"[pic 2D] λ_x ≈ {2*np.pi/max(kx_pk,1e-30)/1000:5.1f} km   "
      f"λ_z ≈ {2*np.pi/max(abs(kz_pk),1e-30)/1000:5.2f} km   "
      f"(pente k_z/k_x = {kz_pk/max(kx_pk,1e-30):+.2f})")
print(f"[contrôle] T1 max profil : z = {z_D[int(np.argmax(np.abs(T1_prof)))]/1000:.1f} km")

# ======================================================================
#  FIGURE A — carte (λ_x, λ_z) du co-spectre 2D
# ======================================================================
# pondération area-preserving 2D : |k_x|·|k_z|·Co  (contribution par décade²)
KX, KZ = np.meshgrid(kx_full, kz_sh)
A2 = np.abs(KX) * np.abs(KZ) * Co2
m2 = np.percentile(np.abs(A2), 99.5) + 1e-30

fig, ax = plt.subplots(1, 2, figsize=(14, 6))

# (a) plan (k_x, k_z) signé — montre l'inclinaison des structures
pc = ax[0].pcolormesh(kx_full, kz_sh, A2, shading='auto',
                      norm=TwoSlopeNorm(vcenter=0, vmin=-m2, vmax=m2), cmap='RdBu_r')
ax[0].axhline(0, color='grey', lw=.8, alpha=.6)
ax[0].plot(kx_pk, kz_pk, 'kx', ms=10, mew=2, label='pic')
ax[0].set_xlabel(r'$k_x$ [rad/m]'); ax[0].set_ylabel(r'$k_z$ [rad/m]')
ax[0].set_title('(a) Co-spectre 2D  $|k_x k_z|\\,\\mathrm{Co}_{T_1}(k_x,k_z)$')
ax[0].legend(fontsize=9)
fig.colorbar(pc, ax=ax[0], label='area-preserving co-spec', pad=0.01)

# (b) même chose en longueurs d'onde (log-log), k_z>0 seulement (symétrie)
half = kz_sh > 0
LX = lamx_km[None, 1:]; LZ = lamz_km[half, None]
A2h = A2[half, 1:]
mh = np.percentile(np.abs(A2h), 99.5) + 1e-30
pc2 = ax[1].pcolormesh(np.tile(lamx_km[1:], (half.sum(),1)),
                       np.tile(lamz_km[half][:,None], (1, nx//2)),
                       A2h, shading='auto',
                       norm=TwoSlopeNorm(vcenter=0, vmin=-mh, vmax=mh), cmap='RdBu_r')
ax[1].set_xscale('log'); ax[1].set_yscale('log')
ax[1].invert_xaxis(); ax[1].invert_yaxis()
ax[1].set_xlabel(r'$\lambda_x$ [km]'); ax[1].set_ylabel(r'$\lambda_z$ [km]')
ax[1].set_title('(b) Échelles dominantes  $(\\lambda_x,\\lambda_z)$')
fig.colorbar(pc2, ax=ax[1], label='area-preserving co-spec', pad=0.01)

plt.tight_layout(); plt.show()










# ======================================================================
#  BLOC B — Co-scalogramme 2D ondelettes (chapeau mexicain isotrope)
#  ----------------------------------------------------------------------
#  Pour chaque échelle s, on convolue u_org2d et w_org2d par une ondelette
#  2D isotrope (DOG / "Mexican hat") via FFT, puis on forme la carte locale
#      C_s(z,x) = W_u^s(z,x) · W_w^s(z,x)
#  -> POUR CHAQUE ÉCHELLE, on voit OÙ (x,z) le flux organisé est actif.
#  On agrège ensuite :
#    • carte (échelle, z) : co-activité moyennée en x  -> où en z vit quelle échelle
#    • cartes (x,z) à 3 échelles clés                  -> localisation spatiale
#
#  x périodique (FFT exacte) ; z apodisé par Hann (réduit l'effet de bord).
#  Réutilise u_org2d, w_org2d, x, z_D, nz_D, nx, dx, dz du BLOC A.
# ======================================================================
NSCALE  = 40
# échelles physiques (rayon caractéristique du chapeau) de ~2 dx à ~1/3 domaine
s_min   = 2.0 * dx
s_max   = (nx * dx) / 3.0
scales  = np.geomspace(s_min, s_max, NSCALE)          # [m]
lam_w_km = (2*np.pi / np.sqrt(2)) * scales / 1000     # λ Fourier-équiv. du DOG [km]

# --- grilles de nombres d'onde 2D (x périodique, z apodisé) ---
kx2 = np.fft.fftfreq(nx,   d=dx) * 2*np.pi
kz2 = np.fft.fftfreq(nz_D, d=dz) * 2*np.pi
KXg, KZg = np.meshgrid(kx2, kz2)
K2 = KXg**2 + KZg**2                                   # |k|²

win_z = np.hanning(nz_D)[:, None]
win_z /= np.sqrt(np.mean(win_z**2))
Uf = np.fft.fft2(u_org2d * win_z)
Wf = np.fft.fft2(w_org2d * win_z)

def dog2d_transform(Ff, s):
    """Convolution 2D par chapeau mexicain (DOG) d'échelle s, via FFT.
       psi_hat(k) = -(s|k|)² · exp(-(s|k|)²/2) · norm  (isotrope, moyenne nulle)."""
    sk2 = s*s * K2
    psih = -sk2 * np.exp(-0.5 * sk2)                   # transformée de Fourier du DOG
    psih *= s / np.sqrt(np.sum(psih**2) + 1e-30)       # normalisation L2 par échelle
    return np.real(np.fft.ifft2(Ff * psih))

# --- co-scalogramme : carte (échelle, z) + stockage de 3 cartes (x,z) ---
co_sz = np.zeros((NSCALE, nz_D))                       # co-activité moyennée en x
Z_TARGET_SCALES = [NSCALE//6, NSCALE//2, (5*NSCALE)//6]   # 3 échelles à cartographier
maps_xz = {}

for i, s in enumerate(scales):
    Wu = dog2d_transform(Uf, s)
    Ww = dog2d_transform(Wf, s)
    Cmap = Wu * Ww                                     # carte locale (z,x) du co-flux
    co_sz[i] = Cmap.mean(axis=1)                       # moyenne en x -> profil(z)
    if i in Z_TARGET_SCALES:
        maps_xz[i] = Cmap.copy()

# --- échelle dominante locale : pour chaque z, l'échelle de |co| max ---
lam_dom_loc = np.full(nz_D, np.nan)
for j in range(nz_D):
    col = np.abs(co_sz[:, j])
    if col.sum() > 0:
        lam_dom_loc[j] = lam_w_km[int(np.argmax(col))]

# ======================================================================
#  FIGURE B1 — co-scalogramme (échelle, z) + échelle dominante
# ======================================================================
A = co_sz * (2*np.pi / np.sqrt(2)) / (scales[:, None])   # ~ area-preserving (×k)
mA = np.percentile(np.abs(A), 99) + 1e-30

fig, ax = plt.subplots(figsize=(8, 6))
pc = ax.pcolormesh(lam_w_km, z_D/1000, A.T, shading='auto',
                   norm=TwoSlopeNorm(vcenter=0, vmin=-mA, vmax=mA), cmap='RdBu_r')
ax.plot(lam_dom_loc, z_D/1000, 'k-', lw=1.6, alpha=.7, label='échelle dominante')
ax.set_xscale('log'); ax.invert_xaxis()
ax.set_xlabel(r'$\lambda$ [km] (DOG isotrope)'); ax.set_ylabel('z [km]')
ax.set_title('Co-scalogramme 2D ondelettes : où en z vit chaque échelle')
ax.legend(fontsize=9)
fig.colorbar(pc, ax=ax, label=r'co-activité ($\times k$)', pad=0.01)
plt.tight_layout(); plt.show()

# ======================================================================
#  FIGURE B2 — cartes locales (x,z) du co-flux à 3 échelles
# ======================================================================
fig, axes = plt.subplots(len(maps_xz), 1, figsize=(11, 9), sharex=True)
Xkm, Zkm = x/1000, z_D/1000
for ax, i in zip(axes, sorted(maps_xz)):
    Cmap = maps_xz[i]
    mm = np.percentile(np.abs(Cmap), 99) + 1e-30
    pc = ax.pcolormesh(Xkm, Zkm, Cmap, shading='auto',
                       norm=TwoSlopeNorm(vcenter=0, vmin=-mm, vmax=mm), cmap='RdBu_r')
    ax.set_ylabel('z [km]')
    ax.set_title(fr'co-flux local à $\lambda \approx$ {lam_w_km[i]:.1f} km')
    fig.colorbar(pc, ax=ax, label='$W_u W_w$', pad=0.01)
axes[-1].set_xlabel('x [km]')
plt.tight_layout(); plt.show()
