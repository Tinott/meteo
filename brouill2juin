# ======================================================================
#  CARACTÉRISATION DES ELLIPSES — mesures corrigées
#  ----------------------------------------------------------------------
#  Reprend la détection par blocs (inchangée) et corrige les CALCULS :
#   • taille  : demi-axe = 2·√λ  (et NON 2·√(2λ) qui surestimait de √2≈1.41)
#   • angle   : θ d'inertie  +  tilt convectif (régression du cœur sur z),
#               plus fiable car non biaisé par la troncature verticale.
#  Réutilise : psi_a, x, z_reg, n_x, nz_D, dxl, dzl  + psi_s, blocs_signe.
# ======================================================================
import numpy as np

# --- ellipse d'inertie d'un bloc : centre, demi-axes [km], angle d'inertie ---
def ellipse_bloc(pts):
    js, iis = pts[:, 0], pts[:, 1]
    w = np.abs(psi_s[js, iis]); w = w / (w.sum() + 1e-30)
    xc = (w*iis*dxl).sum(); zc = (w*js*dzl).sum()
    xx = iis*dxl - xc; zz = js*dzl - zc
    Ixx = (w*xx*xx).sum(); Izz = (w*zz*zz).sum(); Ixz = (w*xx*zz).sum()
    theta = np.degrees(0.5*np.arctan2(2*Ixz, Ixx - Izz))
    tr, det = Ixx + Izz, Ixx*Izz - Ixz**2
    disc = np.sqrt(max(tr*tr/4 - det, 0.0))
    a = 2*np.sqrt(max(tr/2 + disc, 0.0)) / 1000.0     # CORRIGÉ : 2·√λ  (demi-grand axe, km)
    b = 2*np.sqrt(max(tr/2 - disc, 0.0)) / 1000.0     # demi-petit axe, km
    return xc/1000, zc/1000, a, b, theta

# --- tilt convectif : décalage horizontal du cœur avec l'altitude (deg / verticale) ---
def tilt_bloc(pts):
    js, iis = pts[:, 0], pts[:, 1]
    ZC, XC, WL = [], [], []
    for j in np.unique(js):
        ii = iis[js == j]; w = np.abs(psi_s[j, ii])
        if w.sum() < 1e-30: continue
        ang  = 2*np.pi*ii/n_x                          # moyenne x circulaire (périodique)
        xbar = np.arctan2((w*np.sin(ang)).sum(), (w*np.cos(ang)).sum()) % (2*np.pi)
        XC.append(xbar*n_x/(2*np.pi)*dxl); ZC.append(j*dzl); WL.append(w.sum())
    ZC, XC, WL = map(np.array, (ZC, XC, WL))
    if len(ZC) < 3: return np.nan
    Zc = ZC - np.average(ZC, weights=WL); Xc = XC - np.average(XC, weights=WL)
    pente = np.average(Zc*Xc, weights=WL) / np.average(Zc*Zc, weights=WL)
    return np.degrees(np.arctan(pente))               # >0 : penche vers la droite en montant

