# ======================================================================
#  BLOC E — Suivi temporel : naissance, durée de vie, migration verticale
#  ----------------------------------------------------------------------
#  Association gloutonne d'un pas au suivant par proximité dans l'espace
#  des descripteurs (centre x,z + même sens de rotation). Un rouleau est
#  "le même" s'il reste proche (coût = distance pondérée) d'un pas à l'autre.
#  -> tracks = liste de trajectoires ; chaque trajectoire = liste de rouleaux.
#
#  x est périodique : la distance en x tient compte du wrap.
# ======================================================================
Lx = nx * dx / 1000.0                       # largeur domaine [km]
D_MAX = 30.0                                # coût max d'association (km équiv.)
WZ    = 2.0                                  # poids relatif de l'écart vertical

def dx_periodic(x1, x2):
    d = abs(x1 - x2)
    return min(d, Lx - d)

def assoc_cost(r1, r2):
    if r1['sense'] != r2['sense']:
        return np.inf
    dxk = dx_periodic(r1['xc_km'], r2['xc_km'])
    dzk = abs(r1['zc_km'] - r2['zc_km'])
    return np.hypot(dxk, WZ*dzk)

# init : chaque rouleau du 1er pas démarre un track
its = sorted(cat_by_t)
tracks = [[r] for r in cat_by_t[its[0]]]
active = list(range(len(tracks)))           # indices des tracks ouverts

for it_prev, it_cur in zip(its[:-1], its[1:]):
    curr = cat_by_t[it_cur]
    used = set()
    # tente de prolonger chaque track actif par le rouleau le plus proche
    new_active = []
    for ti in active:
        last = tracks[ti][-1]
        if last['it'] != it_prev:           # track déjà clos
            continue
        best, bestc = -1, D_MAX
        for ci, rc in enumerate(curr):
            if ci in used:
                continue
            c = assoc_cost(last, rc)
            if c < bestc:
                best, bestc = ci, c
        if best >= 0:
            tracks[ti].append(curr[best]); used.add(best); new_active.append(ti)
    # rouleaux non appariés -> nouveaux tracks
    for ci, rc in enumerate(curr):
        if ci not in used:
            tracks.append([rc]); new_active.append(len(tracks)-1)
    active = new_active

# --- statistiques de cycle de vie ---
life = np.array([len(t) for t in tracks])           # durée en pas de temps
dt_min = 1                                          # (adapter si dt connu)
