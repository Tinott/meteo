# ----------------------------------------------------------------------
#  TOURBILLON TYPIQUE — synthèse statistique de la population
#  Médianes (robustes aux valeurs extrêmes) ; angle moyenné sur le cercle.
# ----------------------------------------------------------------------
if len(vortices) == 0:
    print("\nAucun tourbillon : ajuste AMP_FRAC / LOOP_FRAC.")
else:
    grands = np.array([v['grand'] for v in vortices])
    petits = np.array([v['petit'] for v in vortices])
    dxs    = np.array([v['dx']    for v in vortices])
    dzs    = np.array([v['dz']    for v in vortices])
    thetas = np.array([v['theta'] for v in vortices])

    # moyenne d'angle sur le cercle (axe non orienté -> période 180°, on double)
    th_typ = 0.5 * np.degrees(np.arctan2(
        np.mean(np.sin(np.radians(2*thetas))),
        np.mean(np.cos(np.radians(2*thetas)))))
    th_disp = 0.5 * np.degrees(np.std(np.radians(2*thetas)))   # dispersion angulaire

    n_anti = sum(v['sign'] > 0 for v in vortices)   # max ψ'
    n_horo = sum(v['sign'] < 0 for v in vortices)   # min ψ'

    print("\n" + "="*50)
    print("  TOURBILLON TYPIQUE  (médianes sur la population)")
    print("="*50)
    print(f"  population ........ {len(vortices)} tourbillons "
          f"({n_anti} max ψ′ / {n_horo} min ψ′)")
    print(f"  grand axe ......... {np.median(grands):.0f} km   "
          f"[{grands.min():.0f}–{grands.max():.0f}]")
    print(f"  petit axe ......... {np.median(petits):.0f} km   "
          f"[{petits.min():.0f}–{petits.max():.0f}]")
    print(f"  aspect grand/petit  {np.median(grands/petits):.1f}")
    print(f"  extension Δx ...... {np.median(dxs):.0f} km")
    print(f"  extension Δz ...... {np.median(dzs):.1f} km")
    print(f"  inclinaison θ ..... {th_typ:+.0f}°  (± {th_disp:.0f}°)")
    print("="*50)
