# ======================================================================
#  TOURBILLON MOYEN PAR SIGNE → modèle ellipse caractéristique
#  ----------------------------------------------------------------------
#  On sépare les boucles BLEUES (min ψ′, sign=-1) des ROUGES (max ψ′, +1).
#  Pour chaque groupe, le tourbillon "typique" est une ELLIPSE :
#    • centre    = (médiane xc, médiane zc)
#    • demi-axes = médiane(grand/2), médiane(petit/2)   [km]
#    • angle θ   = moyenne circulaire des inclinaisons (repli d'axe géré)
#  Superposée à la carte ψ′.
# ======================================================================
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.colors import TwoSlopeNorm

def ellipse_moyenne(groupe):
    """(xc, zc, a, b, theta) médian/circulaire d'une liste de vortices."""
    xc = np.median([v['xc'] for v in groupe])
    zc = np.median([v['zc'] for v in groupe])
    a  = np.median([v['grand'] for v in groupe]) / 2.0      # demi-grand axe [km]
    b  = np.median([v['petit'] for v in groupe]) / 2.0      # demi-petit axe [km]
    th = np.array([v['theta'] for v in groupe])
    theta = 0.5*np.degrees(np.arctan2(np.mean(np.sin(np.radians(2*th))),
                                      np.mean(np.cos(np.radians(2*th)))))
    return xc, zc, a, b, theta

def trace_ellipse(ax, xc, zc, a, b, theta_deg, color, label):
    t  = np.linspace(0, 2*np.pi, 200)
    th = np.radians(theta_deg)
    ex, ez = a*np.cos(t), b*np.sin(t)
    X = xc + ex*np.cos(th) - ez*np.sin(th)
    Z = zc + ex*np.sin(th) + ez*np.cos(th)
    ax.plot(X, Z, color=color, lw=3, label=label)
    ax.plot([xc - a*np.cos(th), xc + a*np.cos(th)],          # grand axe
            [zc - a*np.sin(th), zc + a*np.sin(th)], color=color, lw=1.5, ls='--')
    ax.plot(xc, zc, 'o', color=color, ms=8, mec='k', mew=1.2)

