# ============================================================
#  Pente reel vs predit, niveau par niveau (regression sans intercept)
# ============================================================
pente_z = np.full(n_z, np.nan)
for iz in range(n_z):
    if not m212[iz]: continue
    x, y = dudt_reel[iz,:], dudt_pred_s[iz,:]
    if np.nanstd(x) < 1e-15 or np.all(np.isnan(y)): continue
    ok = np.isfinite(x) & np.isfinite(y)
    if ok.sum() < 10: continue
    pente_z[iz] = np.sum(x[ok]*y[ok])/np.sum(x[ok]**2)   # y = pente*x, x=reel, y=predit

fig, ax = plt.subplots(figsize=(5,7))
ax.plot(pente_z[m212], zkm[m212], 'o-', ms=3)
ax.axvline(1, color='r', lw=1, ls='--', label='pente=1 (accord parfait)')
ax.set_xlabel('pente (predit / reel)'); ax.set_ylabel('z (km)'); ax.legend(fontsize=9)
plt.tight_layout(); plt.show()
print(f"pente mediane (2-8km) : {np.nanmedian(pente_z[m28]):.2f}")
