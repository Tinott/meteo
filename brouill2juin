# ============================================================
def n_eff_safe(x, y):
    if np.nanstd(x) < 1e-15 or np.nanstd(y) < 1e-15:
        return np.nan
    ac_x = np.corrcoef(x[:-1], x[1:])[0,1]
    ac_y = np.corrcoef(y[:-1], y[1:])[0,1]
    if not (np.isfinite(ac_x) and np.isfinite(ac_y)):
        return np.nan
    denom = 1 + ac_x*ac_y
    if denom <= 0:
        return np.nan
    n = len(x)
    neff = n * (1-ac_x*ac_y) / denom
    return neff if neff > 2 else np.nan

p_z = np.full(n_z, np.nan)
statut = [''] * n_z
for iz in range(n_z):
    x, y = produit_adv[iz,:], dudt_tot[iz,:]
    if np.nanstd(x) < 1e-15:
        statut[iz] = 'x quasi constant'; continue
    r_iz = np.corrcoef(x,y)[0,1]
    if not np.isfinite(r_iz):
        statut[iz] = 'r indefini'; continue
    neff = n_eff_safe(x,y)
    if not np.isfinite(neff):
        statut[iz] = 'n_eff indefini/negatif'; continue
    t_val = r_iz*np.sqrt((neff-2)/(1-r_iz**2))
    p_z[iz] = 2*(1-stats.t.cdf(abs(t_val), neff-2))
    statut[iz] = 'ok'

# resume des niveaux non calculables
