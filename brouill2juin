n_stat_it = n_t - t_stat
iz_lo_glob = np.searchsorted(alt, 2000)
iz_hi_glob = np.searchsorted(alt, 18000)
n_z_fit    = iz_hi_glob - iz_lo_glob
z_fit_ab   = alt[iz_lo_glob:iz_hi_glob]

alpha_h = np.zeros((n_stat_it, n_z_fit))
beta_h  = np.zeros((n_stat_it, n_z_fit))
alpha_s = np.zeros((n_stat_it, n_z_fit))
beta_s  = np.zeros((n_stat_it, n_z_fit))

tend_mean_h  = np.zeros(n_z_fit)
tend_mean_s  = np.zeros(n_z_fit)
recon_mean_h = np.zeros(n_z_fit)
recon_mean_s = np.zeros(n_z_fit)

ds_u = xr.open_dataset(path3d('ua'))
ds_w = xr.open_dataset(path3d('wa'))

ubar_glob = np.zeros(n_z_fit)
for i_iz, iz in enumerate(range(iz_lo_glob, iz_hi_glob)):
    for it in range(t_stat, n_t):
        ubar_glob[i_iz] += ds_u['ua'].isel({dim_t: it, dim_z: iz}).values.mean()
    ubar_glob[i_iz] /= n_stat_it
print('ubar_glob calculé.')

for i_iz, iz in enumerate(range(iz_lo_glob, iz_hi_glob)):

    iz_lo = iz - 1
    iz_hi = iz + 1
    dz    = alt[iz_hi] - alt[iz_lo]

    u_all = ds_u['ua'].isel({dim_z: iz,    dim_t: slice(t_stat, n_t)}).values
    u_lo  = ds_u['ua'].isel({dim_z: iz_lo, dim_t: slice(t_stat, n_t)}).values
    u_hi  = ds_u['ua'].isel({dim_z: iz_hi, dim_t: slice(t_stat, n_t)}).values
    w_lo  = ds_w['wa'].isel({dim_z: iz_lo, dim_t: slice(t_stat, n_t)}).values
    w_hi  = ds_w['wa'].isel({dim_z: iz_hi, dim_t: slice(t_stat, n_t)}).values

    acc_tend_h  = 0.0 ; acc_tend_s  = 0.0
    acc_recon_h = 0.0 ; acc_recon_s = 0.0

    for i_t in range(n_stat_it):

        # ── terme gauche y : divergence du flux colonne par colonne ──
        u_p_lo = u_lo[i_t] - u_lo[i_t].mean()
        w_p_lo = w_lo[i_t] - w_lo[i_t].mean()
        u_p_hi = u_hi[i_t] - u_hi[i_t].mean()
        w_p_hi = w_hi[i_t] - w_hi[i_t].mean()

        flux_lo = rho0[iz_lo] * u_p_lo * w_p_lo   # (ny, nx)
        flux_hi = rho0[iz_hi] * u_p_hi * w_p_hi   # (ny, nx)
        y_2d    = -(flux_hi - flux_lo) / (dz * rho0[iz])   # (ny, nx)

        # ── régresseurs colonne par colonne ──────────────────────────
        x1_2d = rho0[iz] * (u_all[i_t] - ubar_glob[i_iz])
        x2_2d = (rho0[iz_hi] * (u_hi[i_t] - ubar_glob[i_iz + 1 if i_iz + 1 < n_z_fit else i_iz])
               - rho0[iz_lo] * (u_lo[i_t] - ubar_glob[i_iz - 1 if i_iz > 0 else 0])) / dz

        # ── système normal par région ─────────────────────────────────
        for mask, alpha_arr, beta_arr, tag in [
            (mh, alpha_h, beta_h, 'h'),
            (ms, alpha_s, beta_s, 's'),
        ]:
            y  = y_2d[mask].ravel()
            x1 = x1_2d[mask].ravel()
            x2 = x2_2d[mask].ravel()

            S11 = x1 @ x1
            S12 = x1 @ x2
            S22 = x2 @ x2
            b1  = x1 @ y
            b2  = x2 @ y

            det = S11 * S22 - S12 * S12
            alpha_arr[i_t, i_iz] = ( S22 * b1 - S12 * b2) / det
            beta_arr [i_t, i_iz] = (-S12 * b1 + S11 * b2) / det

            y_hat = alpha_arr[i_t, i_iz] * x1 + beta_arr[i_t, i_iz] * x2

            if tag == 'h':
                acc_tend_h  += y.mean()
                acc_recon_h += y_hat.mean()
            else:
                acc_tend_s  += y.mean()
                acc_recon_s += y_hat.mean()

    tend_mean_h[i_iz]  = acc_tend_h  / n_stat_it
    tend_mean_s[i_iz]  = acc_tend_s  / n_stat_it
    recon_mean_h[i_iz] = acc_recon_h / n_stat_it
    recon_mean_s[i_iz] = acc_recon_s / n_stat_it

    del u_all, u_lo, u_hi, w_lo, w_hi
    gc.collect()

    if i_iz % 10 == 0:
        print(f'  i_iz={i_iz}/{n_z_fit-1}  ({alt[iz]:.0f} m)')

ds_u.close() ; ds_w.close()
del ds_u, ds_w
gc.collect()
print('α, β (u) calculés.')






# ── Visualisation y vs ŷ ──────────────────────────────────────────────
fig, axes = plt.subplots(1, 2, figsize=(14, 8), sharey=True)

for ax, direct, recon, label, couleur in [
    (axes[0], tend_mean_h, recon_mean_h, 'HUMIDE', 'royalblue'),
    (axes[1], tend_mean_s, recon_mean_s, 'SÈCHE',  'saddlebrown'),
]:
    ax.plot(direct * 1e5, z_fit_ab, color=couleur, lw=2.5,
            label=r'$y$ direct')
    ax.plot(recon  * 1e5, z_fit_ab, color='black', lw=2, linestyle='--',
            label=r'$\hat{y}$ reconstruit')
    ax.axvline(0, color='grey', alpha=0.4)
    ax.set_xlabel('Tendance (×10⁻⁵ m/s²)')
    ax.set_title(f'Région {label}', fontweight='bold')
    ax.legend(fontsize=9)
    ax.grid(True, alpha=0.3)

axes[0].set_ylabel('Altitude (m)')
plt.suptitle(r'§18u — $y$ vs $\hat{y}$ (moyenne temporelle, 2–18 km)',
