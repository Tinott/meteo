# ============================================================
#  1) T1-down : somme humide+sec
#  2) T1 total : somme sur toutes categories/regions
#  3) T2 total et T2-env (somme humide+sec) — cote a cote
# ============================================================

# --- 1) T1-down, somme humide+sec ---
T1_down_total = tend_T1_cat['humide']['down'] + tend_T1_cat['sec']['down']

vmax1 = np.nanpercentile(np.abs(T1_down_total[mask_show]) * 3600, 90) + 1e-12
fig, ax = plt.subplots(figsize=(7, 6))
im = ax.pcolormesh(tt+t_stat, zkm[mask_show], T1_down_total[mask_show]*3600, cmap='RdBu_r',
                    norm=TwoSlopeNorm(0, -vmax1, vmax1), shading='auto')
ax.set_xlabel('t'); ax.set_ylabel('z (km)')
ax.set_title('tend(T1) — down, somme humide+sec')
fig.colorbar(im, ax=ax, pad=.02, label='m/s/h', extend='both')
plt.tight_layout(); plt.show()







# --- 2) T1 total (toutes regions, toutes categories) ---
T1_total = sum(tend_T1_cat[r][c] for r in tend_T1_cat for c in tend_T1_cat[r])

vmax2 = np.nanpercentile(np.abs(T1_total[mask_show]) * 3600, 90) + 1e-12
fig, ax = plt.subplots(figsize=(7, 6))
im = ax.pcolormesh(tt+t_stat, zkm[mask_show], T1_total[mask_show]*3600, cmap='RdBu_r',
                    norm=TwoSlopeNorm(0, -vmax2, vmax2), shading='auto')
ax.set_xlabel('t'); ax.set_ylabel('z (km)')
ax.set_title('tend(T1) total — somme humide/sec x up/down/env')
fig.colorbar(im, ax=ax, pad=.02, label='m/s/h', extend='both')
plt.tight_layout(); plt.show()







# --- 3) T2 total et T2-env (somme humide+sec), cote a cote, meme echelle ---
T2_total     = sum(tend_T2_cat[r][c] for r in tend_T2_cat for c in tend_T2_cat[r])
T2_env_total = tend_T2_cat['humide']['env'] + tend_T2_cat['sec']['env']

vmax3 = max(np.nanpercentile(np.abs(T2_total[mask_show]) * 3600, 90),
            np.nanpercentile(np.abs(T2_env_total[mask_show]) * 3600, 90)) + 1e-12

fig, axes = plt.subplots(1, 2, figsize=(13, 6), sharey=True)
for ax, (fld, lab) in zip(axes, [
        (T2_total,     'tend(T2) total — somme humide/sec x up/down/env'),
        (T2_env_total, 'tend(T2) — env, somme humide+sec')]):
    im = ax.pcolormesh(tt+t_stat, zkm[mask_show], fld[mask_show]*3600, cmap='RdBu_r',
                        norm=TwoSlopeNorm(0, -vmax3, vmax3), shading='auto')
    ax.set_xlabel('t'); ax.set_title(lab, fontsize=10)
    fig.colorbar(im, ax=ax, pad=.02, label='m/s/h', extend='both')
axes[0].set_ylabel('z (km)')
plt.tight_layout(); plt.show()
