# ======================================================================
#  §16 — PREUVE : advection resolue A(z)  vs  friction Reynolds F(z)
#  Equilibre stationnaire => A ≈ -F niveau par niveau (implication, pas correl.)
#  Advection resolue COMPLETE : -(u dx u + v dy u + w dz u), moyennee sur la fenetre
# ======================================================================
dt_sec = 6.0 * 3600.0
adv_prof = np.zeros(n_z)     # advection resolue moyenne <-(u.grad)u>

ds_u = xr.open_dataset(path3d('ua'))
ds_v = xr.open_dataset(path3d('va'))
ds_w = xr.open_dataset(path3d('wa'))

for iz in range(n_z):
    iz_lo, iz_hi = max(iz-1,0), min(iz+1,n_z-1)
    dz = alt[iz_hi]-alt[iz_lo]
    if dz == 0: dz = alt[1]-alt[0]
    acc, n = 0.0, 0
    for it in range(t_stat, n_t-1):
        u_2d = ds_u['ua'].isel({dim_t:it, dim_z:iz}).values
        v_2d = ds_v['va'].isel({dim_t:it, dim_z:iz}).values
        w_2d = ds_w['wa'].isel({dim_t:it, dim_z:iz}).values
        u_lo = ds_u['ua'].isel({dim_t:it, dim_z:iz_lo}).values
        u_hi = ds_u['ua'].isel({dim_t:it, dim_z:iz_hi}).values
        dudz = (u_hi-u_lo)/dz
        adv = -(u_2d*np.gradient(u_2d,dx,axis=1)
              + v_2d*np.gradient(u_2d,dy,axis=0)
              + w_2d*dudz)
        acc += adv.mean(); n += 1
        del u_2d,v_2d,w_2d,u_lo,u_hi,dudz,adv; gc.collect()
    adv_prof[iz] = acc/n if n else 0.0
    if iz % 10 == 0: print(f'  iz={iz}/{n_z-1} ({alt[iz]:.0f} m)')

ds_u.close(); ds_v.close(); ds_w.close(); del ds_u,ds_v,ds_w; gc.collect()

# ---- friction de Reynolds (deja calculee au §7) ----
F = tend_u_glob                      # -1/rho0 d_z(rho0 <u'w'>)
A = adv_prof                         # advection resolue

# ---- restriction troposphere libre (ou l'equilibre est propre) ----
m = (alt >= 2000) & (alt <= 12000)
Fb, Ab = F[m], A[m]

# ---- preuve #1 : pente de regression A = a*F ----
a, b = np.polyfit(Fb, Ab, 1)
r    = np.corrcoef(Fb, Ab)[0,1]

# ---- preuve #2 : NSE (A reconstruit -F) ----
NSE = 1 - np.sum((Ab-(-Fb))**2)/np.sum((Ab-Ab.mean())**2)

# ---- preuve #3 : residu stationnaire << termes ----
resid = Ab + Fb                      # doit ~ dudt ≈ 0
ratio = np.sqrt(np.mean(resid**2))/np.sqrt(np.mean(Fb**2))

print(f'\n[#1 pente ] A = {a:+.2f}*F + cste   (a≈-1 => compensation exacte)  r={r:+.2f}')
print(f'[#2 NSE  ] NSE(A ; -F) = {NSE:+.2f}   (proche de 1 => A explique par -F)')
print(f'[#3 resid] RMS(A+F)/RMS(F) = {ratio:.2f}   (<<1 => rien ne fuit, budget ferme)')

# ---- figure ----
fig, ax = plt.subplots(1, 2, figsize=(13, 6))
ax[0].plot(F*1e5, alt, 'royalblue', lw=2, label=r'Friction $F=-\frac1{\rho_0}\partial_z(\rho_0\overline{u''w''})$')
ax[0].plot(-A*1e5, alt, 'crimson', lw=2, ls='--', label=r'$-$Advection $-A$')
ax[0].axhspan(2000,12000,color='k',alpha=.05)
ax[0].axvline(0,color='grey',lw=.5); ax[0].set_ylim(0,15000)
ax[0].set_xlabel(r'Tendance ($\times10^{-5}$ m/s²)'); ax[0].set_ylabel('Altitude (m)')
ax[0].set_title('F et $-A$ se superposent\n(=> friction ⇔ advection)', fontweight='bold')
ax[0].legend(fontsize=9)

ax[1].scatter(Fb*1e5, Ab*1e5, c=alt[m], cmap='viridis', s=25)
xl = np.array([Fb.min(), Fb.max()])*1e5
ax[1].plot(xl, (a*xl/1e5+b)*1e5, 'k--', lw=1.3, label=f'pente {a:+.2f}')
ax[1].plot(xl, -xl, 'r:', lw=1, label='compensation exacte (-1)')
ax[1].set_xlabel(r'$F$ ($\times10^{-5}$)'); ax[1].set_ylabel(r'$A$ ($\times10^{-5}$)')
ax[1].set_title(f'NSE={NSE:+.2f}  r={r:+.2f}', fontweight='bold'); ax[1].legend(fontsize=9)
cb = fig.colorbar(ax[1].collections[0], ax=ax[1]); cb.set_label('altitude (m)')
plt.tight_layout(); plt.show()
