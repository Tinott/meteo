# ---------------------------------------------------------------------------
# Snapshots f_i(x,y,z) = u'(x,y,z) w'(x,y,z), SANS moyenne en y
# bande z <= Z_MAX_POD, sur les instants stationnaires
# ---------------------------------------------------------------------------
Z_MAX_POD = 18000.0
iz_pod = np.where(alt <= Z_MAX_POD)[0]
zP = alt[iz_pod].copy(); nzP = zP.size

ds_u = xr.open_dataset(path3d('ua'))
n_y = ds_u.sizes[dim_y]
ds_u.close()

N = n_t - t_stat
mem_gb = nzP * n_y * n_x * N * 4 / 1e9  # float32
print(f'Taille attendue : nzP={nzP}, n_y={n_y}, n_x={n_x}, N={N}')
print(f'Mémoire estimée snaps : {mem_gb:.1f} Go (float32)')

snaps = np.zeros((N, nzP, n_y, n_x), dtype=np.float32)  # préallocation

ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for idx, it in enumerate(range(t_stat, n_t)):
    for j, iz in enumerate(iz_pod):
        u_yx = ds_u['ua'].isel({dim_t:it, dim_z:iz}).values
        w_yx = ds_w['wa'].isel({dim_t:it, dim_z:iz}).values
        u_p = u_yx - u_yx.mean(axis=(0,1), keepdims=True)
        w_p = w_yx - w_yx.mean(axis=(0,1), keepdims=True)
        snaps[idx, j] = (u_p * w_p).astype(np.float32)   # (y,x) gardé tel quel
ds_u.close(); ds_w.close(); del ds_u, ds_w; gc.collect()

fmean = snaps.mean(axis=0)             # champ moyen (z,y,x)
A = snaps - fmean                      # fluctuations
print(f'{N} snapshots de taille ({nzP},{n_y},{n_x})')

# ---------------------------------------------------------------------------
# POD méthode des snapshots (sur A centré, cf. discussion précédente)
# ---------------------------------------------------------------------------
Amat = A.reshape(N, -1)                # (N, nzP*n_y*n_x) — centré cette fois
Cs = Amat @ Amat.T / N
evals, evecs = np.linalg.eigh(Cs)
order = evals.argsort()[::-1]; evals = evals[order]; evecs = evecs[:, order]
evals = np.clip(evals, 0, None)

modes = (evecs.T @ Amat)
norms = np.linalg.norm(modes, axis=1) + 1e-30
modes = (modes / norms[:,None]).reshape(N, nzP, n_y, n_x)
coefs = Amat @ modes.reshape(N, -1).T

energy = evals / evals.sum()
cum = np.cumsum(energy)
print('énergie des 6 premiers modes :', np.round(energy[:6]*100, 1), '%')
print(f"modes pour 90% de l'énergie : {np.searchsorted(cum, 0.90)+1}")

# ---------------------------------------------------------------------------
# Spectre + reconstruction du profil de flux + mode dominant (coupe y moyenne)
# ---------------------------------------------------------------------------
def flux_profile_3d(field3d):
    # profil rho0<u'w'>(z) à partir d'un champ (z,y,x) -> moyenne en (y,x)
    return rho0[iz_pod]*field3d.mean(axis=(1,2))

flux_full = flux_profile_3d(fmean)  # profil moyen de référence (= snaps.mean(axis=0))

fig, ax = plt.subplots(1, 3, figsize=(16, 6))
Kshow = int(min(12, energy.size))
kx_bar = np.arange(1, Kshow+1)
ax[0].bar(kx_bar, energy[:Kshow]*100, color='steelblue')
ax[0].plot(kx_bar, cum[:Kshow]*100, 'r-o', ms=4)
ax[0].set_xlabel('mode POD'); ax[0].set_ylabel('énergie (%)')
ax[0].set_title('Spectre POD 3D, champ centré', fontweight='bold'); ax[0].grid(alpha=.3)

Kmax = int(coefs.shape[1])
modes_flat = modes.reshape(Kmax, -1)
for K in [k for k in [1, 2, 4, 8] if k <= Kmax]:
    recon_A = (coefs[:, :K] @ modes_flat[:K]).reshape(N, nzP, n_y, n_x)  # (N,z,y,x)
    recon_snaps = recon_A + fmean[None]     # on rajoute la moyenne retirée
    flux_recon = flux_profile_3d(recon_snaps.mean(axis=0))
    ax[1].plot(flux_recon*1e3, zP, lw=2, label=f'{K} mode(s)')
ax[1].plot(flux_full*1e3, zP, 'k--', lw=2, label='complet')
ax[1].axvline(0, color='grey', alpha=.4)
ax[1].set_xlabel('flux (×10⁻³)'); ax[1].set_ylabel('z (m)')
ax[1].set_title('Reconstruction du profil de flux', fontweight='bold'); ax[1].legend(fontsize=8); ax[1].grid(alpha=.3)

# mode 1 : coupe (z,x) moyennée en y, pour visualisation
mode1_zx = modes[0].mean(axis=1)   # (nzP, n_x)
pm = np.percentile(np.abs(mode1_zx), 99)
im = ax[2].pcolormesh(x/1000, zP/1000, mode1_zx, cmap='RdBu_r',
                      norm=TwoSlopeNorm(0, -pm, pm), shading='auto')
ax[2].set_xlabel('x [km]'); ax[2].set_ylabel('z [km]')
ax[2].set_title('Mode POD #1 (moyenné en y)', fontweight='bold')
fig.colorbar(im, ax=ax[2])
plt.tight_layout(); plt.show()
