def wquantile(v, q, ww):
    """Quantile pondéré (q dans [0,1])."""
    m = np.isfinite(v) & np.isfinite(ww)
    v, ww = v[m], ww[m]
    idx = np.argsort(v); v, ww = v[idx], ww[idx]
    cum = np.cumsum(ww) / ww.sum()
    return np.interp(q, cum, v)

print("\n=== Descripteurs (médiane pondérée [Q25–Q75]) ===")
for name, v, unit in [('aspect ratio', AR, ''), ('orientation', ang, '°'),
                      ('λ_x', lamx, 'km'), ('λ_z', lamz, 'km'),
                      ('z centre', zc, 'km')]:
    q1, q2, q3 = (wquantile(v[ok], qq, w[ok]) for qq in (.25, .5, .75))
    print(f"  {name:12s}: {q2:6.2f} {unit:2s}  [{q1:.2f} – {q3:.2f}]")

# --- relations d'échelle par régression pondérée ---
def wpolyfit(xv, yv, ww, deg=1):
    m = np.isfinite(xv) & np.isfinite(yv) & np.isfinite(ww)
    return np.polyfit(xv[m], yv[m], deg, w=np.sqrt(ww[m]))

p_lamx_z  = wpolyfit(zc[ok],   lamx[ok], w[ok], 1)    # λ_x = f(z)
