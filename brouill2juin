# ============================================================
#  T1 (transport organise) + T2 (covariance sous-maille) — Hovmoller (z,t)
#  Structure corrigee : boucle EXTERNE sur le temps par blocs (BLOC),
#  boucle sur z en memoire ensuite — meme convention que le reste du fichier.
# ============================================================
SEUIL_W = 1e-5; SEUIL_COND = 1e-5

rey_zt = np.full((n_z, n_stat), np.nan)
T1_zt  = np.full((n_z, n_stat), np.nan)
T2_zt  = np.full((n_z, n_stat), np.nan)

ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
ds_clw = xr.open_dataset(path3d('clw')); ds_cli = xr.open_dataset(path3d('cli'))  # 'ice' sur UCLA

for t0 in range(t_stat, n_t, BLOC):
    t1 = min(t0+BLOC, n_t); sl = {dim_t: slice(t0, t1)}
    j0, j1 = t0 - t_stat, t1 - t_stat   # indices dans le tableau de sortie (0-based sur idx_stat)

    U   = load_ordered(ds_u['ua'].isel(sl),   dim_t, dim_z, dim_y, dim_x)   # (t_bloc, n_z, n_y, n_x)
    W   = load_ordered(ds_w['wa'].isel(sl),   dim_t, dim_z, dim_y, dim_x)
    CLW = load_ordered(ds_clw['clw'].isel(sl), dim_t, dim_z, dim_y, dim_x)
    CLI = load_ordered(ds_cli['cli'].isel(sl), dim_t, dim_z, dim_y, dim_x)

    for j in range(t1 - t0):
        for iz in range(n_z):
            uu, ww = U[j, iz].ravel(), W[j, iz].ravel()
            cloud = (ww > SEUIL_W) & ((CLW[j, iz].ravel() + CLI[j, iz].ravel()) > SEUIL_COND)
            ub, wb = uu.mean(), ww.mean()
            N = uu.size

            rey_zt[iz, j0+j] = rho0[iz] * ((uu-ub)*(ww-wb)).mean()

            t1_acc = t2_acc = 0.0
            for msk in [cloud, ~cloud]:
                if not msk.any(): continue
                sig = msk.sum()/N
                uc, wc = uu[msk].mean(), ww[msk].mean()
                t1_acc += sig*(uc-ub)*(wc-wb)
                t2_acc += sig*((uu[msk]-uc)*(ww[msk]-wc)).mean()
            T1_zt[iz, j0+j] = rho0[iz]*t1_acc
            T2_zt[iz, j0+j] = rho0[iz]*t2_acc

    del U, W, CLW, CLI; gc.collect()
    print(f'  t0={t0}/{n_t}')

ds_u.close(); ds_w.close(); ds_clw.close(); ds_cli.close(); gc.collect()

resid = rey_zt - (T1_zt + T2_zt)
print(f'controle |rey-(T1+T2)| max = {np.nanmax(np.abs(resid)):.2e} (doit etre ~0)')
