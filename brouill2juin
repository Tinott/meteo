# ============================================================
#  §11. flux_zt decompose humide/sec (le vrai objet a decomposer),
#       + test down-gradient vs contre-gradient selon le cisaillement d'environnement
# ============================================================
flux_h_zt=np.zeros((n_z,n_stat)); flux_s_zt=np.zeros((n_z,n_stat))
ds_u=xr.open_dataset(path3d('ua')); ds_w=xr.open_dataset(path3d('wa'))
for iz in range(n_z):
    u=ds_u['ua'].isel({dim_t:idx_stat,dim_z:iz}).values.reshape(n_stat,-1)
    w=ds_w['wa'].isel({dim_t:idx_stat,dim_z:iz}).values.reshape(n_stat,-1)
    ub=u.mean(axis=1); wb=w.mean(axis=1)          # moyenne DOMAINE (pas par zone), reference physique
    up=u-ub[:,None]; wp=w-wb[:,None]
    flux_h_zt[iz]=rho0[iz]*(up[:,mh_flat]*wp[:,mh_flat]).mean(axis=1)
    flux_s_zt[iz]=rho0[iz]*(up[:,ms_flat]*wp[:,ms_flat]).mean(axis=1)
    del u,w,up,wp; gc.collect()
ds_u.close(); ds_w.close(); gc.collect()

# verification : f_h*flux_h + f_s*flux_s doit redonner flux_zt (a peu pres —
# reste un terme croise negligeable si les moyennes locales par zone sont proches de ub/wb)
recon_flux=f_h*flux_h_zt+f_s*flux_s_zt
print(f'erreur reconstruction flux_zt : {np.max(np.abs(recon_flux-flux_zt)):.2e}')
print(f"contribution humide au flux total (2-8km) : {flux_h_zt[m28].mean()/flux_tot[m28].mean()*f_h:.0%}")
print(f"contribution seche au flux total  (2-8km) : {flux_s_zt[m28].mean()/flux_tot[m28].mean()*f_s:.0%}")

# down-gradient vs contre-gradient : signe(flux_zt) vs signe(-dudz_zt)
sens_down_gradient = np.sign(flux_zt) == np.sign(-dudz_zt)
frac_down = sens_down_gradient[m28].mean()
print(f"fraction de points (2-8km) en transport DOWN-GRADIENT : {frac_down:.0%} "
      f"({'majoritairement down-gradient' if frac_down>0.5 else 'majoritairement CONTRE-gradient'})")

fig,ax=plt.subplots(figsize=(7,5))
im=ax.pcolormesh(tt+t_stat, zkm[mask_show], sens_down_gradient[mask_show].astype(float),
                  cmap='RdBu_r', shading='auto')
ax.axhspan(2,8,color='k',alpha=.06); ax.set_xlabel('t'); ax.set_ylabel('z (km)')
ax.set_title("1 = down-gradient (flux et -dudz de meme signe) | 0 = contre-gradient")
fig.colorbar(im,ax=ax)
plt.tight_layout(); plt.show()
