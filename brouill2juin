# ======================================================================
# §16 — Comparaison flux de Reynolds <u'w'> : anomalies locales vs globales
#
# locale  : u' = u - mean(u[region]),  w' = w - mean(w[region])
# globale : u' = u - mean(u),          w' = w - mean(w)
# masque appliqué après pour globale
# ======================================================================

dt_sec = 6.0 * 3600.0

flux_loc_h = np.zeros(n_z)   # rho0 <u'w'>_R  anomalies locales  humide
flux_loc_s = np.zeros(n_z)   # rho0 <u'w'>_R  anomalies locales  sec
flux_glob_h = np.zeros(n_z)  # rho0 <u'w'>_R  anomalies globales humide
flux_glob_s = np.zeros(n_z)  # rho0 <u'w'>_R  anomalies globales sec

ds_u = xr.open_dataset(path3d('ua'))
ds_w = xr.open_dataset(path3d('wa'))

for iz in range(n_z):

    acc_loc_h  = 0.0 ; acc_loc_s  = 0.0
    acc_glob_h = 0.0 ; acc_glob_s = 0.0
    n = 0

    for it in range(t_stat, n_t):

        u_2d = ds_u['ua'].isel({dim_t: it, dim_z: iz}).values
        w_2d = ds_w['wa'].isel({dim_t: it, dim_z: iz}).values

        # ── anomalies locales ─────────────────────────────────────────
        u_h = u_2d[mh] ; u_s = u_2d[ms]
        w_h = w_2d[mh] ; w_s = w_2d[ms]

        u_p_h = u_h - u_h.mean()
        u_p_s = u_s - u_s.mean()
        w_p_h = w_h - w_h.mean()
        w_p_s = w_s - w_s.mean()

        acc_loc_h += (u_p_h * w_p_h).mean()
        acc_loc_s += (u_p_s * w_p_s).mean()

        # ── anomalies globales ────────────────────────────────────────
        u_p = u_2d - u_2d.mean()
        w_p = w_2d - w_2d.mean()

        acc_glob_h += (u_p * w_p)[mh].mean()
        acc_glob_s += (u_p * w_p)[ms].mean()

        n += 1
        del u_2d, w_2d, u_h, u_s, w_h, w_s
        del u_p_h, u_p_s, w_p_h, w_p_s, u_p, w_p
        gc.collect()

    flux_loc_h[iz]  = rho0[iz] * acc_loc_h  / n
    flux_loc_s[iz]  = rho0[iz] * acc_loc_s  / n
    flux_glob_h[iz] = rho0[iz] * acc_glob_h / n
    flux_glob_s[iz] = rho0[iz] * acc_glob_s / n

    if iz % 10 == 0:
        print(f'  iz={iz}/{n_z-1}')

ds_u.close() ; ds_w.close()
del ds_u, ds_w
gc.collect()

print('§16 terminé.')








# ======================================================================
# §16 — Visualisation : flux local vs global par région
# ======================================================================

sc = 1e5
idx_tropo = np.searchsorted(alt, 15000)

t1_loc_h  = tendance(flux_loc_h)
t1_loc_s  = tendance(flux_loc_s)
t1_glob_h = tendance(flux_glob_h)
t1_glob_s = tendance(flux_glob_s)

for region, t1_loc, t1_glob, couleur in [
    ('HUMIDE', t1_loc_h, t1_glob_h, 'royalblue'),
    ('SECHE',  t1_loc_s, t1_glob_s, 'saddlebrown'),
]:
    fig, axes = plt.subplots(1, 2, figsize=(14, 8), sharey=True)

    for ax, sl, titre in zip(
        axes,
        [slice(None, idx_tropo), slice(None)],
        ['Troposphere (0-15 km)', 'Colonne complete'],
    ):
        ax.plot(t1_loc[sl]  * sc, alt[sl],
                color=couleur, lw=2.5, linestyle='-',
                label='local  : u\' = u - mean(u[region])')
        ax.plot(t1_glob[sl] * sc, alt[sl],
                color=couleur, lw=2,   linestyle='--',
                label='global : u\' = u - mean(u[domaine])')
        ax.axvline(0, color='grey', alpha=0.4)
        ax.set_xlabel('Divergence flux Reynolds (x1e-5 m/s2)')
        ax.set_title(titre, fontweight='bold')
        ax.legend(fontsize=9)
        ax.grid(True, alpha=0.3)

    axes[0].set_ylabel('Altitude (m)')
    plt.suptitle(
        f'Region {region} — T1 = -1/rho0 * d(rho0 <u\'w\'>)/dz\n'
        'local vs global : si différents → circulation méso-échelle active',
        fontsize=13, fontweight='bold'
    )
    plt.tight_layout()
    plt.show()
