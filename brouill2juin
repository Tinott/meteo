    ax.plot(ubar_s[sl],   alt[sl], color='saddlebrown', lw=2, label=r'$\bar{u}_{\mathrm{sèche}}$')
    ax.plot(ubar_dom[sl], alt[sl], color='black', lw=2, linestyle='--', label=r'$\bar{u}_{\mathrm{domaine}}$')
    ax.axvline(0, color='grey', alpha=0.4)
    ax.set_xlabel('Vent zonal moyen (m/s)')
    ax.set_title(titre, fontweight='bold')
    ax.legend(fontsize=10)
    ax.grid(True, alpha=0.3)

axes[0].set_ylabel('Altitude (m)')
