# ============================================================
#  Controle CRITIQUE : T1(Romps) + T2(cov. interne) = flux reel mesure ?
#  Si ce residu n'est PAS ~0, alors T2 tel que defini n'est pas le
#  complement de T1 -- c'est juste un terme parasite qu'on additionne.
# ============================================================
rey_meme_region_zt = np.full((n_z, n_stat), np.nan)

ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for iz in range(n_z):
    u = ds_u['ua'].isel({dim_t: idx_stat, dim_z: iz}).values.reshape(n_stat, -1)
    w = ds_w['wa'].isel({dim_t: idx_stat, dim_z: iz}).values.reshape(n_stat, -1)
    ub = u.mean(axis=1); wb = w.mean(axis=1)
    rey_meme_region_zt[iz] = rho0[iz] * ((u - ub[:,None]) * (w - wb[:,None])).mean(axis=1)
    del u, w
ds_u.close(); ds_w.close(); gc.collect()

residu_identite = (flux_T1 + T2_zt_lisse) - rey_meme_region_zt
print("residu |T1+T2 - flux reel mesure|, mediane relative :",
      np.nanmedian(np.abs(residu_identite[m28])) / np.nanmedian(np.abs(rey_meme_region_zt[m28])))
