# ===========================================================================
#  LA décomposition : champ complexe  zeta(x,z) = u'(x,z) + i w'(x,z)
#  ---------------------------------------------------------------------------
#  Idée maîtresse : le flux de Reynolds est la PARTIE EN QUADRATURE de zeta.
#  Pour une ondelette de Morlet complexe W = |W| e^{i phi} :
#        u'w'  =  somme_{b,s}  |W(b,s)|^2 * sin(2 phi(b,s)) / Norm
#  -> |W|^2  = amplitude (= sigma_u sigma_w local)
#  -> sin(2 phi) = corrélation portée par le TILT des sous-tourbillons
#  On construit ici zeta moyenné-y sur l'état stationnaire (coupe x,z).
# ===========================================================================
Z_MAX_Q = 18000.0
iz_q = np.where(alt <= Z_MAX_Q)[0]
zQ = alt[iz_q].copy(); nzQ = zQ.size

# zeta moyenné sur y et sur le temps stationnaire (anomalie spatiale (y,x))
Uq = np.zeros((nzQ, n_x)); Wq = np.zeros((nzQ, n_x))
ds_u = xr.open_dataset(path3d('ua')); ds_w = xr.open_dataset(path3d('wa'))
for j, iz in enumerate(iz_q):
    u_acc = np.zeros(n_x); w_acc = np.zeros(n_x); nt = 0
    for it in range(t_stat, n_t):
        u_yx = ds_u['ua'].isel({dim_t:it, dim_z:iz}).values
        w_yx = ds_w['wa'].isel({dim_t:it, dim_z:iz}).values
        u_p = u_yx - u_yx.mean(axis=(0,1), keepdims=True)
        w_p = w_yx - w_yx.mean(axis=(0,1), keepdims=True)
        u_acc += u_p.mean(axis=0); w_acc += w_p.mean(axis=0); nt += 1
    Uq[j] = u_acc/nt; Wq[j] = w_acc/nt
ds_u.close(); ds_w.close(); del ds_u, ds_w; gc.collect()

dxl = float(x[1]-x[0])
# flux "vrai" de référence (profil) sur cette coupe : rho0 <u' w'>_x
flux_ref = rho0[iz_q] * (Uq*Wq).mean(axis=1)
print(f'zeta construit : ({nzQ},{n_x})   dx={dxl:.0f} m')
print(f'flux de référence (médian, bande) = {np.nanmedian((flux_ref)[ (zQ>=2000)&(zQ<=15000) ]):+.2e}')











# ===========================================================================
#  CWT Morlet complexe en x (périodique -> FFT exacte), par niveau.
#  On décompose SÉPARÉMENT u'(x) et w'(x) : Wu, Ww complexes.
#  Le co-spectre en quadrature qui donne le flux est  Re[ Wu * conj(Ww) ].
#  Vérif clé : somme sur les échelles  ==  <u'w'>_x  (Parseval) -> flux_ref.
# ===========================================================================
W0 = 6.0                                   # omega0 Morlet
NSC = 80
scales = np.geomspace(2*dxl, n_x*dxl/2, NSC)          # m
fourier_factor = (4*np.pi)/(W0 + np.sqrt(2+W0**2))
lam_km = scales*fourier_factor/1000.0                 # longueur d'onde [km]
kx = np.fft.fftfreq(n_x, d=dxl)*2*np.pi

def cwt_morlet(sig):
    """CWT Morlet complexe d'un profil périodique -> (NSC, n_x) complexe."""
    S = np.fft.fft(sig)
    out = np.empty((NSC, n_x), complex)
    for i, s in enumerate(scales):
        sk = s*kx
        psih = (np.pi**-0.25)*np.sqrt(2*np.pi*s/dxl)*(sk>0)*np.exp(-0.5*(sk-W0)**2)
        out[i] = np.fft.ifft(S*psih)
    return out

# co-scalogramme de quadrature par niveau : Co(b,s,z) = Re[Wu conj(Ww)]
Co = np.zeros((nzQ, NSC, n_x))
amp2 = np.zeros((nzQ, NSC, n_x))         # |Wu||Ww| (amplitude, pour la phase)
phase = np.zeros((nzQ, NSC, n_x))        # phase relative entre u' et w'
for j in range(nzQ):
    Wu = cwt_morlet(Uq[j]); Ww = cwt_morlet(Wq[j])
    cross = Wu*np.conj(Ww)               # produit croisé complexe
    Co[j]   = np.real(cross)            # PARTIE EN QUADRATURE = densité de flux
    amp2[j] = np.abs(Wu)*np.abs(Ww)
    phase[j]= np.angle(cross)           # phase relative u'/w' (le "tilt")

# reconstruction du flux par sommation sur les échelles (Torrence & Compo)
C_DELTA = 0.776; dj = np.log2(scales[1]/scales[0])
recon = (dj*dxl/C_DELTA) * np.sum(Co/scales[None,:,None], axis=1).mean(axis=1)
flux_recon = rho0[iz_q]*recon

# contrôle : recon doit suivre flux_ref (à la constante d'admissibilité près)
sb = (zQ>=2000)&(zQ<=15000)
scale_fit = np.nansum(flux_ref[sb]*flux_recon[sb])/np.nansum(flux_recon[sb]**2+1e-30)
print(f'reconstruction Morlet vs flux vrai : facteur d’échelle {scale_fit:.2f} '
      f'(idéal ~1), corr profil = {np.corrcoef(flux_ref[sb], flux_recon[sb])[0,1]:+.3f}')









# ===========================================================================
#  FIGURE MAÎTRESSE
#  (a) carte densité de flux Co(x,z) à l'échelle dominante : OÙ vit le transport
#  (b) spectre de flux par échelle : le flux est-il porté par UNE bande ?
#  (c) distribution de la phase relative u'/w' pondérée par |W|² par niveau :
#      pic à phi != 0  =  tilt systématique  =  cœur de l'idée
# ===========================================================================
# échelle dominante du flux (somme |Co| sur x et z, variance-preserving)
flux_per_scale = np.sum(np.abs(Co)/scales[None,:,None], axis=(0,2))
s_dom = int(np.argmax(flux_per_scale))
print(f'échelle dominante du flux : λ ≈ {lam_km[s_dom]:.0f} km')

fig = plt.figure(figsize=(17, 6))
gs = fig.add_gridspec(1, 3, width_ratios=[2, 1, 1.1])

# (a) carte de densité de flux à l'échelle dominante
axa = fig.add_subplot(gs[0,0])
field = Co[:, s_dom, :]
pm = np.percentile(np.abs(field), 99)+1e-30
im = axa.pcolormesh(x/1000, zQ/1000, field, cmap='RdBu_r',
                    norm=TwoSlopeNorm(0, -pm, pm), shading='auto')
axa.set_xlabel('x [km]'); axa.set_ylabel('z [km]')
axa.set_title(f'(a) densité de flux $|W|^2\\sin 2\\varphi$  (λ≈{lam_km[s_dom]:.0f} km)', fontweight='bold')
fig.colorbar(im, ax=axa, pad=.01)

# (b) spectre de flux par échelle
axb = fig.add_subplot(gs[0,1])
axb.plot(flux_per_scale, lam_km, 'purple', lw=2)
axb.axhline(lam_km[s_dom], color='grey', ls='--')
axb.set_xlabel('flux par échelle'); axb.set_ylabel('λ [km]')
axb.set_yscale('log'); axb.set_title('(b) à quelle échelle\nvit le flux', fontweight='bold'); axb.grid(alpha=.3)

# (c) phase dominante par niveau (moyenne circulaire pondérée par |W|^2 a l'échelle dom)
axc = fig.add_subplot(gs[0,2])
w_phase = amp2[:, s_dom, :]
ph = phase[:, s_dom, :]
phi_bar = np.arctan2(np.sum(w_phase*np.sin(ph),axis=1),
                     np.sum(w_phase*np.cos(ph),axis=1))   # moyenne circulaire par z
axc.plot(np.degrees(phi_bar), zQ/1000, 'darkgreen', lw=2)
axc.axvline(0, color='grey', ls='--', label='symétrique (φ=0)')
axc.axvline(-90, color='red', ls=':', alpha=.6, label='flux max (φ=−90°)')
axc.set_xlabel('phase relative u′/w′  φ (deg)'); axc.set_ylabel('z [km]')
axc.set_title('(c) tilt systématique\npar niveau', fontweight='bold'); axc.legend(fontsize=8); axc.grid(alpha=.3)
plt.tight_layout(); plt.show()






# ===========================================================================
#  LA décomposition compacte : flux(z) ≈ Amplitude(z) * sin(2 phi(z))
#  à l'échelle dominante. DEUX nombres par niveau au lieu de tout le champ.
#  On teste si ce produit minimal reconstruit le profil de flux.
# ===========================================================================
# amplitude dominante par niveau (somme de |W|^2 sur x, échelle dom)
A_dom   = np.sum(amp2[:, s_dom, :], axis=1)
# corrélation effective = <sin(2 phi)> pondérée par amplitude
sin2phi = np.sum(amp2[:, s_dom, :]*np.sin(2*phase[:, s_dom, :]), axis=1) / (A_dom+1e-30)
flux_2nombres = rho0[iz_q] * A_dom * sin2phi / n_x       # normalisation grossière

sb = (zQ>=2000)&(zQ<=15000)
k = np.nansum(flux_ref[sb]*flux_2nombres[sb])/np.nansum(flux_2nombres[sb]**2+1e-30)
corr2 = np.corrcoef(flux_ref[sb], flux_2nombres[sb])[0,1]

fig, ax = plt.subplots(1, 3, figsize=(16, 6), sharey=True)
ax[0].plot(A_dom, zQ/1000, 'crimson', lw=2)
ax[0].set_xlabel('amplitude $|W|^2$'); ax[0].set_ylabel('z [km]')
ax[0].set_title('Amplitude (∝ σ$_u$σ$_w$)', fontweight='bold'); ax[0].grid(alpha=.3)

ax[1].plot(sin2phi, zQ/1000, 'darkgreen', lw=2); ax[1].axvline(0, color='grey', alpha=.4)
ax[1].set_xlabel('sin(2φ)  (tilt / corrélation)')
ax[1].set_title('Phase (∝ tilt, donc cisaillement)', fontweight='bold'); ax[1].grid(alpha=.3)

ax[2].plot(flux_ref[sb]*1e3, zQ[sb]/1000, 'k', lw=2.5, label='flux vrai')
ax[2].plot(k*flux_2nombres[sb]*1e3, zQ[sb]/1000, 'r--', lw=2, label=f'amplitude×sin2φ (corr={corr2:+.2f})')
ax[2].axvline(0, color='grey', alpha=.4)
ax[2].set_xlabel('flux (×10⁻³)'); ax[2].set_title('Reconstruction à 2 nombres', fontweight='bold')
ax[2].legend(fontsize=9); ax[2].grid(alpha=.3)
plt.suptitle('Décomposition amplitude × phase : le flux en deux profils', fontsize=13, fontweight='bold')
plt.tight_layout(); plt.show()
print(f'corrélation profil (2 nombres vs vrai) = {corr2:+.3f}')
