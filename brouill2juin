# ======================================================================
#  CO-SCALOGRAMME (x, λ) — AXES GRADUÉS + LIGNES DE RÉFÉRENCE
#  Réutilise : coscalogram_level, uorg_all, worg_all, x, z_D, lam_w_km
# ======================================================================
Z_PICK_KM = 5.0
j_pick = int(np.argmin(np.abs(z_D/1000 - Z_PICK_KM)))
Co_xl  = coscalogram_level(j_pick)
xkm    = x / 1000.0
Lx     = xkm[-1] + (xkm[1]-xkm[0])               # largeur domaine [km]

# échelle dominante
marg    = np.abs(Co_xl).mean(axis=1)
lam_dom = np.exp(np.sum(marg*np.log(lam_w_km)) / (marg.sum()+1e-30))

fig, ax = plt.subplots(figsize=(13, 6))

mC = np.percentile(np.abs(Co_xl), 99) + 1e-30
pc = ax.pcolormesh(xkm, lam_w_km, Co_xl, shading='auto',
                   norm=TwoSlopeNorm(vcenter=0, vmin=-mC, vmax=mC), cmap='RdBu_r')

# --- axe Y : λ en km, log, grandes échelles en bas ---
ax.set_yscale('log'); ax.invert_yaxis()
lam_ticks = [t for t in [2, 5, 10, 20, 50, 100, 200, 300]
             if lam_w_km.min() <= t <= lam_w_km.max()]
ax.set_yticks(lam_ticks)
ax.set_yticklabels([str(t) for t in lam_ticks])
ax.set_ylabel(r'échelle  $\lambda$  [km]', fontsize=11)

# --- axe X : position en km, ticks tous les 50 km ---
xtick_step = 50
xticks = np.arange(0, Lx + 1, xtick_step)
ax.set_xticks(xticks)
ax.set_xticklabels([f'{int(t)}' for t in xticks])
ax.set_xlabel('position  x  [km]', fontsize=11)
ax.margins(x=0)

# --- lignes de référence HORIZONTALES (échelles repères) ---
for lam_ref in [10, 50, 100]:
    if lam_w_km.min() <= lam_ref <= lam_w_km.max():
        ax.axhline(lam_ref, color='grey', lw=0.6, ls=':', alpha=0.6)
# échelle dominante en évidence
ax.axhline(lam_dom, color='k', lw=1.3, ls='--', alpha=0.8)
ax.text(xkm[2], lam_dom, f'  λ dom ≈ {lam_dom:.0f} km',
        va='bottom', ha='left', fontsize=9, color='k',
        bbox=dict(boxstyle='round,pad=0.2', fc='white', ec='none', alpha=0.7))

# --- lignes de référence VERTICALES (positions repères) ---
for x_ref in xticks[1:-1]:
    ax.axvline(x_ref, color='grey', lw=0.4, ls=':', alpha=0.4)

ax.set_title(f'Co-scalogramme du flux organisé $T_1$  —  z = {z_D[j_pick]/1000:.1f} km',
             fontsize=12)

cbar = fig.colorbar(pc, ax=ax, label=r'co-flux  $\mathrm{Co}(x,\lambda)$  [m²/s²]', pad=0.02)
plt.tight_layout(); plt.show()

print("Repères :")
print(f"  x : 0 → {Lx:.0f} km, graduations tous les {xtick_step} km")
print(f"  λ : {lam_w_km.min():.1f} → {lam_w_km.max():.0f} km  "
      f"(petites échelles en HAUT, grandes en BAS)")
print(f"  ─ ─  pointillés gris = échelles repères 10/50/100 km + positions tous les 50 km")
print(f"  ─ ─  tiret noir      = échelle dominante ≈ {lam_dom:.0f} km")
