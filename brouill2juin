#  ETAPE 6 — dudt vs dudz : total / humide / sec (scatter, 2-8km)
# ============================================================
fig, axes = plt.subplots(1,3,figsize=(15,5))
for ax,(x,y,lab) in zip(axes, [(dudz_tot, dudt_tot, "total"),
                                 (dzuc, dtuc, "humide"),
                                 (dzus, dtus, "sec")]):
    xb, yb = x[m28].ravel(), y[m28].ravel()
    ok = np.isfinite(xb)&np.isfinite(yb)
    slope = np.sum(xb[ok]*yb[ok])/np.sum(xb[ok]**2)
    r = np.corrcoef(xb[ok], yb[ok])[0,1]
    ax.scatter(xb[ok], yb[ok], s=3, alpha=.15)
    xx = np.linspace(xb[ok].min(), xb[ok].max(), 10)
    ax.plot(xx, slope*xx, 'r-', lw=1.5)
    ax.set_xlabel(r'$\partial_z u$ (s$^{-1}$)'); ax.set_ylabel(r'$\partial_t u$ (m/s$^2$)')
    ax.set_title(f"{lab} : r={r:+.2f} | pente=-c_z={slope*100:+.2f} cm/s")
