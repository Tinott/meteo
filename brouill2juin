def masque_humide_x(seuil=None, idx_temps=None):
    """Profil PRW(x) moyenné sur y (+ temps si idx_temps=slice), et masque humide.
    seuil=None -> médiane spatiale. idx_temps=None -> tout le stationnaire."""
    ds = xr.open_dataset(path2d('prw'))          # PRW : (time, y, x)
    if idx_temps is None:
        idx_temps = idx_stat                      # défaut : état stationnaire
    prw = ds['prw'].isel({dim_t: idx_temps}).values   # (nt_sel, ny, nx) ou (ny,nx)
    ds.close(); gc.collect()
    # moyenne sur tous les axes sauf x -> profil PRW(x)
    axes_non_x = tuple(a for a in range(prw.ndim) if a != prw.ndim-1)
    prw_x = prw.mean(axis=axes_non_x)            # (nx,)
    if seuil is None:
        seuil = np.median(prw_x)
    humide = prw_x > seuil                        # masque booléen (nx,)
    return prw_x, humide, seuil




def trace_bords_humides(ax, x, humide, color='magenta', lw=1.3):
    """Trace un trait pointillé vertical à chaque frontière sec<->humide."""
    bords = np.where(np.diff(humide.astype(int)) != 0)[0]   # indices de transition
    for b in bords:
        xb = 0.5*(x[b] + x[b+1]) / 1000.0      # milieu de la transition, en km
        ax.axvline(xb, color=color, ls='--', lw=lw, alpha=0.9)





