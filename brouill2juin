print(f"T1+T2    2-8km : {np.nanmedian(corr_T1_T2[m28]):.2f}   | 8-12km : {np.nanmedian(corr_T1_T2[(alt>=8000)&(alt<=12000)]):.2f}")
print("\n=== R2 recalibre median ===")
print(f"T1 seul  2-8km : {np.nanmedian(R2cal_T1[m28]):.2f}   | 8-12km : {np.nanmedian(R2cal_T1[(alt>=8000)&(alt<=12000)]):.2f}")
print(f"T1+T2    2-8km : {np.nanmedian(R2cal_T1_T2[m28]):.2f}   | 8-12km : {np.nanmedian(R2cal_T1_T2[(alt>=8000)&(alt<=12000)]):.2f}")
