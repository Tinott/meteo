        acc_u2d_h += u_2d * mh   # zéro hors région
        acc_u2d_s += u_2d * ms
        acc_v2d_h += v_2d * mh
        acc_v2d_s += v_2d * ms

        n += 1
        del u_2d, u_nx, v_2d, w_2d, p_2d
        del u_h, u_s, w_h, w_s
        del u_p_h, u_p_s, w_p_h, w_p_s
        del u_nx_h, u_nx_s, dpdx
        gc.collect()

    flux_h2[iz] = rho0[iz] * acc_uw_h   / n
    flux_s2[iz] = rho0[iz] * acc_uw_s   / n
    dudt_h[iz]  = acc_dudt_h / n
    dudt_s[iz]  = acc_dudt_s / n
    pres_h[iz]  = acc_pres_h / n
    ubar_h[iz]  = acc_ubar_h / n
    ubar_s[iz]  = acc_ubar_s / n
