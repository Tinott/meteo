# ============================================================
#  Reconstruction du flux a partir de K binarise : uw_reconstruit = -K_binaire * dudz_zt
#  1) difference point par point avec le flux original (u'w')
#  2) difference entre profils moyennes en temps (flux_tot vs reconstruit moyenne sur t)
# ============================================================
uw_reconstruit = -K_binaire * dudz_zt          # meme equation, K remplace par sa version binarisee
diff_zt = uw_zt - uw_reconstruit                # ecart point par point (z,t)

fig, axes = plt.subplots(1, 3, figsize=(16,5), sharey=True)
v = np.nanpercentile(np.abs(uw_zt[mask_show]), 98)
for ax,(fld,lab) in zip(axes, [(uw_zt, r"$\overline{u'w'}$ original"),
                                 (uw_reconstruit, r"$-K_{binaire}\,\partial_z\bar u$ reconstruit"),
                                 (diff_zt, "difference (original - reconstruit)")]):
    im = ax.pcolormesh(tt+t_stat, zkm[mask_show], fld[mask_show], cmap='RdBu_r',
                        norm=TwoSlopeNorm(0,-v,v), shading='auto')
    ax.axhspan(2,8,color='k',alpha=.06); ax.set_xlabel('t'); ax.set_title(lab,fontsize=10)
axes[0].set_ylabel('z (km)'); axes[0].set_ylim(0,Z_TOP_KM)
fig.colorbar(im, ax=axes, orientation='horizontal', pad=.1, aspect=35, shrink=.6, label="m²/s²")
plt.suptitle("Flux original vs reconstruit avec K binarise (point par point)", fontweight='bold')
plt.show()

err_rel_zt = np.sqrt(np.nanmean(diff_zt[m28]**2)) / np.sqrt(np.nanmean(uw_zt[m28]**2))
print(f"RMSE point par point (2-8km) : {np.sqrt(np.nanmean(diff_zt[m28]**2)):.4f} m²/s² "
      f"| erreur relative = {err_rel_zt:.0%}")

# ---- profils moyennes en temps ----
uw_tot_mean = uw_zt.mean(axis=1)
uw_reconstruit_mean = np.nanmean(uw_reconstruit, axis=1)

fig, ax = plt.subplots(figsize=(6,5))
ax.plot(uw_tot_mean[mask_show], zkm[mask_show], label='flux original (moyenne t)')
ax.plot(uw_reconstruit_mean[mask_show], zkm[mask_show], label='flux reconstruit (moyenne t)', ls='--')
ax.axvline(0, color='k', lw=.5); ax.axhspan(2,8,color='k',alpha=.06)
ax.set_xlabel(r"$\overline{u'w'}$ (m²/s²)"); ax.set_ylabel('z (km)'); ax.set_ylim(0,Z_TOP_KM)
ax.legend(); plt.tight_layout(); plt.show()

diff_profil = uw_tot_mean - uw_reconstruit_mean
err_rel_profil = np.sqrt(np.nanmean(diff_profil[m28]**2)) / np.sqrt(np.nanmean(uw_tot_mean[m28]**2))
print(f"RMSE profil moyen (2-8km) : {np.sqrt(np.nanmean(diff_profil[m28]**2)):.4f} m²/s² "
      f"| erreur relative = {err_rel_profil:.0%}")
